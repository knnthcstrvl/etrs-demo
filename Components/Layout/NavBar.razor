@rendermode InteractiveServer

<section>
    <div class="etrs-admin-navbar border border-light-subtle bg-body-tertiary">
        <div class="d-flex align-items-center justify-content-between ps-4 pe-2 pe-lg-4 py-1">
            <div class="d-flex align-items-center">
                <h5 class="fw-bold text-body fs-5 mb-0">Company Name</h5>
                <div class="d-flex ps-3 d-none d-lg-flex align-items-center gap-1">
                    <button type="button" class="btn btn-link text-body text-decoration-none py-2 px-2" aria-label="home">Home</button>
                    <button type="button" class="btn btn-link text-body text-decoration-none py-2 px-2" aria-label="products">Products</button>
                    <button type="button" class="btn btn-link text-body text-decoration-none py-2 px-2" aria-label="company">Company</button>
                    <div class="dropdown">
                        <button class="btn btn-link text-body text-decoration-none py-2 px-2 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="choose a resource">
                            Resources
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Dashboard</a></li>
                            <li><a class="dropdown-item" href="#">Earnings</a></li>
                            <li><a class="dropdown-item" href="#">Support</a></li>
                        </ul>
                    </div>
                    <button type="button" class="btn btn-link text-body text-decoration-none py-2 px-2" aria-label="contact">Contact</button>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-link text-body d-none d-sm-block p-1" aria-label="notification">
                    <i class="fa-regular fa-bell fs-6"></i>
                </button>
                <div class="border-end border-secondary-subtle d-none d-xl-block" style="height: 24px;"></div>
                <div class="border-end border-secondary-subtle d-none d-lg-block" style="height: 24px;"></div>
                <div class="dropdown d-none d-lg-block">
                    <button class="btn btn-link text-body text-decoration-none dropdown-toggle px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="choose a brand">
                        CompanyName.com
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#">React</a></li>
                        <li><a class="dropdown-item" href="#">Vue.js</a></li>
                        <li><a class="dropdown-item" href="#">Angular</a></li>
                    </ul>
                </div>
                <div class="border-end border-secondary-subtle d-none d-sm-block" style="height: 24px;"></div>
                <div class="dropdown ms-2">
                    <button class="btn p-0 border-0 bg-transparent dropdown-toggle" type="button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="assets/images/common/avatar/avatar-3.jpg" alt="profile picture" class="rounded-circle" style="width:32px;height:32px;object-fit:cover;" />
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end profile-dropdown p-2" aria-labelledby="profileDropdown">
                        <li>
                            <a class="dropdown-item d-flex align-items-center rounded mb-1" href="#">
                                <img src="assets/images/common/avatar/avatar-3.jpg" class="rounded-circle me-2" style="width:40px;height:40px;object-fit:cover" />
                                <div>
                                    <div class="fw-bold">Caitlyn King</div>
                                    <div class="text-muted small">caitlyn@untitledui.com</div>
                                </div>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" href="#">My profile <span class="text-muted small">@@caitlyn_king</span></a></li>
                        <li><a class="dropdown-item" href="#">Account settings</a></li>
                        <li><a class="dropdown-item" href="#">Sign out</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><div class="dropdown-item text-muted small">Untitled UI <span class="float-end">v4.0</span></div></li>
                    </ul>
                </div>
                <div class="d-block d-lg-none ms-2">
                    <button class="btn btn-link text-body p-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMobileMenu" aria-expanded="false" aria-label="Toggle navigation">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="collapse d-lg-none" id="navbarMobileMenu">
            <ul class="list-unstyled px-4 pb-2 mb-0">
                <li><a class="dropdown-item rounded" href="#">Home</a></li>
                <li><a class="dropdown-item rounded" href="#">Products</a></li>
                <li><a class="dropdown-item rounded" href="#">Company</a></li>
                <li>
                    <a class="dropdown-item rounded" data-bs-toggle="collapse" href="#mobileResources" role="button" aria-expanded="false">Resources</a>
                    <div class="collapse ps-3" id="mobileResources">
                        <ul class="list-unstyled">
                            <li><a class="dropdown-item rounded" href="#">Dashboard</a></li>
                            <li><a class="dropdown-item rounded" href="#">Earnings</a></li>
                            <li><a class="dropdown-item rounded" href="#">Support</a></li>
                        </ul>
                    </div>
                </li>
                <li><a class="dropdown-item rounded" href="#">Contacts</a></li>
            </ul>
        </div>
    </div>
</section>
