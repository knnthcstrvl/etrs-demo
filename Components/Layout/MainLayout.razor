@inherits LayoutComponentBase

<style>
    .app-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
    }

    .app-body {
        display: flex;
        flex: 1;
        overflow: hidden;
    }

    .app-content {
        flex: 1;
        padding: 16px;
        overflow-y: auto;
        background-color: #f5f5f5;
    }

    .app-footer {
        text-align: center;
        padding: 10px;
        background: #eee;
        font-size: 13px;
    }

    .app-title {
        margin-left: 10px;
        font-size: 18px;
    }

</style>

