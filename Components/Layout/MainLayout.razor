@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="app-container">
    <div class="app-body">
        <Sidebar IsOpen="SidebarOpen" IsOpenChanged="SetSidebarOpenAsync" />

        <main class="app-content">
            <Header />
            <div class="app-content-body">
                @Body
            </div>
        </main>
    </div>
</div>

@* ToastContainer moved to top-level App.razor to ensure a single interactive instance *@

@code {
    private bool SidebarOpen = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("etrsLayoutSync.init");
            var savedSidebarOpen = await JS.InvokeAsync<bool?>("etrsLayoutSync.getSidebarOpen");
            if (savedSidebarOpen.HasValue && savedSidebarOpen.Value != SidebarOpen)
            {
                SidebarOpen = savedSidebarOpen.Value;
                StateHasChanged();
            }
        }
    }

    private async Task SetSidebarOpenAsync(bool isOpen)
    {
        SidebarOpen = isOpen;
        await JS.InvokeVoidAsync("etrsLayoutSync.setSidebarOpen", isOpen);
    }
}
