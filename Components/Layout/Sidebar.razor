@using Syncfusion.Blazor.Lists
@using Syncfusion.Blazor.Navigations

@inject NavigationManager Nav

@rendermode InteractiveServer

<SfSidebar Width="256px" @bind-IsOpen="IsOpen" ShowBackdrop="@IsBackdropVisible" Type="SidebarType.Push" aria-label="main navigation menu" role="complementary">
    <div class="d-flex flex-column justify-content-between vh-100">
        <div>
            <div class="d-flex flex-column justify-content-center align-items-center pt-4 mb-3">
                <span class="e-avatar e-avatar-xlarge e-avatar-circle">
                    <img src="data:image/png;base64," alt="profile picture" />
                </span>
                <div class="fs-5 fw-medium text-body mt-3">System Administrator</div>
                <a class="fs-6 text-body-secondary mt-2 text-decoration-none" href="mailto:admin@local">admin&#64;local</a>
            </div>
            <hr class="mx-3 border-light-subtle opacity-100" />
            <div>
                <SfListView CssClass="border-0 e-bigger" DataSource="@Data" aria-label="main navigation links" role="list">
                    <ListViewFieldSettings TValue="MenuItem"></ListViewFieldSettings>
                    <ListViewTemplates TValue="MenuItem">
                        <Template>
                            <div class="e-list-wrapper d-flex align-items-center px-2" @onclick="() => Navigate(context.Url)">
                                <span class="e-icons @context.FontIcon fs-6"></span>
                                <span class="fs-6 fw-normal ps-2 ms-1">@context.Field</span>
                            </div>
                        </Template>
                    </ListViewTemplates>
                </SfListView>
            </div>
        </div>
        <div class="p-3">
            <SfButton CssClass="e-outline w-100" IconCss="e-icons sf-icon-logout-07 fs-6" Content="Logout" Type="button" aria-label="logout" role="button"></SfButton>
        </div>
    </div>
</SfSidebar>

@code {
    [Parameter]
    public bool IsOpen { get; set; } = true;

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    public bool IsBackdropVisible = false;

    public List<MenuItem> Data = new()
    {
        new MenuItem { Field = "Dashboard", Url = "/", FontIcon = "e-icons e-grid-view" },
        new MenuItem { Field = "Attendance Logs", Url = "/Accounting", FontIcon = "e-icons e-clock" },
        new MenuItem { Field = "Employees", Url = "/Budget", FontIcon = "e-icons e-user" },
        new MenuItem { Field = "Devices", Url = "/Cashier", FontIcon = "e-icons e-file-sync" },
        new MenuItem { Field = "Shifts", Url = "/Procurement", FontIcon = "e-icons e-day" },
        new MenuItem { Field = "Exceptions", Url = "/Property", FontIcon = "e-icons e-warning" },
        new MenuItem { Field = "Users", Url = "/Member", FontIcon = "e-icons e-people" }
    };

    [JSInvokable]
    public void ResizeHandler(string message, int windowWidth)
    {
        if (message == "resizeAction")
        {
            IsBackdropVisible = windowWidth <= 640;
        }

        StateHasChanged();
    }

    public class MenuItem
    {
        public string Field { get; set; } = string.Empty;
        public string FontIcon { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
    }

    private void Navigate(string url)
    {
        Nav.NavigateTo(url);
    }
}
