@rendermode InteractiveServer
@inject Financial.State.CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject Financial.Services.IToastService ToastService

<aside class="etrs-sidebar-shell @(IsOpen ? "is-open" : "is-collapsed")" aria-label="main navigation menu" @onclick="CloseProfileMenu">
        <div class="etrs-sidebar">
    <div class="etrs-sidebar-top">
            <div class="etrs-sidebar-top-actions">
                @if (IsOpen)
                {
                    <span class="etrs-sidebar-logo">ETRS</span>
                }

                <button type="button"
                        class="etrs-sidebar-toggle"
                        @onclick="ToggleSidebar"
                        aria-label="Toggle sidebar">
                    <i class="fa-solid @(IsOpen ? "fa-angle-left" : "fa-angle-right")" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <nav class="etrs-sidebar-nav">
            <div class="etrs-nav-group">
                @foreach (var item in MainItems)
                {
                    <NavLink href="@item.Url"
                             Match="@item.Match"
                             class="etrs-nav-link"
                             title="@item.Label">
                        <span class="etrs-nav-icon" aria-hidden="true">
                            <i class="@item.Icon"></i>
                        </span>
                        @if (IsOpen)
                        {
                            <span class="etrs-nav-label">@item.Label</span>
                        }
                    </NavLink>
                }
            </div>
        </nav>

        <div class="etrs-sidebar-divider etrs-sidebar-divider-bottom"></div>
        <div class="etrs-sidebar-bottom" style="position:relative;">
            <div class="etrs-profile-card etrs-profile-card-bottom">
                <img class="etrs-profile-avatar" src="/images/user-profile.jpg" alt="user profile picture" />

                @if (IsOpen)
                {
                    <div class="etrs-profile-meta">
                        <strong>System Administrator</strong>
                        <span>admin&#64;local</span>
                    </div>

                    <div class="etrs-profile-actions-wrap">
                        <button type="button" class="etrs-profile-actions" title="More" @onclick="ToggleProfileMenu" @onclick:stopPropagation @ref="_profileBtn">
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>

                        <!-- Always render overlay so ElementReference is available to JS; hide when closed -->
                        <div class="etrs-profile-overlay @(IsProfileMenuOpen ? "" : "d-none")" @onclick:stopPropagation @ref="_profileOverlay" role="menu" aria-hidden="@(!IsProfileMenuOpen)">
                            <button type="button" class="etrs-nav-link etrs-nav-button etrs-settings-link" @onclick="OpenSettings" title="@SettingsItem.Label">
                                <span class="etrs-nav-icon" aria-hidden="true"><i class="@SettingsItem.Icon"></i></span>
                                <span class="etrs-nav-label">@SettingsItem.Label</span>
                            </button>

                            <button type="button" class="etrs-nav-link etrs-nav-button logout-button" @onclick="Logout" title="Logout">
                                <span class="etrs-nav-icon" aria-hidden="true"><i class="fa-solid fa-right-from-bracket"></i></span>
                                <span class="etrs-nav-label">Logout</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</aside>

@code {
    [Parameter]
    public bool IsOpen { get; set; } = true;

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

        private readonly List<MenuItem> MainItems = new()
    {
        new() { Label = "Dashboard", Url = "/dashboard", Icon = "fa-solid fa-house", Match = NavLinkMatch.All },
        new() { Label = "Attendance Logs", Url = "/attendance-logs", Icon = "fa-solid fa-clock", Match = NavLinkMatch.Prefix },
        new() { Label = "Employees", Url = "/employees", Icon = "fa-regular fa-circle-user", Match = NavLinkMatch.Prefix },
        new() { Label = "Exceptions", Url = "/exceptions", Icon = "fa-solid fa-triangle-exclamation", Match = NavLinkMatch.Prefix },
        new() { Label = "Users", Url = "/users", Icon = "fa-solid fa-users", Match = NavLinkMatch.Prefix }
    };

    private readonly MenuItem SettingsItem = new()
    {
        Label = "Settings",
        Icon = "fa-solid fa-gear"
    };

    public class MenuItem
    {
        public string Label { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    }

    private async Task ToggleSidebar()
    {
        IsOpen = !IsOpen;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private bool IsProfileMenuOpen { get; set; }
    private ElementReference _profileOverlay;
    private ElementReference _profileBtn;

    private void ToggleProfileMenu()
    {
        IsProfileMenuOpen = !IsProfileMenuOpen;
        _ = JS.InvokeVoidAsync("etrsSidebar.showProfileOverlay", _profileBtn, _profileOverlay, IsProfileMenuOpen);
    }

    private void CloseProfileMenu()
    {
        IsProfileMenuOpen = false;
    }

    private void OpenSettings()
    {
        // navigate to settings page
        NavManager.NavigateTo("/settings");
        IsProfileMenuOpen = false;
    }

    private void Logout()
    {
        try
        {
            AuthStateProvider.UpdateAuthenticationState(string.Empty);
        }
        catch { }

        try
        {
            ToastService.Show(new Models.ToastMessage { Type = Models.ToastType.Information, Title = "Signed out", Message = "You have been logged out.", Duration = 2500 });
        }
        catch { }

        // navigate to login and force reload
        NavManager.NavigateTo("/login", true);
    }
}
