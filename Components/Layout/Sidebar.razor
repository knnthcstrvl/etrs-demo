@rendermode InteractiveServer

<aside class="finance-sidebar-shell @(IsOpen ? "is-open" : "is-collapsed")" aria-label="main navigation menu">
    <div class="finance-sidebar">
        <div class="finance-sidebar-top">
            <div class="finance-profile-card">
                <img class="finance-profile-avatar" src="/images/user-profile.jpg" alt="user profile picture" />

                @if (IsOpen)
                {
                    <div class="finance-profile-meta">
                        <strong>System Administrator</strong>
                        <span>admin&#64;local</span>
                    </div>
                }

                <button type="button"
                        class="finance-sidebar-toggle"
                        @onclick="ToggleSidebar"
                        aria-label="Toggle sidebar">
                    <i class="fa-solid @(IsOpen ? "fa-angle-left" : "fa-angle-right")" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <nav class="finance-sidebar-nav">
            <div class="finance-nav-group">
                @foreach (var item in MainItems)
                {
                    <NavLink href="@item.Url"
                             Match="@item.Match"
                             class="finance-nav-link"
                             title="@item.Label">
                        <span class="finance-nav-icon" aria-hidden="true">
                            <i class="@item.Icon"></i>
                        </span>
                        @if (IsOpen)
                        {
                            <span class="finance-nav-label">@item.Label</span>
                        }
                    </NavLink>
                }
            </div>
        </nav>

        <div class="finance-sidebar-divider finance-sidebar-divider-bottom"></div>
        <div class="finance-sidebar-bottom">
            <button type="button"
                    class="finance-nav-link finance-nav-button finance-settings-link"
                    title="@SettingsItem.Label">
                <span class="finance-nav-icon" aria-hidden="true">
                    <i class="@SettingsItem.Icon"></i>
                </span>
                @if (IsOpen)
                {
                    <span class="finance-nav-label">@SettingsItem.Label</span>
                }
            </button>
        </div>
    </div>
</aside>

@code {
    [Parameter]
    public bool IsOpen { get; set; } = true;

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

        private readonly List<MenuItem> MainItems = new()
    {
        new() { Label = "Dashboard", Url = "/dashboard", Icon = "fa-solid fa-house", Match = NavLinkMatch.All },
        new() { Label = "Attendance Logs", Url = "/attendance-log", Icon = "fa-solid fa-clock", Match = NavLinkMatch.Prefix },
        new() { Label = "Employees", Url = "/Budget", Icon = "fa-regular fa-circle-user", Match = NavLinkMatch.Prefix },
        new() { Label = "Devices", Url = "/Cashier", Icon = "fa-solid fa-tablet-screen-button", Match = NavLinkMatch.Prefix },
        new() { Label = "Shifts", Url = "/Procurement", Icon = "fa-regular fa-rectangle-list", Match = NavLinkMatch.Prefix },
        new() { Label = "Exceptions", Url = "/Property", Icon = "fa-solid fa-triangle-exclamation", Match = NavLinkMatch.Prefix },
        new() { Label = "Users", Url = "/Member", Icon = "fa-solid fa-users", Match = NavLinkMatch.Prefix }
    };

    private readonly MenuItem SettingsItem = new()
    {
        Label = "Settings",
        Icon = "fa-solid fa-gear"
    };

    public class MenuItem
    {
        public string Label { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    }

    private async Task ToggleSidebar()
    {
        IsOpen = !IsOpen;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}
