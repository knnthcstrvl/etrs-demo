@rendermode InteractiveServer
@inject IJSRuntime JS

<header class="finance-header">
    <div class="finance-header-inner">
        <div class="finance-header-search" role="search">
            <span class="finance-search-icon" aria-hidden="true">
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <input type="search"
                   class="finance-search-input"
                   placeholder="Search"
                   aria-label="Search" />
        </div>

        <button type="button"
                class="finance-theme-toggle"
                title="Dark mode"
                aria-label="Toggle dark mode"
                @onclick="ToggleThemeAsync">
            <i class="fa-solid fa-moon" aria-hidden="true"></i>
        </button>
    </div>
</header>

@code {
    private async Task ToggleThemeAsync()
    {
        await JS.InvokeVoidAsync("etrsLayoutSync.toggleTheme");
    }
}
