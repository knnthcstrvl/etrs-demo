@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using Financial.Components.Pages
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IDbContextFactory<Financial.Data.EtrsDbContext> DbFactory

@code {
    [Parameter]
    public RouteData RouteData { get; set; } = default!;

    [Parameter]
    public Type? DefaultLayout { get; set; }

    private AuthenticationState? _authState;
    private bool _initialized;

    protected override async Task OnParametersSetAsync()
    {
        _authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var user = _authState?.User;
        var pageType = RouteData?.PageType;

        if (user?.Identity?.IsAuthenticated == true && !IsLoginPage(pageType))
        {
            var accountIsValid = await CurrentAccountIsValidAsync(user);
            if (!accountIsValid)
            {
                if (AuthStateProvider is Financial.State.CustomAuthenticationStateProvider customAuthStateProvider)
                {
                    await customAuthStateProvider.UpdateAuthenticationState(string.Empty);
                }

                _authState = await AuthStateProvider.GetAuthenticationStateAsync();
                NavManager.NavigateTo("/etr/login?accountDeleted=1");
                _initialized = true;
                return;
            }
        }

        // If user is authenticated and tries to open login page -> redirect to dashboard (client-side)
        if (user?.Identity?.IsAuthenticated == true && IsLoginPage(pageType))
        {
            NavManager.NavigateTo("/etr/dashboard");
            return;
        }

        // If user is not authenticated and the page is not AllowAnonymous and not login page ->
        // do not force a full navigation to /login here. Forcing a reload causes the app to
        // perform a round-trip which in some cases leads to a subsequent redirect to /dashboard
        // (because the auth state can change during the full load). Instead, allow the
        // component to render the login UI in-place so the URL remains the same and the
        // authentication state can stabilize.
        if (user?.Identity?.IsAuthenticated != true && !PageAllowsAnonymous(pageType) && !IsLoginPage(pageType))
        {
            _initialized = true;
            return;
        }

        _initialized = true;
    }

    private bool PageAllowsAnonymous(Type? pageType)
    {
        if (pageType == null) return false;
        return pageType.GetCustomAttributes(typeof(Microsoft.AspNetCore.Authorization.AllowAnonymousAttribute), true).Any();
    }

    private bool IsLoginPage(Type? pageType) => string.Equals(pageType?.Name, "LoginPage", StringComparison.Ordinal);

    private async Task<bool> CurrentAccountIsValidAsync(ClaimsPrincipal user)
    {
        var userIdText = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var hasUserId = int.TryParse(userIdText, out var userId);

        if (!hasUserId)
        {
            return false;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.UserAccounts
            .AsNoTracking()
            .AnyAsync(account =>
                account.IsActive
                && account.UserAccountId == userId);
    }
}

@if (!_initialized)
{
    <div>Loading...</div>
}
else
{
    var user = _authState!.User;
    var pageType = RouteData.PageType;

    if (user.Identity?.IsAuthenticated == true)
    {
        // Prevent authenticated users from accessing the login page
        if (IsLoginPage(pageType))
        {
            NavManager.NavigateTo("/etr/dashboard");
        }
        else
        {
            <RouteView RouteData="RouteData" DefaultLayout="DefaultLayout" />
        }
    }
    else
    {
        // If the page explicitly allows anonymous access, render it; otherwise show login
        if (PageAllowsAnonymous(pageType) || IsLoginPage(pageType))
        {
            <RouteView RouteData="RouteData" DefaultLayout="DefaultLayout" />
        }
        else
        {
            <LayoutView Layout="typeof(Components.Layout.BlankLayout)">
                <LoginPage />
            </LayoutView>
        }
    }
}
