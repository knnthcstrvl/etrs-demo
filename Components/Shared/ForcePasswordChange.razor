</style>

@code {
    private UserAccount? account;
    private bool showPrompt;
    private bool isSaving;
    private bool showNewPassword;
    private bool showConfirmPassword;
    private readonly PasswordChangeForm form = new();
    private string NewPasswordInputType => showNewPassword ? "text" : "password";
    private string ConfirmPasswordInputType => showConfirmPassword ? "text" : "password";

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        await LoadCurrentAccountAsync();
    }

    private async void HandleAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            await task;
            await InvokeAsync(LoadCurrentAccountAsync);
        }
        catch
        {
            await InvokeAsync(() =>
            {
                account = null;
                showPrompt = false;
                StateHasChanged();
            });
        }
    }

    private async Task LoadCurrentAccountAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            account = null;
            showPrompt = false;
            showNewPassword = false;
            showConfirmPassword = false;
            form.Clear();
            StateHasChanged();
            return;
        }

        var userIdText = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var userId = int.TryParse(userIdText, out var parsedUserId) ? parsedUserId : 0;

        await using var db = await DbFactory.CreateDbContextAsync();
        account = await db.UserAccounts
            .AsNoTracking()
            .FirstOrDefaultAsync(u => u.UserAccountId == userId);

        showPrompt = IsPasswordChangeRequired(account);
        if (showPrompt && account is not null && account.MustChangePassword == false)
        {
            await using var updateDb = await DbFactory.CreateDbContextAsync();
            var existing = await updateDb.UserAccounts.FindAsync(account.UserAccountId);
            if (existing is not null && existing.MustChangePassword == false)
            {
                existing.MustChangePassword = true;
                await updateDb.SaveChangesAsync();
                account.MustChangePassword = true;
            }
        }

        if (!showPrompt)
        {
            form.Clear();
        }

        StateHasChanged();
    }

    private async Task ChangePasswordAsync()
    {
        if (account is null || isSaving)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(form.NewPassword))
        {
            ShowToast(Models.ToastType.Warning, "Password required", "Enter a new password.");
            return;
        }

        if (!string.Equals(form.NewPassword, form.ConfirmPassword, StringComparison.Ordinal))
        {
            ShowToast(Models.ToastType.Warning, "Passwords do not match", "Enter the same password in both fields.");
            return;
        }

        isSaving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.UserAccounts.FindAsync(account.UserAccountId);
            if (existing is null)
            {
                ShowToast(Models.ToastType.Warning, "Account unavailable", "Your account could not be found.");
                return;
            }

            if (BCrypt.Net.BCrypt.Verify(form.NewPassword, existing.Password))
            {
                ShowToast(Models.ToastType.Warning, "Use a new password", "You cannot use your initial password.");
                return;
            }

            existing.Password = BCrypt.Net.BCrypt.HashPassword(form.NewPassword);
            existing.MustChangePassword = false;
            existing.DateUpdated = DateTime.UtcNow;
            await db.SaveChangesAsync();

            account = existing;
            showPrompt = false;
            showNewPassword = false;
            showConfirmPassword = false;
            form.Clear();
            ShowToast(Models.ToastType.Success, "Password changed", "Your password was updated.");
        }
        catch (Exception ex)
        {
            ShowToast(Models.ToastType.Error, "Password change failed", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowToast(Models.ToastType type, string title, string message)
    {
        ToastService.Show(new Models.ToastMessage
        {
            Type = type,
            Title = title,
            Message = message
        });
    }

    private void ToggleNewPasswordVisibility()
        => showNewPassword = !showNewPassword;

    private void ToggleConfirmPasswordVisibility()
        => showConfirmPassword = !showConfirmPassword;

    private static bool IsPasswordChangeRequired(UserAccount? user)
    {
        if (user is null)
        {
            return false;
        }

        if (user.MustChangePassword)
        {
            return true;
        }

        return !string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase)
            && user.DateUpdated is null;
    }

    public void Dispose()
        => AuthenticationStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;

    private sealed class PasswordChangeForm
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;

        public void Clear()
        {
            NewPassword = string.Empty;
            ConfirmPassword = string.Empty;
        }
    }
}
