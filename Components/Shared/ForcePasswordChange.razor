@using Financial.Data
@using Financial.Model
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<Financial.Data.EtrsDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Financial.Services.IToastService ToastService
@implements IDisposable

@if (showPrompt && account is not null)
{
    <div class="attendance-detail-overlay force-password-overlay">
        <div class="attendance-detail-modal attendance-input-modal force-password-modal" role="dialog" aria-modal="true" aria-labelledby="forcePasswordTitle" @onclick:stopPropagation="true">
            <div class="attendance-detail-header">
                <div>
                    <h2 id="forcePasswordTitle" class="attendance-detail-title">Change Password</h2>
                </div>
            </div>

            <EditForm Model="form" OnValidSubmit="ChangePasswordAsync">
                <div class="attendance-detail-body attendance-input-body">
                    <div class="attendance-detail-section attendance-detail-hero">
                        <div>
                            <div class="attendance-detail-eyebrow">First Login</div>
                            <div class="attendance-detail-person">Set a new password</div>
                            <div class="attendance-detail-meta">Your account is using an initial password. Change it to continue.</div>
                        </div>
                    </div>

                    <div class="attendance-detail-section">
                        <div class="attendance-input-grid force-password-grid">
                            <div class="attendance-input-field">
                                <label class="attendance-table-toolbar-label" for="forcedNewPassword">New Password</label>
                                <div class="force-password-input-wrap">
                                    <InputText id="forcedNewPassword"
                                               type="@NewPasswordInputType"
                                               class="form-control attendance-input-control force-password-input"
                                               autocomplete="new-password"
                                               @bind-Value="form.NewPassword"
                                               disabled="@isSaving" />
                                    <button type="button"
                                            class="force-password-visibility"
                                            title="@(showNewPassword ? "Hide password" : "Show password")"
                                            aria-label="@(showNewPassword ? "Hide password" : "Show password")"
                                            @onclick="ToggleNewPasswordVisibility"
                                            disabled="@isSaving">
                                        <i class="fa-regular @(showNewPassword ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="attendance-input-field">
                                <label class="attendance-table-toolbar-label" for="forcedConfirmPassword">Confirm Password</label>
                                <div class="force-password-input-wrap">
                                    <InputText id="forcedConfirmPassword"
                                               type="@ConfirmPasswordInputType"
                                               class="form-control attendance-input-control force-password-input"
                                               autocomplete="new-password"
                                               @bind-Value="form.ConfirmPassword"
                                               disabled="@isSaving" />
                                    <button type="button"
                                            class="force-password-visibility"
                                            title="@(showConfirmPassword ? "Hide password" : "Show password")"
                                            aria-label="@(showConfirmPassword ? "Hide password" : "Show password")"
                                            @onclick="ToggleConfirmPasswordVisibility"
                                            disabled="@isSaving">
                                        <i class="fa-regular @(showConfirmPassword ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="attendance-detail-footer">
                    <button type="submit" class="btn btn-primary attendance-detail-done" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save Password")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<style>
