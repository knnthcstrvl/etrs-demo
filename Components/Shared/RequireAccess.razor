@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IDbContextFactory<Financial.Data.EtrsDbContext> DbFactory
@code {
    [Parameter] public string[] RequiredAccess { get; set; } = Array.Empty<string>();
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool initialized;
    private bool authorized;

    protected override async Task OnInitializedAsync()
    {
        initialized = false;
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            if (user?.Identity is null || !user.Identity.IsAuthenticated)
            {
                Nav.NavigateTo("/etr/login");
                return;
            }

            var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
            var userIdText = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            var hasUserId = int.TryParse(userIdText, out var userId);

            if (string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase))
            {
                authorized = true;
                initialized = true;
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var account = hasUserId
                ? await db.UserAccounts.FirstOrDefaultAsync(u => u.UserAccountId == userId)
                : null;
            if (account is null)
            {
                authorized = false;
                initialized = true;
                Nav.NavigateTo("/etr/dashboard");
                return;
            }

            var accessSet = new HashSet<string>((account.AccessLevel ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries), StringComparer.OrdinalIgnoreCase);

            if (RequiredAccess == null || RequiredAccess.Length == 0)
            {
                // If no requirements defined, allow access
                authorized = true;
            }
            else
            {
                authorized = RequiredAccess.Any(r => Financial.Services.AccessPolicy.HasAccess(accessSet, r));
            }

            if (!authorized)
            {
                // redirect to dashboard if not authorized
                Nav.NavigateTo("/etr/dashboard");
            }
        }
        catch
        {
            authorized = false;
            Nav.NavigateTo("/etr/dashboard");
        }
        finally
        {
            initialized = true;
        }
    }
}

@if (!initialized)
{
    <div />
}
else if (authorized)
{
    @ChildContent
}
else
{
    <div />
}
