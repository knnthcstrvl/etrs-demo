@page "/Procurement"
@using Financial.Data
@using Financial.Model.Dtr
@using Microsoft.EntityFrameworkCore
@inject ProcurementDbContext Db

<PageTitle>Shifts</PageTitle>

<section class="panel-card">
    <div class="panel-heading">
        <div>
            <h1>Shift Schedules</h1>
            <p class="mb-0 text-muted">Seeded schedules used to compare expected time in and time out versus biometric punches.</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Work Date</th>
                    <th>Shift</th>
                    <th>Time In</th>
                    <th>Time Out</th>
                    <th>Source</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shift in shifts)
                {
                    <tr>
                        <td>@shift.Employee.FirstName @shift.Employee.LastName</td>
                        <td>@shift.WorkDate.ToString("MMM dd, yyyy")</td>
                        <td>@shift.ShiftName</td>
                        <td>@DateTime.Today.Add(shift.ScheduledTimeIn).ToString("hh:mm tt")</td>
                        <td>@DateTime.Today.Add(shift.ScheduledTimeOut).ToString("hh:mm tt")</td>
                        <td>@shift.ScheduleSource</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private List<ShiftSchedule> shifts = new();

    protected override async Task OnInitializedAsync()
    {
        shifts = await Db.ShiftSchedules
            .AsNoTracking()
            .Include(s => s.Employee)
            .OrderBy(s => s.WorkDate)
            .ThenBy(s => s.Employee.LastName)
            .ToListAsync();
    }
}
