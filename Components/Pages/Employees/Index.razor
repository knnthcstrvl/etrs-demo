    private IQueryable<Employee> ApplyDivisionScope(IQueryable<Employee> query)
    {
        if (string.Equals(CurrentUser.Role, "Admin", StringComparison.OrdinalIgnoreCase))
        {
            return query;
        }

        var scope = CurrentUser.DivisionScope.ToArray();
        return scope.Length == 0
            ? query.Where(employee => false)
            : query.Where(employee => scope.Contains(employee.DivisionCenterUnit));
    }

