    {
        employeeStatusType = type;
        activeEmployeeStatusDropdown = null;
        SyncEmployeeFormStatus();
    }

    private async Task ToggleEmployeeStatusDropdownAsync(string dropdown)
    {
        if (string.Equals(activeEmployeeStatusDropdown, dropdown, StringComparison.Ordinal))
        {
            activeEmployeeStatusDropdown = null;
            return;
        }

        if (string.Equals(dropdown, "activity", StringComparison.Ordinal))
        {
            openEmployeeStatusActivityUpward = await ShouldOpenEmployeeStatusMenuUpwardAsync(employeeStatusActivityButtonRef);
            openEmployeeStatusTypeUpward = false;
        }
        else
        {
            openEmployeeStatusTypeUpward = await ShouldOpenEmployeeStatusMenuUpwardAsync(employeeStatusTypeButtonRef);
            openEmployeeStatusActivityUpward = false;
        }

        activeEmployeeStatusDropdown = dropdown;
    }

    private void CloseEmployeeStatusDropdown()
    {
        activeEmployeeStatusDropdown = null;
    }

    private async Task<bool> ShouldOpenEmployeeStatusMenuUpwardAsync(ElementReference triggerRef)
    {
        try
        {
            return await JS.InvokeAsync<bool>("attendanceLogs.shouldOpenMenuUpward", triggerRef, 190, 16);
        }
        catch
        {
            return false;
        }
    }

    private string GetEmployeeStatusDropdownMenuClass(string dropdown)
    {
        var isOpen = string.Equals(activeEmployeeStatusDropdown, dropdown, StringComparison.Ordinal);
        var opensUpward = string.Equals(dropdown, "activity", StringComparison.Ordinal)
            ? openEmployeeStatusActivityUpward
            : openEmployeeStatusTypeUpward;

        return $"attendance-filter-select-menu{(isOpen ? " show" : string.Empty)}{(opensUpward ? " open-upward" : string.Empty)}";
    }

    private void SetEmployeeStatusSelections(string? status)
    {
        var (activity, employmentType) = ParseEmployeeStatus(status);

        employeeStatusActivity = EmployeeActivityOptions.Contains(activity, StringComparer.OrdinalIgnoreCase)
            ? activity
            : "Active";

        employeeStatusType = EmployeeTypeOptions.Contains(employmentType, StringComparer.OrdinalIgnoreCase)
            ? employmentType
            : "Regular";

        SyncEmployeeFormStatus();
    }

    private void SyncEmployeeFormStatus()
    {
        employeeForm.Status = $"{employeeStatusActivity}, {employeeStatusType}";
    }

