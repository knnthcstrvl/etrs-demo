@page "/employees"
@using Financial.Data
@using Financial.Model.Dtr
@using System.Text
@using Microsoft.EntityFrameworkCore
@inject ProcurementDbContext Db
@inject IJSRuntime JS
@inject Financial.Services.CurrentUserService CurrentUser

<PageTitle>ETRS | Employees</PageTitle>

<RequireAccess RequiredAccess='@(new string[] { "View", "Edit", "Import", "Export" })'>
<div class="dashboard-shell">
    <div class="panel-heading attendance-logs-heading">
        <div>
            <h1 class="attendance-logs-title">Employees</h1>
        </div>
        <div class="attendance-logs-header-actions">
            <InputFile id="employees-import-input" OnChange="ImportEmployeesAsync" accept=".csv" style="display:none;" />
            <label for="employees-import-input" class="btn btn-outline-secondary mb-0 @(CurrentUser.HasAccess("Import") ? "" : "disabled")">Import</label>
            <button type="button" class="btn btn-outline-secondary attendance-logs-export-btn" @onclick="ExportEmployeesAsync" disabled="@(!CurrentUser.HasAccess("Export"))">Export</button>
        </div>
    </div>


    <div class="metric-grid dashboard-metrics attendance-logs-metrics">
        <div class="metric-card">
            <span class="metric-label">Employees</span>
            <strong>@employees.Count</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Active</span>
            <strong>@activeEmployees</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Inactive</span>
            <strong>@inactiveEmployees</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Divisions</span>
            <strong>@divisionCount</strong>
        </div>
    </div>

    <div class="panel-card attendance-table-card">
        @if (showEmployeeModal)
        {
            <div class="modal-overlay">
                <div class="modal-card">
                    <h3>@(isEditingEmployee ? "Edit Employee" : "Add Employee")</h3>
                    <div class="form-grid">
                        <div>
                            <label>ID Number</label>
                            <input class="form-control" @bind="employeeForm.IdNumber" />
                        </div>
                        <div>
                            <label>Last Name</label>
                            <input class="form-control" @bind="employeeForm.LastName" />
                        </div>
                        <div>
                            <label>First Name</label>
                            <input class="form-control" @bind="employeeForm.FirstName" />
                        </div>
                        <div>
                            <label>Middle Name</label>
                            <input class="form-control" @bind="employeeForm.MiddleName" />
                        </div>
                        <div>
                            <label>Division / Unit</label>
                            <input class="form-control" @bind="employeeForm.DivisionCenterUnit" />
                        </div>
                        <div>
                            <label>Designation</label>
                            <input class="form-control" @bind="employeeForm.Designation" />
                        </div>
                        <div>
                            <label>Status</label>
                            <input class="form-control" @bind="employeeForm.Status" />
                        </div>
                    </div>
                    <div class="modal-actions">
                        <button class="btn btn-secondary" @onclick="CloseEmployeeModal">Cancel</button>
                        <button class="btn btn-primary" @onclick="SaveEmployeeAsync">Save</button>
                    </div>
                </div>
            </div>
        }
        <table class="table attendance-table">
            <thead>
                <tr>
                    <th>ID Number</th>
                    <th>Name</th>
                    <th>Division / Unit</th>
                    <th>Designation</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in PagedEmployees)
                {
                    var statusParts = ParseEmployeeStatus(employee.Status);

                    <tr>
                        <td><span class="cell-ellipsis" title="@DisplayValue(employee.IdNumber)">@DisplayValue(employee.IdNumber)</span></td>
                        <td><span class="cell-ellipsis" title="@FormatName(employee.LastName, employee.FirstName, employee.MiddleName)">@FormatName(employee.LastName, employee.FirstName, employee.MiddleName)</span></td>
                        <td><span class="cell-ellipsis" title="@DisplayValue(employee.DivisionCenterUnit)">@DisplayValue(employee.DivisionCenterUnit)</span></td>
                        <td><span class="cell-ellipsis" title="@DisplayValue(employee.Designation)">@DisplayValue(employee.Designation)</span></td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(employee.Status))
                            {
                                <span class="cell-ellipsis" title="-">-</span>
                            }
                            else
                            {
                                <div class="employee-status-pills" title="@DisplayValue(employee.Status)">
                                    <span class="@GetEmployeeActivityStatusClass(statusParts.Activity)">@statusParts.Activity</span>
                                    @if (!string.IsNullOrWhiteSpace(statusParts.EmploymentType))
                                    {
                                        <span class="employee-status-pill employee-status-type">@statusParts.EmploymentType</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            <button class="btn btn-link" @onclick="() => OpenEditEmployeeModal(employee)">Edit</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-footer">
        <div class="table-entries">@GetEntriesText(employees.Count, employeePage)</div>
        <div class="table-pagination">
            <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangeEmployeePage(employeePage - 1)" disabled="@(employeePage <= 1)">&#8249;</button>
            @foreach (var pageItem in BuildPageItems(EmployeeTotalPages, employeePage))
            {
                if (pageItem.HasValue)
                {
                    <button type="button" class="table-page-btn @(pageItem.Value == employeePage ? "active" : null)" @onclick="() => ChangeEmployeePage(pageItem.Value)">@pageItem.Value</button>
                }
                else
                {
                    <span class="table-page-ellipsis">...</span>
                }
            }
            <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangeEmployeePage(employeePage + 1)" disabled="@(employeePage >= EmployeeTotalPages)">&#8250;</button>
        </div>
    </div>
</div>
</RequireAccess>

<style>
    .employee-status-pills {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    .employee-status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 1.75rem;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        line-height: 1;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .employee-status-active {
        background: #e8f1ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
    }

    .employee-status-inactive {
        background: #fee2e2;
        color: #b91c1c;
        border-color: #fecaca;
    }

    .employee-status-type {
        background: var(--etrs-gray-100);
        color: var(--etrs-gray-700);
        border-color: var(--etrs-gray-200);
    }
</style>

@code {
    private const int PageSize = 10;
    private static readonly string[] EmployeeCsvHeaders =
    {
        "IdNumber",
        "LastName",
        "FirstName",
        "MiddleName",
        "DivisionCenterUnit",
        "Designation",
        "Status"
    };
    private static readonly Dictionary<string, string> EmployeeHeaderAliases = new(StringComparer.OrdinalIgnoreCase)
    {
        ["EmployeeId"] = "EmployeeId",
        ["IdNumber"] = "IdNumber",
        ["ID Number"] = "IdNumber",
        ["Id Number"] = "IdNumber",
        ["LastName"] = "LastName",
        ["Last Name"] = "LastName",
        ["FirstName"] = "FirstName",
        ["First Name"] = "FirstName",
        ["MiddleName"] = "MiddleName",
        ["Middle Name"] = "MiddleName",
        ["DivisionCenterUnit"] = "DivisionCenterUnit",
        ["Division / Unit"] = "DivisionCenterUnit",
        ["Division/Unit"] = "DivisionCenterUnit",
        ["Division"] = "DivisionCenterUnit",
        ["Designation"] = "Designation",
        ["Status"] = "Status"
    };

    private List<Employee> employees = new();
    private int activeEmployees;
    private int inactiveEmployees;
    private int divisionCount;
    private int employeePage = 1;

    private IEnumerable<Employee> PagedEmployees => employees
        .Skip((employeePage - 1) * PageSize)
        .Take(PageSize);

    private int EmployeeTotalPages => Math.Max(1, (int)Math.Ceiling(employees.Count / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitializeAsync();
        await LoadEmployeesAsync();
    }

    private async Task LoadEmployeesAsync()
    {
        employees = await Db.Employees
            .AsNoTracking()
            .OrderBy(e => e.LastName)
            .ThenBy(e => e.FirstName)
            .ToListAsync();

        activeEmployees = employees.Count(e => IsActiveEmployeeStatus(e.Status));
        inactiveEmployees = employees.Count - activeEmployees;
        divisionCount = employees
            .Select(e => e.DivisionCenterUnit)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        employeePage = Math.Clamp(employeePage, 1, EmployeeTotalPages);
    }

    private static string FormatName(string lastName, string firstName, string middleName)
    {
        var middleInitial = string.IsNullOrWhiteSpace(middleName) ? string.Empty : $" {middleName.Trim()[0]}.";
        return $"{lastName}, {firstName}{middleInitial}";
    }

    private void ChangeEmployeePage(int page)
    {
        employeePage = Math.Clamp(page, 1, EmployeeTotalPages);
    }

    private static string GetEntriesText(int totalCount, int currentPage)
    {
        if (totalCount == 0)
        {
            return "Showing 0 to 0 of 0 entries";
        }

        var start = ((currentPage - 1) * PageSize) + 1;
        var end = Math.Min(currentPage * PageSize, totalCount);
        return $"Showing {start} to {end} of {totalCount} entries";
    }

    private static IEnumerable<int?> BuildPageItems(int totalPages, int currentPage)
    {
        if (totalPages <= 7)
        {
            for (var page = 1; page <= totalPages; page++)
            {
                yield return page;
            }

            yield break;
        }

        yield return 1;

        if (currentPage > 3)
        {
            yield return null;
        }

        for (var page = Math.Max(2, currentPage - 1); page <= Math.Min(totalPages - 1, currentPage + 1); page++)
        {
            yield return page;
        }

        if (currentPage < totalPages - 2)
        {
            yield return null;
        }

        yield return totalPages;
    }

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static (string Activity, string EmploymentType) ParseEmployeeStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return (string.Empty, string.Empty);
        }

        var normalizedStatus = status.Trim();
        var separatorIndex = normalizedStatus.IndexOf(',');
        if (separatorIndex < 0)
        {
            separatorIndex = normalizedStatus.IndexOf(' ');
        }

        var parts = separatorIndex < 0
            ? new[] { normalizedStatus }
            : new[]
            {
                normalizedStatus[..separatorIndex],
                normalizedStatus[(separatorIndex + 1)..]
            };

        parts = parts
            .Select(part => part.Trim())
            .Where(part => !string.IsNullOrWhiteSpace(part))
            .ToArray();

        if (parts.Length == 0)
        {
            return (string.Empty, string.Empty);
        }

        return parts.Length == 1
            ? (FormatEmployeeStatusLabel(parts[0]), string.Empty)
            : (FormatEmployeeStatusLabel(parts[0]), FormatEmployeeStatusLabel(parts[1]));
    }

    private static bool IsActiveEmployeeStatus(string? status)
    {
        var (activity, _) = ParseEmployeeStatus(status);
        return string.Equals(activity, "Active", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetEmployeeActivityStatusClass(string activity)
    {
        var className = string.Equals(activity, "Active", StringComparison.OrdinalIgnoreCase)
            ? "employee-status-active"
            : string.Equals(activity, "Inactive", StringComparison.OrdinalIgnoreCase)
                ? "employee-status-inactive"
                : "employee-status-type";

        return $"employee-status-pill {className}";
    }

    private static string FormatEmployeeStatusLabel(string value)
    {
        return value.ToUpperInvariant() switch
        {
            "ACTIVE" => "Active",
            "INACTIVE" => "Inactive",
            "REGULAR" => "Regular",
            "COS" => "COS",
            "JO" => "JO",
            "CASUAL" => "Casual",
            "INTERN" => "Intern",
            _ => value
        };
    }

    private async Task ExportEmployeesAsync()
    {
        var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
        await JS.InvokeVoidAsync("attendanceLogs.downloadCsv", $"employees_{timestamp}.csv", BuildEmployeesCsv());
    }

    private string BuildEmployeesCsv()
    {
        var rows = new List<string>
        {
            string.Join(",", EmployeeCsvHeaders)
        };

        rows.AddRange(employees.Select(employee => string.Join(",", new[]
        {
            CsvValue(employee.IdNumber),
            CsvValue(employee.LastName),
            CsvValue(employee.FirstName),
            CsvValue(employee.MiddleName),
            CsvValue(employee.DivisionCenterUnit),
            CsvValue(employee.Designation),
            CsvValue(employee.Status)
        })));

        return string.Join(Environment.NewLine, rows);
    }

    private async Task ImportEmployeesAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            var content = await reader.ReadToEndAsync();
            var rows = ParseCsv(content);

            if (rows.Count <= 1)
            {
                ShowToast(ToastType.Warning, "Import skipped", "The selected CSV file does not contain any employee rows.");
                return;
            }

            var headers = rows[0]
                .Select(header => (header ?? string.Empty).Trim().TrimStart('\uFEFF'))
                .ToList();

            var headerMap = BuildHeaderMap(headers);
            if (headerMap is null)
            {
                ShowToast(ToastType.Warning, "Import failed", "Invalid employee CSV format. Use the Employees export file as the template.");
                return;
            }

            var existingEmployees = await Db.Employees.ToListAsync();
            var employeesByIdNumber = existingEmployees
                .Where(employee => !string.IsNullOrWhiteSpace(employee.IdNumber))
                .ToDictionary(employee => employee.IdNumber, StringComparer.OrdinalIgnoreCase);

            var inserted = 0;
            var updated = 0;
            var skipped = 0;

            foreach (var row in rows.Skip(1))
            {
                var values = NormalizeEmployeeImportRow(row, headers.Count);
                if (values.All(string.IsNullOrWhiteSpace))
                {
                    skipped++;
                    continue;
                }

                var idNumber = GetMappedValue(values, headerMap, "IdNumber");
                Employee employee;

                if (!string.IsNullOrWhiteSpace(idNumber) && employeesByIdNumber.TryGetValue(idNumber, out var existingEmployee))
                {
                    employee = existingEmployee;
                    updated++;
                }
                else
                {
                    employee = new Employee();
                    await Db.Employees.AddAsync(employee);

                    if (!string.IsNullOrWhiteSpace(idNumber))
                    {
                        employeesByIdNumber[idNumber] = employee;
                    }

                    inserted++;
                }

                employee.IdNumber = GetMappedValue(values, headerMap, "IdNumber");
                employee.LastName = GetMappedValue(values, headerMap, "LastName");
                employee.FirstName = GetMappedValue(values, headerMap, "FirstName");
                employee.MiddleName = GetMappedValue(values, headerMap, "MiddleName");
                employee.DivisionCenterUnit = GetMappedValue(values, headerMap, "DivisionCenterUnit");
                employee.Designation = GetMappedValue(values, headerMap, "Designation");
                employee.Status = GetMappedValue(values, headerMap, "Status");
            }

            await Db.SaveChangesAsync();
            await LoadEmployeesAsync();

            ShowToast(
                ToastType.Success,
                "Employees imported",
                $"Inserted: {inserted}, Updated: {updated}, Skipped: {skipped}.");
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Import failed", ex.Message);
        }
    }

    private static Dictionary<string, int>? BuildHeaderMap(IReadOnlyList<string> headers)
    {
        var headerMap = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

        for (var i = 0; i < headers.Count; i++)
        {
            var rawHeader = headers[i];
            if (string.IsNullOrWhiteSpace(rawHeader))
            {
                continue;
            }

            if (!EmployeeHeaderAliases.TryGetValue(rawHeader, out var normalizedHeader))
            {
                continue;
            }

            if (!headerMap.ContainsKey(normalizedHeader))
            {
                headerMap[normalizedHeader] = i;
            }
        }

        foreach (var requiredHeader in EmployeeCsvHeaders)
        {
            if (!headerMap.ContainsKey(requiredHeader))
            {
                return null;
            }
        }

        return headerMap;
    }

    private static List<string> NormalizeEmployeeImportRow(IReadOnlyList<string> row, int expectedCount)
    {
        var values = new List<string>();

        for (var index = 0; index < expectedCount; index++)
        {
            if (index == expectedCount - 1 && row.Count > expectedCount)
            {
                values.Add(string.Join(", ", row.Skip(index).Select(value => value ?? string.Empty)));
                break;
            }

            values.Add(index < row.Count ? row[index] ?? string.Empty : string.Empty);
        }

        while (values.Count < expectedCount)
        {
            values.Add(string.Empty);
        }

        return values;
    }

    private static List<List<string>> ParseCsv(string content)
    {
        var rows = new List<List<string>>();
        var currentRow = new List<string>();
        var currentValue = new StringBuilder();
        var inQuotes = false;

        for (var i = 0; i < content.Length; i++)
        {
            var ch = content[i];

            if (inQuotes)
            {
                if (ch == '"')
                {
                    if (i + 1 < content.Length && content[i + 1] == '"')
                    {
                        currentValue.Append('"');
                        i++;
                    }
                    else
                    {
                        inQuotes = false;
                    }
                }
                else
                {
                    currentValue.Append(ch);
                }

                continue;
            }

            if (ch == '"')
            {
                inQuotes = true;
                continue;
            }

            if (ch == ',')
            {
                currentRow.Add(currentValue.ToString());
                currentValue.Clear();
                continue;
            }

            if (ch == '\r')
            {
                continue;
            }

            if (ch == '\n')
            {
                currentRow.Add(currentValue.ToString());
                currentValue.Clear();
                rows.Add(currentRow);
                currentRow = new List<string>();
                continue;
            }

            currentValue.Append(ch);
        }

        if (currentValue.Length > 0 || currentRow.Count > 0)
        {
            currentRow.Add(currentValue.ToString());
            rows.Add(currentRow);
        }

        return rows;
    }

    private static string CsvValue(string? value)
    {
        var text = value ?? string.Empty;
        return $"\"{text.Replace("\"", "\"\"")}\"";
    }

    private static string GetMappedValue(IReadOnlyList<string> values, IReadOnlyDictionary<string, int> headerMap, string headerName)
    {
        if (!headerMap.TryGetValue(headerName, out var index))
        {
            return string.Empty;
        }

        if (index < 0 || index >= values.Count)
        {
            return string.Empty;
        }

        return values[index];
    }

    private void ShowToast(ToastType type, string title, string message)
    {
        ToastService.Show(new ToastMessage
        {
            Type = type,
            Title = title,
            Message = message
        });
    }

    // employee edit modal state
    private bool showEmployeeModal;
    private bool isEditingEmployee;
    private Employee employeeForm = new();

    private void OpenEditEmployeeModal(Employee employee)
    {
        isEditingEmployee = true;
        employeeForm = new Employee
        {
            EmployeeId = employee.EmployeeId,
            IdNumber = employee.IdNumber,
            LastName = employee.LastName,
            FirstName = employee.FirstName,
            MiddleName = employee.MiddleName,
            DivisionCenterUnit = employee.DivisionCenterUnit,
            Designation = employee.Designation,
            Status = employee.Status
        };
        showEmployeeModal = true;
    }

    private void CloseEmployeeModal()
    {
        showEmployeeModal = false;
    }

    private async Task SaveEmployeeAsync()
    {
        if (isEditingEmployee)
        {
            var existing = await Db.Employees.FindAsync(employeeForm.EmployeeId);
            if (existing is not null)
            {
                existing.IdNumber = employeeForm.IdNumber;
                existing.LastName = employeeForm.LastName;
                existing.FirstName = employeeForm.FirstName;
                existing.MiddleName = employeeForm.MiddleName;
                existing.DivisionCenterUnit = employeeForm.DivisionCenterUnit;
                existing.Designation = employeeForm.Designation;
                existing.Status = employeeForm.Status;
                await Db.SaveChangesAsync();
                await LoadEmployeesAsync();
            }
        }

        showEmployeeModal = false;
    }
}
