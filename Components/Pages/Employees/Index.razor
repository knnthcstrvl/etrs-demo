        }
    }

    private RenderFragment SortHeader(string label, string column) => builder =>
    {
        var sequence = 0;
        var isSorted = IsSortedColumn(column);
        var isDescending = GetIsSortedDescending(column);
        var showClear = HasCustomSort(column);

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "attendance-sort-header");

        builder.OpenElement(sequence++, "button");
        builder.AddAttribute(sequence++, "type", "button");
        builder.AddAttribute(sequence++, "class", $"attendance-sort-trigger{(isSorted ? " active" : string.Empty)}");
        builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => ToggleSort(column)));
        builder.AddAttribute(sequence++, "title", $"Sort by {label}");

        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "attendance-sort-label");
        builder.AddContent(sequence++, label);
        builder.CloseElement();

        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", $"attendance-sort-icon{(isSorted ? " active" : string.Empty)}");
        builder.OpenElement(sequence++, "i");
        builder.AddAttribute(sequence++, "class", isDescending ? "fa-solid fa-caret-down" : "fa-solid fa-caret-up");
        builder.AddAttribute(sequence++, "aria-hidden", "true");
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();

        if (showClear)
        {
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "class", "attendance-sort-clear");
            builder.AddAttribute(sequence++, "title", "Clear sorting");
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, ClearSorting));
            builder.AddAttribute(sequence++, "aria-label", "Clear sorting");
            builder.AddContent(sequence++, "x");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private bool HasCustomSort(string column)
        => !string.IsNullOrWhiteSpace(sortColumn)
            && string.Equals(sortColumn, column, StringComparison.OrdinalIgnoreCase);

    private bool IsSortedColumn(string column)
    {
        if (!string.IsNullOrWhiteSpace(sortColumn))
        {
            return string.Equals(sortColumn, column, StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals(column, "latest", StringComparison.OrdinalIgnoreCase);
    }

    private bool GetIsSortedDescending(string column)
    {
        if (string.IsNullOrWhiteSpace(sortColumn))
        {
            return string.Equals(column, "latest", StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals(sortColumn, column, StringComparison.OrdinalIgnoreCase) && sortDescending;
    }

    private void ToggleSort(string column)
    {
        if (string.Equals(sortColumn, column, StringComparison.OrdinalIgnoreCase))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = false;
        }

        employeePage = 1;
        RefreshFilteredEmployees();
    }

    private void ClearSorting()
    {
        sortColumn = null;
        sortDescending = true;
        employeePage = 1;
        RefreshFilteredEmployees();
    }

    private IEnumerable<Employee> ApplyEmployeeSort(IEnumerable<Employee> source)
    {
        var column = sortColumn?.Trim().ToLowerInvariant();
        var descending = sortDescending;

        return column switch
        {
            "id" => OrderByDirection(source, descending, employee => NormalizeSortValue(employee.IdNumber))
                .ThenBy(employee => NormalizeSortValue(employee.LastName))
                .ThenBy(employee => NormalizeSortValue(employee.FirstName)),
            "employee" => OrderByDirection(source, descending, employee => NormalizeSortValue(employee.LastName))
                .ThenBy(employee => NormalizeSortValue(employee.FirstName))
                .ThenBy(employee => NormalizeSortValue(employee.MiddleName)),
            "division" => OrderByDirection(source, descending, employee => NormalizeSortValue(employee.DivisionCenterUnit))
                .ThenBy(employee => NormalizeSortValue(employee.LastName))
                .ThenBy(employee => NormalizeSortValue(employee.FirstName)),
            "designation" => OrderByDirection(source, descending, employee => NormalizeSortValue(employee.Designation))
                .ThenBy(employee => NormalizeSortValue(employee.LastName))
                .ThenBy(employee => NormalizeSortValue(employee.FirstName)),
            "status" => OrderByDirection(source, descending, employee => NormalizeSortValue(employee.Status))
                .ThenBy(employee => NormalizeSortValue(employee.LastName))
                .ThenBy(employee => NormalizeSortValue(employee.FirstName)),
            _ => source
                .OrderByDescending(employee => employee.EmployeeId)
                .ThenBy(employee => NormalizeSortValue(employee.LastName))
                .ThenBy(employee => NormalizeSortValue(employee.FirstName))
        };
    }

    private static IOrderedEnumerable<T> OrderByDirection<T, TKey>(IEnumerable<T> source, bool descending, Func<T, TKey> keySelector)
        => descending ? source.OrderByDescending(keySelector) : source.OrderBy(keySelector);

    private static string NormalizeSortValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();

