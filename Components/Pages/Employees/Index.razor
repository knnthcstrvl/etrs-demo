    private async Task LoadEmployeesAsync()
    {
        employees = await ApplyDivisionScope(Db.Employees)
            .AsNoTracking()
            .OrderByDescending(e => e.EmployeeId)
            .ThenBy(e => e.LastName)
            .ThenBy(e => e.FirstName)
            .ToListAsync();

        activeEmployees = employees.Count(e => IsActiveEmployeeStatus(e.Status));
        inactiveEmployees = employees.Count - activeEmployees;
        divisionCount = employees
            .Select(e => e.DivisionCenterUnit)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        RefreshFilteredEmployees();
    }

    private static string FormatName(string? lastName, string? firstName, string? middleName)
    {
        var last = lastName?.Trim() ?? string.Empty;
        var first = firstName?.Trim() ?? string.Empty;
        var middleInitial = string.IsNullOrWhiteSpace(middleName) ? string.Empty : $" {middleName.Trim()[0]}.";
        return $"{last}, {first}{middleInitial}".Trim(' ', ',').ToUpperInvariant();
    }

    private void RefreshFilteredEmployees(bool resetPaging = false)
    {
        filteredEmployees = ApplyEmployeeSort(employees.Where(MatchesEmployeeFilters)).ToList();

        if (resetPaging)
        {
            employeePage = 1;
            return;
        }

        employeePage = Math.Clamp(employeePage, 1, EmployeeTotalPages);
    }

    private bool MatchesEmployeeFilters(Employee employee)
    {
        if (!MatchesSharedSearch(employee))
        {
            return false;
        }

        if (!MatchesSelectedValue(employee.IdNumber, filterIdNumber))
        {
            return false;
        }

        if (!MatchesSelectedValue(FormatName(employee.LastName, employee.FirstName, employee.MiddleName), filterEmployee))
        {
            return false;
        }

        if (!MatchesSelectedValue(employee.DivisionCenterUnit, filterDivision))
        {
            return false;
        }

        if (!MatchesSelectedValue(employee.Designation, filterDesignation))
        {
            return false;
        }

        return MatchesSelectedValue(employee.Status, filterStatus);
    }

    private bool MatchesSharedSearch(Employee employee)
    {
        var query = tableSearchText.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return ContainsText(employee.IdNumber, query)
            || MatchesEmployeeName(employee.LastName, employee.FirstName, employee.MiddleName, query)
            || ContainsText(employee.DivisionCenterUnit, query)
            || ContainsText(employee.Designation, query)
            || ContainsText(employee.Status, query);
    }

    private static bool ContainsText(string? source, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return !string.IsNullOrWhiteSpace(source)
            && source.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static bool MatchesSelectedValue(string? source, string? selectedValue)
    {
        if (string.IsNullOrWhiteSpace(selectedValue))
        {
            return true;
        }

        return string.Equals(source?.Trim(), selectedValue.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static bool MatchesEmployeeName(string? lastName, string? firstName, string? middleName, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        var trimmedQuery = query.Trim();
        var fullName = string.Join(" ", new[] { firstName, middleName, lastName }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var reversedName = string.Join(" ", new[] { lastName, firstName, middleName }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var formattedName = FormatName(lastName ?? string.Empty, firstName ?? string.Empty, middleName ?? string.Empty);

        return ContainsText(firstName, trimmedQuery)
            || ContainsText(middleName, trimmedQuery)
            || ContainsText(lastName, trimmedQuery)
            || ContainsText(fullName, trimmedQuery)
            || ContainsText(reversedName, trimmedQuery)
            || ContainsText(formattedName, trimmedQuery);
    }

    private static IEnumerable<string> GetDistinctOptions(IEnumerable<string?> values)
