@page "/etr/employees"
@using Financial.Data
@using Financial.Model.Dtr
@using System.Text
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject ProcurementDbContext Db
@inject IJSRuntime JS
@inject Financial.Services.CurrentUserService CurrentUser

<PageTitle>ETRS | Employees</PageTitle>

<RequireAccess RequiredAccess='@(new string[] { AccessPolicy.ManageEmployees })'>
<div class="dashboard-shell">
    <div class="panel-heading attendance-logs-heading">
        <div>
            <h1 class="attendance-logs-title">Employees</h1>
        </div>
        <div class="attendance-logs-header-actions">
            <button type="button" class="btn btn-outline-secondary attendance-logs-export-btn" @onclick="OpenAddEmployeeModal" disabled="@(!CurrentUser.HasAccess(AccessPolicy.AddEmployee))">Add Employee</button>
            <span class="employees-header-sep" aria-hidden="true"></span>
            <button type="button" class="btn btn-outline-secondary attendance-logs-export-btn" @onclick="OpenImportEmployeesModal" disabled="@(!CurrentUser.HasAccess(AccessPolicy.ImportEmployees))">Import</button>
            <button type="button" class="btn btn-outline-secondary attendance-logs-export-btn" @onclick="OpenExportEmployeesModal" disabled="@(!CurrentUser.HasAccess(AccessPolicy.ExportEmployees))">Export</button>
        </div>
    </div>


    <div class="metric-grid dashboard-metrics attendance-logs-metrics">
        <div class="metric-card">
            <span class="metric-label">Employees</span>
            <strong>@employees.Count</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Active</span>
            <strong>@activeEmployees</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Inactive</span>
            <strong>@inactiveEmployees</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Divisions</span>
            <strong>@divisionCount</strong>
        </div>
    </div>

    <div style="margin-top:1rem;">
    <div class="attendance-table-toolbar">
        <div class="attendance-table-search">
            <input id="employeeSearch"
                   class="form-control attendance-table-search-input"
                   type="search"
                   placeholder="Search..."
                   value="@tableSearchText"
                   @oninput="HandleTableSearchInput" />
        </div>

        <div class="attendance-table-actions" @ref="tableMenuControlsRef">
            <div class="attendance-filter-dropdown">
                <button type="button" class="btn btn-outline-secondary attendance-filter-button" @onclick="ToggleFilterMenu">
                    <i class="fa-solid fa-bars-staggered" aria-hidden="true"></i>
                    <span>Filter</span>
                    @if (HasActiveTableFilters)
                    {
                        <span class="attendance-filter-button-clear"
                              title="Clear filters"
                              role="button"
                              tabindex="0"
                              @onclick="ClearFiltersFromButton"
                              @onclick:stopPropagation="true">&times;</span>
                    }
                </button>

                <div class="attendance-filter-menu @(showFilterMenu ? "show" : null)" @onclick:stopPropagation="true">
                    <div class="attendance-filter-grid">
                        <div class="attendance-filter-field">
                            <label class="attendance-table-toolbar-label" for="employeeFilterId">ID Number</label>
                            <div class="attendance-filter-select-wrap">
                                <button type="button"
                                        id="employeeFilterId"
                                        class="attendance-filter-select-trigger @(activeFilterField == "id" ? "active" : null)"
                                        @onclick='() => ToggleFilterField("id")'>
                                    <span class="attendance-filter-select-value">@DisplayValue(filterIdNumber, "All ID Numbers")</span>
                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                </button>

                                <div class="attendance-filter-select-menu @(activeFilterField == "id" ? "show" : null)">
                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterIdNumber) ? "active" : null)" @onclick='() => SetFilterValue("id", string.Empty)'>All ID Numbers</button>
                                    @foreach (var option in CurrentIdNumberOptions)
                                    {
                                        <button type="button" class="attendance-filter-select-option @(string.Equals(filterIdNumber, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("id", option)'>@option</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="attendance-filter-field">
                            <label class="attendance-table-toolbar-label" for="employeeFilterEmployee">Employee</label>
                            <div class="attendance-filter-select-wrap">
                                <button type="button"
                                        id="employeeFilterEmployee"
                                        class="attendance-filter-select-trigger @(activeFilterField == "employee" ? "active" : null)"
                                        @onclick='() => ToggleFilterField("employee")'>
                                    <span class="attendance-filter-select-value">@DisplayValue(filterEmployee, "All Employees")</span>
                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                </button>

                                <div class="attendance-filter-select-menu @(activeFilterField == "employee" ? "show" : null)">
                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterEmployee) ? "active" : null)" @onclick='() => SetFilterValue("employee", string.Empty)'>All Employees</button>
                                    @foreach (var option in CurrentEmployeeOptions)
                                    {
                                        <button type="button" class="attendance-filter-select-option @(string.Equals(filterEmployee, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("employee", option)'>@option</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="attendance-filter-field">
                            <label class="attendance-table-toolbar-label" for="employeeFilterDivision">Division/Center/Admin Unit</label>
                            <div class="attendance-filter-select-wrap">
                                <button type="button"
                                        id="employeeFilterDivision"
                                        class="attendance-filter-select-trigger @(activeFilterField == "division" ? "active" : null)"
                                        @onclick='() => ToggleFilterField("division")'>
                                    <span class="attendance-filter-select-value">@DisplayValue(filterDivision, "All Divisions/Centers/Admin Units")</span>
                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                </button>

                                <div class="attendance-filter-select-menu @(activeFilterField == "division" ? "show" : null)">
                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterDivision) ? "active" : null)" @onclick='() => SetFilterValue("division", string.Empty)'>All Divisions/Centers/Admin Units</button>
                                    @foreach (var option in CurrentDivisionOptions)
                                    {
                                        <button type="button" class="attendance-filter-select-option @(string.Equals(filterDivision, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("division", option)'>@option</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="attendance-filter-field">
                            <label class="attendance-table-toolbar-label" for="employeeFilterDesignation">Designation</label>
                            <div class="attendance-filter-select-wrap">
                                <button type="button"
                                        id="employeeFilterDesignation"
                                        class="attendance-filter-select-trigger @(activeFilterField == "designation" ? "active" : null)"
                                        @onclick='() => ToggleFilterField("designation")'>
                                    <span class="attendance-filter-select-value">@DisplayValue(filterDesignation, "All Designations")</span>
                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                </button>

                                <div class="attendance-filter-select-menu @(activeFilterField == "designation" ? "show" : null)">
                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterDesignation) ? "active" : null)" @onclick='() => SetFilterValue("designation", string.Empty)'>All Designations</button>
                                    @foreach (var option in CurrentDesignationOptions)
                                    {
                                        <button type="button" class="attendance-filter-select-option @(string.Equals(filterDesignation, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("designation", option)'>@option</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="attendance-filter-field">
                            <label class="attendance-table-toolbar-label" for="employeeFilterStatus">Status</label>
                            <div class="attendance-filter-select-wrap">
                                <button type="button"
                                        id="employeeFilterStatus"
                                        class="attendance-filter-select-trigger @(activeFilterField == "status" ? "active" : null)"
                                        @onclick='() => ToggleFilterField("status")'>
                                    <span class="attendance-filter-select-value">@DisplayValue(filterStatus, "All Statuses")</span>
                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                </button>

                                <div class="attendance-filter-select-menu @(activeFilterField == "status" ? "show" : null)">
                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterStatus) ? "active" : null)" @onclick='() => SetFilterValue("status", string.Empty)'>All Statuses</button>
                                    @foreach (var option in CurrentStatusOptions)
                                    {
                                        <button type="button" class="attendance-filter-select-option @(string.Equals(filterStatus, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("status", option)'>@option</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="attendance-filter-actions">
                        <button type="button" class="attendance-filter-clear" @onclick="ClearFilters">Clear</button>
                        <button type="button" class="btn btn-primary attendance-filter-apply" @onclick="CloseFilterMenu">Apply</button>
                    </div>
                </div>
            </div>

            <div class="attendance-filter-dropdown attendance-entries-counter">
                <button type="button" class="btn btn-outline-secondary attendance-filter-button attendance-entries-button" @onclick="ToggleEntriesMenu">
                    <span>@pageSize</span>
                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                </button>

                <div class="attendance-entries-menu attendance-filter-menu @(showEntriesMenu ? "show" : null)" @onclick:stopPropagation="true">
                    @foreach (var option in PageSizeOptions)
                    {
                        <button type="button"
                                class="attendance-entries-option @(pageSize == option ? "active" : null)"
                                @onclick="() => SelectPageSize(option)">
                            @option
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="panel-card attendance-table-card"
         @onmouseenter="KeepRowMenuOpen"
         @onmouseleave="HideRowMenuAsync">
        @if (selectedEmployee is not null)
        {
            <div class="attendance-detail-overlay" @onclick="CloseEmployeeDetail">
                <div class="attendance-detail-modal employee-detail-modal" @onclick:stopPropagation="true">
                    <div class="attendance-detail-header">
                        <div>
                            <h2 class="attendance-detail-title">Employee Details</h2>
                        </div>
                        <div class="attendance-detail-header-actions">
                            <button type="button"
                                    class="attendance-detail-header-button"
                                    @onclick="() => OpenEditEmployeeModal(selectedEmployee)"
                                    disabled="@(!CurrentUser.HasAccess(AccessPolicy.EditEmployee))">
                                Edit Employee
                            </button>
                            <button type="button" class="attendance-detail-close" @onclick="CloseEmployeeDetail" aria-label="Close employee details">
                                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <div class="attendance-detail-body">
                        <div class="attendance-detail-section attendance-detail-hero">
                            @{
                                var selectedStatusParts = ParseEmployeeStatus(selectedEmployee.Status);
                            }
                            <div>
                                <div class="attendance-detail-eyebrow">Employee</div>
                                <div class="attendance-detail-person">@FormatName(selectedEmployee.LastName, selectedEmployee.FirstName, selectedEmployee.MiddleName)</div>
                                <div class="attendance-detail-meta">@DisplayValue(selectedEmployee.IdNumber)</div>
                            </div>
                            <div class="employee-status-pills attendance-detail-status-pills" title="@DisplayValue(selectedEmployee.Status)">
                                @if (!string.IsNullOrWhiteSpace(selectedStatusParts.Activity))
                                {
                                    <span class="@GetEmployeeActivityStatusClass(selectedStatusParts.Activity)">@selectedStatusParts.Activity</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(selectedStatusParts.EmploymentType))
                                {
                                    <span class="employee-status-pill employee-status-type">@selectedStatusParts.EmploymentType</span>
                                }
                            </div>
                        </div>

                        <div class="attendance-detail-section attendance-detail-section-primary">
                            <div class="attendance-detail-grid">
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">ID Number</span>
                                    <strong>@DisplayValue(selectedEmployee.IdNumber)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Last Name</span>
                                    <strong>@DisplayValue(selectedEmployee.LastName)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">First Name</span>
                                    <strong>@DisplayValue(selectedEmployee.FirstName)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Middle Name</span>
                                    <strong>@DisplayValue(selectedEmployee.MiddleName)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Division/Center/Admin Unit</span>
                                    <strong>@DisplayValue(selectedEmployee.DivisionCenterUnit)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Designation</span>
                                    <strong>@DisplayValue(selectedEmployee.Designation)</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="attendance-detail-footer">
                        <button type="button" class="attendance-detail-text-action" @onclick="CloseEmployeeDetail">Close</button>
                    </div>
                </div>
            </div>
        }

        @if (showEmployeeModal)
        {
            <div class="attendance-detail-overlay" @onclick="CloseEmployeeModal">
                <div class="attendance-detail-modal attendance-input-modal employee-input-modal" @onclick="CloseEmployeeStatusDropdown" @onclick:stopPropagation="true">
                    <div class="attendance-detail-header">
                        <div>
                            <h2 class="attendance-detail-title">@(isEditingEmployee ? "Edit Employee" : "Add Employee")</h2>
                        </div>
                        <button type="button" class="attendance-detail-close" @onclick="CloseEmployeeModal" aria-label="Close employee form">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="attendance-detail-body attendance-input-body">
                        <div class="attendance-detail-section attendance-detail-hero">
                            <div>
                                <div class="attendance-detail-eyebrow">Employee Record</div>
                                <div class="attendance-detail-person">Enter the employee details.</div>
                                <div class="attendance-detail-meta">This will @(isEditingEmployee ? "update the selected employee record" : "add a new employee to the master list").</div>
                            </div>
                            <div class="attendance-input-pill">@(isEditingEmployee ? "Edit" : "New")</div>
                        </div>

                        <div class="attendance-detail-section">
                            <div class="attendance-input-grid">
                                <div class="attendance-input-field">
                                    <span class="attendance-detail-label">ID Number</span>
                                    <input class="form-control attendance-input-control" @bind="employeeForm.IdNumber" />
                                </div>
                                <div class="attendance-input-field">
                                    <span class="attendance-detail-label">Last Name</span>
                                    <input class="form-control attendance-input-control" @bind="employeeForm.LastName" />
                                </div>
                                <div class="attendance-input-field">
                                    <span class="attendance-detail-label">First Name</span>
                                    <input class="form-control attendance-input-control" @bind="employeeForm.FirstName" />
                                </div>
                                <div class="attendance-input-field">
                                    <span class="attendance-detail-label">Middle Name</span>
                                    <input class="form-control attendance-input-control" @bind="employeeForm.MiddleName" />
                                </div>
                                <div class="attendance-input-field">
                                    <span class="attendance-detail-label">Division/Center/Admin Unit</span>
                                    <input class="form-control attendance-input-control" @bind="employeeForm.DivisionCenterUnit" />
                                </div>
                                <div class="attendance-input-field">
                                    <span class="attendance-detail-label">Designation</span>
                                    <input class="form-control attendance-input-control" @bind="employeeForm.Designation" />
                                </div>
                                <div class="attendance-input-field employee-status-field attendance-input-field-wide">
                                    <span class="attendance-detail-label">Status</span>
                                    <div class="employee-status-selector">
                                        <div class="employee-status-option-group">
                                            <label class="employee-status-option-heading" for="employeeStatusActivity">Employment Status</label>
                                            <div class="attendance-filter-select-wrap employee-status-dropdown" @onclick:stopPropagation="true">
                                                <button type="button"
                                                        id="employeeStatusActivity"
                                                        @ref="employeeStatusActivityButtonRef"
                                                        class="attendance-filter-select-trigger attendance-input-control @(activeEmployeeStatusDropdown == "activity" ? "active" : null)"
                                                        @onclick='() => ToggleEmployeeStatusDropdownAsync("activity")'>
                                                    <span class="attendance-filter-select-value">@employeeStatusActivity</span>
                                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                                </button>

                                                <div class="@GetEmployeeStatusDropdownMenuClass("activity")">
                                                    @foreach (var option in EmployeeActivityOptions)
                                                    {
                                                        <button type="button"
                                                                class="attendance-filter-select-option @(string.Equals(employeeStatusActivity, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                                                @onclick="() => SelectEmployeeStatusActivity(option)">
                                                            @option
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="employee-status-option-group">
                                            <label class="employee-status-option-heading" for="employeeStatusType">Employment Type</label>
                                            <div class="attendance-filter-select-wrap employee-status-dropdown" @onclick:stopPropagation="true">
                                                <button type="button"
                                                        id="employeeStatusType"
                                                        @ref="employeeStatusTypeButtonRef"
                                                        class="attendance-filter-select-trigger attendance-input-control @(activeEmployeeStatusDropdown == "type" ? "active" : null)"
                                                        @onclick='() => ToggleEmployeeStatusDropdownAsync("type")'>
                                                    <span class="attendance-filter-select-value">@employeeStatusType</span>
                                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                                </button>

                                                <div class="@GetEmployeeStatusDropdownMenuClass("type")">
                                                    @foreach (var option in EmployeeTypeOptions)
                                                    {
                                                        <button type="button"
                                                                class="attendance-filter-select-option @(string.Equals(employeeStatusType, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                                                @onclick="() => SelectEmployeeStatusType(option)">
                                                            @option
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="attendance-detail-footer">
                        <button type="button" class="attendance-detail-text-action" @onclick="CloseEmployeeModal">Cancel</button>
                        <button type="button" class="btn btn-primary attendance-detail-done" @onclick="SaveEmployeeAsync">Save</button>
                    </div>
                </div>
            </div>
        }

        @if (showDeleteEmployeeModal && employeePendingDelete is not null)
        {
            <div class="attendance-detail-overlay" @onclick="CloseDeleteEmployeeModal">
                <div class="attendance-detail-modal employee-delete-modal" @onclick:stopPropagation="true">
                    <div class="attendance-detail-header">
                        <div>
                            <h2 class="attendance-detail-title">Delete Employee</h2>
                        </div>
                        <button type="button"
                                class="attendance-detail-close"
                                @onclick="CloseDeleteEmployeeModal"
                                aria-label="Close delete confirmation"
                                disabled="@isDeletingEmployee">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="attendance-detail-body">
                        <div class="attendance-detail-section attendance-delete-warning">
                            <div class="attendance-delete-icon" aria-hidden="true">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>
                            <div>
                                <div class="attendance-detail-eyebrow">Confirm Delete</div>
                                <div class="attendance-detail-person">@FormatName(employeePendingDelete.LastName, employeePendingDelete.FirstName, employeePendingDelete.MiddleName)</div>
                                <div class="attendance-detail-meta">
                                    This will permanently delete the employee record. Attendance logs will remain available.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="attendance-detail-footer">
                        <button type="button"
                                class="attendance-detail-text-action"
                                @onclick="CloseDeleteEmployeeModal"
                                disabled="@isDeletingEmployee">
                            Cancel
                        </button>
                        <button type="button"
                                class="btn btn-danger attendance-detail-done"
                                @onclick="DeleteEmployeeAsync"
                                disabled="@isDeletingEmployee">
                            @(isDeletingEmployee ? "Deleting..." : "Delete")
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (showExportEmployeesModal)
        {
            <div class="attendance-detail-overlay" @onclick="CloseExportEmployeesModal">
                <div class="attendance-detail-modal employee-delete-modal" @onclick:stopPropagation="true">
                    <div class="attendance-detail-header">
                        <div>
                            <h2 class="attendance-detail-title">Export Employees</h2>
                        </div>
                        <button type="button"
                                class="attendance-detail-close"
                                @onclick="CloseExportEmployeesModal"
                                aria-label="Close export confirmation"
                                disabled="@isExportingEmployees">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="attendance-detail-body">
                        <div class="attendance-detail-section attendance-delete-warning">
                            <div class="attendance-export-icon" aria-hidden="true">
                                <i class="fa-solid fa-file-export"></i>
                            </div>
                            <div>
                                <div class="attendance-detail-eyebrow">Confirm Export</div>
                                <div class="attendance-detail-person">Employees CSV</div>
                                <div class="attendance-detail-meta">
                                    This will download a CSV file containing all employee records.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="attendance-detail-footer">
                        <button type="button"
                                class="attendance-detail-text-action"
                                @onclick="CloseExportEmployeesModal"
                                disabled="@isExportingEmployees">
                            Cancel
                        </button>
                        <button type="button"
                                class="btn btn-primary attendance-detail-done"
                                @onclick="ExportEmployeesAsync"
                                disabled="@isExportingEmployees">
                            @(isExportingEmployees ? "Exporting..." : "Export")
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (showImportEmployeesModal)
        {
            <div class="attendance-detail-overlay" @onclick="CloseImportEmployeesModal">
                <div class="attendance-detail-modal employee-delete-modal" @onclick:stopPropagation="true">
                    <div class="attendance-detail-header">
                        <div>
                            <h2 class="attendance-detail-title">Import Employees</h2>
                        </div>
                        <button type="button"
                                class="attendance-detail-close"
                                @onclick="CloseImportEmployeesModal"
                                aria-label="Close import confirmation"
                                disabled="@isImportingEmployees">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="attendance-detail-body">
                        <div class="attendance-detail-section attendance-delete-warning">
                            <div class="attendance-import-icon" aria-hidden="true">
                                <i class="fa-solid fa-file-import"></i>
                            </div>
                            <div>
                                <div class="attendance-detail-eyebrow">Confirm Import</div>
                                <div class="attendance-detail-person">Employees CSV</div>
                                <div class="attendance-detail-meta">
                                    Select a CSV file to insert new employees or update matching ID numbers.
                                </div>
                            </div>
                        </div>

                        <div class="attendance-detail-section">
                            <label class="attendance-table-toolbar-label" for="employees-import-input">CSV file</label>
                            <InputFile id="employees-import-input"
                                       class="form-control attendance-import-file-input"
                                       OnChange="SelectEmployeeImportFile"
                                       accept=".csv"
                                       disabled="@isImportingEmployees" />
                        </div>
                    </div>

                    <div class="attendance-detail-footer">
                        <button type="button"
                                class="attendance-detail-text-action"
                                @onclick="CloseImportEmployeesModal"
                                disabled="@isImportingEmployees">
                            Cancel
                        </button>
                        <button type="button"
                                class="btn btn-primary attendance-detail-done"
                                @onclick="ImportSelectedEmployeesAsync"
                                disabled="@(isImportingEmployees || employeeImportFile is null)">
                            @(isImportingEmployees ? "Importing..." : "Import")
                        </button>
                    </div>
                </div>
            </div>
        }

        <table class="table attendance-table">
            <thead>
                <tr>
                    <th class="attendance-actions-column">Actions</th>
                    <th>@SortHeader("ID Number", "id")</th>
                    <th>@SortHeader("Name", "employee")</th>
                    <th>@SortHeader("Division/Center/Admin Unit", "division")</th>
                    <th>@SortHeader("Designation", "designation")</th>
                    <th>@SortHeader("Status", "status")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in PagedEmployees)
                {
                    var statusParts = ParseEmployeeStatus(employee.Status);

                    <tr class="attendance-log-row"
                        data-row-menu-key="@GetEmployeeRowMenuKey(employee)"
                        @ondblclick="() => OpenEmployeeDetail(employee)"
                        @onmouseenter="e => ShowEmployeeRowMenuAsync(employee, e)">
                        <td class="attendance-actions-cell">
                            <button type="button"
                                    class="attendance-action-button"
                                    title="View"
                                    aria-label="View employee details"
                                    @onclick="() => OpenEmployeeDetail(employee)"
                                    @onclick:stopPropagation="true">
                                <i class="fa-regular fa-eye" aria-hidden="true"></i>
                            </button>
                            <button type="button"
                                    class="attendance-action-button"
                                    title="Edit"
                                    aria-label="Edit employee"
                                    @onclick="() => OpenEditEmployeeModal(employee)"
                                    @onclick:stopPropagation="true"
                                    disabled="@(!CurrentUser.HasAccess(AccessPolicy.EditEmployee))">
                                <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                            </button>
                            <button type="button"
                                    class="attendance-action-button attendance-action-button-danger"
                                    title="Delete"
                                    aria-label="Delete employee"
                                    @onclick="() => OpenDeleteEmployeeModal(employee)"
                                    @onclick:stopPropagation="true"
                                    disabled="@(!CanDeleteEmployees)">
                                <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                            </button>
                        </td>
                        <td><span class="cell-ellipsis" title="@DisplayValue(employee.IdNumber)">@DisplayValue(employee.IdNumber)</span></td>
                        <td><span class="cell-ellipsis" title="@FormatName(employee.LastName, employee.FirstName, employee.MiddleName)">@FormatName(employee.LastName, employee.FirstName, employee.MiddleName)</span></td>
                        <td><span class="cell-ellipsis" title="@DisplayValue(employee.DivisionCenterUnit)">@DisplayValue(employee.DivisionCenterUnit)</span></td>
                        <td><span class="cell-ellipsis" title="@DisplayValue(employee.Designation)">@DisplayValue(employee.Designation)</span></td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(employee.Status))
                            {
                                <span class="cell-ellipsis" title="-">-</span>
                            }
                            else
                            {
                                <div class="employee-status-pills" title="@DisplayValue(employee.Status)">
                                    <span class="@GetEmployeeActivityStatusClass(statusParts.Activity)">@statusParts.Activity</span>
                                    @if (!string.IsNullOrWhiteSpace(statusParts.EmploymentType))
                                    {
                                        <span class="employee-status-pill employee-status-type">@statusParts.EmploymentType</span>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                }
                @if (!PagedEmployees.Any())
                {
                    <tr>
                        <td colspan="6" class="attendance-empty-state">No employees match the current search and filters.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="attendance-hover-row-menu @(HasHoveredRowMenu ? "show" : null)"
         style="@RowActionMenuStyle"
         @onmouseenter="KeepRowMenuOpen"
         @onmouseleave="HideRowMenuAsync"
         @onclick:stopPropagation="true">
        @if (hoveredEmployeeRowMenuEmployee is not null)
        {
            <div class="attendance-hover-row-menu-title" title="@FormatName(hoveredEmployeeRowMenuEmployee.LastName, hoveredEmployeeRowMenuEmployee.FirstName, hoveredEmployeeRowMenuEmployee.MiddleName)">
                @FormatName(hoveredEmployeeRowMenuEmployee.LastName, hoveredEmployeeRowMenuEmployee.FirstName, hoveredEmployeeRowMenuEmployee.MiddleName)
            </div>
            <button type="button" @onclick="OpenHoveredEmployeeDetail">
                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                <span>View</span>
            </button>
            <button type="button" @onclick="OpenHoveredEmployeeEdit" disabled="@(!CurrentUser.HasAccess(AccessPolicy.EditEmployee))">
                <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                <span>Edit</span>
            </button>
            <button type="button" class="attendance-hover-row-menu-danger" @onclick="OpenHoveredEmployeeDelete" disabled="@(!CanDeleteEmployees)">
                <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                <span>Delete</span>
            </button>
        }
    </div>
    <div class="table-footer">
        <div class="table-entries">@GetEntriesText(filteredEmployees.Count, employeePage, pageSize)</div>
        <div class="table-pagination">
            <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangeEmployeePage(employeePage - 1)" disabled="@(employeePage <= 1)">&#8249;</button>
            @foreach (var pageItem in BuildPageItems(EmployeeTotalPages, employeePage))
            {
                if (pageItem.HasValue)
                {
                    <button type="button" class="table-page-btn @(pageItem.Value == employeePage ? "active" : null)" @onclick="() => ChangeEmployeePage(pageItem.Value)">@pageItem.Value</button>
                }
                else
                {
                    <span class="table-page-ellipsis">...</span>
                }
            }
            <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangeEmployeePage(employeePage + 1)" disabled="@(employeePage >= EmployeeTotalPages)">&#8250;</button>
        </div>
    </div>
    </div>
</div>
</RequireAccess>

