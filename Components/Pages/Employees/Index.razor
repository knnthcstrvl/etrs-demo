    private async Task SaveEmployeeAsync()
    {
        SyncEmployeeFormStatus();

        if (isEditingEmployee)
        {
            var existing = await Db.Employees.FindAsync(employeeForm.EmployeeId);
            if (existing is not null)
            {
                existing.IdNumber = employeeForm.IdNumber;
                existing.LastName = employeeForm.LastName;
                existing.FirstName = employeeForm.FirstName;
                existing.MiddleName = employeeForm.MiddleName;
                existing.DivisionCenterUnit = employeeForm.DivisionCenterUnit;
                existing.Designation = employeeForm.Designation;
                existing.Status = employeeForm.Status;
                await Db.SaveChangesAsync();
                await LoadEmployeesAsync();
            }
        }
        else
        {
            await Db.Employees.AddAsync(employeeForm);
            await Db.SaveChangesAsync();
            await LoadEmployeesAsync();
        }

        showEmployeeModal = false;
    }

    private async Task DeleteEmployeeAsync()
    {
        if (employeePendingDelete is null || isDeletingEmployee)
        {
            return;
        }

        if (!CanDeleteEmployees)
        {
            ShowToast(ToastType.Warning, "Delete unavailable", "You do not have access to delete employees.");
            return;
        }

        isDeletingEmployee = true;

        try
        {
            var employeeId = employeePendingDelete.EmployeeId;
            var employeeName = FormatName(employeePendingDelete.LastName, employeePendingDelete.FirstName, employeePendingDelete.MiddleName);
            var existing = await Db.Employees.FindAsync(employeeId);

            if (existing is null)
            {
                ShowToast(ToastType.Warning, "Employee not found", "The employee record no longer exists.");
            }
            else
            {
                Db.Employees.Remove(existing);
                await Db.SaveChangesAsync();

                if (selectedEmployee?.EmployeeId == employeeId)
                {
                    selectedEmployee = null;
                }

                showDeleteEmployeeModal = false;
                employeePendingDelete = null;
                await LoadEmployeesAsync();
                ShowToast(ToastType.Success, "Employee deleted", $"{employeeName} was deleted.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Delete failed", ex.Message);
        }
        finally
        {
            isDeletingEmployee = false;
        }
    }

    private void SelectEmployeeStatusActivity(string status)
