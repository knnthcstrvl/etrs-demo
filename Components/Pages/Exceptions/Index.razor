    private static CalendarTagType? ResolveCalendarCancelTag(int wfhCount, int holidayCount)
    {
        if (holidayCount > 0 && holidayCount >= wfhCount)
        {
            return CalendarTagType.Holiday;
        }

        return wfhCount > 0 ? CalendarTagType.Wfh : null;
    }

