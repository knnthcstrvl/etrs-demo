    private async Task TagCalendarDateAsync(DateTime date, CalendarTagType tagType)
    {
        if (!CanChangeCalendarDate(date))
        {
            ShowToast(ToastType.Warning, "Date unavailable", "Only current or future weekdays in this month can be set as WFH or Holiday.");
            return;
        }

        isBusy = true;

        try
        {
            var attendanceDate = date.Date;
            await ApplyCalendarTagAsync(attendanceDate, tagType);

            await Db.SaveChangesAsync();

            var label = tagType == CalendarTagType.Holiday ? HolidayConditionName : WfhOptionValue;
            ShowToast(ToastType.Success, $"{label} date set", $"All active employees were tagged as {label} for {attendanceDate:MMM dd, yyyy}.");
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Calendar update failed", ex.Message);
        }
        finally
        {
            isBusy = false;
        }

        await LoadPageDataAsync();
        await LoadCalendarDataAsync();
    }

