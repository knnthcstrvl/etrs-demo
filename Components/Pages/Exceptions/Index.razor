        calendarCursor = DateTime.Today;
        calendarTransitionClass = todayMonth >= currentMonth ? "slide-next" : "slide-prev";
        calendarRenderKey++;
        await LoadCalendarDataAsync();
        await ResetCalendarTransitionAsync();
    }

