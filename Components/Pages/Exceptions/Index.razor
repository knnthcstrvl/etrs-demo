    private static bool IsActiveEmployeeStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return false;
        }

        var normalizedStatus = status.Trim();
        var separatorIndex = normalizedStatus.IndexOf(',');

        if (separatorIndex < 0)
        {
            separatorIndex = normalizedStatus.IndexOf(' ');
        }

        var activity = separatorIndex < 0
            ? normalizedStatus
            : normalizedStatus[..separatorIndex];

        return string.Equals(activity.Trim(), "Active", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetSelectedOptionValue(AttendanceLogWfh? log, string arrangement)
    {
        if (log is null)
        {
            return NotTaggedOptionValue;
        }

        if (log?.ExceptionConditionId is int exceptionConditionId
            && !string.Equals(arrangement, HolidayConditionName, StringComparison.OrdinalIgnoreCase))
        {
            return exceptionConditionId.ToString();
        }

        if (string.Equals(arrangement, AbsentOptionValue, StringComparison.OrdinalIgnoreCase))
        {
            return AbsentOptionValue;
        }

        return WfhOptionValue;
    }

    private async Task<bool> IsHolidayDateAsync(DateTime attendanceDate)
    {
        var logs = await Db.AttendanceLogsWfh
            .AsNoTracking()
            .Include(l => l.ExceptionCondition)
            .Where(l => l.AttendanceDate == attendanceDate.Date)
            .ToListAsync();

        return logs.Any(IsHolidayArrangement);
    }

    private static bool IsHolidayArrangement(AttendanceLogWfh log)
        => string.Equals(ResolveArrangement(log), HolidayConditionName, StringComparison.OrdinalIgnoreCase);

    private static bool IsEmptyCalendarTag(AttendanceLogWfh log, CalendarTagType tagType)
    {
        var arrangement = string.IsNullOrWhiteSpace(log.WorkArrangement) ? WfhOptionValue : log.WorkArrangement;
        var isCalendarArrangement = tagType == CalendarTagType.Holiday
            ? string.Equals(arrangement, HolidayConditionName, StringComparison.OrdinalIgnoreCase)
            : string.Equals(arrangement, WfhOptionValue, StringComparison.OrdinalIgnoreCase);

        return isCalendarArrangement
            && string.IsNullOrWhiteSpace(log.Target)
            && string.IsNullOrWhiteSpace(log.Accomplishment)
            && string.IsNullOrWhiteSpace(log.Mov)
            && log.TimeIn is null
            && log.TimeOut is null;
    }

    private string GetEntriesText(int totalCount, int currentPage)
    {
        if (totalCount == 0)
        {
            return "Showing 0 to 0 of 0 entries";
        }

        var start = ((currentPage - 1) * pageSize) + 1;
        var end = Math.Min(currentPage * pageSize, totalCount);
        return $"Showing {start} to {end} of {totalCount} entries";
    }

    private static IEnumerable<int?> BuildPageItems(int totalPages, int currentPage)
    {
        if (totalPages <= 7)
        {
            for (var page = 1; page <= totalPages; page++)
            {
                yield return page;
            }

            yield break;
        }

        yield return 1;

        if (currentPage > 3)
        {
            yield return null;
        }

        for (var page = Math.Max(2, currentPage - 1); page <= Math.Min(totalPages - 1, currentPage + 1); page++)
        {
            yield return page;
        }

        if (currentPage < totalPages - 2)
        {
            yield return null;
        }

        yield return totalPages;
    }

