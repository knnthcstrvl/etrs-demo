@page "/etr/exceptions"
@using Financial.Data
@using Financial.Model.Dtr
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@inject ProcurementDbContext Db
@inject IToastService ToastService
@inject IJSRuntime JS
@inject Financial.Services.CurrentUserService CurrentUser

@implements IAsyncDisposable

<PageTitle>ETRS | Exceptions</PageTitle>

<RequireAccess RequiredAccess='@(new string[] { AccessPolicy.ManageExceptions })'>
<div class="dashboard-shell">
    <div class="panel-heading attendance-logs-heading exceptions-heading">
        <div>
            <h1 class="attendance-logs-title">Exceptions</h1>
        </div>
        <div class="exceptions-heading-actions">
            <div class="exceptions-date-filter">
                <input id="exceptions-table-date"
                       type="date"
                       class="form-control exceptions-date-input"
                       aria-label="Table date"
                       value="@selectedDate.ToString("yyyy-MM-dd")"
                       @onchange="OnTableDateChangedAsync"
                       disabled="@isBusy" />
            </div>
            <span class="period-sep" aria-hidden="true"></span>
            <button type="button" class="btn btn-outline-secondary attendance-logs-export-btn exceptions-calendar-button" @onclick="OpenCalendarModal" disabled="@isBusy">
                Calendar
            </button>
        </div>
    </div>

    <div class="metric-grid dashboard-metrics attendance-logs-metrics">
        <div class="metric-card">
            <span class="metric-label">Active Employees</span>
            <strong>@activeEmployeeCount</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Tagged WFH</span>
            <strong>@wfhTaggedCount</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Exceptions</span>
            <strong>@exceptionTaggedCount</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Conditions</span>
            <strong>@conditions.Count</strong>
        </div>
    </div>

    <div class="exceptions-table-section">
    <div class="attendance-table-toolbar">
        <div class="attendance-table-search">
            <input id="exceptionsTableSearch"
                   class="form-control attendance-table-search-input"
                   type="search"
                   placeholder="Search..."
                   value="@tableSearchText"
                   @oninput="HandleTableSearchInput" />
        </div>

        <div class="attendance-table-actions" @ref="tableMenuControlsRef">
            <div class="attendance-filter-dropdown">
                <button type="button" class="btn btn-outline-secondary attendance-filter-button" @onclick="ToggleFilterMenu">
                    <i class="fa-solid fa-bars-staggered" aria-hidden="true"></i>
                    <span>Filter</span>
                    @if (HasActiveTableFilters)
                    {
                        <span class="attendance-filter-button-clear"
                              title="Clear filters"
                              role="button"
                              tabindex="0"
                              @onclick="ClearFiltersFromButton"
                              @onclick:stopPropagation="true">x</span>
                    }
                </button>

                <div class="attendance-filter-menu @(showFilterMenu ? "show" : null)" @onclick:stopPropagation="true">
                    <div class="attendance-filter-grid">
                        <div class="attendance-filter-field">
                            <label class="attendance-table-toolbar-label" for="exceptionsFilterId">ID Number</label>
                            <div class="attendance-filter-select-wrap">
                                <button type="button"
                                        id="exceptionsFilterId"
                                        class="attendance-filter-select-trigger @(activeFilterField == "id" ? "active" : null)"
                                        @onclick='() => ToggleFilterField("id")'>
                                    <span class="attendance-filter-select-value">@DisplayValue(filterIdNumber, "All ID Numbers")</span>
                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                </button>

                                <div class="attendance-filter-select-menu @(activeFilterField == "id" ? "show" : null)">
                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterIdNumber) ? "active" : null)" @onclick='() => SetFilterValue("id", string.Empty)'>All ID Numbers</button>
                                    @foreach (var option in IdNumberOptions)
                                    {
                                        <button type="button" class="attendance-filter-select-option @(string.Equals(filterIdNumber, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("id", option)'>@option</button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="attendance-filter-field">
                            <label class="attendance-table-toolbar-label" for="exceptionsFilterEmployee">Employee</label>
                            <div class="attendance-filter-select-wrap">
                                <button type="button"
                                        id="exceptionsFilterEmployee"
                                        class="attendance-filter-select-trigger @(activeFilterField == "employee" ? "active" : null)"
                                        @onclick='() => ToggleFilterField("employee")'>
                                    <span class="attendance-filter-select-value">@DisplayValue(filterEmployee, "All Employees")</span>
                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                </button>

                                <div class="attendance-filter-select-menu @(activeFilterField == "employee" ? "show" : null)">
                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterEmployee) ? "active" : null)" @onclick='() => SetFilterValue("employee", string.Empty)'>All Employees</button>
                                    @foreach (var option in EmployeeOptions)
                                    {
                                        <button type="button" class="attendance-filter-select-option @(string.Equals(filterEmployee, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("employee", option)'>@option</button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="attendance-filter-field">
                            <label class="attendance-table-toolbar-label" for="exceptionsFilterDivision">Division / Unit</label>
                            <div class="attendance-filter-select-wrap">
                                <button type="button"
                                        id="exceptionsFilterDivision"
                                        class="attendance-filter-select-trigger @(activeFilterField == "division" ? "active" : null)"
                                        @onclick='() => ToggleFilterField("division")'>
                                    <span class="attendance-filter-select-value">@DisplayValue(filterDivision, "All Divisions / Units")</span>
                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                </button>

                                <div class="attendance-filter-select-menu @(activeFilterField == "division" ? "show" : null)">
                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterDivision) ? "active" : null)" @onclick='() => SetFilterValue("division", string.Empty)'>All Divisions / Units</button>
                                    @foreach (var option in DivisionOptions)
                                    {
                                        <button type="button" class="attendance-filter-select-option @(string.Equals(filterDivision, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("division", option)'>@option</button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="attendance-filter-field">
                            <label class="attendance-table-toolbar-label" for="exceptionsFilterDesignation">Designation</label>
                            <div class="attendance-filter-select-wrap">
                                <button type="button"
                                        id="exceptionsFilterDesignation"
                                        class="attendance-filter-select-trigger @(activeFilterField == "designation" ? "active" : null)"
                                        @onclick='() => ToggleFilterField("designation")'>
                                    <span class="attendance-filter-select-value">@DisplayValue(filterDesignation, "All Designations")</span>
                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                </button>

                                <div class="attendance-filter-select-menu @(activeFilterField == "designation" ? "show" : null)">
                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterDesignation) ? "active" : null)" @onclick='() => SetFilterValue("designation", string.Empty)'>All Designations</button>
                                    @foreach (var option in DesignationOptions)
                                    {
                                        <button type="button" class="attendance-filter-select-option @(string.Equals(filterDesignation, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("designation", option)'>@option</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="attendance-filter-actions">
                        <button type="button" class="attendance-filter-clear" @onclick="ClearFilters">Clear</button>
                        <button type="button" class="btn btn-primary attendance-filter-apply" @onclick="CloseFilterMenu">Apply</button>
                    </div>
                </div>
            </div>

            <div class="attendance-filter-dropdown attendance-entries-counter">
                <button type="button" class="btn btn-outline-secondary attendance-filter-button attendance-entries-button" @onclick="ToggleEntriesMenu">
                    <span>@pageSize</span>
                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                </button>

                <div class="attendance-entries-menu attendance-filter-menu @(showEntriesMenu ? "show" : null)" @onclick:stopPropagation="true">
                    @foreach (var option in PageSizeOptions)
                    {
                        <button type="button"
                                class="attendance-entries-option @(pageSize == option ? "active" : null)"
                                @onclick="() => SelectPageSize(option)">
                            @option
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="panel-card attendance-table-card"
         @onmouseenter="KeepRowMenuOpen"
         @onmouseleave="HideRowMenuAsync">
        @if (rows.Count == 0)
        {
            <div class="empty-state">
                <strong>No active employees found.</strong>
                <p class="mb-0 text-muted">Import employees first before applying WFH tags.</p>
            </div>
        }
        else
        {
            <table class="table attendance-table">
                <thead>
                    <tr>
                        <th class="attendance-actions-column">Actions</th>
                        <th>@SortHeader("ID Number", "id")</th>
                        <th>@SortHeader("Employee", "employee")</th>
                        <th>@SortHeader("Division / Unit", "division")</th>
                        <th>@SortHeader("Designation", "designation")</th>
                        <th>Current Tag</th>
                        <th>Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in PagedRows)
                    {
                        <tr class="attendance-log-row"
                            data-row-menu-key="@GetRowMenuKey(row)"
                            @ondblclick="() => OpenDetailsModal(row)"
                            @onmouseenter="e => ShowRowMenuAsync(row, e)">
                            <td class="attendance-actions-cell">
                                <button type="button"
                                        class="attendance-action-button"
                                        title="View"
                                        aria-label="View exception details"
                                        @onclick="() => OpenDetailsModal(row)"
                                        @onclick:stopPropagation="true">
                                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                </button>
                                <button type="button"
                                        class="attendance-action-button"
                                        title="Exception Setup"
                                        aria-label="Open exception setup"
                                        @onclick="() => OpenExceptionSetupModal(row)"
                                        @onclick:stopPropagation="true"
                                        disabled="@(isBusy || isSelectedDateHoliday || !CurrentUser.HasAccess(AccessPolicy.ManageExceptions))">
                                    <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                                </button>
                            </td>
                            <td><span class="cell-ellipsis" title="@DisplayValue(row.IdNumber)">@DisplayValue(row.IdNumber)</span></td>
                            <td><span class="cell-ellipsis" title="@row.EmployeeName">@row.EmployeeName</span></td>
                            <td><span class="cell-ellipsis" title="@DisplayValue(row.DivisionCenterUnit)">@DisplayValue(row.DivisionCenterUnit)</span></td>
                            <td><span class="cell-ellipsis" title="@DisplayValue(row.Designation)">@DisplayValue(row.Designation)</span></td>
                            <td>
                                <span class="status-badge @(row.IsException ? "status-warning" : "status-ok")">@row.CurrentArrangement</span>
                            </td>
                            <td><span class="cell-ellipsis" title="@FormatDateTime(row.TagUpdatedAt)">@FormatDateTime(row.TagUpdatedAt)</span></td>
                        </tr>
                    }
                    @if (!PagedRows.Any())
                    {
                        <tr>
                            <td colspan="7" class="attendance-empty-state">No employees match the current search and filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="attendance-hover-row-menu @(showRowActionMenu ? "show" : null)"
         style="@RowActionMenuStyle"
         @onmouseenter="KeepRowMenuOpen"
         @onmouseleave="HideRowMenuAsync"
         @onclick:stopPropagation="true">
        @if (hoveredRowMenuRow is not null)
        {
            <div class="attendance-hover-row-menu-title" title="@hoveredRowMenuRow.EmployeeName">
                @hoveredRowMenuRow.EmployeeName
            </div>
            <button type="button" @onclick="OpenHoveredDetails">
                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                <span>View</span>
            </button>
            <button type="button" @onclick="OpenHoveredExceptionSetup" disabled="@(isBusy || isSelectedDateHoliday || !CurrentUser.HasAccess(AccessPolicy.ManageExceptions))">
                <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                <span>Exception Setup</span>
            </button>
        }
    </div>

    <div class="table-footer">
        <div class="table-entries">@GetEntriesText(filteredRows.Count, rowPage)</div>
        <div class="table-pagination">
            <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangePage(rowPage - 1)" disabled="@(rowPage <= 1)">&#8249;</button>
            @foreach (var pageItem in BuildPageItems(TotalPages, rowPage))
            {
                if (pageItem.HasValue)
                {
                    <button type="button" class="table-page-btn @(pageItem.Value == rowPage ? "active" : null)" @onclick="() => ChangePage(pageItem.Value)">@pageItem.Value</button>
                }
                else
                {
                    <span class="table-page-ellipsis">...</span>
                }
            }
            <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangePage(rowPage + 1)" disabled="@(rowPage >= TotalPages)">&#8250;</button>
        </div>
    </div>
    </div>

    @if (selectedDetailRow is not null)
    {
        <div class="attendance-detail-overlay" @onclick="CloseDetailsModal">
            <div class="attendance-detail-modal exceptions-detail-modal" @onclick:stopPropagation="true">
                <div class="attendance-detail-header">
                    <div>
                        <h2 class="attendance-detail-title">Exception Details</h2>
                    </div>
                    <div class="attendance-detail-header-actions">
                        <button type="button"
                                class="attendance-detail-header-button"
                                @onclick="() => OpenExceptionSetupModal(selectedDetailRow)"
                                disabled="@(isBusy || isSelectedDateHoliday || !CurrentUser.HasAccess(AccessPolicy.ManageExceptions))">
                            Exception Setup
                        </button>
                        <button type="button" class="attendance-detail-close" @onclick="CloseDetailsModal" aria-label="Close details">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="attendance-detail-body">
                    <div class="attendance-detail-section attendance-detail-hero">
                        <div>
                            <div class="attendance-detail-eyebrow">Exception Record</div>
                            <div class="attendance-detail-person">@selectedDetailRow.EmployeeName</div>
                        </div>
                        <div class="attendance-detail-status">@selectedDetailRow.CurrentArrangement</div>
                    </div>

                    <div class="attendance-detail-section attendance-detail-section-primary">
                        <div class="attendance-detail-grid">
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">ID Number</span>
                                <strong>@DisplayValue(selectedDetailRow.IdNumber)</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Employee</span>
                                <strong>@selectedDetailRow.EmployeeName</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Division / Unit</span>
                                <strong>@DisplayValue(selectedDetailRow.DivisionCenterUnit)</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Designation</span>
                                <strong>@DisplayValue(selectedDetailRow.Designation)</strong>
                            </div>
                        </div>
                    </div>

                    <div class="attendance-detail-section">
                        <div class="attendance-detail-grid attendance-detail-grid-compact">
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Current Tag</span>
                                <strong>@selectedDetailRow.CurrentArrangement</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Updated</span>
                                <strong>@FormatDateTime(selectedDetailRow.TagUpdatedAt)</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="attendance-detail-footer">
                    <button type="button" class="attendance-detail-text-action" @onclick="CloseDetailsModal">Close</button>
                </div>
            </div>
        </div>
    }

    @if (setupRow is not null)
    {
        <div class="attendance-detail-overlay" @onclick="CloseExceptionSetupModal">
            <div class="attendance-detail-modal attendance-export-modal exceptions-setup-modal" @onclick:stopPropagation="true">
                <div class="attendance-detail-header">
                    <div>
                        <h2 class="attendance-detail-title">Exception Setup</h2>
                    </div>
                    <div class="attendance-detail-header-actions">
                        <button type="button" class="attendance-detail-close" @onclick="CloseExceptionSetupModal" aria-label="Close setup">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="attendance-detail-body attendance-input-body">
                    <div class="attendance-detail-section attendance-detail-hero">
                        <div>
                            <div class="attendance-detail-eyebrow">@selectedDate.ToString("MMMM d, yyyy")</div>
                            <div class="attendance-detail-person">@setupRow.EmployeeName</div>
                            <div class="attendance-detail-meta">Select the arrangement for this employee on the table date.</div>
                        </div>
                        <div class="attendance-detail-status">@setupRow.CurrentArrangement</div>
                    </div>

                    <div class="attendance-detail-section attendance-detail-section-primary">
                        <div class="attendance-detail-field">
                            <span class="attendance-detail-label">Arrangement</span>
                            <div class="attendance-filter-select-wrap exceptions-setup-select" @ref="setupOptionControlsRef">
                                <button type="button"
                                        class="attendance-filter-select-trigger @(showSetupOptionMenu ? "active" : null)"
                                        @onclick="ToggleSetupOptionMenu"
                                        disabled="@(isBusy || isSelectedDateHoliday)">
                                    <span class="attendance-filter-select-value">@GetSetupOptionLabel(setupSelectedOption)</span>
                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                </button>

                                <div class="attendance-filter-select-menu @(showSetupOptionMenu ? "show" : null)">
                                    @if (string.Equals(setupSelectedOption, NotTaggedOptionValue, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button" class="attendance-filter-select-option active" @onclick="() => SelectSetupOption(NotTaggedOptionValue)">Not Tagged</button>
                                    }
                                    <button type="button" class="attendance-filter-select-option @(string.Equals(setupSelectedOption, WfhOptionValue, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick="() => SelectSetupOption(WfhOptionValue)">WFH</button>
                                    @foreach (var condition in ManualExceptionConditions)
                                    {
                                        var optionValue = condition.ExceptionConditionId.ToString();
                                        <button type="button" class="attendance-filter-select-option @(string.Equals(setupSelectedOption, optionValue, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick="() => SelectSetupOption(optionValue)">@condition.ConditionName</button>
                                    }
                                    <button type="button" class="attendance-filter-select-option @(string.Equals(setupSelectedOption, AbsentOptionValue, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick="() => SelectSetupOption(AbsentOptionValue)">Absent</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="attendance-detail-footer">
                    <button type="button" class="attendance-detail-text-action" @onclick="CloseExceptionSetupModal" disabled="@isBusy">Cancel</button>
                    <button type="button" class="btn btn-primary attendance-detail-done" @onclick="SaveSetupRowAsync" disabled="@(isBusy || isSelectedDateHoliday)">Save</button>
                </div>
            </div>
        </div>
    }

    @if (isCalendarModalOpen)
    {
        <div class="attendance-detail-overlay exceptions-calendar-overlay" @onclick="CloseCalendarModal">
            <div class="attendance-detail-modal exceptions-calendar-modal @(calendarViewMode == CalendarViewMode.List ? "list-mode" : null)" @onclick:stopPropagation="true">
                <div class="attendance-detail-header exceptions-calendar-topbar">
                    <div class="exceptions-calendar-nav">
                        <button type="button" class="exceptions-icon-button" @onclick="() => ChangeCalendarMonth(-1)" aria-label="Previous month">
                            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="exceptions-today-button" @onclick="GoToToday">Today</button>
                        <button type="button" class="exceptions-icon-button" @onclick="() => ChangeCalendarMonth(1)" aria-label="Next month">
                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="exceptions-calendar-title">@calendarCursor.ToString("MMMM yyyy")</div>
                    <div class="attendance-detail-header-actions exceptions-calendar-tools">
                        <button type="button" class="exceptions-icon-button @(calendarViewMode == CalendarViewMode.List ? "active" : null)" @onclick="() => SetCalendarViewMode(CalendarViewMode.List)" aria-label="List view"><i class="fa-solid fa-list" aria-hidden="true"></i></button>
                        <button type="button" class="exceptions-icon-button @(calendarViewMode == CalendarViewMode.Month ? "active" : null)" @onclick="() => SetCalendarViewMode(CalendarViewMode.Month)" aria-label="Calendar view"><i class="fa-solid fa-calendar-day" aria-hidden="true"></i></button>
                        <button type="button" class="attendance-detail-close exceptions-calendar-close" @onclick="CloseCalendarModal" aria-label="Close calendar"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                    </div>
                </div>

                <div class="attendance-detail-body exceptions-calendar-body">
                    @if (calendarViewMode == CalendarViewMode.Month)
                    {
                        <div class="exceptions-calendar-month @calendarTransitionClass @calendarViewTransitionClass" @key="calendarRenderKey">
                            <div class="exceptions-calendar-weekdays">
                                @foreach (var weekday in Weekdays)
                                {
                                    <div>@weekday</div>
                                }
                            </div>

                            <div class="exceptions-calendar-grid">
                                @foreach (var day in CalendarDays)
                                {
                                    <div class="exceptions-calendar-cell @(day.IsInCurrentMonth ? null : "muted") @(day.IsWeekend ? "weekend" : null) @(day.IsPast ? "past" : null) @(day.IsToday ? "today" : null)">
                                        <div class="exceptions-calendar-date">@day.Date.Day</div>
                                        <div class="exceptions-calendar-events">
                                            @if (day.Summary?.WfhCount > 0)
                                            {
                                                <span class="exceptions-calendar-event wfh"><i class="fa-solid fa-house-laptop" aria-hidden="true"></i> WFH <b>@day.Summary.WfhCount</b></span>
                                            }
                                            @if (day.Summary?.HolidayCount > 0)
                                            {
                                                <span class="exceptions-calendar-event holiday"><i class="fa-regular fa-calendar-check" aria-hidden="true"></i> Holiday <b>@day.Summary.HolidayCount</b></span>
                                            }
                                            @if (day.Summary?.ExceptionCount > 0)
                                            {
                                                <span class="exceptions-calendar-event exception"><i class="fa-solid fa-user-clock" aria-hidden="true"></i> Exception <b>@day.Summary.ExceptionCount</b></span>
                                            }
                                        </div>
                                        @if (day.CanShowActions)
                                        {
                                            <div class="exceptions-calendar-cell-actions">
                                                @if (day.HasCalendarTag)
                                                {
                                                    @if (day.CalendarCancelTag is { } cancelTag)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-light" @onclick="() => OpenCalendarCancelConfirmation(day.Date, cancelTag)" disabled="@isBusy">@GetCancelButtonLabel(cancelTag)</button>
                                                    }
                                                    @if (!day.HasHolidayTag)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => OpenExceptionsForDateAsync(day.Date)" disabled="@isBusy">Add Exception</button>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenCalendarTagsForDateAsync(day.Date)" disabled="@isBusy">View All</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => OpenCalendarTagConfirmation(day.Date, CalendarTagType.Wfh)" disabled="@isBusy">Set WFH</button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenCalendarTagConfirmation(day.Date, CalendarTagType.Holiday)" disabled="@isBusy">Set Holiday</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="exceptions-calendar-list @calendarViewTransitionClass" @key="calendarRenderKey">
                            @if (!CalendarListItems.Any())
                            {
                                <div class="exceptions-calendar-list-empty">
                                    <strong>No scheduled WFH or Holiday dates.</strong>
                                    <span>Select the calendar view to add dates for @calendarCursor.ToString("MMMM yyyy").</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var day in CalendarListItems)
                                {
                                    <div class="exceptions-calendar-list-row">
                                        <div>
                                            <div class="exceptions-calendar-list-date">@day.Date.ToString("dddd, MMMM d")</div>
                                            <div class="exceptions-calendar-list-events">
                                                @if (day.Summary?.WfhCount > 0)
                                                {
                                                    <span class="exceptions-calendar-event wfh"><i class="fa-solid fa-house-laptop" aria-hidden="true"></i> WFH <b>@day.Summary.WfhCount</b></span>
                                                }
                                                @if (day.Summary?.HolidayCount > 0)
                                                {
                                                    <span class="exceptions-calendar-event holiday"><i class="fa-regular fa-calendar-check" aria-hidden="true"></i> Holiday <b>@day.Summary.HolidayCount</b></span>
                                                }
                                                @if (day.Summary?.ExceptionCount > 0)
                                                {
                                                    <span class="exceptions-calendar-event exception"><i class="fa-solid fa-user-clock" aria-hidden="true"></i> Exception <b>@day.Summary.ExceptionCount</b></span>
                                                }
                                            </div>
                                        </div>
                                        <div class="exceptions-calendar-list-actions">
                                            @if (day.CanChangeDate)
                                            {
                                                @if (day.CalendarCancelTag is { } cancelTag)
                                                {
                                                    <button type="button" class="btn btn-sm btn-light" @onclick="() => OpenCalendarCancelConfirmation(day.Date, cancelTag)" disabled="@isBusy">@GetCancelButtonLabel(cancelTag)</button>
                                                }
                                                @if (!day.HasHolidayTag)
                                                {
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => OpenExceptionsForDateAsync(day.Date)" disabled="@isBusy">Add Exception</button>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenCalendarTagsForDateAsync(day.Date)" disabled="@isBusy">View All</button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                @if (pendingCalendarAction is { } pendingAction)
                {
                    <div class="exceptions-confirm-overlay" @onclick="CloseCalendarTagConfirmation">
                        <div class="exceptions-confirm-modal" @onclick:stopPropagation="true">
                            <div class="exceptions-confirm-header">
                                <h2>@GetCalendarConfirmationTitle(pendingAction)</h2>
                                <button type="button" class="attendance-detail-close exceptions-calendar-close" @onclick="CloseCalendarTagConfirmation" aria-label="Close confirmation">
                                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="exceptions-confirm-body">
                                @GetCalendarConfirmationLead(pendingAction)
                                <strong>@pendingAction.Date.ToString("MMMM d, yyyy")</strong>?
                            </div>
                            <div class="attendance-detail-footer exceptions-confirm-actions">
                                <button type="button" class="attendance-detail-text-action" @onclick="CloseCalendarTagConfirmation" disabled="@isBusy">Cancel</button>
                                <button type="button" class="btn btn-primary attendance-detail-done" @onclick="ConfirmCalendarTagAsync" disabled="@isBusy">Confirm</button>
                            </div>
                        </div>
                    </div>
                }

                @if (calendarTableModalMode is { } tableMode)
                {
                    <div class="exceptions-table-overlay" @onclick="CloseCalendarTableModal">
                        <div class="exceptions-table-modal" @onclick:stopPropagation="true">
                            <div class="exceptions-table-header">
                                <div>
                                    <h2>@GetCalendarTableTitle(tableMode)</h2>
                                    <span>@calendarTableDate.ToString("dddd, MMMM d, yyyy")</span>
                                </div>
                                <button type="button" class="attendance-detail-close exceptions-calendar-close" @onclick="CloseCalendarTableModal" aria-label="Close table">
                                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="exceptions-table-body">
                                @if (!calendarTableRows.Any())
                                {
                                    <div class="exceptions-calendar-list-empty">
                                        <strong>No active employees found.</strong>
                                        <span>Import employees first before applying exception tags.</span>
                                    </div>
                                }
                                else
                                {
                                    <table class="table attendance-table exceptions-modal-table">
                                        <thead>
                                            <tr>
                                                <th>ID Number</th>
                                                <th>Employee</th>
                                                <th>Division / Unit</th>
                                                <th>Current Tag</th>
                                                @if (CanEditCalendarTable(tableMode))
                                                {
                                                    <th>Exception Setup</th>
                                                    <th>Action</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in calendarTableRows)
                                            {
                                                <tr>
                                                    <td><span class="cell-ellipsis" title="@DisplayValue(row.IdNumber)">@DisplayValue(row.IdNumber)</span></td>
                                                    <td><span class="cell-ellipsis" title="@row.EmployeeName">@row.EmployeeName</span></td>
                                                    <td><span class="cell-ellipsis" title="@DisplayValue(row.DivisionCenterUnit)">@DisplayValue(row.DivisionCenterUnit)</span></td>
                                                    <td><span class="status-badge @(row.IsException ? "status-warning" : "status-ok")">@row.CurrentArrangement</span></td>
                                                    @if (CanEditCalendarTable(tableMode))
                                                    {
                                                        <td>
                                                            <select class="form-select form-select-sm" value="@row.SelectedOption" @onchange="e => row.SelectedOption = e.Value?.ToString() ?? WfhOptionValue" disabled="@isBusy">
                                                                @if (string.Equals(row.SelectedOption, NotTaggedOptionValue, StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    <option value="@NotTaggedOptionValue">Not Tagged</option>
                                                                }
                                                                <option value="@WfhOptionValue">WFH</option>
                                                                @foreach (var condition in ManualExceptionConditions)
                                                                {
                                                                    <option value="@condition.ExceptionConditionId">@condition.ConditionName</option>
                                                                }
                                                                <option value="@AbsentOptionValue">Absent</option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SaveCalendarTableRowAsync(row)" disabled="@isBusy">Save</button>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                            <div class="attendance-detail-footer exceptions-table-footer">
                                <button type="button" class="btn btn-primary attendance-detail-done" @onclick="CloseCalendarTableModal" disabled="@isBusy">Done</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
</RequireAccess>

