@code {
    private const int DefaultPageSize = 10;
    private const int MaxPageSize = 100;
    private const string NotTaggedOptionValue = "Not Tagged";
    private const string WfhOptionValue = "WFH";
    private const string AbsentOptionValue = "Absent";
    private const string HolidayConditionName = "Holiday";
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private readonly List<EmployeeTagRow> rows = new();
    private readonly List<EmployeeTagRow> filteredRows = new();
    private readonly List<CalendarDayItem> calendarDays = new();
    private readonly List<EmployeeTagRow> calendarTableRows = new();
    private readonly Dictionary<DateTime, CalendarDaySummary> calendarSummaries = new();
    private List<ExceptionCondition> conditions = new();
    private DateTime selectedDate = DateTime.Today;
    private DateTime calendarCursor = DateTime.Today;
    private string calendarTransitionClass = string.Empty;
    private string calendarViewTransitionClass = string.Empty;
    private int calendarRenderKey;
    private int activeEmployeeCount;
    private int wfhTaggedCount;
    private int exceptionTaggedCount;
    private int rowPage = 1;
    private int pageSize = DefaultPageSize;
    private string tableSearchText = string.Empty;
    private string filterIdNumber = string.Empty;
    private string filterEmployee = string.Empty;
    private string filterDivision = string.Empty;
    private string filterDesignation = string.Empty;
    private string? activeFilterField;
    private string? sortColumn;
    private bool sortDescending;
    private bool showFilterMenu;
    private bool showEntriesMenu;
    private bool showSetupOptionMenu;
    private bool isBusy;
    private bool isSelectedDateHoliday;
    private bool isCalendarModalOpen;
    private CalendarViewMode calendarViewMode = CalendarViewMode.Month;
    private CalendarTableMode? calendarTableModalMode;
    private DateTime calendarTableDate = DateTime.Today;
    private bool isCalendarTableDateHoliday;
    private PendingCalendarAction? pendingCalendarAction;
    private EmployeeTagRow? selectedDetailRow;
    private EmployeeTagRow? setupRow;
    private EmployeeTagRow? hoveredRowMenuRow;
    private string setupSelectedOption = WfhOptionValue;
    private double rowActionMenuLeft;
    private double rowActionMenuTop;
    private bool showRowActionMenu;
    private bool rowActionMenuHovered;
    private int rowActionMenuShowVersion;
    private int rowActionMenuHideVersion;
    private ElementReference tableMenuControlsRef;
    private ElementReference setupOptionControlsRef;
    private DotNetObjectReference<Index>? tableMenuDotNetRef;
    private DotNetObjectReference<Index>? setupOptionDotNetRef;
    private bool tableMenuDismissRegistered;
    private bool setupOptionDismissRegistered;

    private IEnumerable<EmployeeTagRow> PagedRows => filteredRows
        .Skip((rowPage - 1) * pageSize)
        .Take(pageSize);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(filteredRows.Count / (double)pageSize));
    private IReadOnlyList<CalendarDayItem> CalendarDays => calendarDays;
    private IEnumerable<CalendarDayItem> CalendarListItems => calendarDays
        .Where(d => d.IsInCurrentMonth && d.HasAnyEvent)
        .OrderBy(d => d.Date);
    private IEnumerable<ExceptionCondition> ManualExceptionConditions => conditions
        .Where(c => c.IsActive && !string.Equals(c.ConditionName, HolidayConditionName, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<string> IdNumberOptions => GetDistinctOptions(rows.Select(r => r.IdNumber));
    private IEnumerable<string> EmployeeOptions => GetDistinctOptions(rows.Select(r => r.EmployeeName));
    private IEnumerable<string> DivisionOptions => GetDistinctOptions(rows.Select(r => r.DivisionCenterUnit));
    private IEnumerable<string> DesignationOptions => GetDistinctOptions(rows.Select(r => r.Designation));
    private bool HasActiveTableFilters
        => !string.IsNullOrWhiteSpace(filterIdNumber)
            || !string.IsNullOrWhiteSpace(filterEmployee)
            || !string.IsNullOrWhiteSpace(filterDivision)
            || !string.IsNullOrWhiteSpace(filterDesignation);
    private string RowActionMenuStyle => $"left:{rowActionMenuLeft:0}px;top:{rowActionMenuTop:0}px;";
    private static readonly string[] Weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    protected override async Task OnInitializedAsync()
    {
        await Financial.Data.Seeders.ExceptionConditionSeeder.SeedAsync(Db);

        conditions = await Db.ExceptionConditions
            .AsNoTracking()
            .OrderBy(c => c.ConditionName)
            .ToListAsync();

        await LoadPageDataAsync();
        await LoadCalendarDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncTableMenuDismissRegistrationAsync();
        await SyncSetupOptionDismissRegistrationAsync();
    }

    private async Task LoadPageDataAsync()
    {
        isBusy = true;

        try
        {
            rows.Clear();

            var attendanceDate = selectedDate.Date;
            var employees = await Db.Employees
                .AsNoTracking()
                .OrderBy(e => e.LastName)
                .ThenBy(e => e.FirstName)
                .ToListAsync();
            employees = employees
                .Where(e => IsActiveEmployeeStatus(e.Status))
                .ToList();

            var logs = await Db.AttendanceLogsWfh
                .AsNoTracking()
                .Include(l => l.ExceptionCondition)
                .Where(l => l.AttendanceDate == attendanceDate)
                .ToListAsync();

            var logsByEmployeeId = logs.ToDictionary(l => l.EmployeeId);
            isSelectedDateHoliday = logs.Any(IsHolidayArrangement);

            foreach (var employee in employees)
            {
                logsByEmployeeId.TryGetValue(employee.EmployeeId, out var log);
                var arrangement = ResolveArrangement(log);

                rows.Add(new EmployeeTagRow
                {
                    EmployeeId = employee.EmployeeId,
                    IdNumber = employee.IdNumber,
                    EmployeeName = FormatName(employee.LastName, employee.FirstName, employee.MiddleName),
                    DivisionCenterUnit = employee.DivisionCenterUnit,
                    Designation = employee.Designation,
                    CurrentArrangement = arrangement,
                    SelectedOption = GetSelectedOptionValue(log, arrangement),
                    TagUpdatedAt = log?.TagUpdatedAt,
                    TimeIn = log?.TimeIn,
                    TimeOut = log?.TimeOut,
                    Target = log?.Target,
                    Accomplishment = log?.Accomplishment,
                    Mov = log?.Mov,
                    IsException = !string.Equals(arrangement, WfhOptionValue, StringComparison.OrdinalIgnoreCase)
                });
            }

            activeEmployeeCount = employees.Count;
            wfhTaggedCount = logs.Count(l => string.Equals(l.WorkArrangement, WfhOptionValue, StringComparison.OrdinalIgnoreCase));
            exceptionTaggedCount = logs.Count(l => !string.Equals(l.WorkArrangement, WfhOptionValue, StringComparison.OrdinalIgnoreCase));
            RefreshFilteredRows();
        }
        finally
        {
            isBusy = false;
        }
    }

    private void RefreshFilteredRows(bool resetPaging = false)
    {
        filteredRows.Clear();
        filteredRows.AddRange(ApplyRowSort(rows.Where(MatchesRowFilters)));

        if (resetPaging)
        {
            rowPage = 1;
            return;
        }

        rowPage = Math.Clamp(rowPage, 1, TotalPages);
    }

    private bool MatchesRowFilters(EmployeeTagRow row)
    {
        var query = tableSearchText.Trim();
        if (!string.IsNullOrWhiteSpace(query)
            && !ContainsText(row.IdNumber, query)
            && !ContainsText(row.EmployeeName, query)
            && !ContainsText(row.DivisionCenterUnit, query)
            && !ContainsText(row.Designation, query))
        {
            return false;
        }

        return MatchesSelectedValue(row.IdNumber, filterIdNumber)
            && MatchesSelectedValue(row.EmployeeName, filterEmployee)
            && MatchesSelectedValue(row.DivisionCenterUnit, filterDivision)
            && MatchesSelectedValue(row.Designation, filterDesignation);
    }

    private IEnumerable<EmployeeTagRow> ApplyRowSort(IEnumerable<EmployeeTagRow> source)
    {
        var column = sortColumn?.Trim().ToLowerInvariant();
        var descending = sortDescending;

        return column switch
        {
            "id" => OrderByDirection(source, descending, row => NormalizeSortValue(row.IdNumber))
                .ThenBy(row => NormalizeSortValue(row.EmployeeName)),
            "division" => OrderByDirection(source, descending, row => NormalizeSortValue(row.DivisionCenterUnit))
                .ThenBy(row => NormalizeSortValue(row.EmployeeName)),
            "designation" => OrderByDirection(source, descending, row => NormalizeSortValue(row.Designation))
                .ThenBy(row => NormalizeSortValue(row.EmployeeName)),
            "employee" or null or "" => OrderByDirection(source, descending, row => NormalizeSortValue(row.EmployeeName))
                .ThenBy(row => NormalizeSortValue(row.IdNumber)),
            _ => OrderByDirection(source, false, row => NormalizeSortValue(row.EmployeeName))
                .ThenBy(row => NormalizeSortValue(row.IdNumber))
        };
    }

    private Task HandleTableSearchInput(ChangeEventArgs e)
    {
        tableSearchText = e.Value?.ToString() ?? string.Empty;
        RefreshFilteredRows(resetPaging: true);
        return Task.CompletedTask;
    }

    private void ToggleFilterMenu()
    {
        showFilterMenu = !showFilterMenu;
        if (showFilterMenu)
        {
            showEntriesMenu = false;
        }
        else
        {
            activeFilterField = null;
        }
    }

    private void CloseFilterMenu()
    {
        showFilterMenu = false;
        activeFilterField = null;
    }

    private void ToggleFilterField(string fieldKey)
    {
        activeFilterField = string.Equals(activeFilterField, fieldKey, StringComparison.Ordinal) ? null : fieldKey;
    }

    private void SetFilterValue(string fieldKey, string value)
    {
        switch (fieldKey)
        {
            case "id":
                filterIdNumber = value;
                break;
            case "employee":
                filterEmployee = value;
                break;
            case "division":
                filterDivision = value;
                break;
            case "designation":
                filterDesignation = value;
                break;
        }

        activeFilterField = null;
        RefreshFilteredRows(resetPaging: true);
    }

    private void ToggleEntriesMenu()
    {
        showEntriesMenu = !showEntriesMenu;
        if (showEntriesMenu)
        {
            showFilterMenu = false;
            activeFilterField = null;
        }
    }

    private void SelectPageSize(int selectedPageSize)
    {
        pageSize = Math.Clamp(selectedPageSize, 1, MaxPageSize);
        rowPage = 1;
        showEntriesMenu = false;
    }

    private void ClearFilters()
    {
        tableSearchText = string.Empty;
        filterIdNumber = string.Empty;
        filterEmployee = string.Empty;
        filterDivision = string.Empty;
        filterDesignation = string.Empty;
        showFilterMenu = false;
        showEntriesMenu = false;
        activeFilterField = null;
        RefreshFilteredRows(resetPaging: true);
    }

    private void ClearFiltersFromButton(MouseEventArgs _)
        => ClearFilters();

    private RenderFragment SortHeader(string label, string column) => builder =>
    {
        var sequence = 0;
        var isSorted = IsSortedColumn(column);
        var isDescending = isSorted && sortDescending;

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "attendance-sort-header");

        builder.OpenElement(sequence++, "button");
        builder.AddAttribute(sequence++, "type", "button");
        builder.AddAttribute(sequence++, "class", $"attendance-sort-trigger{(isSorted ? " active" : string.Empty)}");
        builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => ToggleSort(column)));
        builder.AddAttribute(sequence++, "title", $"Sort by {label}");

        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "attendance-sort-label");
        builder.AddContent(sequence++, label);
        builder.CloseElement();

        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", $"attendance-sort-icon{(isSorted ? " active" : string.Empty)}");
        builder.OpenElement(sequence++, "i");
        builder.AddAttribute(sequence++, "class", isDescending ? "fa-solid fa-caret-down" : "fa-solid fa-caret-up");
        builder.AddAttribute(sequence++, "aria-hidden", "true");
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();

        if (!string.IsNullOrWhiteSpace(sortColumn)
            && string.Equals(sortColumn, column, StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "class", "attendance-sort-clear");
            builder.AddAttribute(sequence++, "title", "Clear sorting");
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, ClearSorting));
            builder.AddAttribute(sequence++, "aria-label", "Clear sorting");
            builder.AddContent(sequence++, "x");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private bool IsSortedColumn(string column)
    {
        if (!string.IsNullOrWhiteSpace(sortColumn))
        {
            return string.Equals(sortColumn, column, StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals(column, "employee", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleSort(string column)
    {
        if (string.Equals(sortColumn, column, StringComparison.OrdinalIgnoreCase))
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = false;
        }

        RefreshFilteredRows(resetPaging: true);
    }

    private void ClearSorting()
    {
        sortColumn = null;
        sortDescending = false;
        RefreshFilteredRows(resetPaging: true);
    }

