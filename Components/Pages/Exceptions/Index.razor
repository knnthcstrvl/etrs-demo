    private async Task SaveEmployeeTagForDateAsync(EmployeeTagRow row, DateTime attendanceDate)
    {
        isBusy = true;

        try
        {
            if (await IsHolidayDateAsync(attendanceDate.Date))
            {
                ShowToast(ToastType.Warning, "Holiday date locked", "Cancel the Holiday setup before changing employee arrangements for this date.");
                return;
            }

            if (string.Equals(row.SelectedOption, NotTaggedOptionValue, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            var employee = await Db.Employees.FirstOrDefaultAsync(e => e.EmployeeId == row.EmployeeId);
            if (employee is null)
            {
                ShowToast(ToastType.Warning, "Employee not found", "The employee record no longer exists.");
                return;
            }

            var log = await Db.AttendanceLogsWfh.FirstOrDefaultAsync(l => l.EmployeeId == row.EmployeeId && l.AttendanceDate == attendanceDate);
            if (log is null)
            {
                log = new AttendanceLogWfh
                {
                    EmployeeId = employee.EmployeeId,
                    AttendanceDate = attendanceDate
                };
                Db.AttendanceLogsWfh.Add(log);
            }

            log.IdNumber = employee.IdNumber;
            log.LastName = employee.LastName;
            log.FirstName = employee.FirstName;
            log.MiddleName = employee.MiddleName;
            log.DivisionCenterUnit = employee.DivisionCenterUnit;
            log.Designation = employee.Designation;
            log.TagUpdatedAt = DateTime.Now;

            if (string.Equals(row.SelectedOption, WfhOptionValue, StringComparison.OrdinalIgnoreCase))
            {
                log.WorkArrangement = WfhOptionValue;
                log.ExceptionConditionId = null;
            }
            else if (string.Equals(row.SelectedOption, AbsentOptionValue, StringComparison.OrdinalIgnoreCase))
            {
                log.WorkArrangement = AbsentOptionValue;
                log.ExceptionConditionId = null;
            }
            else if (int.TryParse(row.SelectedOption, out var exceptionConditionId))
            {
                var condition = await Db.ExceptionConditions.FirstOrDefaultAsync(c => c.ExceptionConditionId == exceptionConditionId && c.IsActive);
                if (condition is null)
                {
                    ShowToast(ToastType.Warning, "Condition not found", "The selected exception condition is no longer available.");
                    return;
                }

                log.WorkArrangement = condition.ConditionName;
                log.ExceptionConditionId = condition.ExceptionConditionId;
            }
            else
            {
                ShowToast(ToastType.Warning, "Invalid selection", "Choose a valid WFH exception option.");
                return;
            }

            await Db.SaveChangesAsync();
            ShowToast(ToastType.Success, "Employee tag saved", $"{FormatName(employee.LastName, employee.FirstName, employee.MiddleName)} was tagged as {log.WorkArrangement} for {attendanceDate:MMM dd, yyyy}.");
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Save failed", ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ApplyCalendarTagAsync(DateTime attendanceDate, CalendarTagType tagType)
    {
        var now = DateTime.Now;
        if (!CanChangeCalendarDate(attendanceDate))
        {
            throw new InvalidOperationException("Only current or future weekdays can be set as WFH or Holiday.");
        }

        var employees = await Db.Employees
            .ToListAsync();
        employees = employees
            .Where(e => IsActiveEmployeeStatus(e.Status))
            .ToList();

        var logs = await Db.AttendanceLogsWfh
            .Where(l => l.AttendanceDate == attendanceDate)
            .ToListAsync();

        var logsByEmployeeId = logs.ToDictionary(l => l.EmployeeId);
        ExceptionCondition? holidayCondition = null;

        if (tagType == CalendarTagType.Holiday)
        {
            holidayCondition = await Db.ExceptionConditions
                .FirstOrDefaultAsync(c => c.IsActive && c.ConditionName == HolidayConditionName);

            if (holidayCondition is null)
            {
                throw new InvalidOperationException("Holiday condition is not available.");
            }
        }

        foreach (var employee in employees)
        {
            if (!logsByEmployeeId.TryGetValue(employee.EmployeeId, out var log))
            {
                log = new AttendanceLogWfh
                {
                    EmployeeId = employee.EmployeeId,
                    AttendanceDate = attendanceDate
                };

                Db.AttendanceLogsWfh.Add(log);
            }

            log.IdNumber = employee.IdNumber;
            log.LastName = employee.LastName;
            log.FirstName = employee.FirstName;
            log.MiddleName = employee.MiddleName;
            log.DivisionCenterUnit = employee.DivisionCenterUnit;
            log.Designation = employee.Designation;
            log.TagUpdatedAt = now;

            if (tagType == CalendarTagType.Holiday && holidayCondition is not null)
            {
                log.WorkArrangement = holidayCondition.ConditionName;
                log.ExceptionConditionId = holidayCondition.ExceptionConditionId;
            }
            else
            {
                log.WorkArrangement = WfhOptionValue;
                log.ExceptionConditionId = null;
            }
        }
    }

    private async Task LoadCalendarDataAsync()
    {
        var monthStart = new DateTime(calendarCursor.Year, calendarCursor.Month, 1);
        var firstGridDate = monthStart.AddDays(-GetSundayBasedDayIndex(monthStart));
        var lastGridDate = firstGridDate.AddDays(41);

        var logs = await Db.AttendanceLogsWfh
            .AsNoTracking()
            .Include(l => l.ExceptionCondition)
            .Where(l => l.AttendanceDate >= firstGridDate && l.AttendanceDate <= lastGridDate)
            .ToListAsync();

        calendarSummaries.Clear();

        foreach (var group in logs.GroupBy(l => l.AttendanceDate.Date))
        {
            var wfhCount = 0;
            var holidayCount = 0;
            var exceptionCount = 0;

            foreach (var log in group)
            {
                var arrangement = ResolveArrangement(log);
                if (string.Equals(arrangement, WfhOptionValue, StringComparison.OrdinalIgnoreCase))
                {
                    wfhCount++;
                }
                else if (string.Equals(arrangement, HolidayConditionName, StringComparison.OrdinalIgnoreCase))
                {
                    holidayCount++;
                }
                else
                {
                    exceptionCount++;
                }
            }

            var calendarTag = ResolveCalendarCancelTag(wfhCount, holidayCount);
            calendarSummaries[group.Key] = new CalendarDaySummary(wfhCount, holidayCount, exceptionCount, calendarTag);
        }

        calendarDays.Clear();

        for (var dayOffset = 0; dayOffset < 42; dayOffset++)
        {
            var date = firstGridDate.AddDays(dayOffset);
            calendarSummaries.TryGetValue(date.Date, out var summary);
            calendarDays.Add(new CalendarDayItem
            {
                Date = date.Date,
                IsInCurrentMonth = date.Month == calendarCursor.Month,
                IsWeekend = date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday,
                IsPast = date.Date < DateTime.Today,
                IsToday = date.Date == DateTime.Today,
                Summary = summary
            });
        }
    }

