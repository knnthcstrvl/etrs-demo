    [JSInvokable]
    public void CloseTableMenus()
    {
        if (!showFilterMenu && !showEntriesMenu && string.IsNullOrWhiteSpace(activeFilterField) && !showSetupOptionMenu)
        {
            return;
        }

        showFilterMenu = false;
        showEntriesMenu = false;
        activeFilterField = null;
        showSetupOptionMenu = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SyncTableMenuDismissRegistrationAsync()
    {
        var shouldRegister = showFilterMenu || showEntriesMenu;

        if (shouldRegister && !tableMenuDismissRegistered)
        {
            tableMenuDotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("attendanceLogs.registerTableMenuDismiss", tableMenuControlsRef, tableMenuDotNetRef);
            tableMenuDismissRegistered = true;
        }
        else if (!shouldRegister && tableMenuDismissRegistered)
        {
            await JS.InvokeVoidAsync("attendanceLogs.unregisterTableMenuDismiss", tableMenuControlsRef);
            tableMenuDismissRegistered = false;
        }
    }

    private async Task SyncSetupOptionDismissRegistrationAsync()
    {
        var shouldRegister = showSetupOptionMenu && setupRow is not null;

        if (shouldRegister && !setupOptionDismissRegistered)
        {
            setupOptionDotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("attendanceLogs.registerTableMenuDismiss", setupOptionControlsRef, setupOptionDotNetRef);
            setupOptionDismissRegistered = true;
        }
        else if (!shouldRegister && setupOptionDismissRegistered)
        {
            await JS.InvokeVoidAsync("attendanceLogs.unregisterTableMenuDismiss", setupOptionControlsRef);
            setupOptionDismissRegistered = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (tableMenuDismissRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync("attendanceLogs.unregisterTableMenuDismiss", tableMenuControlsRef);
            }
            catch
            {
            }
        }

        if (setupOptionDismissRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync("attendanceLogs.unregisterTableMenuDismiss", setupOptionControlsRef);
            }
            catch
            {
            }
        }

        tableMenuDotNetRef?.Dispose();
        setupOptionDotNetRef?.Dispose();
    }

