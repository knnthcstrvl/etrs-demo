    private async Task ShowRowMenuAsync(EmployeeTagRow row, MouseEventArgs e)
    {
        var showVersion = ++rowActionMenuShowVersion;
        rowActionMenuHideVersion++;
        rowActionMenuHovered = true;
        showRowActionMenu = false;

        await Task.Delay(1000);

        if (!rowActionMenuHovered || showVersion != rowActionMenuShowVersion)
        {
            return;
        }

        hoveredRowMenuRow = row;

        try
        {
            var position = await JS.InvokeAsync<RowMenuPosition>("attendanceLogs.getRowMenuPosition", GetRowMenuKey(row), e.ClientX, e.ClientY, 184, 108, 12);
            rowActionMenuLeft = position.Left;
            rowActionMenuTop = position.Top;
        }
        catch
        {
            rowActionMenuLeft = e.ClientX + 12;
            rowActionMenuTop = e.ClientY + 12;
        }

        showRowActionMenu = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HideRowMenuAsync()
    {
        rowActionMenuHovered = false;
        rowActionMenuShowVersion++;
        var hideVersion = ++rowActionMenuHideVersion;

        await Task.Delay(120);

        if (rowActionMenuHovered || hideVersion != rowActionMenuHideVersion)
        {
            return;
        }

        showRowActionMenu = false;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(190);

        if (!showRowActionMenu && hideVersion == rowActionMenuHideVersion)
        {
            hoveredRowMenuRow = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void KeepRowMenuOpen()
    {
        rowActionMenuHovered = true;
        rowActionMenuHideVersion++;
    }

