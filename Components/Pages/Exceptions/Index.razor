    private async Task CancelCalendarDateAsync(DateTime date, CalendarTagType tagType)
    {
        if (!CanChangeCalendarDate(date))
        {
            ShowToast(ToastType.Warning, "Date unavailable", "Only current or future weekdays can be changed from the calendar.");
            return;
        }

        isBusy = true;

        try
        {
            var attendanceDate = date.Date;
            var logs = await Db.AttendanceLogsWfh
                .Where(l => l.AttendanceDate == attendanceDate)
                .ToListAsync();

            var removableLogs = logs
                .Where(log => IsEmptyCalendarTag(log, tagType))
                .ToList();

            var label = GetCalendarTagLabel(tagType);
            if (removableLogs.Count == 0)
            {
                ShowToast(ToastType.Warning, $"No {label} tags removed", "This date has submitted log details or employee exceptions that should be changed from the employee table.");
            }
            else
            {
                Db.AttendanceLogsWfh.RemoveRange(removableLogs);
                await Db.SaveChangesAsync();
                ShowToast(ToastType.Success, $"{label} cancelled", $"Empty {label} tags were removed for {attendanceDate:MMM dd, yyyy}.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Cancel failed", ex.Message);
        }
        finally
        {
            isBusy = false;
        }

        await LoadPageDataAsync();
        await LoadCalendarDataAsync();
    }

