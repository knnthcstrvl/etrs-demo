    private static string ResolveArrangement(AttendanceLogWfh? log)
    {
        if (log is null)
        {
            return "Not Tagged";
        }

        if (!string.IsNullOrWhiteSpace(log.ExceptionCondition?.ConditionName))
        {
            return log.ExceptionCondition.ConditionName;
        }

        return string.IsNullOrWhiteSpace(log.WorkArrangement) ? WfhOptionValue : log.WorkArrangement;
    }

    private static string FormatName(string? lastName, string? firstName, string? middleName)
    {
        var last = lastName?.Trim() ?? string.Empty;
        var first = firstName?.Trim() ?? string.Empty;
        var middleInitial = string.IsNullOrWhiteSpace(middleName) ? string.Empty : $" {middleName.Trim()[0]}.";
        return $"{last}, {first}{middleInitial}".Trim(' ', ',').ToUpperInvariant();
    }

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string DisplayValue(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static bool ContainsText(string? source, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return !string.IsNullOrWhiteSpace(source)
            && source.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static bool MatchesSelectedValue(string? source, string? selectedValue)
    {
        if (string.IsNullOrWhiteSpace(selectedValue))
        {
            return true;
        }

        return string.Equals(source?.Trim(), selectedValue.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static IEnumerable<string> GetDistinctOptions(IEnumerable<string?> values)
        => values
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value, StringComparer.OrdinalIgnoreCase);

    private static IOrderedEnumerable<T> OrderByDirection<T, TKey>(IEnumerable<T> source, bool descending, Func<T, TKey> selector)
        => descending ? source.OrderByDescending(selector) : source.OrderBy(selector);

    private static string NormalizeSortValue(string? value) => value?.Trim() ?? string.Empty;

    private static string FormatDateTime(DateTime? value) => value?.ToString("MMM dd, yyyy hh:mm tt") ?? "-";

    private static string FormatClockTime(DateTime? value) => value?.ToString("hh:mm tt") ?? "-";

    private string GetSetupOptionLabel(string? optionValue)
    {
        if (string.Equals(optionValue, NotTaggedOptionValue, StringComparison.OrdinalIgnoreCase))
        {
            return NotTaggedOptionValue;
        }

        if (string.Equals(optionValue, WfhOptionValue, StringComparison.OrdinalIgnoreCase))
        {
            return WfhOptionValue;
        }

        if (string.Equals(optionValue, AbsentOptionValue, StringComparison.OrdinalIgnoreCase))
        {
            return AbsentOptionValue;
        }

        return int.TryParse(optionValue, out var conditionId)
            ? conditions.FirstOrDefault(c => c.ExceptionConditionId == conditionId)?.ConditionName ?? "Select arrangement"
            : "Select arrangement";
    }

    private static int GetSundayBasedDayIndex(DateTime date) => (int)date.DayOfWeek;

    private static bool CanChangeCalendarDate(DateTime date)
        => date.Date >= DateTime.Today
            && date.DayOfWeek is not DayOfWeek.Saturday
            && date.DayOfWeek is not DayOfWeek.Sunday;

