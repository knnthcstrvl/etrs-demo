        public bool IsWeekend { get; set; }
        public bool IsPast { get; set; }
        public bool IsToday { get; set; }
        public CalendarDaySummary? Summary { get; set; }
        public bool HasCalendarTag => Summary?.WfhCount > 0 || Summary?.HolidayCount > 0;
        public bool HasHolidayTag => Summary?.HolidayCount > 0;
        public CalendarTagType? CalendarCancelTag => Summary?.CalendarTag;
        public bool HasAnyEvent => HasCalendarTag || Summary?.ExceptionCount > 0;
