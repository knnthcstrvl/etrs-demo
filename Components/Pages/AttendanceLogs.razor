@page "/etr/attendance-logs"
@using Financial.Data
@inject Financial.Services.CurrentUserService CurrentUser
@using Financial.Model.Dtr
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using System.IO.Compression
@inject ProcurementDbContext Db
@inject IWebHostEnvironment Environment
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IJSRuntime JS
@inject IToastService ToastService

@rendermode InteractiveServer
@implements IAsyncDisposable

<HeadContent>
    <title>ETRS | Attendance Logs</title>
</HeadContent>

<RequireAccess RequiredAccess=@(new string[] { AccessPolicy.ManageAttendanceLogs, AccessPolicy.VerificationApprover })>
    <div class="dashboard-shell">
    <div class="panel-heading attendance-logs-heading">
        <div>
            <h1 class="attendance-logs-title">Attendance Logs</h1>
        </div>
        <div class="attendance-logs-controls" @ref="periodControlsRef">
            <div class="attendance-filter-select-wrap period-dropdown">
                <button type="button" class="attendance-filter-select-trigger period-button @(showPeriodMenu ? "active" : null)" @onclick="TogglePeriodMenu">
                    <span class="period-button-content">
                        <span class="period-label">Period:</span>
                        <span class="period-selected">@SelectedPeriodLabel</span>
                        @if (selectedPeriod?.IsCurrent == true)
                        {
                            <span class="period-current-text">(Current)</span>
                        }
                    </span>
                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                </button>

                <div class="attendance-filter-select-menu period-menu @(showPeriodMenu ? "show" : null)">
                    @foreach (var p in periods)
                    {
                        var itemId = selectedPeriod == p ? "period-1-selected-item" : null;
                        <button type="button" class="attendance-filter-select-option period-option @(selectedPeriod == p ? "active" : null)" id="@itemId" @onclick="() => SelectPeriod(p)">
                            <span class="period-option-label">@p.Label</span>
                            @if (p.IsCurrent)
                            {
                                <span class="period-current-text">(Current)</span>
                            }
                        </button>
                    }
                </div>
            </div>

            @if (periods.Count > 1 && !showAddPeriod && !isClosingAddPeriod)
            {
                <button type="button" class="btn btn-outline-secondary period-add-button" @onclick="ToggleAddPeriod">+</button>
            }

            @if (showAddPeriod || isClosingAddPeriod)
            {
                <div class="period-range-entry @(isClosingAddPeriod ? "closing" : null)">
                    <div class="period-to-label">TO</div>

                    <div class="attendance-filter-select-wrap period-dropdown">
                    <button type="button" class="period-close-btn" title="Close period range" @onclick="ToggleAddPeriod">×</button>
                    <button type="button" class="attendance-filter-select-trigger period-button @(showPeriod2Menu ? "active" : null)" @onclick="TogglePeriod2Menu">
                        <span class="period-button-content">
                            <span class="period-label">Period:</span>
                            <span class="period-selected">@SelectedPeriod2Label</span>
                            @if (secondSelectedPeriod?.IsCurrent == true)
                            {
                                <span class="period-current-text">(Current)</span>
                            }
                        </span>
                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                    </button>

                    <div class="attendance-filter-select-menu period-menu @(showPeriod2Menu ? "show" : null)">
                        @foreach (var p in periods)
                        {
                            var itemId = secondSelectedPeriod == p ? "period-2-selected-item" : null;
                            <button type="button" class="attendance-filter-select-option period-option @(secondSelectedPeriod == p ? "active" : null)" id="@itemId" @onclick="() => SelectSecondPeriod(p)">
                                <span class="period-option-label">@p.Label</span>
                                @if (p.IsCurrent)
                                {
                                    <span class="period-current-text">(Current)</span>
                                }
                            </button>
                        }
                    </div>
                </div>
                </div>
            }

            <span class="period-sep" aria-hidden="true"></span>
            <button type="button" class="btn btn-outline-secondary attendance-logs-export-btn" @onclick="OpenInputLogsModal" disabled="@(!CurrentUser.HasAccess(AccessPolicy.InputLogs))">Input Logs</button>
            <button type="button" class="btn btn-outline-secondary attendance-logs-export-btn" @onclick="OpenExportLogsModal" disabled=@(!CurrentUser.HasAccess(AccessPolicy.ExportLogs))>Export</button>
        </div>
    </div>

    <div class="metric-grid dashboard-metrics attendance-logs-metrics">
        <div class="metric-card">
            <span class="metric-label">Onsite</span>
            <strong>@onsiteLogs.Count</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">WFH Tagged</span>
            <strong>@wfhTaggedCount</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Employees</span>
            <strong>@employeeCount</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Exceptions Today</span>
            <strong>@exceptionTodayCount</strong>
        </div>
    </div>

    <div style="margin-top:1rem;">
        <div class="attendance-view-tabs" role="tablist" aria-label="Attendance log views">
            <button
                type="button"
                role="tab"
                class="attendance-view-tab @(viewMode == "onsite" ? "active" : null)"
                aria-selected="@(viewMode == "onsite")"
                @onclick='() => viewMode = "onsite"'>
                Onsite (Biometrics)
            </button>
            <button
                type="button"
                role="tab"
                class="attendance-view-tab @(viewMode == "wfh" ? "active" : null)"
                aria-selected="@(viewMode == "wfh")"
                @onclick='() => viewMode = "wfh"'>
                WFH (ETRS)
            </button>
        </div>

        <div class="attendance-table-toolbar">
            <div class="attendance-table-search">
                <input id="attendanceLogSearch"
                       class="form-control attendance-table-search-input"
                       type="search"
                       placeholder="Search..."
                       value="@tableSearchText"
                       @oninput="HandleTableSearchInput" />
            </div>

            <div class="attendance-table-actions" @ref="tableMenuControlsRef">
                <div class="attendance-filter-dropdown">
                    <button type="button" class="btn btn-outline-secondary attendance-filter-button" @onclick="ToggleFilterMenu">
                        <i class="fa-solid fa-bars-staggered" aria-hidden="true"></i>
                        <span>Filter</span>
                        @if (HasActiveTableFilters)
                        {
                            <span class="attendance-filter-button-clear"
                                  title="Clear filters"
                                  role="button"
                                  tabindex="0"
                                  @onclick="ClearFiltersFromButton"
                                  @onclick:stopPropagation="true">×</span>
                        }
                    </button>

                    <div class="attendance-filter-menu @(showFilterMenu ? "show" : null)" @onclick:stopPropagation="true">
                        <div class="attendance-filter-grid">
                            <div class="attendance-filter-field">
                                <label class="attendance-table-toolbar-label" for="attendanceFilterId">ID Number</label>
                                <div class="attendance-filter-select-wrap">
                                    <button type="button"
                                            id="attendanceFilterId"
                                            class="attendance-filter-select-trigger @(activeFilterField == "id" ? "active" : null)"
                                            @onclick='() => ToggleFilterField("id")'>
                                        <span class="attendance-filter-select-value">@DisplayValue(filterIdNumber, "All ID Numbers")</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(activeFilterField == "id" ? "show" : null)">
                                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterIdNumber) ? "active" : null)" @onclick='() => SetFilterValue("id", string.Empty)'>All ID Numbers</button>
                                        @foreach (var option in CurrentIdNumberOptions)
                                        {
                                            <button type="button" class="attendance-filter-select-option @(string.Equals(filterIdNumber, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("id", option)'>@option</button>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="attendance-filter-field">
                                <label class="attendance-table-toolbar-label" for="attendanceFilterEmployee">Employee</label>
                                <div class="attendance-filter-select-wrap">
                                    <button type="button"
                                            id="attendanceFilterEmployee"
                                            class="attendance-filter-select-trigger @(activeFilterField == "employee" ? "active" : null)"
                                            @onclick='() => ToggleFilterField("employee")'>
                                        <span class="attendance-filter-select-value">@DisplayValue(filterEmployee, "All Employees")</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(activeFilterField == "employee" ? "show" : null)">
                                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterEmployee) ? "active" : null)" @onclick='() => SetFilterValue("employee", string.Empty)'>All Employees</button>
                                        @foreach (var option in CurrentEmployeeOptions)
                                        {
                                            <button type="button" class="attendance-filter-select-option @(string.Equals(filterEmployee, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("employee", option)'>@option</button>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="attendance-filter-field">
                                <label class="attendance-table-toolbar-label" for="attendanceFilterDivision">Division/Center/Admin Unit</label>
                                <div class="attendance-filter-select-wrap">
                                    <button type="button"
                                            id="attendanceFilterDivision"
                                            class="attendance-filter-select-trigger @(activeFilterField == "division" ? "active" : null)"
                                            @onclick='() => ToggleFilterField("division")'>
                                        <span class="attendance-filter-select-value">@DisplayValue(filterDivision, "All Divisions/Centers/Admin Units")</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(activeFilterField == "division" ? "show" : null)">
                                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterDivision) ? "active" : null)" @onclick='() => SetFilterValue("division", string.Empty)'>All Divisions/Centers/Admin Units</button>
                                        @foreach (var option in CurrentDivisionOptions)
                                        {
                                            <button type="button" class="attendance-filter-select-option @(string.Equals(filterDivision, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("division", option)'>@option</button>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="attendance-filter-field">
                                <label class="attendance-table-toolbar-label" for="attendanceFilterDesignation">Designation</label>
                                <div class="attendance-filter-select-wrap">
                                    <button type="button"
                                            id="attendanceFilterDesignation"
                                            class="attendance-filter-select-trigger @(activeFilterField == "designation" ? "active" : null)"
                                            @onclick='() => ToggleFilterField("designation")'>
                                        <span class="attendance-filter-select-value">@DisplayValue(filterDesignation, "All Designations")</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(activeFilterField == "designation" ? "show" : null)">
                                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterDesignation) ? "active" : null)" @onclick='() => SetFilterValue("designation", string.Empty)'>All Designations</button>
                                        @foreach (var option in CurrentDesignationOptions)
                                        {
                                            <button type="button" class="attendance-filter-select-option @(string.Equals(filterDesignation, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("designation", option)'>@option</button>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="attendance-filter-field">
                                <label class="attendance-table-toolbar-label" for="attendanceFilterStatus">Status</label>
                                <div class="attendance-filter-select-wrap">
                                    <button type="button"
                                            id="attendanceFilterStatus"
                                            class="attendance-filter-select-trigger @(activeFilterField == "status" ? "active" : null)"
                                            @onclick='() => ToggleFilterField("status")'>
                                        <span class="attendance-filter-select-value">@DisplayValue(filterStatus, "All Statuses")</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(activeFilterField == "status" ? "show" : null)">
                                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterStatus) ? "active" : null)" @onclick='() => SetFilterValue("status", string.Empty)'>All Statuses</button>
                                        @foreach (var option in CurrentStatusOptions)
                                        {
                                            <button type="button" class="attendance-filter-select-option @(string.Equals(filterStatus, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("status", option)'>@option</button>
                                        }
                                    </div>
                                </div>
                            </div>
                            @if (viewMode == "wfh")
                            {
                                <div class="attendance-filter-field">
                                    <label class="attendance-table-toolbar-label" for="attendanceFilterTarget">Target</label>
                                    <div class="attendance-filter-select-wrap">
                                        <button type="button"
                                                id="attendanceFilterTarget"
                                                class="attendance-filter-select-trigger @(activeFilterField == "target" ? "active" : null)"
                                                @onclick='() => ToggleFilterField("target")'>
                                            <span class="attendance-filter-select-value">@DisplayValue(filterTarget, "All Target")</span>
                                            <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                        </button>

                                        <div class="attendance-filter-select-menu @(activeFilterField == "target" ? "show" : null)">
                                            <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterTarget) ? "active" : null)" @onclick='() => SetFilterValue("target", string.Empty)'>All Target</button>
                                            @foreach (var option in TargetFilterOptions)
                                            {
                                                <button type="button" class="attendance-filter-select-option @(string.Equals(filterTarget, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("target", option)'>@option</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="attendance-filter-field">
                                    <label class="attendance-table-toolbar-label" for="attendanceFilterAccomplishment">Accomplishment</label>
                                    <div class="attendance-filter-select-wrap">
                                        <button type="button"
                                                id="attendanceFilterAccomplishment"
                                                class="attendance-filter-select-trigger @(activeFilterField == "accomplishment" ? "active" : null)"
                                                @onclick='() => ToggleFilterField("accomplishment")'>
                                            <span class="attendance-filter-select-value">@DisplayValue(filterAccomplishment, "All Accomplishment")</span>
                                            <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                        </button>

                                        <div class="attendance-filter-select-menu @(activeFilterField == "accomplishment" ? "show" : null)">
                                            <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterAccomplishment) ? "active" : null)" @onclick='() => SetFilterValue("accomplishment", string.Empty)'>All Accomplishment</button>
                                            @foreach (var option in AccomplishmentFilterOptions)
                                            {
                                                <button type="button" class="attendance-filter-select-option @(string.Equals(filterAccomplishment, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("accomplishment", option)'>@option</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="attendance-filter-field">
                                    <label class="attendance-table-toolbar-label" for="attendanceFilterMov">MOV</label>
                                    <div class="attendance-filter-select-wrap">
                                        <button type="button"
                                                id="attendanceFilterMov"
                                                class="attendance-filter-select-trigger @(activeFilterField == "mov" ? "active" : null)"
                                                @onclick='() => ToggleFilterField("mov")'>
                                            <span class="attendance-filter-select-value">@DisplayValue(filterMov, "All MOV")</span>
                                            <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                        </button>

                                        <div class="attendance-filter-select-menu @(activeFilterField == "mov" ? "show" : null)">
                                            <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterMov) ? "active" : null)" @onclick='() => SetFilterValue("mov", string.Empty)'>All MOV</button>
                                            @foreach (var option in MovFilterOptions)
                                            {
                                                <button type="button" class="attendance-filter-select-option @(string.Equals(filterMov, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("mov", option)'>@option</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="attendance-filter-actions">
                            <button type="button" class="attendance-filter-clear" @onclick="ClearFilters">Clear</button>
                            <button type="button" class="btn btn-primary attendance-filter-apply" @onclick="CloseFilterMenu">Apply</button>
                        </div>
                    </div>
                </div>

                <div class="attendance-filter-dropdown attendance-entries-counter">
                    <button type="button" class="btn btn-outline-secondary attendance-filter-button attendance-entries-button" @onclick="ToggleEntriesMenu">
                        <span>@pageSize</span>
                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                    </button>

                    <div class="attendance-entries-menu attendance-filter-menu @(showEntriesMenu ? "show" : null)" @onclick:stopPropagation="true">
                        @foreach (var option in PageSizeOptions)
                        {
                            <button type="button"
                                    class="attendance-entries-option @(pageSize == option ? "active" : null)"
                                    @onclick="() => SelectPageSize(option)">
                                @option
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-card attendance-table-card"
             @ref="attendanceTableCardRef"
             @onmouseenter="KeepRowMenuOpen"
             @onmouseleave="HideRowMenuAsync">
            @if (viewMode == "onsite")
            {
                <table class="table attendance-table attendance-table-onsite">
                    <thead style="background:var(--finance-surface-soft);border-bottom:1px solid var(--finance-border);">
                        <tr>
                            <th class="attendance-actions-column">Actions</th>
                            <th>@SortHeader("ID Number", "id", false)</th>
                            <th>@SortHeader("Employee", "employee", false)</th>
                            <th>@SortHeader("Division/Center/Admin Unit", "division", false)</th>
                            <th>@SortHeader("Designation", "designation", false)</th>
                            <th>@SortHeader("Status", "status", false)</th>
                            <th>@SortHeader("Attendance Date", "date", false)</th>
                            <th>@SortHeader("AM", "am", false)</th>
                            <th>@SortHeader("PM", "pm", false)</th>
                            <th>LATE/UNDERTIME</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in PagedOnsiteLogs)
                        {
                            <tr class="attendance-log-row"
                                data-row-menu-key="@GetOnsiteRowMenuKey(log)"
                                @ondblclick="() => OpenOnsiteDetail(log)"
                                @onmouseenter="e => ShowOnsiteRowMenuAsync(log, e)">
                                <td class="attendance-actions-cell">
                                    <button type="button"
                                            class="attendance-action-button"
                                            title="View"
                                            aria-label="View attendance details"
                                            @onclick="() => OpenOnsiteDetail(log)"
                                            @onclick:stopPropagation="true">
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                    </button>
                                    <button type="button"
                                            class="attendance-action-button"
                                            title="Edit"
                                            aria-label="Edit attendance log"
                                            @onclick="() => OpenOnsiteEdit(log)"
                                            @onclick:stopPropagation="true"
                                            disabled="@(!CurrentUser.HasAccess(AccessPolicy.EditLogs))">
                                        <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                                    </button>
                                </td>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.IdNumber)">@DisplayValue(log.IdNumber)</span></td>
                                <td><span class="cell-ellipsis" title="@FormatName(log.LastName, log.FirstName, log.MiddleName)">@FormatName(log.LastName, log.FirstName, log.MiddleName)</span></td>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.DivisionCenterUnit)">@DisplayValue(log.DivisionCenterUnit)</span></td>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.Designation)">@DisplayValue(log.Designation)</span></td>
                                <td><span class="cell-ellipsis" title="@DisplayEmployeeType(log)">@DisplayEmployeeType(log)</span></td>
                                <td><span class="cell-ellipsis" title="@FormatDate(log.AttendanceDate)">@FormatDate(log.AttendanceDate)</span></td>
                                <td class="time-cell @(IsTardinessOverride(log) ? "attendance-time-overridden" : null)"><span class="cell-ellipsis" title="@FormatTimeRange(log.TimeInAm, log.TimeOutAm)">@FormatTimeRange(log.TimeInAm, log.TimeOutAm)</span></td>
                                <td class="time-cell @(IsTardinessOverride(log) ? "attendance-time-overridden" : null)"><span class="cell-ellipsis" title="@FormatTimeRange(GetCreditedOnsiteTimeInPm(log), log.TimeOutPm)">@FormatTimeRange(GetCreditedOnsiteTimeInPm(log), log.TimeOutPm)</span></td>
                                <td>
                                    <div class="attendance-tardiness-pills" title="@FormatTardinessTags(GetResolvedTardiness(log))">
                                        @foreach (var tag in GetTardinessTags(GetResolvedTardiness(log)))
                                        {
                                            <span class="@GetTardinessPillClass(tag)">@tag</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!PagedOnsiteLogs.Any())
                        {
                            <tr>
                                <td colspan="10" class="attendance-empty-state">No attendance logs match the current search and filters.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table class="table attendance-table attendance-table-wfh">
                    <thead style="background:var(--finance-surface-soft);border-bottom:1px solid var(--finance-border);">
                        <tr>
                            <th class="attendance-actions-column">Actions</th>
                            <th>@SortHeader("ID Number", "id", true)</th>
                            <th>@SortHeader("Employee", "employee", true)</th>
                            <th>@SortHeader("Division/Center/Admin Unit", "division", true)</th>
                            <th>@SortHeader("Designation", "designation", true)</th>
                            <th>@SortHeader("Status", "status", true)</th>
                            <th>@SortHeader("Attendance Date", "date", true)</th>
                            <th>Target</th>
                            <th>Accomplishment</th>
                            <th>MOV</th>
                            <th>Verification</th>
                            <th>Arrangement</th>
                            <th>@SortHeader("Time In", "timein", true)</th>
                            <th>@SortHeader("Time Out", "timeout", true)</th>
                            <th>LATE/UNDERTIME</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in PagedWfhLogs)
                        {
                            <tr class="attendance-log-row"
                                data-row-menu-key="@GetWfhRowMenuKey(log)"
                                @ondblclick="() => OpenWfhDetail(log)"
                                @onmouseenter="e => ShowWfhRowMenuAsync(log, e)">
                                <td class="attendance-actions-cell">
                                    <button type="button"
                                            class="attendance-action-button"
                                            title="View"
                                            aria-label="View attendance details"
                                            @onclick="() => OpenWfhDetail(log)"
                                            @onclick:stopPropagation="true">
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                    </button>
                                    <button type="button"
                                            class="attendance-action-button"
                                            title="Edit"
                                            aria-label="Edit attendance log"
                                            @onclick="() => OpenWfhEdit(log)"
                                            @onclick:stopPropagation="true"
                                            disabled="@(!CurrentUser.HasAccess(AccessPolicy.EditLogs))">
                                        <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                                    </button>
                                </td>
