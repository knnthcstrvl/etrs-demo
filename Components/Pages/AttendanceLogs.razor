    }

    private async Task SaveWfhInputLogAsync(Employee employee)
    {
        var attendanceDate = inputForm.AttendanceDate.Date;
        var timeIn = CombineDateAndTime(attendanceDate, inputForm.WfhTimeIn);
        var timeOut = CombineDateAndTime(attendanceDate, inputForm.WfhTimeOut);
        var target = inputForm.Target.Trim();
        var accomplishment = inputForm.Accomplishment.Trim();
        var mov = await SaveInputMovFileAsync(inputForm.MovFile);

        if (!timeIn.HasValue && !timeOut.HasValue && string.IsNullOrWhiteSpace(target) && string.IsNullOrWhiteSpace(accomplishment) && string.IsNullOrWhiteSpace(mov))
        {
            throw new InvalidOperationException("Enter at least time in, time out, target, accomplishment, or means of verification for the WFH log.");
        }

        var log = await Db.AttendanceLogsWfh
            .FirstOrDefaultAsync(l => l.EmployeeId == employee.EmployeeId && l.AttendanceDate == attendanceDate);

        if (log is null)
        {
            log = new AttendanceLogWfh
            {
                EmployeeId = employee.EmployeeId,
                AttendanceDate = attendanceDate
            };
            Db.AttendanceLogsWfh.Add(log);
        }

        log.IdNumber = employee.IdNumber;
        log.LastName = employee.LastName;
        log.FirstName = employee.FirstName;
        log.MiddleName = employee.MiddleName;
        log.DivisionCenterUnit = employee.DivisionCenterUnit;
        log.Designation = employee.Designation;
        log.WorkArrangement = "WFH";
        log.ExceptionConditionId = null;
        log.TagUpdatedAt = DateTime.Now;
        log.TimeIn ??= timeIn;
        log.TimeOut ??= timeOut;
        log.Target = string.IsNullOrWhiteSpace(log.Target) ? target : log.Target;
        log.Accomplishment = string.IsNullOrWhiteSpace(log.Accomplishment) ? accomplishment : log.Accomplishment;
        log.Mov = string.IsNullOrWhiteSpace(log.Mov) ? mov ?? log.Mov : log.Mov;
        log.Tardiness = ComputeTardinessForWfh(log);

        await Db.SaveChangesAsync();
        ShowToast(ToastType.Success, "WFH log saved", $"{employee.FirstName} {employee.LastName} WFH log was saved.");
    }

