    private static DateTime? CombineDateAndTime(DateTime date, string? timeText)
    {
        if (string.IsNullOrWhiteSpace(timeText))
        {
            return null;
        }

        if (!TimeOnly.TryParse(timeText, out var time))
        {
            throw new InvalidOperationException($"Invalid time value: {timeText}.");
        }

        return date.Date.Add(time.ToTimeSpan());
    }

