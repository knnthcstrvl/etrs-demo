    private static string BuildPdfPreviewUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return string.Empty;
        }

        var baseUrl = url;
        var existingFragment = string.Empty;
        var fragmentIndex = url.IndexOf('#');
        if (fragmentIndex >= 0)
        {
            baseUrl = url[..fragmentIndex];
            existingFragment = url[(fragmentIndex + 1)..];
        }

        var viewerOptions = "toolbar=0&navpanes=0&scrollbar=0&statusbar=0&messages=0&view=FitH";
        var fragment = string.IsNullOrWhiteSpace(existingFragment)
            ? viewerOptions
            : $"{existingFragment}&{viewerOptions}";

        return $"{baseUrl}#{fragment}";
    }

    private static (string TimeInPhoto, string TimeOutPhoto) GetPhotoVerificationImages(AttendanceLogWfh log)
    {
        var values = SplitPhotoVerificationValue(log.Verification);
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var value in values)
        {
            var trimmed = value.Trim();
            if (trimmed.StartsWith("time-in:", StringComparison.OrdinalIgnoreCase))
            {
                result["time-in"] = NormalizePhotoVerificationUrl(trimmed["time-in:".Length..].Trim());
            }
            else if (trimmed.StartsWith("time-out:", StringComparison.OrdinalIgnoreCase))
            {
                result["time-out"] = NormalizePhotoVerificationUrl(trimmed["time-out:".Length..].Trim());
            }
            else if (!result.ContainsKey("time-in"))
            {
                result["time-in"] = NormalizePhotoVerificationUrl(trimmed);
            }
            else if (!result.ContainsKey("time-out"))
            {
                result["time-out"] = NormalizePhotoVerificationUrl(trimmed);
            }
        }

        var timeIn = result.TryGetValue("time-in", out var inUrl) ? inUrl : string.Empty;
        var timeOut = result.TryGetValue("time-out", out var outUrl) ? outUrl : string.Empty;

        if (string.IsNullOrWhiteSpace(timeIn) && string.IsNullOrWhiteSpace(timeOut) && values.Count == 1)
        {
            var singleValue = NormalizePhotoVerificationUrl(values[0]);
            return log.TimeOut.HasValue
                ? (string.Empty, singleValue)
                : (singleValue, string.Empty);
        }

        return (timeIn, timeOut);
    }

    private static string NormalizePhotoVerificationUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return string.Empty;
        }

        var normalized = url.Trim();
        if (normalized.StartsWith("time-in:", StringComparison.OrdinalIgnoreCase))
        {
            normalized = normalized["time-in:".Length..].Trim();
        }

        if (normalized.StartsWith("time-out:", StringComparison.OrdinalIgnoreCase))
        {
            normalized = normalized["time-out:".Length..].Trim();
        }

        normalized = normalized.Replace('\\', '/');
        if (normalized.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
        {
            normalized = "/" + normalized;
        }

        return normalized;
    }

    private static bool IsEmailVerificationValue(string? value)
        => !string.IsNullOrWhiteSpace(value)
            && value.Contains('@', StringComparison.Ordinal)
            && !value.Contains('/', StringComparison.Ordinal)
            && !value.Contains('\\', StringComparison.Ordinal);

    private static List<string> SplitPhotoVerificationValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return new();
        }

        var trimmed = value.Trim();
        var separators = new[] { "||", "|", ";", "\n" };
        foreach (var separator in separators)
        {
            if (trimmed.Contains(separator, StringComparison.Ordinal))
            {
                return trimmed
                    .Split(separator, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(item => !string.IsNullOrWhiteSpace(item))
                    .ToList();
            }
        }

        return new List<string> { trimmed };
    }

