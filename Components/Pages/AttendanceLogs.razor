    private async Task SearchInputEmployeesAsync(string? searchText)
    {
        var query = (searchText ?? string.Empty).Trim();
        var shouldShow = query.Length >= 1;
        showInputEmployeeResults = shouldShow;

        if (!showInputEmployeeResults)
        {
            inputEmployeeSearchResults.Clear();
            await UnregisterInputEmployeeOutsideClickAsync();
            return;
        }

        pendingRegisterInputEmployeeOutsideClick = true;

        inputEmployeeSearchResults = await ApplyDivisionScope(Db.Employees)
            .AsNoTracking()
            .Where(e => e.IdNumber.Contains(query))
            .Where(e => e.Status.StartsWith("Active"))
            .OrderBy(e => e.LastName)
            .ThenBy(e => e.FirstName)
            .Take(12)
            .ToListAsync();
    }

