    private async Task SaveEditLogAsync()
    {
        if (isSavingEditLog)
        {
            return;
        }

        isSavingEditLog = true;

        try
        {
            if (editLogForm.IsWfh)
            {
                await SaveEditedWfhLogAsync();
            }
            else
            {
                await SaveEditedOnsiteLogAsync();
            }

            await LoadLogsAsync();
            CloseEditLogsModal();
        }
        catch (InvalidOperationException ex)
        {
            ShowToast(ToastType.Warning, "Validation", ex.Message);
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Save failed", ex.Message);
        }
        finally
        {
            isSavingEditLog = false;
        }
    }

    private async Task SaveInputLogAsync()
    {
        if (isSavingInputLog)
        {
            return;
        }

        var validationContext = new ValidationContext(inputForm);
        var validationResults = new List<ValidationResult>();
        if (!Validator.TryValidateObject(inputForm, validationContext, validationResults, true))
        {
            ShowToast(ToastType.Warning, "Validation", validationResults[0].ErrorMessage ?? "Invalid input.");
            return;
        }

        var employee = await ApplyDivisionScope(Db.Employees).FirstOrDefaultAsync(e => e.EmployeeId == inputForm.EmployeeId);
        if (employee is null)
        {
            ShowToast(ToastType.Warning, "Employee not found", "The selected employee no longer exists.");
            return;
        }

        if (!IsActiveEmployeeStatus(employee.Status))
        {
            ShowToast(ToastType.Warning, "Inactive employee", $"{FormatInputEmployeeName(employee)} is inactive and cannot be manually encoded.");
            return;
        }

        isSavingInputLog = true;

        try
        {
            if (inputLogMode == InputLogMode.Onsite)
            {
                await SaveOnsiteInputLogAsync(employee);
            }
            else
            {
                await SaveWfhInputLogAsync(employee);
            }

            await RefreshAvailablePeriodsAsync();
            EnsureSavedDateIsVisible(inputForm.AttendanceDate);
            await LoadLogsAsync();
            CloseInputLogsModal();
        }
        catch (InvalidOperationException ex)
        {
            ShowToast(ToastType.Warning, "Validation", ex.Message);
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Save failed", ex.Message);
        }
        finally
        {
            isSavingInputLog = false;
        }
    }

    private async Task SaveOnsiteInputLogAsync(Employee employee)
    {
        var attendanceDate = inputForm.AttendanceDate.Date;
        var newTimeInAm = CombineDateAndTime(attendanceDate, inputForm.OnsiteTimeInAm);
        var newTimeOutAm = CombineDateAndTime(attendanceDate, inputForm.OnsiteTimeOutAm);
        var newTimeInPm = CombineDateAndTime(attendanceDate, inputForm.OnsiteTimeInPm);
        var newTimeOutPm = CombineDateAndTime(attendanceDate, inputForm.OnsiteTimeOutPm);
        var hasAnyTime = newTimeInAm.HasValue
            || newTimeOutAm.HasValue
            || newTimeInPm.HasValue
            || newTimeOutPm.HasValue;

        if (!hasAnyTime)
        {
            throw new InvalidOperationException("Enter at least one onsite time value.");
        }

        var wfhTag = await ApplyDivisionScope(Db.AttendanceLogsWfh)
            .AsNoTracking()
            .Include(l => l.ExceptionCondition)
            .FirstOrDefaultAsync(l => l.EmployeeId == employee.EmployeeId && l.AttendanceDate == attendanceDate);

        if (wfhTag is not null && string.Equals(GetWorkArrangement(wfhTag), "WFH", StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException($"{FormatInputEmployeeName(employee)} is tagged as WFH for {attendanceDate:MMMM dd, yyyy} and cannot be manually encoded as onsite.");
        }

        var log = await ApplyDivisionScope(Db.AttendanceLogs)
            .FirstOrDefaultAsync(l => l.EmployeeId == employee.EmployeeId && l.AttendanceDate == attendanceDate);

        if (log is null)
        {
            log = new AttendanceLog
            {
                EmployeeId = employee.EmployeeId,
                AttendanceDate = attendanceDate
            };
            Db.AttendanceLogs.Add(log);
        }

        log.IdNumber = employee.IdNumber;
        log.LastName = employee.LastName;
        log.FirstName = employee.FirstName;
        log.MiddleName = employee.MiddleName;
        log.DivisionCenterUnit = employee.DivisionCenterUnit;
        log.Designation = employee.Designation;
        log.TimeInAm ??= newTimeInAm;
        log.TimeOutAm ??= newTimeOutAm;
        log.TimeInPm ??= newTimeInPm;
        log.TimeOutPm ??= newTimeOutPm;
        ApplyCreditedOnsiteTimeInPm(log);
        log.Tardiness = ComputeTardinessForOnsite(log, employee.Status);

        await Db.SaveChangesAsync();
        ShowToast(ToastType.Success, "Onsite log saved", $"{FormatInputEmployeeName(employee)} onsite log was saved.");
    }

    private async Task SaveWfhInputLogAsync(Employee employee)
    {
        var attendanceDate = inputForm.AttendanceDate.Date;
        var timeIn = CombineDateAndTime(attendanceDate, inputForm.WfhTimeIn);
        var timeOut = CombineDateAndTime(attendanceDate, inputForm.WfhTimeOut);
        var target = inputForm.Target.Trim();
        var accomplishment = inputForm.Accomplishment.Trim();
        var mov = await SaveInputMovFileAsync(inputForm.MovFile);

        if (!timeIn.HasValue && !timeOut.HasValue && string.IsNullOrWhiteSpace(target) && string.IsNullOrWhiteSpace(accomplishment) && string.IsNullOrWhiteSpace(mov))
        {
            throw new InvalidOperationException("Enter at least time in, time out, target, accomplishment, or means of verification for the WFH log.");
        }

        var log = await ApplyDivisionScope(Db.AttendanceLogsWfh)
            .FirstOrDefaultAsync(l => l.EmployeeId == employee.EmployeeId && l.AttendanceDate == attendanceDate);

        if (log is null)
        {
            log = new AttendanceLogWfh
            {
                EmployeeId = employee.EmployeeId,
                AttendanceDate = attendanceDate
            };
            Db.AttendanceLogsWfh.Add(log);
        }

        log.IdNumber = employee.IdNumber;
        log.LastName = employee.LastName;
        log.FirstName = employee.FirstName;
        log.MiddleName = employee.MiddleName;
        log.DivisionCenterUnit = employee.DivisionCenterUnit;
        log.Designation = employee.Designation;
        log.WorkArrangement = "WFH";
        log.ExceptionConditionId = null;
        log.TagUpdatedAt = DateTime.Now;
        log.TimeIn ??= timeIn;
        log.TimeOut ??= timeOut;
        log.Target = string.IsNullOrWhiteSpace(log.Target) ? target : log.Target;
        log.Accomplishment = string.IsNullOrWhiteSpace(log.Accomplishment) ? accomplishment : log.Accomplishment;
        log.Mov = string.IsNullOrWhiteSpace(log.Mov) ? mov ?? log.Mov : log.Mov;
        log.Tardiness = ComputeTardinessForWfh(log, employee.Status);

        await Db.SaveChangesAsync();
        ShowToast(ToastType.Success, "WFH log saved", $"{FormatInputEmployeeName(employee)} WFH log was saved.");
    }

    private async Task SaveEditedOnsiteLogAsync()
    {
        var log = await ApplyDivisionScope(Db.AttendanceLogs).FirstOrDefaultAsync(l => l.AttendanceLogId == editLogForm.AttendanceLogId);
        if (log is null)
        {
            throw new InvalidOperationException("The onsite log no longer exists.");
        }

        var attendanceDate = log.AttendanceDate.Date;
        log.TimeInAm = CombineDateAndTime(attendanceDate, editLogForm.OnsiteTimeInAm);
        log.TimeOutAm = CombineDateAndTime(attendanceDate, editLogForm.OnsiteTimeOutAm);
        log.TimeInPm = CombineDateAndTime(attendanceDate, editLogForm.OnsiteTimeInPm);
        log.TimeOutPm = CombineDateAndTime(attendanceDate, editLogForm.OnsiteTimeOutPm);

        if (!log.TimeInAm.HasValue && !log.TimeOutAm.HasValue && !log.TimeInPm.HasValue && !log.TimeOutPm.HasValue)
        {
            throw new InvalidOperationException("Enter at least one onsite time value.");
        }

        ApplyCreditedOnsiteTimeInPm(log);

        var computedLateUndertime = ComputeTardinessForOnsite(log, editLogForm.EmployeeStatus);
        log.Tardiness = NormalizeStoredTardiness(editLogForm.Tardiness, computedLateUndertime);

        await Db.SaveChangesAsync();
        ShowToast(ToastType.Success, "Onsite log updated", $"{FormatName(log.LastName, log.FirstName, log.MiddleName)} onsite log was updated.");
    }

    private async Task SaveEditedWfhLogAsync()
    {
        var log = await ApplyDivisionScope(Db.AttendanceLogsWfh)
            .Include(l => l.ExceptionCondition)
            .FirstOrDefaultAsync(l => l.AttendanceLogWfhId == editLogForm.AttendanceLogWfhId);
        if (log is null)
        {
            throw new InvalidOperationException("The WFH log no longer exists.");
        }

        var attendanceDate = log.AttendanceDate.Date;
        var newMov = await SaveInputMovFileAsync(editLogForm.MovFile);

        log.TimeIn = CombineDateAndTime(attendanceDate, editLogForm.WfhTimeIn);
        log.TimeOut = CombineDateAndTime(attendanceDate, editLogForm.WfhTimeOut);
        log.Target = editLogForm.Target.Trim();
        log.Accomplishment = editLogForm.Accomplishment.Trim();
        log.Mov = string.IsNullOrWhiteSpace(newMov) ? log.Mov : newMov;
        log.TagUpdatedAt = DateTime.Now;

        if (!log.TimeIn.HasValue
            && !log.TimeOut.HasValue
            && string.IsNullOrWhiteSpace(log.Target)
            && string.IsNullOrWhiteSpace(log.Accomplishment)
            && string.IsNullOrWhiteSpace(log.Mov))
        {
            throw new InvalidOperationException("Enter at least time in, time out, target, accomplishment, or means of verification for the WFH log.");
        }

        var computedLateUndertime = ComputeTardinessForWfh(log, editLogForm.EmployeeStatus);
        log.Tardiness = NormalizeStoredTardiness(editLogForm.Tardiness, computedLateUndertime);

        await Db.SaveChangesAsync();
        ShowToast(ToastType.Success, "WFH log updated", $"{FormatName(log.LastName, log.FirstName, log.MiddleName)} WFH log was updated.");
    }

    private static DateTime? CombineDateAndTime(DateTime date, string? timeText)
    {
        if (string.IsNullOrWhiteSpace(timeText))
        {
            return null;
        }

        if (!TimeOnly.TryParse(timeText, out var time))
        {
            throw new InvalidOperationException($"Invalid time value: {timeText}.");
        }

        return date.Date.Add(time.ToTimeSpan());
    }

    private static string FormatTimeInput(DateTime? value) => value?.ToString("HH:mm") ?? string.Empty;

