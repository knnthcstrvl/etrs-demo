    private IEnumerable<AttendanceLog> ApplyOnsiteSort(IEnumerable<AttendanceLog> logs, AttendanceTableState state)
    {
        var column = state.SortColumn?.Trim().ToLowerInvariant();
        var descending = state.SortDescending;

        if (column == "date")
        {
            return OrderByDirection(logs, descending, log => log.AttendanceDate.Date)
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName))
                .ThenBy(log => NormalizeSortValue(log.MiddleName))
                .ThenBy(log => NormalizeSortValue(log.IdNumber));
        }

        var groupedByDate = logs.OrderByDescending(log => log.AttendanceDate.Date);

        return column switch
        {
            "id" => ThenByDirection(groupedByDate, descending, log => NormalizeSortValue(log.IdNumber))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "division" => ThenByDirection(groupedByDate, descending, log => NormalizeSortValue(log.DivisionCenterUnit))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "designation" => ThenByDirection(groupedByDate, descending, log => NormalizeSortValue(log.Designation))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "status" => ThenByDirection(groupedByDate, descending, log => NormalizeSortValue(GetEmployeeType(log)))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "am" => ThenByDirection(groupedByDate, descending, log => log.TimeInAm ?? DateTime.MinValue)
                .ThenBy(log => log.TimeOutAm ?? DateTime.MinValue)
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "pm" => ThenByDirection(groupedByDate, descending, log => GetCreditedOnsiteTimeInPm(log) ?? DateTime.MinValue)
                .ThenBy(log => log.TimeOutPm ?? DateTime.MinValue)
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "employee" => ThenByEmployee(groupedByDate, descending),
            null or "" => ThenByEmployee(groupedByDate, false),
            _ => ThenByEmployee(groupedByDate, false)
        };
    }

    private IEnumerable<AttendanceLogWfh> ApplyWfhSort(IEnumerable<AttendanceLogWfh> logs, AttendanceTableState state)
    {
        var column = state.SortColumn?.Trim().ToLowerInvariant();
        var descending = state.SortDescending;

        if (column == "date")
        {
            return OrderByDirection(logs, descending, log => log.AttendanceDate.Date)
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName))
                .ThenBy(log => NormalizeSortValue(log.MiddleName))
                .ThenBy(log => NormalizeSortValue(log.IdNumber));
        }

        var groupedByDate = logs.OrderByDescending(log => log.AttendanceDate.Date);

        return column switch
        {
            "id" => ThenByDirection(groupedByDate, descending, log => NormalizeSortValue(log.IdNumber))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "division" => ThenByDirection(groupedByDate, descending, log => NormalizeSortValue(log.DivisionCenterUnit))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "designation" => ThenByDirection(groupedByDate, descending, log => NormalizeSortValue(log.Designation))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "status" => ThenByDirection(groupedByDate, descending, log => NormalizeSortValue(GetEmployeeType(log)))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "timein" => ThenByDirection(groupedByDate, descending, log => log.TimeIn ?? DateTime.MinValue)
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "timeout" => ThenByDirection(groupedByDate, descending, log => log.TimeOut ?? DateTime.MinValue)
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "employee" => ThenByEmployee(groupedByDate, descending),
            null or "" => ThenByEmployee(groupedByDate, false),
            _ => ThenByEmployee(groupedByDate, false)
        };
    }

    private static IOrderedEnumerable<T> ThenByEmployee<T>(IOrderedEnumerable<T> logs, bool descending) where T : class
        => descending
            ? logs.ThenByDescending(log => NormalizeSortValue(GetLastName(log)))
                .ThenByDescending(log => NormalizeSortValue(GetFirstName(log)))
                .ThenByDescending(log => NormalizeSortValue(GetMiddleName(log)))
                .ThenByDescending(log => NormalizeSortValue(GetIdNumber(log)))
            : logs.ThenBy(log => NormalizeSortValue(GetLastName(log)))
                .ThenBy(log => NormalizeSortValue(GetFirstName(log)))
                .ThenBy(log => NormalizeSortValue(GetMiddleName(log)))
                .ThenBy(log => NormalizeSortValue(GetIdNumber(log)));

    private static IOrderedEnumerable<T> OrderByEmployee<T>(IEnumerable<T> logs, bool descending) where T : class
        => descending
            ? logs.OrderByDescending(log => NormalizeSortValue(GetLastName(log)))
                .ThenByDescending(log => NormalizeSortValue(GetFirstName(log)))
                .ThenByDescending(log => NormalizeSortValue(GetMiddleName(log)))
                .ThenByDescending(log => NormalizeSortValue(GetIdNumber(log)))
            : logs.OrderBy(log => NormalizeSortValue(GetLastName(log)))
                .ThenBy(log => NormalizeSortValue(GetFirstName(log)))
                .ThenBy(log => NormalizeSortValue(GetMiddleName(log)))
                .ThenBy(log => NormalizeSortValue(GetIdNumber(log)));

    private static IOrderedEnumerable<T> OrderByDirection<T, TKey>(IEnumerable<T> source, bool descending, Func<T, TKey> selector)
        => descending ? source.OrderByDescending(selector) : source.OrderBy(selector);

    private static IOrderedEnumerable<T> ThenByDirection<T, TKey>(IOrderedEnumerable<T> source, bool descending, Func<T, TKey> selector)
        => descending ? source.ThenByDescending(selector) : source.ThenBy(selector);

