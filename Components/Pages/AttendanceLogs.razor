    private static IReadOnlyList<string> GetTardinessTags(string? value)
    {
        var normalized = NormalizeTardinessForEdit(GetStoredTardinessDisplayValue(value));
        if (string.IsNullOrWhiteSpace(normalized)
            || string.Equals(normalized, "On Time", StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalized, "Pending", StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalized, "Tagged", StringComparison.OrdinalIgnoreCase))
        {
            return new[] { "On Time" };
        }

        if (string.Equals(normalized, "Incomplete", StringComparison.OrdinalIgnoreCase))
        {
            return new[] { "Incomplete" };
        }

        if (string.Equals(normalized, "Absent", StringComparison.OrdinalIgnoreCase))
        {
            return new[] { "Absent" };
        }

        var tags = normalized
            .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(NormalizeTardinessPillText)
            .Where(tag => !string.IsNullOrWhiteSpace(tag))
            .ToList();

        if (tags.Count == 0)
        {
            var statusTag = GetTardinessStatusTag(normalized);
            if (string.Equals(statusTag, "Late with Undertime", StringComparison.OrdinalIgnoreCase))
            {
                tags.Add("Late");
                tags.Add("Undertime");
            }
            else
            {
                tags.Add(statusTag);
            }
        }

        return tags.Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
    }

    private static string NormalizeTardinessPillText(string value)
    {
        if (IsHalfDayTag(value))
        {
            return GetHalfDayStatus(value);
        }

        return NormalizeDurationTagText(value.Trim());
    }

    private static string NormalizeDurationTagText(string value)
    {
        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length < 2)
        {
            return value;
        }

        var durationText = parts[0];
        var statusText = string.Join(" ", parts.Skip(1));
        var minuteSuffixes = new[] { "minute(s)", "minutes", "minute", "mins", "min", "m" };
        if (IsDurationTardinessStatus(statusText))
        {
            foreach (var suffix in minuteSuffixes)
            {
                if (durationText.EndsWith(suffix, StringComparison.OrdinalIgnoreCase)
                    && int.TryParse(durationText[..^suffix.Length], out var minutes))
                {
                    return $"{FormatDurationCompact(TimeSpan.FromMinutes(minutes))} {statusText}";
                }
            }
        }

        if (parts.Length >= 3
            && int.TryParse(parts[0], out var spacedMinutes)
            && minuteSuffixes.Contains(parts[1], StringComparer.OrdinalIgnoreCase)
            && IsDurationTardinessStatus(string.Join(" ", parts.Skip(2))))
        {
            return $"{FormatDurationCompact(TimeSpan.FromMinutes(spacedMinutes))} {string.Join(" ", parts.Skip(2))}";
        }

        return value;
    }

    private static bool IsDurationTardinessStatus(string value)
        => string.Equals(value, "late", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, "undertime", StringComparison.OrdinalIgnoreCase);

    private static string FormatTardinessTags(string? value)
        => string.Join(", ", GetTardinessTags(value));

    private static string GetTardinessPillClass(string tag)
    {
        var variant = tag switch
        {
            "On Time" => "on-time",
            "Absent" => "absent",
            "Incomplete" => "incomplete",
            "Half-Day (AM)" or "Half-Day (PM)" => "half-day",
            _ when tag.Contains("late", StringComparison.OrdinalIgnoreCase) => "late",
            _ when tag.Contains("undertime", StringComparison.OrdinalIgnoreCase) => "undertime",
            _ => "on-time"
        };

        return $"attendance-tardiness-pill attendance-tardiness-pill-{variant}";
    }

