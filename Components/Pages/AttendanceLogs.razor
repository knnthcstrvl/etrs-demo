    private IEnumerable<string> BuildEditTardinessOptions()
        => new[] { DefaultTardinessOption }.Concat(EditTardinessStatusOptions);

    private const string DefaultTardinessOption = "Default";
    private const string DefaultTardinessSentinel = "__DEFAULT__";
    private const string ManualTardinessPrefix = "[Manual] ";

    private static readonly string[] EditTardinessStatusOptions = new[]
    {
        "On Time",
        "Absent",
        "Half-Day (AM)",
        "Half-Day (PM)",
        "Late",
        "Undertime",
        "Late with Undertime",
        "Incomplete"
    };

    private static string NormalizeTardinessForEdit(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();

    private static string GetEditTardinessValue(string? value)
        => IsManualTardinessOverride(value)
            ? NormalizeTardinessForEdit(GetStoredTardinessDisplayValue(value))
            : DefaultTardinessSentinel;

    private static string NormalizeStoredTardiness(string? value, string? computedValue)
    {
        var normalized = NormalizeTardinessForEdit(value);
        if (string.Equals(normalized, DefaultTardinessSentinel, StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalized, DefaultTardinessOption, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        var displayValue = string.IsNullOrWhiteSpace(normalized)
            ? "On Time"
            : string.Join("; ", normalized
                .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(NormalizeTardinessPillText));

        if (IsSameLateUndertimeTag(displayValue, computedValue))
        {
            return string.Empty;
        }

        return $"{ManualTardinessPrefix}{displayValue}";
    }

    private static bool IsSameLateUndertimeTag(string? selectedValue, string? computedValue)
        => string.Equals(
            GetTardinessStatusTag(selectedValue),
            GetTardinessStatusTag(computedValue),
            StringComparison.OrdinalIgnoreCase);

    private static string ResolveTardiness(string? savedValue, Func<string> computeValue)
    {
        return IsManualTardinessOverride(savedValue)
            ? GetStoredTardinessDisplayValue(savedValue)
            : computeValue();
    }

    private static bool HasManualTardinessTag(string? value)
    {
        var normalized = NormalizeTardinessForEdit(GetStoredTardinessDisplayValue(value));
        var statusTag = GetTardinessStatusTag(normalized);
        return EditTardinessStatusOptions.Any(option =>
            string.Equals(statusTag, option, StringComparison.OrdinalIgnoreCase));
    }

    private static bool IsManualTardinessOverride(string? value)
        => NormalizeTardinessForEdit(value).StartsWith(ManualTardinessPrefix, StringComparison.OrdinalIgnoreCase);

    private static string GetStoredTardinessDisplayValue(string? value)
    {
        var normalized = NormalizeTardinessForEdit(value);
        return normalized.StartsWith(ManualTardinessPrefix, StringComparison.OrdinalIgnoreCase)
            ? normalized[ManualTardinessPrefix.Length..].Trim()
            : normalized;
    }

    private string ResolveEditTardinessSelection(string value)
    {
        var computedValue = ComputeEditFormTardiness();

        if (string.Equals(value, DefaultTardinessOption, StringComparison.OrdinalIgnoreCase))
        {
            return DefaultTardinessSentinel;
        }

        var selectedTag = GetTardinessStatusTag(value);

        if (string.Equals(selectedTag, "Late", StringComparison.OrdinalIgnoreCase))
        {
            return GetTardinessSegment(computedValue, "late") ?? selectedTag;
        }

        if (string.Equals(selectedTag, "Undertime", StringComparison.OrdinalIgnoreCase))
        {
            return GetTardinessSegment(computedValue, "undertime") ?? selectedTag;
        }

        if (string.Equals(selectedTag, "Late with Undertime", StringComparison.OrdinalIgnoreCase))
        {
            var parts = new[]
            {
                GetTardinessSegment(computedValue, "late") ?? "Late",
                GetTardinessSegment(computedValue, "undertime") ?? "Undertime"
            };

            return string.Join("; ", parts);
        }

        return NormalizeTardinessForEdit(value);
    }

    private string ComputeEditFormTardiness()
    {
        var attendanceDate = editLogForm.AttendanceDate.Date;

        if (editLogForm.IsWfh)
        {
            var log = new AttendanceLogWfh
            {
                AttendanceDate = attendanceDate,
                TimeIn = CombineDateAndTime(attendanceDate, editLogForm.WfhTimeIn),
                TimeOut = CombineDateAndTime(attendanceDate, editLogForm.WfhTimeOut),
                WorkArrangement = "WFH"
            };

            return ComputeTardinessForWfh(log, editLogForm.EmployeeStatus);
        }

        var onsiteLog = new AttendanceLog
        {
            AttendanceDate = attendanceDate,
            TimeInAm = CombineDateAndTime(attendanceDate, editLogForm.OnsiteTimeInAm),
            TimeOutAm = CombineDateAndTime(attendanceDate, editLogForm.OnsiteTimeOutAm),
            TimeInPm = CombineDateAndTime(attendanceDate, editLogForm.OnsiteTimeInPm),
            TimeOutPm = CombineDateAndTime(attendanceDate, editLogForm.OnsiteTimeOutPm)
        };
        ApplyCreditedOnsiteTimeInPm(onsiteLog);

        return ComputeTardinessForOnsite(onsiteLog, editLogForm.EmployeeStatus);
    }

    private static string? GetTardinessSegment(string? value, string keyword)
    {
        var normalized = NormalizeTardinessForEdit(value);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return null;
        }

        return normalized
            .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .FirstOrDefault(part => part.Contains(keyword, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsTardinessOverride(AttendanceLog log)
        => IsTardinessOverride(
            log.Tardiness,
            ComputeTardinessForOnsite(log, ResolveEmployeeStatus(log)));

    private bool IsTardinessOverride(AttendanceLogWfh log)
        => IsTardinessOverride(
            log.Tardiness,
            ComputeTardinessForWfh(log, ResolveEmployeeStatus(log)));

    private static bool IsTardinessOverride(string? savedValue, string computedValue)
    {
        if (!IsManualTardinessOverride(savedValue))
        {
            return false;
        }

        return !string.Equals(
            GetTardinessStatusTag(savedValue),
            GetTardinessStatusTag(computedValue),
            StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayEditTardiness(string? value)
    {
        var normalized = NormalizeTardinessForEdit(value);
        return string.Equals(normalized, DefaultTardinessSentinel, StringComparison.OrdinalIgnoreCase)
            ? DefaultTardinessOption
            : GetTardinessStatusTag(GetStoredTardinessDisplayValue(value));
    }

    private static string GetTardinessStatusTag(string? value)
    {
        var normalized = NormalizeTardinessForEdit(GetStoredTardinessDisplayValue(value));
        if (string.IsNullOrWhiteSpace(normalized)
            || string.Equals(normalized, "On Time", StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalized, "Pending", StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalized, "Tagged", StringComparison.OrdinalIgnoreCase))
        {
            return "On Time";
        }

        if (string.Equals(normalized, "Incomplete", StringComparison.OrdinalIgnoreCase))
        {
            return "Incomplete";
        }

        if (string.Equals(normalized, "Absent", StringComparison.OrdinalIgnoreCase))
        {
            return "Absent";
        }

        if (IsHalfDayTag(normalized))
        {
            return GetHalfDayStatus(normalized);
        }

        var hasLate = normalized.Contains("late", StringComparison.OrdinalIgnoreCase);
        var hasUndertime = normalized.Contains("undertime", StringComparison.OrdinalIgnoreCase);

        return (hasLate, hasUndertime) switch
        {
            (true, true) => "Late with Undertime",
            (true, false) => "Late",
            (false, true) => "Undertime",
            _ => "On Time"
        };
    }

