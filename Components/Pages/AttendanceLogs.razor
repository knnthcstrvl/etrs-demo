    private async Task SaveEditLogAsync()
    {
        if (isSavingEditLog)
        {
            return;
        }

        isSavingEditLog = true;

        try
        {
            if (editLogForm.IsWfh)
            {
                await SaveEditedWfhLogAsync();
            }
            else
            {
                await SaveEditedOnsiteLogAsync();
            }

            await LoadLogsAsync();
            CloseEditLogsModal();
        }
        catch (InvalidOperationException ex)
        {
            ShowToast(ToastType.Warning, "Validation", ex.Message);
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Save failed", ex.Message);
        }
        finally
        {
            isSavingEditLog = false;
        }
    }

    private async Task SaveInputLogAsync()
    {
        if (isSavingInputLog)
        {
            return;
        }

        var validationContext = new ValidationContext(inputForm);
        var validationResults = new List<ValidationResult>();
        if (!Validator.TryValidateObject(inputForm, validationContext, validationResults, true))
        {
            ShowToast(ToastType.Warning, "Validation", validationResults[0].ErrorMessage ?? "Invalid input.");
            return;
        }

        var employee = await Db.Employees.FirstOrDefaultAsync(e => e.EmployeeId == inputForm.EmployeeId);
        if (employee is null)
        {
            ShowToast(ToastType.Warning, "Employee not found", "The selected employee no longer exists.");
            return;
        }

        isSavingInputLog = true;

        try
        {
            if (inputLogMode == InputLogMode.Onsite)
            {
                await SaveOnsiteInputLogAsync(employee);
            }
            else
            {
                await SaveWfhInputLogAsync(employee);
            }

            await LoadLogsAsync();
            CloseInputLogsModal();
        }
        catch (InvalidOperationException ex)
        {
            ShowToast(ToastType.Warning, "Validation", ex.Message);
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Save failed", ex.Message);
        }
        finally
        {
            isSavingInputLog = false;
        }
    }

    private async Task SaveOnsiteInputLogAsync(Employee employee)
    {
        var attendanceDate = inputForm.AttendanceDate.Date;
        var newTimeInAm = CombineDateAndTime(attendanceDate, inputForm.OnsiteTimeInAm);
        var newTimeOutAm = CombineDateAndTime(attendanceDate, inputForm.OnsiteTimeOutAm);
        var newTimeInPm = CombineDateAndTime(attendanceDate, inputForm.OnsiteTimeInPm);
        var newTimeOutPm = CombineDateAndTime(attendanceDate, inputForm.OnsiteTimeOutPm);
        var hasAnyTime = newTimeInAm.HasValue
            || newTimeOutAm.HasValue
            || newTimeInPm.HasValue
            || newTimeOutPm.HasValue;

        if (!hasAnyTime)
        {
            throw new InvalidOperationException("Enter at least one onsite time value.");
        }

        var log = await Db.AttendanceLogs
            .FirstOrDefaultAsync(l => l.EmployeeId == employee.EmployeeId && l.AttendanceDate == attendanceDate);

        if (log is null)
        {
            log = new AttendanceLog
            {
                EmployeeId = employee.EmployeeId,
                AttendanceDate = attendanceDate
            };
            Db.AttendanceLogs.Add(log);
        }

        log.IdNumber = employee.IdNumber;
        log.LastName = employee.LastName;
        log.FirstName = employee.FirstName;
        log.MiddleName = employee.MiddleName;
        log.DivisionCenterUnit = employee.DivisionCenterUnit;
        log.Designation = employee.Designation;
        log.TimeInAm ??= newTimeInAm;
        log.TimeOutAm ??= newTimeOutAm;
        log.TimeInPm ??= newTimeInPm;
        log.TimeOutPm ??= newTimeOutPm;
        log.Tardiness = ComputeTardinessForOnsite(log);

        await Db.SaveChangesAsync();
