    private RenderFragment SortHeader(string label, string column, bool isWfh) => builder =>
    {
        var sequence = 0;
        var isSorted = IsSortedColumn(column, isWfh);
        var isDescending = GetIsSortedDescending(column, isWfh);
        var showClear = HasCustomSort(column, isWfh);

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "attendance-sort-header");

        builder.OpenElement(sequence++, "button");
        builder.AddAttribute(sequence++, "type", "button");
        builder.AddAttribute(sequence++, "class", $"attendance-sort-trigger{(isSorted ? " active" : string.Empty)}");
        builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => ToggleSort(column, isWfh)));
        builder.AddAttribute(sequence++, "title", $"Sort by {label}");

        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "attendance-sort-label");
        builder.AddContent(sequence++, label);
        builder.CloseElement();

        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", $"attendance-sort-icon{(isSorted ? " active" : string.Empty)}");
        builder.OpenElement(sequence++, "i");
        builder.AddAttribute(sequence++, "class", isDescending ? "fa-solid fa-caret-down" : "fa-solid fa-caret-up");
        builder.AddAttribute(sequence++, "aria-hidden", "true");
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();

        if (showClear)
        {
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "class", "attendance-sort-clear");
            builder.AddAttribute(sequence++, "title", "Clear sorting");
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => ClearSorting(isWfh)));
            builder.AddAttribute(sequence++, "aria-label", "Clear sorting");
            builder.AddContent(sequence++, "×");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private bool HasCustomSort(string column, bool isWfh)
    {
        var state = isWfh ? wfhTableState : onsiteTableState;
        return !string.IsNullOrWhiteSpace(state.SortColumn)
            && string.Equals(state.SortColumn, column, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsSortedColumn(string column, bool isWfh)
    {
        var state = isWfh ? wfhTableState : onsiteTableState;
        if (!string.IsNullOrWhiteSpace(state.SortColumn))
        {
            return string.Equals(state.SortColumn, column, StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals(column, "employee", StringComparison.OrdinalIgnoreCase);
    }

    private bool GetIsSortedDescending(string column, bool isWfh)
    {
        var state = isWfh ? wfhTableState : onsiteTableState;
        if (string.IsNullOrWhiteSpace(state.SortColumn))
        {
            return false;
        }

        return string.Equals(state.SortColumn, column, StringComparison.OrdinalIgnoreCase) && state.SortDescending;
    }

    private void ToggleSort(string column, bool isWfh)
    {
        var state = isWfh ? wfhTableState : onsiteTableState;
        if (string.Equals(state.SortColumn, column, StringComparison.OrdinalIgnoreCase))
        {
            state.SortDescending = !state.SortDescending;
        }
        else
        {
            state.SortColumn = column;
            state.SortDescending = false;
        }

        if (isWfh)
        {
            wfhPage = 1;
        }
        else
        {
            onsitePage = 1;
        }

        RefreshFilteredLogs();
    }

    private void ClearSorting(bool isWfh)
    {
        var state = isWfh ? wfhTableState : onsiteTableState;
        state.SortColumn = null;
        state.SortDescending = false;

        if (isWfh)
        {
            wfhPage = 1;
        }
        else
        {
            onsitePage = 1;
        }

        RefreshFilteredLogs();
    }

    private static IEnumerable<AttendanceLog> ApplyOnsiteSort(IEnumerable<AttendanceLog> logs, AttendanceTableState state)
    {
        var column = state.SortColumn?.Trim().ToLowerInvariant();
        var descending = state.SortDescending;

        return column switch
        {
            "id" => OrderByDirection(logs, descending, log => NormalizeSortValue(log.IdNumber))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "division" => OrderByDirection(logs, descending, log => NormalizeSortValue(log.DivisionCenterUnit))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "designation" => OrderByDirection(logs, descending, log => NormalizeSortValue(log.Designation))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "am" => OrderByDirection(logs, descending, log => log.TimeInAm ?? DateTime.MinValue)
                .ThenBy(log => log.TimeOutAm ?? DateTime.MinValue)
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "pm" => OrderByDirection(logs, descending, log => log.TimeInPm ?? DateTime.MinValue)
                .ThenBy(log => log.TimeOutPm ?? DateTime.MinValue)
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "employee" or null or "" => OrderByEmployee(logs, descending),
            _ => OrderByEmployee(logs, false)
        };
    }

    private static IEnumerable<AttendanceLogWfh> ApplyWfhSort(IEnumerable<AttendanceLogWfh> logs, AttendanceTableState state)
    {
        var column = state.SortColumn?.Trim().ToLowerInvariant();
        var descending = state.SortDescending;

        return column switch
        {
            "id" => OrderByDirection(logs, descending, log => NormalizeSortValue(log.IdNumber))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "division" => OrderByDirection(logs, descending, log => NormalizeSortValue(log.DivisionCenterUnit))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "designation" => OrderByDirection(logs, descending, log => NormalizeSortValue(log.Designation))
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "timein" => OrderByDirection(logs, descending, log => log.TimeIn ?? DateTime.MinValue)
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "timeout" => OrderByDirection(logs, descending, log => log.TimeOut ?? DateTime.MinValue)
                .ThenBy(log => NormalizeSortValue(log.LastName))
                .ThenBy(log => NormalizeSortValue(log.FirstName)),
            "employee" or null or "" => OrderByEmployee(logs, descending),
            _ => OrderByEmployee(logs, false)
        };
    }

    private static IOrderedEnumerable<T> OrderByEmployee<T>(IEnumerable<T> logs, bool descending) where T : class
        => descending
            ? logs.OrderByDescending(log => NormalizeSortValue(GetLastName(log)))
                .ThenByDescending(log => NormalizeSortValue(GetFirstName(log)))
                .ThenByDescending(log => NormalizeSortValue(GetMiddleName(log)))
                .ThenByDescending(log => NormalizeSortValue(GetIdNumber(log)))
            : logs.OrderBy(log => NormalizeSortValue(GetLastName(log)))
                .ThenBy(log => NormalizeSortValue(GetFirstName(log)))
                .ThenBy(log => NormalizeSortValue(GetMiddleName(log)))
                .ThenBy(log => NormalizeSortValue(GetIdNumber(log)));

    private static IOrderedEnumerable<T> OrderByDirection<T, TKey>(IEnumerable<T> source, bool descending, Func<T, TKey> selector)
        => descending ? source.OrderByDescending(selector) : source.OrderBy(selector);

    private static string NormalizeSortValue(string? value) => value?.Trim() ?? string.Empty;

    private static string? GetLastName<T>(T log) where T : class => log switch
    {
