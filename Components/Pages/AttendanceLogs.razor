    private async Task RefreshAvailablePeriodsAsync(bool preserveSelections = true)
    {
        var previousSelectedPeriod = preserveSelections ? selectedPeriod : null;
        var previousSecondSelectedPeriod = preserveSelections ? secondSelectedPeriod : null;
        var previousExportSelectedPeriod = preserveSelections ? exportSelectedPeriod : null;
        var previousExportSecondSelectedPeriod = preserveSelections ? exportSecondSelectedPeriod : null;

        periods = await GetAvailablePeriodsAsync(DateTime.Today);

        if (!preserveSelections)
        {
            selectedPeriod = periods.FirstOrDefault(p => p.IsCurrent) ?? periods.LastOrDefault();
            secondSelectedPeriod = null;
            exportSelectedPeriod = null;
            exportSecondSelectedPeriod = null;
            showAddPeriod = false;
            showExportAddPeriod = false;
        }
        else
        {
            selectedPeriod = FindMatchingPeriod(previousSelectedPeriod);
            secondSelectedPeriod = FindMatchingPeriod(previousSecondSelectedPeriod);
            exportSelectedPeriod = FindMatchingPeriod(previousExportSelectedPeriod);
            exportSecondSelectedPeriod = FindMatchingPeriod(previousExportSecondSelectedPeriod);

            if (selectedPeriod is null && secondSelectedPeriod is not null)
            {
                selectedPeriod = secondSelectedPeriod;
                secondSelectedPeriod = null;
            }

            if (selectedPeriod is null)
            {
                selectedPeriod = periods.FirstOrDefault(p => p.IsCurrent) ?? periods.LastOrDefault();
            }

            if (exportSelectedPeriod is null && exportSecondSelectedPeriod is not null)
            {
                exportSelectedPeriod = exportSecondSelectedPeriod;
                exportSecondSelectedPeriod = null;
            }

            NormalizeSelectedPeriods();
            NormalizeSelectedPeriods(ref exportSelectedPeriod, ref exportSecondSelectedPeriod);
            showAddPeriod = secondSelectedPeriod is not null;
            showExportAddPeriod = exportSecondSelectedPeriod is not null;
        }

        if (selectedPeriod != null)
        {
            ApplySelectedPeriodRange();
        }
        else
        {
            filterStart = DateTime.Today;
            filterEnd = DateTime.Today;
        }
    }

    private async Task<List<Period>> GetAvailablePeriodsAsync(DateTime now)
    {
        var onsiteDates = await ApplyDivisionScope(Db.AttendanceLogs)
            .AsNoTracking()
            .Select(l => l.AttendanceDate)
            .Distinct()
            .ToListAsync();

        var wfhDates = await ApplyDivisionScope(Db.AttendanceLogsWfh)
            .AsNoTracking()
            .Where(l => l.ExceptionConditionId == null
                && l.WorkArrangement == "WFH"
                && (l.TimeIn.HasValue
                    || l.TimeOut.HasValue
                    || !string.IsNullOrWhiteSpace(l.Target)
                    || !string.IsNullOrWhiteSpace(l.Accomplishment)
                    || !string.IsNullOrWhiteSpace(l.Mov)))
            .Select(l => l.AttendanceDate)
            .Distinct()
            .ToListAsync();

        return onsiteDates
            .Concat(wfhDates)
            .Select(date => BuildPeriodForDate(date.Date, now))
            .GroupBy(period => new { period.Start, period.End })
            .Select(group => group.First())
            .OrderBy(period => period.Start)
            .ToList();
    }

    private Period? FindMatchingPeriod(Period? period)
        => period is null
            ? null
            : periods.FirstOrDefault(p => p.Start.Date == period.Start.Date && p.End.Date == period.End.Date);

    private static Period BuildPeriodForDate(DateTime date, DateTime now)
    {
        var start = date.Day <= 15
            ? new DateTime(date.Year, date.Month, 1)
            : new DateTime(date.Year, date.Month, 16);
        var end = date.Day <= 15
            ? new DateTime(date.Year, date.Month, 15)
            : new DateTime(date.Year, date.Month, DateTime.DaysInMonth(date.Year, date.Month));

        return new Period
        {
            Start = start,
            End = end,
            Label = $"{start:MMM dd} - {end:dd}, {end:yyyy}",
            IsCurrent = now.Date >= start.Date && now.Date <= end.Date
        };
    }

    private void EnsurePeriodsIncludeDate(DateTime attendanceDate)
    {
        var targetDate = attendanceDate.Date;

        var matchingPeriod = BuildPeriodForDate(targetDate, DateTime.Today);
        if (!periods.Any(p => p.Start.Date == matchingPeriod.Start.Date && p.End.Date == matchingPeriod.End.Date))
        {
            periods.Add(matchingPeriod);
            periods = periods.OrderBy(p => p.Start).ToList();
        }
    }

    private void EnsureSavedDateIsVisible(DateTime attendanceDate)
    {
        var targetDate = attendanceDate.Date;
        EnsurePeriodsIncludeDate(targetDate);

        if (filterStart != default && filterEnd != default
            && targetDate >= filterStart.Date
            && targetDate <= filterEnd.Date)
        {
            return;
        }

        var matchingPeriod = periods.FirstOrDefault(p => targetDate >= p.Start.Date && targetDate <= p.End.Date);
        if (matchingPeriod is null)
        {
            return;
        }

        if (selectedPeriod is null && secondSelectedPeriod is null)
        {
            selectedPeriod = matchingPeriod;
            showAddPeriod = false;
        }
        else if (selectedPeriod is not null && secondSelectedPeriod is null)
        {
            if (matchingPeriod.Start != selectedPeriod.Start || matchingPeriod.End != selectedPeriod.End)
            {
                secondSelectedPeriod = matchingPeriod;
                showAddPeriod = true;
            }
        }
        else
        {
            selectedPeriod ??= matchingPeriod;
            secondSelectedPeriod ??= matchingPeriod;

            if (matchingPeriod.Start < selectedPeriod.Start)
            {
                selectedPeriod = matchingPeriod;
            }
            else if (matchingPeriod.End > secondSelectedPeriod.End)
            {
                secondSelectedPeriod = matchingPeriod;
            }

            showAddPeriod = secondSelectedPeriod is not null;
        }

        NormalizeSelectedPeriods();
        isClosingAddPeriod = false;
        showPeriodMenu = false;
        showPeriod2Menu = false;
        ApplySelectedPeriodRange();
    }

    private static (DateTime Start, DateTime End) GetCurrentCutoffRange(DateTime now)
    {
        var startOfMonth = new DateTime(now.Year, now.Month, 1);
        var fifteenth = startOfMonth.AddDays(14); // 1 + 14 = 15th
        if (now.Date <= fifteenth.Date)
        {
            return (startOfMonth.Date, fifteenth.Date);
        }

        var lastDay = new DateTime(now.Year, now.Month, DateTime.DaysInMonth(now.Year, now.Month));
        return (startOfMonth.AddDays(15).Date, lastDay.Date);
    }

    private async Task LoadLogsAsync()
    {
        // Ensure valid range
        if (filterStart > filterEnd)
        {
            var tmp = filterStart;
            filterStart = filterEnd;
            filterEnd = tmp;
        }

        var start = filterStart.Date;
        var endExclusive = filterEnd.Date.AddDays(1);
        await RefreshEmployeeStatusLookupAsync();

        onsiteLogs = await ApplyDivisionScope(Db.AttendanceLogs)
            .AsNoTracking()
            .Include(l => l.Employee)
            .Where(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .OrderByDescending(l => l.AttendanceDate)
            .ThenBy(l => l.LastName)
            .ThenBy(l => l.FirstName)
            .ToListAsync();

        await PersistCreditedOnsiteTimeInPmAsync(onsiteLogs);

        wfhTaggedCount = await ApplyDivisionScope(Db.AttendanceLogsWfh)
            .AsNoTracking()
            .Where(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .CountAsync(l => (l.WorkArrangement ?? "WFH") == "WFH" && l.ExceptionConditionId == null);

        wfhLogs = await ApplyDivisionScope(Db.AttendanceLogsWfh)
            .AsNoTracking()
            .Include(l => l.Employee)
            .Include(l => l.ExceptionCondition)
            .Where(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .Where(l => l.ExceptionConditionId == null
                && l.WorkArrangement == "WFH"
                && (l.TimeIn.HasValue
                    || l.TimeOut.HasValue
                    || !string.IsNullOrWhiteSpace(l.Target)
                    || !string.IsNullOrWhiteSpace(l.Accomplishment)
                    || !string.IsNullOrWhiteSpace(l.Mov)))
            .OrderByDescending(l => l.AttendanceDate)
            .ThenBy(l => l.LastName)
            .ThenBy(l => l.FirstName)
            .ToListAsync();

        RefreshFilteredLogs(resetPaging: true);

        StateHasChanged();
    }

    private async Task RefreshEmployeeStatusLookupAsync()
    {
        var employees = await ApplyDivisionScope(Db.Employees)
            .AsNoTracking()
            .Where(e => !string.IsNullOrWhiteSpace(e.IdNumber))
            .Select(e => new { e.IdNumber, e.Status })
            .ToListAsync();

        employeeStatusesByIdNumber = employees
            .GroupBy(e => e.IdNumber.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                group => group.Key,
                group => group.First().Status,
                StringComparer.OrdinalIgnoreCase);
    }

    private string? ResolveEmployeeStatus(AttendanceLog log)
        => ResolveEmployeeStatus(log.IdNumber, log.Employee?.Status);

    private string? ResolveEmployeeStatus(AttendanceLogWfh log)
        => ResolveEmployeeStatus(log.IdNumber, log.Employee?.Status);

    private string? ResolveEmployeeStatus(string? idNumber, string? fallbackStatus)
    {
        if (!string.IsNullOrWhiteSpace(idNumber)
            && employeeStatusesByIdNumber.TryGetValue(idNumber.Trim(), out var employeeStatus))
        {
            return employeeStatus;
        }

        return fallbackStatus;
    }

