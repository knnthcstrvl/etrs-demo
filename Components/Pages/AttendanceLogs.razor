    private async Task ApproveMovVerificationAsync(AttendanceLogWfh log)
    {
        if (!CanApproveVerifications || isApprovingVerification || log == null)
        {
            return;
        }

        isApprovingVerification = true;

        try
        {
            // Fetch a fresh instance to avoid tracking conflicts
            var dbLog = await Db.AttendanceLogsWfh.FirstOrDefaultAsync(l => l.AttendanceLogWfhId == log.AttendanceLogWfhId);
            if (dbLog == null)
            {
                ShowToast(ToastType.Error, "Error", "Log not found in database.");
                return;
            }

            dbLog.MovApprovalStatus = "Approved";
            dbLog.MovApprovedAt = DateTime.UtcNow;
            dbLog.MovRejectedAt = null;
            // clear any manual tardiness override so default/computed tardiness is used
            dbLog.Tardiness = string.Empty;

            // optimistic UI update so modal/table reflect change immediately
            if (selectedWfhLog is not null && selectedWfhLog.AttendanceLogWfhId == dbLog.AttendanceLogWfhId)
            {
                selectedWfhLog.MovApprovalStatus = dbLog.MovApprovalStatus;
                selectedWfhLog.MovApprovedAt = dbLog.MovApprovedAt;
                selectedWfhLog.MovRejectedAt = dbLog.MovRejectedAt;
                selectedWfhLog.Tardiness = dbLog.Tardiness;
            }

            Db.AttendanceLogsWfh.Update(dbLog);
            await Db.SaveChangesAsync();

            await LoadLogsAsync();
            // refresh selected WFH log reference so detail modal and table reflect changes immediately
            selectedWfhLog = wfhLogs.FirstOrDefault(l => l.AttendanceLogWfhId == dbLog.AttendanceLogWfhId);
            _ = InvokeAsync(StateHasChanged);
            ShowToast(ToastType.Success, "MOV Approved", "MOV has been approved successfully.");
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Error", $"Error saving MOV approval: {ex.Message}");
        }
        finally
        {
            isApprovingVerification = false;
        }
    }

    private async Task UndoCurrentVerificationAsync(AttendanceLogWfh log)
    {
        if (!CanApproveVerifications || isApprovingVerification || log is null)
        {
            return;
        }

        isApprovingVerification = true;

        try
        {
            var dbLog = await Db.AttendanceLogsWfh.FirstOrDefaultAsync(l => l.AttendanceLogWfhId == log.AttendanceLogWfhId);
            if (dbLog is null)
            {
                ShowToast(ToastType.Error, "Error", "Log not found in database.");
                return;
            }

            if (IsPhotoVerificationSidecar)
            {
                dbLog.PhotoVerificationApprovalStatus = "Pending";
                dbLog.PhotoVerificationApprovedAt = null;
                dbLog.PhotoVerificationRejectedAt = null;
            }
            else
            {
                dbLog.MovApprovalStatus = "Pending";
                dbLog.MovApprovedAt = null;
                dbLog.MovRejectedAt = null;
            }

            dbLog.Tardiness = string.Empty;
            Db.AttendanceLogsWfh.Update(dbLog);
            await Db.SaveChangesAsync();

            await LoadLogsAsync();
            selectedWfhLog = wfhLogs.FirstOrDefault(l => l.AttendanceLogWfhId == dbLog.AttendanceLogWfhId);
            await InvokeAsync(StateHasChanged);
            ShowToast(ToastType.Success, "Decision Undone", $"{SidecarPreviewTitle} has been reset to pending.");
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Error", $"Error undoing verification decision: {ex.Message}");
        }
        finally
        {
            isApprovingVerification = false;
        }
    }

    private async Task RejectMovVerificationAsync(AttendanceLogWfh log)
    {
        if (!CanApproveVerifications || isApprovingVerification || log == null)
        {
            return;
        }

        isApprovingVerification = true;

        try
        {
            // Fetch a fresh instance to avoid tracking conflicts
            var dbLog = await Db.AttendanceLogsWfh.FirstOrDefaultAsync(l => l.AttendanceLogWfhId == log.AttendanceLogWfhId);
            if (dbLog == null)
            {
                ShowToast(ToastType.Error, "Error", "Log not found in database.");
                return;
            }

            dbLog.MovApprovalStatus = "Rejected";
            dbLog.MovRejectedAt = DateTime.UtcNow;
            dbLog.MovApprovedAt = null;
            // store as a manual tardiness override so the UI treats this as an explicit "Absent"
            dbLog.Tardiness = ManualTardinessPrefix + "Absent";

            // optimistic UI update so modal/table reflect change immediately
            if (selectedWfhLog is not null && selectedWfhLog.AttendanceLogWfhId == dbLog.AttendanceLogWfhId)
            {
                selectedWfhLog.MovApprovalStatus = dbLog.MovApprovalStatus;
                selectedWfhLog.MovRejectedAt = dbLog.MovRejectedAt;
                selectedWfhLog.MovApprovedAt = dbLog.MovApprovedAt;
                selectedWfhLog.Tardiness = dbLog.Tardiness;
            }

            Db.AttendanceLogsWfh.Update(dbLog);
            await Db.SaveChangesAsync();

            await LoadLogsAsync();
            // refresh selected WFH log reference so detail modal and table reflect changes immediately
            selectedWfhLog = wfhLogs.FirstOrDefault(l => l.AttendanceLogWfhId == dbLog.AttendanceLogWfhId);
            _ = InvokeAsync(StateHasChanged);
            ShowToast(ToastType.Success, "MOV Rejected", "MOV has been rejected and attendance marked as Absent.");
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Error", $"Error saving MOV rejection: {ex.Message}");
        }
        finally
        {
            isApprovingVerification = false;
        }
    }

    private async Task ApproveVerificationSidecarAsync()
    {
        if (selectedWfhLog == null)
        {
            return;
        }

        if (IsPhotoVerificationSidecar)
        {
            await ApprovePhotoVerificationAsync(selectedWfhLog);
        }
        else
        {
            await ApproveMovVerificationAsync(selectedWfhLog);
        }
    }

    private async Task RejectVerificationSidecarAsync()
    {
        if (selectedWfhLog == null)
        {
            return;
        }

        if (IsPhotoVerificationSidecar)
        {
            await RejectPhotoVerificationAsync(selectedWfhLog);
        }
        else
        {
            await RejectMovVerificationAsync(selectedWfhLog);
        }
    }

