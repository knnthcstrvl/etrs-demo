                                            <span class="attendance-detail-label">Target</span>
                                            <textarea class="form-control attendance-input-control attendance-input-textarea" @bind="inputForm.Target"></textarea>
                                        </div>
                                        <div class="attendance-input-field attendance-input-field-wide">
                                            <span class="attendance-detail-label">Accomplishment</span>
                                            <textarea class="form-control attendance-input-control attendance-input-textarea" @bind="inputForm.Accomplishment"></textarea>
