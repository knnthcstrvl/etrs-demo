        {
            var tmp = filterStart;
            filterStart = filterEnd;
            filterEnd = tmp;
        }

        var start = filterStart.Date;
        var endExclusive = filterEnd.Date.AddDays(1);

        onsiteLogs = await Db.AttendanceLogs
            .AsNoTracking()
            .Where(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .OrderByDescending(l => l.AttendanceDate)
            .ThenBy(l => l.LastName)
            .ThenBy(l => l.FirstName)
            .ToListAsync();

        wfhTaggedCount = await Db.AttendanceLogsWfh
            .AsNoTracking()
            .Where(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .CountAsync(l => (l.WorkArrangement ?? "WFH") == "WFH" && l.ExceptionConditionId == null);

        wfhLogs = await Db.AttendanceLogsWfh
            .AsNoTracking()
            .Include(l => l.ExceptionCondition)
            .Where(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .Where(l => l.ExceptionConditionId == null
                && l.WorkArrangement == "WFH"
                && (l.TimeIn.HasValue
                    || l.TimeOut.HasValue
                    || !string.IsNullOrWhiteSpace(l.Target)
                    || !string.IsNullOrWhiteSpace(l.Accomplishment)
                    || !string.IsNullOrWhiteSpace(l.Mov)))
            .OrderByDescending(l => l.AttendanceDate)
            .ThenBy(l => l.LastName)
            .ThenBy(l => l.FirstName)
            .ToListAsync();

        // Compute tardiness/absent labels in-memory according to rules
        foreach (var log in wfhLogs)
        {
            log.Tardiness = ComputeTardinessForWfh(log);
        }

        foreach (var log in onsiteLogs)
        {
            log.Tardiness = ComputeTardinessForOnsite(log);
        }

        RefreshFilteredLogs(resetPaging: true);

        StateHasChanged();
    }

    private void RefreshFilteredLogs(bool resetPaging = false)
    {
        filteredOnsiteLogs = ApplyOnsiteSort(
                onsiteLogs.Where(MatchesOnsiteFilters),
                onsiteTableState)
            .ToList();

        filteredWfhLogs = ApplyWfhSort(
                wfhLogs.Where(MatchesWfhFilters),
                wfhTableState)
            .ToList();

        if (resetPaging)
        {
            onsitePage = 1;
            wfhPage = 1;
            return;
        }

        onsitePage = Math.Clamp(onsitePage, 1, OnsiteTotalPages);
        wfhPage = Math.Clamp(wfhPage, 1, WfhTotalPages);
    }

    private bool MatchesOnsiteFilters(AttendanceLog log)
    {
        if (!MatchesSharedSearch(log.IdNumber, log.LastName, log.FirstName, log.MiddleName, log.DivisionCenterUnit, log.Designation))
        {
            return false;
        }

        if (!MatchesSelectedValue(log.IdNumber, filterIdNumber))
        {
            return false;
        }

        if (!MatchesSelectedValue(FormatName(log.LastName, log.FirstName, log.MiddleName), filterEmployee))
        {
            return false;
        }

        if (!MatchesSelectedValue(log.DivisionCenterUnit, filterDivision))
        {
            return false;
        }

        if (!MatchesSelectedValue(log.Designation, filterDesignation))
        {
            return false;
        }

        if (!MatchesSelectedValue(GetOnsiteAttendanceStatus(log), filterStatus))
        {
            return false;
        }

        return true;
    }

    private bool MatchesWfhFilters(AttendanceLogWfh log)
    {
        if (!MatchesSharedSearch(log.IdNumber, log.LastName, log.FirstName, log.MiddleName, log.DivisionCenterUnit, log.Designation))
        {
            return false;
        }

        if (!MatchesSelectedValue(log.IdNumber, filterIdNumber))
        {
            return false;
        }

        if (!MatchesSelectedValue(FormatName(log.LastName, log.FirstName, log.MiddleName), filterEmployee))
        {
            return false;
        }

        if (!MatchesSelectedValue(log.DivisionCenterUnit, filterDivision))
        {
            return false;
        }

        if (!MatchesSelectedValue(log.Designation, filterDesignation))
        {
            return false;
        }

        if (!MatchesSelectedValue(GetWfhAttendanceStatus(log), filterStatus))
        {
            return false;
        }

        if (!MatchesPresenceFilter(filterTarget, log.Target, "With Target", "Without Target"))
        {
            return false;
        }

        if (!MatchesPresenceFilter(filterAccomplishment, log.Accomplishment, "With Accomplishment", "Without Accomplishment"))
        {
            return false;
        }

        return MatchesPresenceFilter(filterMov, log.Mov, "With MOV", "Without MOV");
    }

    private bool MatchesSharedSearch(
        string? idNumber,
        string? lastName,
        string? firstName,
        string? middleName,
        string? division,
        string? designation)
    {
        var query = tableSearchText.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return ContainsText(idNumber, query)
            || MatchesEmployeeName(lastName, firstName, middleName, query)
            || ContainsText(division, query)
            || ContainsText(designation, query);
    }

    private static bool ContainsText(string? source, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return !string.IsNullOrWhiteSpace(source)
            && source.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static bool MatchesSelectedValue(string? source, string? selectedValue)
    {
        if (string.IsNullOrWhiteSpace(selectedValue))
        {
            return true;
        }

        return string.Equals(source?.Trim(), selectedValue.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static bool MatchesPresenceFilter(string? selectedValue, string? actualValue, string withValue, string withoutValue)
    {
        if (string.IsNullOrWhiteSpace(selectedValue))
        {
            return true;
        }

        var hasValue = !string.IsNullOrWhiteSpace(actualValue);

        if (string.Equals(selectedValue, withValue, StringComparison.OrdinalIgnoreCase))
        {
            return hasValue;
        }

        if (string.Equals(selectedValue, withoutValue, StringComparison.OrdinalIgnoreCase))
        {
            return !hasValue;
        }

        return true;
    }

    private static bool MatchesEmployeeName(string? lastName, string? firstName, string? middleName, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        var trimmedQuery = query.Trim();
        var fullName = string.Join(" ", new[] { firstName, middleName, lastName }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var reversedName = string.Join(" ", new[] { lastName, firstName, middleName }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var formattedName = FormatName(lastName ?? string.Empty, firstName ?? string.Empty, middleName ?? string.Empty);

        return ContainsText(firstName, trimmedQuery)
            || ContainsText(middleName, trimmedQuery)
            || ContainsText(lastName, trimmedQuery)
            || ContainsText(fullName, trimmedQuery)
            || ContainsText(reversedName, trimmedQuery)
            || ContainsText(formattedName, trimmedQuery);
    }

