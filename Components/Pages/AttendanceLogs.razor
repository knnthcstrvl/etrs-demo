    private async Task ConfirmVerificationAsync()
    {
        if (!CanApproveVerifications
            || (!pendingVerificationApproval.HasValue && !pendingVerificationUndo)
            || selectedWfhLog is null) return;

        if (pendingVerificationUndo)
        {
            await UndoCurrentVerificationAsync(selectedWfhLog);
            CloseVerificationConfirmation();
            return;
        }

        var approve = pendingVerificationApproval.GetValueOrDefault();
        if (IsPhotoVerificationSidecar)
        {
            if (approve) await ApprovePhotoVerificationAsync(selectedWfhLog); else await RejectPhotoVerificationAsync(selectedWfhLog);
        }
        else
        {
            if (approve) await ApproveMovVerificationAsync(selectedWfhLog); else await RejectMovVerificationAsync(selectedWfhLog);
        }
        CloseVerificationConfirmation();
    }
