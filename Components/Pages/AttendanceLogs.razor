    private string GetVerificationStatusClass(string? status)
    {
        return status switch
        {
            "Approved" => "badge badge-success verification-status",
            "Rejected" => "badge badge-danger verification-status",
            _ => "badge badge-secondary verification-status"
        };
    }

    private string GetVerificationStatusLabel(string? status)
    {
        return status switch
        {
            "Approved" => "Approved",
            "Rejected" => "Rejected",
            _ => "Pending"
        };
    }

    private bool IsVerificationRejected(string? status) => status == "Rejected";

    private async Task SyncPeriodDismissRegistrationAsync()
    {
        var shouldRegister = showPeriodMenu || showPeriod2Menu;

        if (shouldRegister && !periodDismissRegistered)
        {
            periodDropdownDotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("attendanceLogs.registerPeriodDismiss", periodControlsRef, periodDropdownDotNetRef);
            periodDismissRegistered = true;
        }
        else if (!shouldRegister && periodDismissRegistered)
        {
            await JS.InvokeVoidAsync("attendanceLogs.unregisterPeriodDismiss", periodControlsRef);
            periodDismissRegistered = false;
        }
    }

    private async Task SyncTableMenuDismissRegistrationAsync()
    {
        var shouldRegister = showFilterMenu || showEntriesMenu;

        if (shouldRegister && !tableMenuDismissRegistered)
        {
            tableMenuDotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("attendanceLogs.registerTableMenuDismiss", tableMenuControlsRef, tableMenuDotNetRef);
            tableMenuDismissRegistered = true;
        }
        else if (!shouldRegister && tableMenuDismissRegistered)
        {
            await JS.InvokeVoidAsync("attendanceLogs.unregisterTableMenuDismiss", tableMenuControlsRef);
            tableMenuDismissRegistered = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await UnregisterInputEmployeeOutsideClickAsync();

        if (periodDismissRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync("attendanceLogs.unregisterPeriodDismiss", periodControlsRef);
            }
            catch
            {
            }
        }

        if (tableMenuDismissRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync("attendanceLogs.unregisterTableMenuDismiss", tableMenuControlsRef);
            }
            catch
            {
            }
        }

        periodDropdownDotNetRef?.Dispose();
        tableMenuDotNetRef?.Dispose();
        inputEmployeeSearchDotNetRef?.Dispose();
    }

    private void ShowToast(ToastType type, string title, string message)
    {
        ToastService.Show(new ToastMessage
        {
            Type = type,
            Title = title,
            Message = message
        });
    }

