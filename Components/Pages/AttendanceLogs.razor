                @if ((showMovPreviewModal || isClosingMovPreview) && showMovPreviewWithEditLog)
                {
                    <div class="attendance-detail-modal attendance-mov-preview-modal attendance-mov-preview-sidecar @(isClosingMovPreview ? "closing" : null)" @onclick:stopPropagation="true">
                        <div class="attendance-detail-header">
                            <div>
                                <h2 class="attendance-detail-title">Means of Verification</h2>
                            </div>
                        </div>

                        <div class="attendance-detail-body attendance-mov-preview-body">
                            @MovPreviewContent
