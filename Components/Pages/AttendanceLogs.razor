                                    aria-label="Reject verification"
                                    @onclick="() => OpenVerificationConfirmation(false)"
                                    disabled="@(isApprovingVerification || !CanApproveVerifications)">
                                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
