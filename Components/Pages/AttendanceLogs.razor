                                    <span class="attendance-detail-label">ID Number</span>
                                    <strong>@DisplayValue(selectedOnsiteLog.IdNumber)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Attendance Date</span>
                                    <strong>@FormatDate(selectedOnsiteLog.AttendanceDate)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Division / Unit</span>
                                    <strong>@DisplayValue(selectedOnsiteLog.DivisionCenterUnit)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Designation</span>
                                    <strong>@DisplayValue(selectedOnsiteLog.Designation)</strong>
                                </div>
                            </div>
                        </div>

                        <div class="attendance-detail-section">
                            <div class="attendance-detail-grid attendance-detail-grid-compact">
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">AM Time In</span>
                                    <strong>@FormatDateTime(selectedOnsiteLog.TimeInAm)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">AM Time Out</span>
                                    <strong>@FormatDateTime(selectedOnsiteLog.TimeOutAm)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">PM Time In</span>
                                    <strong>@FormatDateTime(selectedOnsiteLog.TimeInPm)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">PM Time Out</span>
                                    <strong>@FormatDateTime(selectedOnsiteLog.TimeOutPm)</strong>
                                </div>
                            </div>
                        </div>
                    }
                    else if (selectedWfhLog is not null)
                    {
                        <div class="attendance-detail-section attendance-detail-hero">
                            <div>
                                <div class="attendance-detail-eyebrow">WFH ETRS Log</div>
                                <div class="attendance-detail-person">@FormatName(selectedWfhLog.LastName, selectedWfhLog.FirstName, selectedWfhLog.MiddleName)</div>
                            </div>
                            <div class="attendance-detail-status">@GetWfhAttendanceStatus(selectedWfhLog)</div>
                        </div>

                        <div class="attendance-detail-section attendance-detail-section-primary">
                            <div class="attendance-detail-grid">
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">ID Number</span>
                                    <strong>@DisplayValue(selectedWfhLog.IdNumber)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Attendance Date</span>
                                    <strong>@FormatDate(selectedWfhLog.AttendanceDate)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Division / Unit</span>
                                    <strong>@DisplayValue(selectedWfhLog.DivisionCenterUnit)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Designation</span>
                                    <strong>@DisplayValue(selectedWfhLog.Designation)</strong>
                                </div>
                            </div>
                        </div>

                        <div class="attendance-detail-section">
                            <div class="attendance-detail-grid attendance-detail-grid-compact">
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Time In</span>
                                    <strong>@FormatDateTime(selectedWfhLog.TimeIn)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Time Out</span>
                                    <strong>@FormatDateTime(selectedWfhLog.TimeOut)</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">Tardiness</span>
                                    <strong>@DisplayValue(selectedWfhLog.Tardiness, "On Time")</strong>
                                </div>
                                <div class="attendance-detail-field">
                                    <span class="attendance-detail-label">MOV</span>
                                    @if (string.IsNullOrWhiteSpace(selectedWfhLog.Mov))
                                    {
                                        <strong>-</strong>
                                    }
                                    else
                                    {
                                        <a class="attendance-detail-text-action" href="@selectedWfhLog.Mov" target="_blank">Open file</a>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="attendance-detail-section">
                            <div class="attendance-detail-field attendance-detail-field-wide">
                                <span class="attendance-detail-label">Target</span>
                                <p class="attendance-detail-preserve-spacing">@DisplayValue(selectedWfhLog.Target)</p>
                            </div>
                        </div>

                        <div class="attendance-detail-section">
                            <div class="attendance-detail-field attendance-detail-field-wide">
                                <span class="attendance-detail-label">Accomplishment</span>
                                <p class="attendance-detail-preserve-spacing">@DisplayValue(selectedWfhLog.Accomplishment)</p>
                            </div>
                        </div>
                    }
                </div>

                <div class="attendance-detail-footer">
                    <button type="button" class="attendance-detail-text-action" @onclick="CloseAttendanceDetail">Close</button>
                </div>
            </div>
        </div>
    }

    @if (showInputLogsModal)
    {
        <div class="attendance-detail-overlay" @onclick="CloseInputLogsModal">
            <div class="attendance-detail-modal attendance-input-modal" @onclick="CloseModalTransientUiAsync" @onclick:stopPropagation="true">
                <div class="attendance-detail-header">
                    <div>
                        <h2 class="attendance-detail-title">Input Logs</h2>
                    </div>
                    <button type="button" class="attendance-detail-close" @onclick="CloseInputLogsModal" aria-label="Close input logs">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="attendance-detail-body attendance-input-body">
                    <div class="attendance-detail-section attendance-detail-hero">
                        <div>
                            <div class="attendance-detail-eyebrow">Manual Attendance Entry</div>
                            <div class="attendance-detail-person">Choose log type, then enter the details.</div>
                            <div class="attendance-detail-meta">This will add or update a daily attendance record for the selected employee.</div>
                        </div>
                        <div class="attendance-input-pill">@InputLogModeLabel</div>
                    </div>

                    <div class="attendance-detail-section attendance-detail-section-primary">
                        <div class="attendance-input-mode-grid">
                            <button type="button" class="attendance-input-mode-card @(inputLogMode == InputLogMode.Onsite ? "selected" : null)" @onclick='() => SelectInputLogMode(InputLogMode.Onsite)'>
                                <span class="attendance-input-mode-title">Onsite</span>
                                <span class="attendance-input-mode-sub">AM / PM biometric-style logs</span>
                            </button>
                            <button type="button" class="attendance-input-mode-card @(inputLogMode == InputLogMode.Wfh ? "selected" : null)" @onclick='() => SelectInputLogMode(InputLogMode.Wfh)'>
                                <span class="attendance-input-mode-title">WFH</span>
                                <span class="attendance-input-mode-sub">Time in / out with work details</span>
                            </button>
                        </div>
                    </div>

                    <div class="attendance-detail-section">
                        <div class="attendance-input-grid">
                            <div class="attendance-input-field">
                                <span class="attendance-detail-label">Employee</span>
                                <div class="attendance-input-search-wrap" @ref="inputEmployeeSearchWrapRef" @onclick:stopPropagation="true">
                                    <div class="attendance-input-search-input-wrap">
                                        <input
                                            value="@inputEmployeeSearchText"
                                            @oninput="HandleInputEmployeeSearchChanged"
                                            @onfocus="HandleInputEmployeeSearchFocus"
                                            class="form-control attendance-input-control attendance-input-search-input"
                                            autocomplete="off"
                                            disabled="@isSavingInputLog" />
                                        <span class="attendance-input-search-icon" aria-hidden="true">Search</span>
                                    </div>

                                    <div class="@GetInputEmployeeOverlayClass()">
                                        @if (showInputEmployeeResults)
                                        {
                                            @if (inputEmployeeSearchResults.Count == 0)
                                            {
                                                <div class="attendance-input-empty-state">No Employee Found</div>
                                            }
                                            else
                                            {
                                                <div class="attendance-input-results-grid">
                                                    @foreach (var employee in inputEmployeeSearchResults)
                                                    {
                                                        <button type="button" class="@GetInputEmployeeResultClass(employee)" @onclick="() => SelectInputEmployee(employee)">
                                                            <span class="attendance-input-result-id">@employee.IdNumber</span>
                                                            <span class="attendance-input-result-name">@FormatInputEmployeeName(employee)</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="attendance-input-field">
                                <span class="attendance-detail-label">Attendance Date</span>
                                <InputDate @bind-Value="inputForm.AttendanceDate" class="form-control attendance-input-control" />
                            </div>
                            <div class="attendance-input-mode-panel attendance-input-field-wide attendance-input-mode-panel-@inputLogMode.ToString().ToLowerInvariant()" @key="inputLogMode">
                                <div class="attendance-input-mode-panel-grid">
                                    @if (inputLogMode == InputLogMode.Onsite)
                                    {
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">AM Time In</span>
                                            <input type="time" class="form-control attendance-input-control" value="@inputForm.OnsiteTimeInAm" @onchange='e => UpdateTimeField(value => inputForm.OnsiteTimeInAm = value, e)' />
                                        </div>
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">AM Time Out</span>
                                            <input type="time" class="form-control attendance-input-control" value="@inputForm.OnsiteTimeOutAm" @onchange='e => UpdateTimeField(value => inputForm.OnsiteTimeOutAm = value, e)' />
                                        </div>
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">PM Time In</span>
                                            <input type="time" class="form-control attendance-input-control" value="@inputForm.OnsiteTimeInPm" @onchange='e => UpdateTimeField(value => inputForm.OnsiteTimeInPm = value, e)' />
                                        </div>
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">PM Time Out</span>
                                            <input type="time" class="form-control attendance-input-control" value="@inputForm.OnsiteTimeOutPm" @onchange='e => UpdateTimeField(value => inputForm.OnsiteTimeOutPm = value, e)' />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">Time In</span>
                                            <input type="time" class="form-control attendance-input-control" value="@inputForm.WfhTimeIn" @onchange='e => UpdateTimeField(value => inputForm.WfhTimeIn = value, e)' />
                                        </div>
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">Time Out</span>
                                            <input type="time" class="form-control attendance-input-control" value="@inputForm.WfhTimeOut" @onchange='e => UpdateTimeField(value => inputForm.WfhTimeOut = value, e)' />
                                        </div>
                                        <div class="attendance-input-field attendance-input-field-wide">
                                            <span class="attendance-detail-label">Target</span>
                                            <textarea class="form-control attendance-input-control attendance-input-textarea" @bind="inputForm.Target"></textarea>
                                        </div>
                                        <div class="attendance-input-field attendance-input-field-wide">
                                            <span class="attendance-detail-label">Accomplishment</span>
                                            <textarea class="form-control attendance-input-control attendance-input-textarea" @bind="inputForm.Accomplishment"></textarea>
                                        </div>
                                        <div class="attendance-input-field attendance-input-field-wide">
                                            <span class="attendance-detail-label">Means of Verification</span>
                                            <div class="attendance-input-upload-wrap">
                                                <label for="attendanceInputMovUpload" class="attendance-input-file-button">Choose File</label>
                                                <InputFile id="attendanceInputMovUpload"
                                                           class="attendance-input-file-input"
                                                           OnChange="HandleInputMovSelected"
                                                           disabled="@isSavingInputLog" />
                                                <span class="attendance-input-upload-note">@(string.IsNullOrWhiteSpace(inputForm.MovFileName) ? "No file chosen." : inputForm.MovFileName)</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="attendance-detail-footer">
                    <button type="button" class="attendance-detail-text-action" @onclick="CloseInputLogsModal" disabled="@isSavingInputLog">Cancel</button>
                    <button type="button" class="btn btn-primary attendance-detail-done" @onclick="SaveInputLogAsync" disabled="@isSavingInputLog">@(isSavingInputLog ? "Saving..." : "Save")</button>
                </div>
            </div>
        </div>
    }

    @if (showEditLogsModal)
    {
        <div class="attendance-detail-overlay" @onclick="CloseEditLogsModal">
            <div class="attendance-detail-modal attendance-input-modal" @onclick="CloseModalTransientUiAsync" @onclick:stopPropagation="true">
                <div class="attendance-detail-header">
                    <div>
                        <h2 class="attendance-detail-title">Edit Logs</h2>
                    </div>
                    <button type="button" class="attendance-detail-close" @onclick="CloseEditLogsModal" aria-label="Close edit logs">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="attendance-detail-body attendance-input-body">
                    <div class="attendance-detail-section attendance-detail-hero">
                        <div>
                            <div class="attendance-detail-eyebrow">@editLogForm.LogTypeLabel Log</div>
                            <div class="attendance-detail-person">@editLogForm.EmployeeName</div>
                        </div>
                        <div class="attendance-input-pill">@editLogForm.LogTypeLabel</div>
                    </div>

                    <div class="attendance-detail-section attendance-detail-section-primary">
                        <div class="attendance-input-grid">
                            <div class="attendance-input-field">
                                <span class="attendance-detail-label">Attendance Date</span>
                                <input class="form-control attendance-input-control attendance-input-control-readonly" value="@FormatDate(editLogForm.AttendanceDate)" readonly />
                            </div>
                            <div class="attendance-input-field">
                                <span class="attendance-detail-label">Tardiness</span>
                                <div class="attendance-filter-select-wrap attendance-input-select-wrap" @onclick:stopPropagation="true">
                                    <button type="button"
                                            class="attendance-filter-select-trigger attendance-input-control @(showEditTardinessMenu ? "active" : null)"
                                            @onclick="ToggleEditTardinessMenu">
                                        <span class="attendance-filter-select-value">@DisplayEditTardiness(editLogForm.Tardiness)</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(showEditTardinessMenu ? "show" : null)">
                                        @foreach (var option in EditTardinessOptions)
                                        {
                                            <button type="button"
                                                    class="attendance-filter-select-option @(string.Equals(DisplayEditTardiness(editLogForm.Tardiness), option, StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                                    @onclick='() => SelectEditTardiness(option)'>
                                                @option
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="attendance-input-mode-panel attendance-input-field-wide attendance-input-mode-panel-@(editLogForm.IsWfh ? "wfh" : "onsite")">
                                <div class="attendance-input-mode-panel-grid">
                                    @if (!editLogForm.IsWfh)
                                    {
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">AM Time In</span>
                                            <input type="time" class="form-control attendance-input-control" value="@editLogForm.OnsiteTimeInAm" @onchange='e => UpdateTimeField(value => editLogForm.OnsiteTimeInAm = value, e)' />
                                        </div>
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">AM Time Out</span>
                                            <input type="time" class="form-control attendance-input-control" value="@editLogForm.OnsiteTimeOutAm" @onchange='e => UpdateTimeField(value => editLogForm.OnsiteTimeOutAm = value, e)' />
                                        </div>
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">PM Time In</span>
                                            <input type="time" class="form-control attendance-input-control" value="@editLogForm.OnsiteTimeInPm" @onchange='e => UpdateTimeField(value => editLogForm.OnsiteTimeInPm = value, e)' />
                                        </div>
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">PM Time Out</span>
                                            <input type="time" class="form-control attendance-input-control" value="@editLogForm.OnsiteTimeOutPm" @onchange='e => UpdateTimeField(value => editLogForm.OnsiteTimeOutPm = value, e)' />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">Time In</span>
                                            <input type="time" class="form-control attendance-input-control" value="@editLogForm.WfhTimeIn" @onchange='e => UpdateTimeField(value => editLogForm.WfhTimeIn = value, e)' />
                                        </div>
                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">Time Out</span>
                                            <input type="time" class="form-control attendance-input-control" value="@editLogForm.WfhTimeOut" @onchange='e => UpdateTimeField(value => editLogForm.WfhTimeOut = value, e)' />
                                        </div>
                                        <div class="attendance-input-field attendance-input-field-wide">
                                            <span class="attendance-detail-label">Target</span>
                                            <textarea class="form-control attendance-input-control attendance-input-textarea" @bind="editLogForm.Target"></textarea>
                                        </div>
                                        <div class="attendance-input-field attendance-input-field-wide">
                                            <span class="attendance-detail-label">Accomplishment</span>
                                            <textarea class="form-control attendance-input-control attendance-input-textarea" @bind="editLogForm.Accomplishment"></textarea>
                                        </div>
                                        <div class="attendance-input-field attendance-input-field-wide">
                                            <span class="attendance-detail-label">Means of Verification</span>
                                            <div class="attendance-input-upload-wrap">
                                                <label for="attendanceEditMovUpload" class="attendance-input-file-button">Replace File</label>
                                                <InputFile id="attendanceEditMovUpload"
                                                           class="attendance-input-file-input"
                                                           OnChange="HandleEditMovSelected"
                                                           disabled="@isSavingEditLog" />
                                                <span class="attendance-input-upload-note">@(string.IsNullOrWhiteSpace(editLogForm.MovFileName) ? "Keep current file." : editLogForm.MovFileName)</span>
                                                @if (!string.IsNullOrWhiteSpace(editLogForm.ExistingMov))
                                                {
                                                    <a class="attendance-detail-text-action attendance-input-upload-link-end" href="@editLogForm.ExistingMov" target="_blank">Open current file</a>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="attendance-detail-footer">
                    <button type="button" class="attendance-detail-text-action" @onclick="CloseEditLogsModal" disabled="@isSavingEditLog">Cancel</button>
                    <button type="button" class="btn btn-primary attendance-detail-done" @onclick="SaveEditLogAsync" disabled="@isSavingEditLog">@(isSavingEditLog ? "Saving..." : "Save Changes")</button>
                </div>
            </div>
        </div>
    }
</div>
</RequireAccess>

<style>
    .attendance-logs-title {
