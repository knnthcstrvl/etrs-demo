                                            <span class="attendance-detail-label">PM Time Out</span>
                                            <input type="time" class="form-control attendance-input-control" value="@inputForm.OnsiteTimeOutPm" @onchange='e => UpdateTimeField(value => inputForm.OnsiteTimeOutPm = value, e)' />
