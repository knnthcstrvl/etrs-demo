    private void AddMovImageNavigationButton(RenderTreeBuilder builder, ref int sequence, string iconClass, string label, Action action)
    {
        builder.OpenElement(sequence++, "button");
        builder.AddAttribute(sequence++, "type", "button");
        builder.AddAttribute(sequence++, "aria-label", label);
        builder.AddAttribute(sequence++, "title", label);
        builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, action));
        builder.OpenElement(sequence++, "i");
        builder.AddAttribute(sequence++, "class", iconClass);
        builder.AddAttribute(sequence++, "aria-hidden", "true");
        builder.CloseElement();
        builder.CloseElement();
    }

    private void ShowPreviousMovFile()
    {
