        var confirmationVerb = isUndoConfirmation
            ? "undo the decision for"
            : pendingVerificationApproval == true ? "accept" : "reject";
        <div class="attendance-verification-confirm-overlay attendance-verification-confirm-page-overlay" @onclick="CloseVerificationConfirmation">
            <div class="attendance-verification-confirm-modal" @onclick:stopPropagation="true">
