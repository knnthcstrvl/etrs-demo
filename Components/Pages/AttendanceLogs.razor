    private RenderFragment MovPreviewContent => builder =>
    {
        var sequence = 0;
        var urls = SplitMovUrls(movPreviewUrl).ToList();
        if (urls.Count == 0)
        {
            return;
        }

        var currentIndex = Math.Clamp(movImagePreviewIndex, 0, urls.Count - 1);
        var currentUrl = urls[currentIndex];

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "attendance-mov-image-card");
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "attendance-detail-label");
        builder.AddContent(sequence++, urls.Count == 1
            ? GetMovFileName(currentUrl)
            : $"{GetMovFileName(currentUrl)} ({currentIndex + 1} of {urls.Count})");
        builder.CloseElement();
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "attendance-mov-image-frame");

        if (IsPdfUrl(currentUrl))
        {
            builder.OpenElement(sequence++, "iframe");
            builder.AddAttribute(sequence++, "class", "attendance-mov-preview-frame");
            builder.AddAttribute(sequence++, "src", BuildPdfPreviewUrl(currentUrl));
            builder.AddAttribute(sequence++, "title", $"PDF preview: {GetMovFileName(currentUrl)}");
            builder.CloseElement();
        }
        else if (IsImageUrl(currentUrl))
        {
            builder.OpenElement(sequence++, "img");
            builder.AddAttribute(sequence++, "class", "attendance-mov-preview-image");
            builder.AddAttribute(sequence++, "src", currentUrl);
            builder.AddAttribute(sequence++, "alt", $"Means of verification: {GetMovFileName(currentUrl)}");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "attendance-mov-preview-fallback");
            builder.OpenElement(sequence++, "p");
            builder.AddContent(sequence++, $"{GetMovFileType(currentUrl)}: {GetMovFileName(currentUrl)}");
            builder.CloseElement();
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "href", currentUrl);
            builder.AddAttribute(sequence++, "target", "_blank");
            builder.AddAttribute(sequence++, "rel", "noopener noreferrer");
            builder.AddContent(sequence++, "Open file");
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();

        if (urls.Count > 1)
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "attendance-mov-image-navigation");
            AddMovImageNavigationButton(builder, ref sequence, "fa-solid fa-chevron-left", "Previous file", ShowPreviousMovFile);
            AddMovImageNavigationButton(builder, ref sequence, "fa-solid fa-chevron-right", "Next file", ShowNextMovFile);
            builder.CloseElement();
        }

        builder.CloseElement();
