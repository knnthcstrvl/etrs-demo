@page "/attendance-logs"
@using Components.Shared
@using Financial.Data
@inject Financial.Services.CurrentUserService CurrentUser
@using Financial.Model.Dtr
@using Microsoft.EntityFrameworkCore
@inject ProcurementDbContext Db
@inject IJSRuntime JS

@rendermode InteractiveServer

<RequireAccess RequiredAccess=@(new string[] { "View", "Export", "Edit", "Import" })>
    <div class="dashboard-shell">
    <div class="panel-heading attendance-logs-heading">
        <div>
            <h1 class="attendance-logs-title">Attendance Logs</h1>
        </div>
        <button type="button" class="btn btn-outline-secondary attendance-logs-export-btn" @onclick="ExportAttendanceLogsAsync" disabled=@(!CurrentUser.HasAccess("Export"))>Export</button>
    </div>

    <div class="metric-grid dashboard-metrics attendance-logs-metrics">
        <div class="metric-card">
            <span class="metric-label">Onsite</span>
            <strong>@onsiteLogs.Count</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">WFH Tagged</span>
            <strong>@wfhTaggedCount</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Employees</span>
            <strong>@employeeCount</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Exceptions Today</span>
            <strong>@exceptionTodayCount</strong>
        </div>
    </div>

    <div style="margin-top:1rem;">
        <div style="display:flex;justify-content:flex-start;align-items:center;margin-bottom:0.6rem;gap:0.5rem;">
            <button class='btn @(viewMode=="onsite"?"btn-primary":"btn-outline-secondary")' @onclick='() => viewMode = "onsite"'>Onsite (Biometric)</button>
            <button class='btn @(viewMode=="wfh"?"btn-primary":"btn-outline-secondary")' @onclick='() => viewMode = "wfh"'>WFH (ETRS)</button>
        </div>

        <div class="panel-card attendance-table-card">
            @if (viewMode == "onsite")
            {
                <table class="table attendance-table attendance-table-onsite">
                    <thead style="background:var(--finance-surface-soft);border-bottom:1px solid var(--finance-border);">
                        <tr>
                            <th>ID Number</th>
                            <th>Employee</th>
                            <th>Division / Unit</th>
                            <th>Designation</th>
                            <th>AM</th>
                            <th>PM</th>
                            <th>Tardiness</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in PagedOnsiteLogs)
                        {
                            <tr>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.IdNumber)">@DisplayValue(log.IdNumber)</span></td>
                                <td><span class="cell-ellipsis" title="@FormatName(log.LastName, log.FirstName, log.MiddleName)">@FormatName(log.LastName, log.FirstName, log.MiddleName)</span></td>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.DivisionCenterUnit)">@DisplayValue(log.DivisionCenterUnit)</span></td>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.Designation)">@DisplayValue(log.Designation)</span></td>
                                <td class="time-cell"><span class="cell-ellipsis" title="@FormatTimeRange(log.TimeInAm, log.TimeOutAm)">@FormatTimeRange(log.TimeInAm, log.TimeOutAm)</span></td>
                                <td class="time-cell"><span class="cell-ellipsis" title="@FormatTimeRange(log.TimeInPm, log.TimeOutPm)">@FormatTimeRange(log.TimeInPm, log.TimeOutPm)</span></td>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.Tardiness)">@DisplayValue(log.Tardiness)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table class="table attendance-table attendance-table-wfh">
                    <thead style="background:var(--finance-surface-soft);border-bottom:1px solid var(--finance-border);">
                        <tr>
                            <th>ID Number</th>
                            <th>Employee</th>
                            <th>Division / Unit</th>
                            <th>Designation</th>
                            <th>Target</th>
                            <th>Accomplishment</th>
                            <th>MOV</th>
                            <th>Arrangement</th>
                            <th>Status</th>
                            <th>Time In</th>
                            <th>Time Out</th>
                            <th>Tardiness</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in PagedWfhLogs)
                        {
                            <tr>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.IdNumber)">@DisplayValue(log.IdNumber)</span></td>
                                <td><span class="cell-ellipsis" title="@FormatName(log.LastName, log.FirstName, log.MiddleName)">@FormatName(log.LastName, log.FirstName, log.MiddleName)</span></td>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.DivisionCenterUnit)">@DisplayValue(log.DivisionCenterUnit)</span></td>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.Designation)">@DisplayValue(log.Designation)</span></td>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.Target)">@DisplayValue(log.Target)</span></td>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.Accomplishment)">@DisplayValue(log.Accomplishment)</span></td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(log.Mov))
                                    {
                                        <span class="cell-ellipsis" title="-">-</span>
                                    }
                                    else
                                    {
                                        <a class="cell-ellipsis" href="@log.Mov" target="_blank" title="@log.Mov">View File</a>
                                    }
                                </td>
                                <td><span class="cell-ellipsis" title="@GetWorkArrangement(log)">@GetWorkArrangement(log)</span></td>
                                <td><span class="cell-ellipsis" title="@GetWfhAttendanceStatus(log)">@GetWfhAttendanceStatus(log)</span></td>
                                <td class="time-cell"><span class="cell-ellipsis" title="@FormatTime(log.TimeIn)">@FormatTime(log.TimeIn)</span></td>
                                <td class="time-cell"><span class="cell-ellipsis" title="@FormatTime(log.TimeOut)">@FormatTime(log.TimeOut)</span></td>
                                <td><span class="cell-ellipsis" title="@DisplayValue(log.Tardiness)">@DisplayValue(log.Tardiness)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        @if (viewMode == "onsite")
        {
            <div class="table-footer">
                <div class="table-entries">@GetEntriesText(onsiteLogs.Count, onsitePage)</div>
                <div class="table-pagination">
                    <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangeOnsitePage(onsitePage - 1)" disabled="@(onsitePage <= 1)">&#8249;</button>
                    @foreach (var pageItem in BuildPageItems(OnsiteTotalPages, onsitePage))
                    {
                        if (pageItem.HasValue)
                        {
                            <button type="button" class="table-page-btn @(pageItem.Value == onsitePage ? "active" : null)" @onclick="() => ChangeOnsitePage(pageItem.Value)">@pageItem.Value</button>
                        }
                        else
                        {
                            <span class="table-page-ellipsis">...</span>
                        }
                    }
                    <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangeOnsitePage(onsitePage + 1)" disabled="@(onsitePage >= OnsiteTotalPages)">&#8250;</button>
                </div>
            </div>
        }
        else
        {
            <div class="table-footer">
                <div class="table-entries">@GetEntriesText(wfhLogs.Count, wfhPage)</div>
                <div class="table-pagination">
                    <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangeWfhPage(wfhPage - 1)" disabled="@(wfhPage <= 1)">&#8249;</button>
                    @foreach (var pageItem in BuildPageItems(WfhTotalPages, wfhPage))
                    {
                        if (pageItem.HasValue)
                        {
                            <button type="button" class="table-page-btn @(pageItem.Value == wfhPage ? "active" : null)" @onclick="() => ChangeWfhPage(pageItem.Value)">@pageItem.Value</button>
                        }
                        else
                        {
                            <span class="table-page-ellipsis">...</span>
                        }
                    }
                    <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangeWfhPage(wfhPage + 1)" disabled="@(wfhPage >= WfhTotalPages)">&#8250;</button>
                </div>
            </div>
        }
    </div>
</div>
</RequireAccess>

<style>
    .attendance-logs-title {
        font-size: 1.45rem;
    }

    .attendance-logs-export-btn {
        align-self: center;
        white-space: nowrap;
    }

    .attendance-table-card {
        padding: 1rem;
        overflow-x: auto;
    }

    .attendance-table {
        width: max-content;
        min-width: 100%;
        margin: 0;
        border-collapse: collapse;
        table-layout: auto;
    }

    .attendance-table thead {
        background: var(--finance-surface-soft);
        border-bottom: 1px solid var(--finance-border);
    }

    .attendance-table th,
    .attendance-table td {
        padding: 0.85rem 0.75rem;
        vertical-align: top;
        white-space: nowrap;
    }

    .attendance-table th {
        min-width: 8rem;
    }

    .attendance-table .cell-ellipsis {
        display: block;
        max-width: 18rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .attendance-table tbody tr {
        border-bottom: 1px solid var(--finance-border-soft);
    }

    .attendance-table .time-cell {
        min-width: 10rem;
    }

    .attendance-table .time-cell .cell-ellipsis {
        max-width: 11rem;
    }
</style>

@code {
    private const int PageSize = 10;
    private string viewMode = "onsite";
    private int employeeCount;
    private int wfhTaggedCount;
    private int exceptionTodayCount;
    private List<AttendanceLog> onsiteLogs = new();
    private List<AttendanceLogWfh> wfhLogs = new();
    private int onsitePage = 1;
    private int wfhPage = 1;

    private IEnumerable<AttendanceLog> PagedOnsiteLogs => onsiteLogs
        .Skip((onsitePage - 1) * PageSize)
        .Take(PageSize);

    private IEnumerable<AttendanceLogWfh> PagedWfhLogs => wfhLogs
        .Skip((wfhPage - 1) * PageSize)
        .Take(PageSize);

    private int OnsiteTotalPages => Math.Max(1, (int)Math.Ceiling(onsiteLogs.Count / (double)PageSize));
    private int WfhTotalPages => Math.Max(1, (int)Math.Ceiling(wfhLogs.Count / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        employeeCount = await Db.Employees.CountAsync();

        onsiteLogs = await Db.AttendanceLogs
            .AsNoTracking()
            .OrderByDescending(l => l.AttendanceDate)
            .ThenBy(l => l.LastName)
            .ThenBy(l => l.FirstName)
            .ToListAsync();

        wfhLogs = await Db.AttendanceLogsWfh
            .AsNoTracking()
            .Include(l => l.ExceptionCondition)
            .OrderByDescending(l => l.AttendanceDate)
            .ThenBy(l => l.LastName)
            .ThenBy(l => l.FirstName)
            .ToListAsync();

        wfhTaggedCount = wfhLogs.Count(l => string.Equals(GetWorkArrangement(l), "WFH", StringComparison.OrdinalIgnoreCase));
        exceptionTodayCount = wfhLogs.Count(l =>
            l.AttendanceDate == DateTime.Today &&
            !string.Equals(GetWorkArrangement(l), "WFH", StringComparison.OrdinalIgnoreCase));

        // Compute tardiness/absent labels in-memory according to rules
        foreach (var log in wfhLogs)
        {
            log.Tardiness = ComputeTardinessForWfh(log);
        }

        foreach (var log in onsiteLogs)
        {
            log.Tardiness = ComputeTardinessForOnsite(log);
        }
    }

    private static string FormatName(string lastName, string firstName, string middleName)
    {
        var middleInitial = string.IsNullOrWhiteSpace(middleName) ? string.Empty : $" {middleName.Trim()[0]}.";
        return $"{lastName}, {firstName}{middleInitial}";
    }

    private static string FormatTime(DateTime? value) => value?.ToString("MMM dd, yyyy\nhh:mm tt") ?? "-";

    private static string FormatTimeRange(DateTime? start, DateTime? end)
        => $"{(start?.ToString("hh:mm tt") ?? "-")} / {(end?.ToString("hh:mm tt") ?? "-")}";

    private void ChangeOnsitePage(int page)
    {
        onsitePage = Math.Clamp(page, 1, OnsiteTotalPages);
    }

    private void ChangeWfhPage(int page)
    {
        wfhPage = Math.Clamp(page, 1, WfhTotalPages);
    }

    private static string GetEntriesText(int totalCount, int currentPage)
    {
        if (totalCount == 0)
        {
            return "Showing 0 to 0 of 0 entries";
        }

        var start = ((currentPage - 1) * PageSize) + 1;
        var end = Math.Min(currentPage * PageSize, totalCount);
        return $"Showing {start} to {end} of {totalCount} entries";
    }

    private static IEnumerable<int?> BuildPageItems(int totalPages, int currentPage)
    {
        if (totalPages <= 7)
        {
            for (var page = 1; page <= totalPages; page++)
            {
                yield return page;
            }

            yield break;
        }

        yield return 1;

        if (currentPage > 3)
        {
            yield return null;
        }

        for (var page = Math.Max(2, currentPage - 1); page <= Math.Min(totalPages - 1, currentPage + 1); page++)
        {
            yield return page;
        }

        if (currentPage < totalPages - 2)
        {
            yield return null;
        }

        yield return totalPages;
    }

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetWorkArrangement(AttendanceLogWfh log)
        => !string.IsNullOrWhiteSpace(log.ExceptionCondition?.ConditionName)
            ? log.ExceptionCondition.ConditionName
            : string.IsNullOrWhiteSpace(log.WorkArrangement) ? "WFH" : log.WorkArrangement;

    private static string GetWfhAttendanceStatus(AttendanceLogWfh log)
    {
        var arrangement = GetWorkArrangement(log);
        if (!string.Equals(arrangement, "WFH", StringComparison.OrdinalIgnoreCase))
        {
            return "Exception";
        }

        if (!log.TimeIn.HasValue && !log.TimeOut.HasValue)
        {
            return "Tagged";
        }

        if (!log.TimeIn.HasValue || !log.TimeOut.HasValue)
        {
            return "Incomplete";
        }

        return "Submitted";
    }

    // --- Tardiness calculation helpers ---
    private static string ComputeTardinessForWfh(AttendanceLogWfh log)
    {
        if (!string.Equals(GetWorkArrangement(log), "WFH", StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        if (!log.TimeIn.HasValue || !log.TimeOut.HasValue)
        {
            return string.Empty;
        }

        var date = log.AttendanceDate.Date;
        var timeIn = log.TimeIn.Value;

        // Only consider morning in window for tardiness
        var sevenAm = date.AddHours(7);
        var eightAm = date.AddHours(8);

        // Any log before 7:00 treated as 7:00
        if (timeIn < sevenAm) timeIn = sevenAm;

        // If within flexible window 7:00 - 8:00 => not late
        if (timeIn >= sevenAm && timeIn <= eightAm)
        {
            return string.Empty; // show as '-' in UI
        }

        // Late if strictly after 8:00:00
        if (timeIn > eightAm)
        {
            var diff = timeIn - eightAm;
            return FormatLateSpan(diff);
        }

        return string.Empty;
    }

    private static string ComputeTardinessForOnsite(AttendanceLog log)
    {
        // Determine morning in candidate
        var date = log.AttendanceDate.Date;

        var timeInAm = log.TimeInAm;
        var timeInPm = log.TimeInPm;

        // Absent if no in times recorded for the day
        if (!timeInAm.HasValue && !timeInPm.HasValue)
        {
            return "Absent";
        }

        // Half-Day AM: TimeInAm exists and TimeOutAm recorded between 12:00 and 13:00
        if (timeInAm.HasValue && log.TimeOutAm.HasValue)
        {
            var outAm = log.TimeOutAm.Value.TimeOfDay;
            if (outAm >= TimeSpan.FromHours(12) && outAm <= TimeSpan.FromHours(13))
            {
                return "Half-Day (AM)";
            }
        }

        // Half-Day PM: TimeInPm at or after 13:00 and TimeOutPm at 17:00
        if (timeInPm.HasValue && log.TimeOutPm.HasValue)
        {
            var inPm = timeInPm.Value.TimeOfDay;
            var outPm = log.TimeOutPm.Value.TimeOfDay;
            if (inPm >= TimeSpan.FromHours(13) && outPm == TimeSpan.FromHours(17))
            {
                return "Half-Day (PM)";
            }
        }

        // Use AM time if available for tardiness calculation, otherwise use first available timeIn
        var timeIn = timeInAm ?? timeInPm!.Value;

        var sevenAm = date.AddHours(7);
        var eightAm = date.AddHours(8);

        if (timeIn < sevenAm) timeIn = sevenAm;

        if (timeIn >= sevenAm && timeIn <= eightAm)
        {
            return string.Empty;
        }

        if (timeIn > eightAm)
        {
            var diff = timeIn - eightAm;
            return FormatLateSpan(diff);
        }

        return string.Empty;
    }

    private static string FormatLateSpan(TimeSpan diff)
    {
        // Round up seconds to minutes (any seconds > 0 counts as next minute)
        var totalMinutes = (int)Math.Ceiling(diff.TotalSeconds / 60.0);
        if (totalMinutes <= 0) totalMinutes = 1;

        if (totalMinutes < 60)
        {
            return totalMinutes == 1 ? "1min late" : $"{totalMinutes}mins late";
        }

        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;

        var hourPart = hours == 1 ? "1hr" : $"{hours}hrs";
        if (minutes == 0)
            return $"{hourPart} late";

        var minutePart = minutes == 1 ? "1min" : $"{minutes}mins";
        return $"{hourPart} and {minutePart} late";
    }

    private async Task ExportAttendanceLogsAsync()
    {
        var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");

        var onsiteCsv = BuildOnsiteCsv();
        var wfhCsv = BuildWfhCsv();

        await JS.InvokeVoidAsync("attendanceLogs.downloadCsv", $"attendance_logs_onsite_{timestamp}.csv", onsiteCsv);
        await JS.InvokeVoidAsync("attendanceLogs.downloadCsv", $"attendance_logs_wfh_{timestamp}.csv", wfhCsv);
    }

    private string BuildOnsiteCsv()
    {
        var rows = new List<string>
        {
            string.Join(",", new[]
            {
                "AttendanceLogId",
                "EmployeeId",
                "BiometricDeviceId",
                "IdNumber",
                "LastName",
                "FirstName",
                "MiddleName",
                "DivisionCenterUnit",
                "Designation",
                "TimeInAm",
                "TimeOutAm",
                "TimeInPm",
                "TimeOutPm",
                "Tardiness",
                "AttendanceDate"
            })
        };

        rows.AddRange(onsiteLogs.Select(log => string.Join(",", new[]
        {
            CsvValue(log.AttendanceLogId),
            CsvValue(log.EmployeeId),
            CsvValue(log.BiometricDeviceId),
            CsvValue(log.IdNumber),
            CsvValue(log.LastName),
            CsvValue(log.FirstName),
            CsvValue(log.MiddleName),
            CsvValue(log.DivisionCenterUnit),
            CsvValue(log.Designation),
            CsvValue(log.TimeInAm),
            CsvValue(log.TimeOutAm),
            CsvValue(log.TimeInPm),
            CsvValue(log.TimeOutPm),
            CsvValue(log.Tardiness),
            CsvValue(log.AttendanceDate)
        })));

        return string.Join(Environment.NewLine, rows);
    }

    private string BuildWfhCsv()
    {
        var rows = new List<string>
        {
            string.Join(",", new[]
            {
                "AttendanceLogWfhId",
                "EmployeeId",
                "IdNumber",
                "LastName",
                "FirstName",
                "MiddleName",
                "DivisionCenterUnit",
                "Designation",
                "Target",
                "Accomplishment",
                "Mov",
                "WorkArrangement",
                "AttendanceStatus",
                "TimeIn",
                "TimeOut",
                "Tardiness",
                "AttendanceDate"
            })
        };

        rows.AddRange(wfhLogs.Select(log => string.Join(",", new[]
        {
            CsvValue(log.AttendanceLogWfhId),
            CsvValue(log.EmployeeId),
            CsvValue(log.IdNumber),
            CsvValue(log.LastName),
            CsvValue(log.FirstName),
            CsvValue(log.MiddleName),
            CsvValue(log.DivisionCenterUnit),
            CsvValue(log.Designation),
            CsvValue(log.Target),
            CsvValue(log.Accomplishment),
            CsvValue(log.Mov),
            CsvValue(GetWorkArrangement(log)),
            CsvValue(GetWfhAttendanceStatus(log)),
            CsvValue(log.TimeIn),
            CsvValue(log.TimeOut),
            CsvValue(log.Tardiness),
            CsvValue(log.AttendanceDate)
        })));

        return string.Join(Environment.NewLine, rows);
    }

    private static string CsvValue(object? value)
    {
        if (value is null)
        {
            return "\"\"";
        }

        var text = value switch
        {
            DateTime dateTime => dateTime.ToString("yyyy-MM-dd HH:mm:ss"),
            DateTimeOffset dateTimeOffset => dateTimeOffset.ToString("yyyy-MM-dd HH:mm:ss zzz"),
            _ => value.ToString() ?? string.Empty
        };

        return $"\"{text.Replace("\"", "\"\"")}\"";
    }

}
