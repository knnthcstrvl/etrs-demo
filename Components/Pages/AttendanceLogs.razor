    private void BuildPeriods(DateTime now)
    {
        periods.Clear();
        var startMonth = new DateTime(2026, 3, 1);
        var currentMonth = new DateTime(now.Year, now.Month, 1);

        for (var month = startMonth; month <= currentMonth; month = month.AddMonths(1))
        {
            var firstStart = new DateTime(month.Year, month.Month, 1);
            var firstEnd = firstStart.AddDays(14); // 1-15
            var secondStart = firstStart.AddDays(15); // 16th
            var secondEnd = new DateTime(month.Year, month.Month, DateTime.DaysInMonth(month.Year, month.Month));

            var p1 = new Period
            {
                Start = firstStart,
                End = firstEnd,
                Label = $"{firstStart:MMM dd} - {firstEnd:dd}, {firstEnd:yyyy}",
                IsCurrent = now.Date >= firstStart.Date && now.Date <= firstEnd.Date
            };

            var p2 = new Period
            {
                Start = secondStart,
                End = secondEnd,
                Label = $"{secondStart:MMM dd} - {secondEnd:dd}, {secondEnd:yyyy}",
                IsCurrent = now.Date >= secondStart.Date && now.Date <= secondEnd.Date
            };

            periods.Add(p1);
            periods.Add(p2);
        }
    }

    private static (DateTime Start, DateTime End) GetCurrentCutoffRange(DateTime now)
    {
        var startOfMonth = new DateTime(now.Year, now.Month, 1);
        var fifteenth = startOfMonth.AddDays(14); // 1 + 14 = 15th
        if (now.Date <= fifteenth.Date)
        {
            return (startOfMonth.Date, fifteenth.Date);
        }

        var lastDay = new DateTime(now.Year, now.Month, DateTime.DaysInMonth(now.Year, now.Month));
        return (startOfMonth.AddDays(15).Date, lastDay.Date);
    }

