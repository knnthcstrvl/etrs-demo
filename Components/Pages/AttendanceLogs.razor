                                        <div class="attendance-input-field">
                                            <span class="attendance-detail-label">Time Out</span>
                                            <input type="time" class="form-control attendance-input-control" value="@inputForm.WfhTimeOut" @onchange='e => UpdateTimeField(value => inputForm.WfhTimeOut = value, e)' />
