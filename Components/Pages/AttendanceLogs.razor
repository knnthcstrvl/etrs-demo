    private async Task CloseMovPreviewWithDetailAsync()
    {
        if (!showMovPreviewWithAttendanceDetail && !showMovPreviewWithEditLog)
        {
            CloseMovPreview();
            return;
        }

        var closeVersion = ++movPreviewOpenVersion;
        isClosingMovPreview = showMovPreviewModal;
        showMovPreviewModal = false;

        await InvokeAsync(StateHasChanged);

        if (isClosingMovPreview)
        {
            await Task.Delay(220);
        }

        if (closeVersion != movPreviewOpenVersion)
        {
            return;
        }

        isClosingMovPreview = false;
        isRestoringAttendanceDetail = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(260);

        if (closeVersion != movPreviewOpenVersion)
        {
            return;
        }

        isRestoringAttendanceDetail = false;
        suppressAttendanceDetailEnterAnimation = true;
        showMovPreviewWithAttendanceDetail = false;
        showMovPreviewWithEditLog = false;
        movPreviewUrl = string.Empty;
        movImagePreviewIndex = 0;
        movPreviewTitle = string.Empty;
        ClearPhotoVerificationPreview();
        sidecarPreviewMode = SidecarPreviewMode.Mov;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);

        if (closeVersion != movPreviewOpenVersion)
        {
            return;
        }

        suppressAttendanceDetailEnterAnimation = false;
        await InvokeAsync(StateHasChanged);
    }

