                                            <span class="attendance-detail-label">Time In</span>
                                            <input type="time" class="form-control attendance-input-control" value="@inputForm.WfhTimeIn" @onchange='e => UpdateTimeField(value => inputForm.WfhTimeIn = value, e)' />
