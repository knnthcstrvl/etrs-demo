@page "/dashboard"
@using Financial.Data
@using Financial.Model.Dtr
@using Microsoft.EntityFrameworkCore
@inject ProcurementDbContext Db

<PageTitle>DTR Dashboard</PageTitle>

<div class="dashboard-shell">
    <div class="dashboard-hero hero-course">
        <div class="hero-left">
            <div class="hero-label">Welcome</div>
            <h1>ETR Dashboard</h1>
        </div>
        <!-- decorative/right column is part of background image -->
        <div class="hero-right" aria-hidden="true"></div>
    </div>

    <div class="metric-grid dashboard-metrics">
        <div class="metric-card">
            <span class="metric-label">Active Employees</span>
            <strong>@activeEmployees</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Today Logs</span>
            <strong>@todayLogs</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Open Exceptions</span>
            <strong>@openIssues</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Online Devices</span>
            <strong>@onlineDevices / @totalDevices</strong>
        </div>
    </div>

    <div class="dashboard-grid">
        <section class="panel-card">
            <div class="panel-heading">
                <h2>Recent Attendance Logs</h2>
                <span>Last @recentLogs.Count records</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Log</th>
                            <th>Device</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in recentLogs)
                        {
                            <tr>
                                <td>@log.Employee.EmployeeNumber - @log.Employee.FirstName @log.Employee.LastName</td>
                                <td>@log.LogType on @log.LogTime.ToString("MMM dd, yyyy hh:mm tt")</td>
                                <td>@(log.BiometricDevice?.DeviceName ?? "Pending device")</td>
                                <td><span class="status-badge @(log.IsSynced ? "status-ok" : "status-warning")">@(log.IsSynced ? "Synced" : "Pending")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-heading">
                <h2>Exception Queue</h2>
                <span>Needs review before payroll cutoff</span>
            </div>
            @foreach (var issue in issueQueue)
            {
                <div class="issue-row">
                    <div>
                        <strong>@issue.IssueType</strong>
                        <div>@issue.Employee.FirstName @issue.Employee.LastName • @issue.AttendanceDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="text-end">
                        <span class="status-badge status-warning">@issue.Status</span>
                        <div class="text-muted small">@issue.Remarks</div>
                    </div>
                </div>
            }
        </section>

        <section class="panel-card">
            <div class="panel-heading">
                <h2>Biometric Devices</h2>
                <span>Current sync health</span>
            </div>
            @foreach (var device in devices)
            {
                <div class="device-row">
                    <div>
                        <strong>@device.DeviceName</strong>
                        <div>@device.Location • @device.IpAddress</div>
                    </div>
                    <div class="text-end">
                        <span class="status-badge @(device.IsOnline ? "status-ok" : "status-danger")">@device.SyncStatus</span>
                        <div class="text-muted small">@(device.LastSyncedAt?.ToString("MMM dd, yyyy hh:mm tt") ?? "No sync yet")</div>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private int activeEmployees;
    private int todayLogs;
    private int openIssues;
    private int onlineDevices;
    private int totalDevices;
    private List<AttendanceLog> recentLogs = new();
    private List<AttendanceIssue> issueQueue = new();
    private List<BiometricDevice> devices = new();

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;

        activeEmployees = await Db.Employees.CountAsync(e => e.IsActive);
        todayLogs = await Db.AttendanceLogs.CountAsync(l => l.LogTime.Date == today);
        openIssues = await Db.AttendanceIssues.CountAsync(i => i.Status != "Closed");
        totalDevices = await Db.BiometricDevices.CountAsync();
        onlineDevices = await Db.BiometricDevices.CountAsync(d => d.IsOnline);

        recentLogs = await Db.AttendanceLogs
            .AsNoTracking()
            .Include(l => l.Employee)
            .Include(l => l.BiometricDevice)
            .OrderByDescending(l => l.LogTime)
            .Take(6)
            .ToListAsync();

        issueQueue = await Db.AttendanceIssues
            .AsNoTracking()
            .Include(i => i.Employee)
            .OrderByDescending(i => i.AttendanceDate)
            .ThenBy(i => i.Status)
            .Take(4)
            .ToListAsync();

        devices = await Db.BiometricDevices
            .AsNoTracking()
            .OrderByDescending(d => d.IsOnline)
            .ThenBy(d => d.DeviceName)
            .ToListAsync();
    }
}
