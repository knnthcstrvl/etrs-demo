    private async Task RefreshAvailablePeriodsAsync(bool preserveSelections = true)
    {
        var previous = preserveSelections ? selectedPeriod : null;
        var previousSecond = preserveSelections ? secondSelectedPeriod : null;
        var previousExport = preserveSelections ? exportSelectedPeriod : null;
        var previousExportSecond = preserveSelections ? exportSecondSelectedPeriod : null;
        var datesOnsite = await Db.AttendanceLogs
            .AsNoTracking()
            .Select(l => l.AttendanceDate)
            .Distinct()
            .ToListAsync();

        var datesWfh = await Db.AttendanceLogsWfh
            .AsNoTracking()
            .Where(l => l.TimeIn.HasValue || l.TimeOut.HasValue || !string.IsNullOrWhiteSpace(l.Target) || !string.IsNullOrWhiteSpace(l.Accomplishment) || !string.IsNullOrWhiteSpace(l.Mov))
            .Select(l => l.AttendanceDate)
            .Distinct()
            .ToListAsync();

        periods = datesOnsite.Concat(datesWfh)
            .Select(d => BuildPeriodForDate(d.Date, DateTime.Today))
            .GroupBy(p => new { p.Start, p.End })
            .Select(g => g.First())
            .OrderBy(p => p.Start)
            .ToList();

        if (!preserveSelections || periods.Count == 0)
        {
            selectedPeriod = periods.FirstOrDefault(p => p.IsCurrent) ?? periods.LastOrDefault();
            secondSelectedPeriod = null;
            exportSelectedPeriod = null;
            exportSecondSelectedPeriod = null;
            showAddPeriod = false;
            showExportAddPeriod = false;
            if (selectedPeriod != null)
            {
                ApplySelectedPeriodRange();
            }
            return;
        }

        if (previous != null)
        {
            selectedPeriod = periods.FirstOrDefault(p => p.Start.Date == previous.Start.Date && p.End.Date == previous.End.Date)
                ?? periods.FirstOrDefault(p => p.IsCurrent) ?? periods.LastOrDefault();
        }

        secondSelectedPeriod = FindMatchingPeriod(previousSecond);
        exportSelectedPeriod = FindMatchingPeriod(previousExport);
        exportSecondSelectedPeriod = FindMatchingPeriod(previousExportSecond);

        if (selectedPeriod is null)
        {
            selectedPeriod = periods.FirstOrDefault(p => p.IsCurrent) ?? periods.LastOrDefault();
        }

        NormalizeSelectedPeriods();
        NormalizeSelectedPeriods(ref exportSelectedPeriod, ref exportSecondSelectedPeriod);
        showAddPeriod = secondSelectedPeriod is not null;
        showExportAddPeriod = exportSecondSelectedPeriod is not null;
        ApplySelectedPeriodRange();
    }

    private Period? FindMatchingPeriod(Period? period)
        => period is null
            ? null
            : periods.FirstOrDefault(p => p.Start.Date == period.Start.Date && p.End.Date == period.End.Date);

    private static Period BuildPeriodForDate(DateTime date, DateTime now)
    {
        var start = date.Day <= 15
            ? new DateTime(date.Year, date.Month, 1)
            : new DateTime(date.Year, date.Month, 16);
        var end = date.Day <= 15
            ? new DateTime(date.Year, date.Month, 15)
            : new DateTime(date.Year, date.Month, DateTime.DaysInMonth(date.Year, date.Month));

        return new Period
        {
            Start = start,
            End = end,
            Label = $"{start:MMM dd} - {end:dd}, {end:yyyy}",
            IsCurrent = now.Date >= start.Date && now.Date <= end.Date
        };
    }

    private async Task LoadRecentLogsAsync()
    {
        if (filterStart == default || filterEnd == default)
        {
            ApplySelectedPeriodRange();
        }

        if (filterStart > filterEnd)
        {
            (filterStart, filterEnd) = (filterEnd, filterStart);
        }

        var start = filterStart == default ? DateTime.Today : filterStart.Date;
        var endExclusive = (filterEnd == default ? DateTime.Today : filterEnd.Date).AddDays(1);

        employeeCount = await Db.Employees.CountAsync();
        onsiteLogsToday = await Db.AttendanceLogs.CountAsync(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive);
        wfhLogsToday = await Db.AttendanceLogsWfh.CountAsync(l =>
            l.AttendanceDate >= start && l.AttendanceDate < endExclusive &&
            (l.TimeIn.HasValue || l.TimeOut.HasValue));

        recentOnsiteLogs = await Db.AttendanceLogs
            .AsNoTracking()
            .Where(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .OrderByDescending(l => l.AttendanceDate)
            .ThenBy(l => l.LastName)
            .Take(5)
            .ToListAsync();

        recentWfhLogs = await Db.AttendanceLogsWfh
            .AsNoTracking()
            .Where(l => (l.TimeIn.HasValue || l.TimeOut.HasValue) && l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .OrderByDescending(l => l.AttendanceDate)
            .ThenBy(l => l.LastName)
            .Take(5)
            .ToListAsync();

        await LoadLateUndertimeChartAsync(start, endExclusive);
        await LoadDivisionPieAsync(start, endExclusive);
        dashboardChartsRenderPending = true;
    }

    private async Task LoadLateUndertimeChartAsync(DateTime start, DateTime endExclusive)
    {
        var onsiteLogs = await Db.AttendanceLogs
            .AsNoTracking()
            .Include(l => l.Employee)
            .Where(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .ToListAsync();

        var wfhLogs = await Db.AttendanceLogsWfh
            .AsNoTracking()
            .Include(l => l.Employee)
            .Include(l => l.ExceptionCondition)
            .Where(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .Where(l => l.TimeIn.HasValue || l.TimeOut.HasValue)
            .ToListAsync();

        var onsiteItems = onsiteLogs.Select(log =>
        {
            var resolvedTardiness = ResolveTardiness(log.Tardiness, () => ComputeTardinessForOnsite(log, ResolveEmployeeStatus(log)));
            return new LateUndertimeChartItem(
                log.AttendanceDate.Date,
                HasTardinessTag(resolvedTardiness, "late"),
                HasTardinessTag(resolvedTardiness, "undertime"));
        });

        var wfhItems = wfhLogs.Select(log =>
        {
            var resolvedTardiness = ResolveTardiness(log.Tardiness, () => ComputeTardinessForWfh(log, ResolveEmployeeStatus(log)));
            return new LateUndertimeChartItem(
                log.AttendanceDate.Date,
                HasTardinessTag(resolvedTardiness, "late"),
                HasTardinessTag(resolvedTardiness, "undertime"));
        });

        lateUndertimeChart = BuildLateUndertimeChart(onsiteItems.Concat(wfhItems), start, endExclusive);
        lateTotal = lateUndertimeChart.Sum(p => p.LateCount);
        undertimeTotal = lateUndertimeChart.Sum(p => p.UndertimeCount);
    }

    private static List<LateUndertimeChartPoint> BuildLateUndertimeChart(
        IEnumerable<LateUndertimeChartItem> items,
        DateTime start,
        DateTime endExclusive)
    {
        return items
            .Where(item => item.HasLate || item.HasUndertime)
            .Select(item => new
            {
                Item = item,
                Period = BuildPeriodForDate(item.Date, DateTime.Today)
            })
            .GroupBy(entry => new { entry.Period.Start, entry.Period.End, entry.Period.Label })
            .OrderBy(group => group.Key.Start)
            .Select(group => new LateUndertimeChartPoint
            {
                Label = FormatCompactPeriodLabel(group.Key.Start, group.Key.End),
                TooltipLabel = group.Key.Label,
                LateCount = group.Count(entry => entry.Item.HasLate),
                UndertimeCount = group.Count(entry => entry.Item.HasUndertime)
            })
            .ToList();
    }

    private static string FormatCompactPeriodLabel(DateTime start, DateTime end)
        => start.Month == end.Month && start.Year == end.Year
            ? $"{start:MMM d} - {end:d}"
            : $"{start:MMM d} - {end:MMM d}";

    private static bool HasTardinessTag(string? value, string tag)
        => !string.IsNullOrWhiteSpace(value)
            && value.Contains(tag, StringComparison.OrdinalIgnoreCase);

    private const string ManualTardinessPrefix = "[Manual] ";

    private static string ResolveEmployeeStatus(AttendanceLog log)
        => log.Employee?.Status ?? "Active";

    private static string ResolveEmployeeStatus(AttendanceLogWfh log)
        => log.Employee?.Status ?? "Active";

    private static string ResolveTardiness(string? savedValue, Func<string> computeValue)
        => IsManualTardinessOverride(savedValue)
            ? GetStoredTardinessDisplayValue(savedValue)
            : computeValue();

    private static bool IsManualTardinessOverride(string? value)
        => NormalizeTardiness(value).StartsWith(ManualTardinessPrefix, StringComparison.OrdinalIgnoreCase);

    private static string GetStoredTardinessDisplayValue(string? value)
    {
        var normalized = NormalizeTardiness(value);
        return normalized.StartsWith(ManualTardinessPrefix, StringComparison.OrdinalIgnoreCase)
            ? normalized[ManualTardinessPrefix.Length..].Trim()
            : normalized;
    }

    private static string NormalizeTardiness(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();

    private static string ComputeTardinessForWfh(AttendanceLogWfh log, string? employeeStatus)
    {
        if (!string.Equals(GetWorkArrangement(log), "WFH", StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        var date = log.AttendanceDate.Date;
        if (!log.TimeOut.HasValue)
        {
            return "Absent";
        }

        if (!log.TimeIn.HasValue)
        {
            return string.Empty;
        }

        if (IsMorningHalfDay(log.TimeIn, log.TimeOut, date, allowLunchWindowTimeOut: true))
        {
            return FormatHalfDayLateUndertime(
                "Half-Day (AM)",
                CalculateLateDuration(date, log.TimeIn.Value, employeeStatus),
                CalculateMorningHalfDayUndertime(date, log.TimeOut.Value));
        }

        if (IsAfternoonHalfDay(log.TimeIn, log.TimeOut))
        {
            return FormatHalfDayLateUndertime(
                "Half-Day (PM)",
                CalculateAfternoonHalfDayLate(date, log.TimeIn.Value),
                CalculateAfternoonHalfDayUndertime(date, log.TimeOut.Value, employeeStatus));
        }

        var late = CalculateLateDuration(date, log.TimeIn.Value, employeeStatus);
        var worked = CalculateWorkedDuration(new[] { (log.TimeIn, log.TimeOut) }, date);
        var undertime = CalculateUndertime(worked, late, date, log.TimeIn.Value, log.TimeOut, employeeStatus);

        return FormatLateUndertime(late, undertime);
    }

    private static string ComputeTardinessForOnsite(AttendanceLog log, string? employeeStatus)
    {
        var date = log.AttendanceDate.Date;
        var timeInAm = log.TimeInAm;
        var creditedTimeInPm = GetCreditedOnsiteTimeInPm(log);

        if (!log.TimeOutAm.HasValue && !log.TimeOutPm.HasValue)
        {
            return "Absent";
        }

        if (!timeInAm.HasValue && !creditedTimeInPm.HasValue)
        {
            return HasAnyOnsitePunch(log) ? "Incomplete" : "Absent";
        }

        if (!HasCompleteOnsiteMorning(timeInAm, log.TimeOutAm)
            && creditedTimeInPm is DateTime afternoonTimeIn
            && log.TimeOutPm is DateTime afternoonTimeOut
            && IsAfternoonHalfDay(creditedTimeInPm, log.TimeOutPm))
        {
            return FormatHalfDayLateUndertime(
                "Half-Day (PM)",
                CalculateAfternoonHalfDayLate(date, afternoonTimeIn),
                CalculateAfternoonHalfDayUndertime(date, afternoonTimeOut, employeeStatus));
        }

        if (IsOnsiteMorningOnlyHalfDay(timeInAm, log.TimeOutAm)
            && !HasCompleteOnsiteAfternoon(creditedTimeInPm, log.TimeOutPm))
        {
            return FormatHalfDayLateUndertime(
                "Half-Day (AM)",
                CalculateLateDuration(date, timeInAm!.Value, employeeStatus),
                CalculateMorningHalfDayUndertime(date, log.TimeOutAm!.Value));
        }

        if (HasIncompleteOnsitePunch(log, creditedTimeInPm))
        {
            return "Incomplete";
        }

        if (HasOpenOnsiteInterval(log) && DateTime.Now >= date.Date.AddDays(1).AddMinutes(-1))
        {
            return "Absent";
        }

        var timeIn = timeInAm ?? creditedTimeInPm!.Value;
        var late = CalculateLateDuration(date, timeIn, employeeStatus);
        if (HasOpenOnsiteInterval(log))
        {
            return FormatLateUndertime(late, TimeSpan.Zero);
        }

        var worked = CalculateWorkedDuration(new[]
        {
            (timeInAm, log.TimeOutAm),
            (creditedTimeInPm, log.TimeOutPm)
        }, date);
        var latestTimeOut = log.TimeOutPm ?? log.TimeOutAm;
        var undertime = CalculateUndertime(worked, late, date, timeIn, latestTimeOut, employeeStatus);
        var morningEarlyOutUndertime = CalculateMorningEarlyOutUndertime(date, timeInAm, log.TimeOutAm);
        if (morningEarlyOutUndertime > undertime)
        {
            undertime = morningEarlyOutUndertime;
        }

        return FormatLateUndertime(late, undertime);
    }

    private static readonly TimeSpan RequiredWorkDuration = TimeSpan.FromHours(8);

    private static string GetWorkArrangement(AttendanceLogWfh log)
        => !string.IsNullOrWhiteSpace(log.ExceptionCondition?.ConditionName)
            ? log.ExceptionCondition.ConditionName
            : string.IsNullOrWhiteSpace(log.WorkArrangement) ? "WFH" : log.WorkArrangement;

    private static TimeSpan CalculateLateDuration(DateTime date, DateTime actualTimeIn, string? employeeStatus)
    {
        var officialTimeIn = GetOfficialTimeIn(date, actualTimeIn);
        var lateThreshold = IsFixedEightAmEmployee(employeeStatus)
            ? date.AddHours(8)
            : date.AddHours(9);

        return officialTimeIn > lateThreshold
            ? CalculateDurationExcludingLunch(date, lateThreshold, officialTimeIn)
            : TimeSpan.Zero;
    }

    private static TimeSpan CalculateAfternoonHalfDayLate(DateTime date, DateTime actualTimeIn)
    {
        actualTimeIn = NormalizeAttendanceTime(date, actualTimeIn);
        var lateThreshold = date.AddHours(13);
        return actualTimeIn > lateThreshold
            ? actualTimeIn - lateThreshold
            : TimeSpan.Zero;
    }

    private static TimeSpan CalculateMorningHalfDayUndertime(DateTime date, DateTime actualTimeOut)
    {
        actualTimeOut = NormalizeAttendanceTime(date, actualTimeOut);
        if (actualTimeOut.TimeOfDay >= TimeSpan.FromHours(23)
            && actualTimeOut.TimeOfDay < TimeSpan.FromHours(24))
        {
            actualTimeOut = actualTimeOut.AddHours(-12);
        }

        var requiredOut = date.AddHours(12);
        return actualTimeOut < requiredOut
            ? requiredOut - actualTimeOut
            : TimeSpan.Zero;
    }

    private static TimeSpan CalculateMorningEarlyOutUndertime(DateTime date, DateTime? timeIn, DateTime? timeOut)
    {
        if (!timeIn.HasValue || !timeOut.HasValue)
        {
            return TimeSpan.Zero;
        }

        var timeInClock = timeIn.Value.TimeOfDay;
        var timeOutClock = timeOut.Value.TimeOfDay;
        var noon = TimeSpan.FromHours(12);

        if (timeInClock >= noon || timeOutClock >= noon || timeOutClock <= timeInClock)
        {
            return TimeSpan.Zero;
        }

        return noon - timeOutClock;
    }

    private static TimeSpan CalculateAfternoonHalfDayUndertime(DateTime date, DateTime actualTimeOut, string? employeeStatus)
    {
        actualTimeOut = NormalizeAttendanceTime(date, actualTimeOut);
        var requiredOut = IsFixedEightAmEmployee(employeeStatus)
            ? date.AddHours(17)
            : date.AddHours(18);
        return actualTimeOut < requiredOut
            ? requiredOut - actualTimeOut
            : TimeSpan.Zero;
    }

    private static DateTime GetOfficialTimeIn(DateTime date, DateTime actualTimeIn)
    {
        actualTimeIn = NormalizeAttendanceTime(date, actualTimeIn);
        var sevenAm = date.AddHours(7);
        return actualTimeIn < sevenAm ? sevenAm : actualTimeIn;
    }

    private static DateTime NormalizeAttendanceTime(DateTime date, DateTime value)
        => date.Date.Add(value.TimeOfDay);

    private static DateTime? GetCreditedOnsiteTimeInPm(AttendanceLog log)
    {
        if (log.TimeInPm.HasValue)
        {
            return log.TimeInPm;
        }

        var date = log.AttendanceDate.Date;
        if (!IsCreditableOnsiteAfternoonStart(log)
            || !log.TimeOutPm.HasValue
            || log.TimeOutPm.Value.TimeOfDay <= TimeSpan.FromHours(13))
        {
            return null;
        }

        return date.AddHours(13);
    }

    private static bool IsCreditableOnsiteAfternoonStart(AttendanceLog log)
    {
        if (!log.TimeOutAm.HasValue)
        {
            return false;
        }

        var timeOutClock = log.TimeOutAm.Value.TimeOfDay;
        if (timeOutClock > TimeSpan.FromHours(13))
        {
            return false;
        }

        return !log.TimeInAm.HasValue || timeOutClock > log.TimeInAm.Value.TimeOfDay;
    }

    private static bool IsFixedEightAmEmployee(string? employeeStatus)
    {
        if (string.IsNullOrWhiteSpace(employeeStatus))
        {
            return false;
        }

        var status = employeeStatus.Trim();
        return ContainsStatusToken(status, "COS")
            || ContainsStatusToken(status, "JO")
            || ContainsStatusToken(status, "Casual")
            || ContainsStatusToken(status, "Intern");
    }

    private static bool ContainsStatusToken(string value, string token)
        => value
            .Split(new[] { ' ', ',', '/', '-', ';', ':' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Any(part => string.Equals(part, token, StringComparison.OrdinalIgnoreCase));

    private static TimeSpan CalculateWorkedDuration(IEnumerable<(DateTime? Start, DateTime? End)> intervals, DateTime date)
    {
        var total = TimeSpan.Zero;

        foreach (var (startValue, endValue) in intervals)
        {
            if (!startValue.HasValue || !endValue.HasValue || endValue.Value <= startValue.Value)
            {
                continue;
            }

            var start = GetOfficialTimeIn(date, startValue.Value);
            var end = NormalizeAttendanceTime(date, endValue.Value);
            if (end <= start)
            {
                continue;
            }

            total += CalculateDurationExcludingLunch(date, start, end);
        }

        return total > RequiredWorkDuration ? RequiredWorkDuration : total;
    }

    private static TimeSpan CalculateDurationExcludingLunch(DateTime date, DateTime start, DateTime end)
    {
        start = NormalizeAttendanceTime(date, start);
        end = NormalizeAttendanceTime(date, end);

        if (end <= start)
        {
            return TimeSpan.Zero;
        }

        var duration = end - start;
        var lunchStart = date.AddHours(12);
        var lunchEnd = date.AddHours(13);
        var overlapStart = start > lunchStart ? start : lunchStart;
        var overlapEnd = end < lunchEnd ? end : lunchEnd;

        if (overlapEnd > overlapStart)
        {
            duration -= overlapEnd - overlapStart;
        }

        return duration > TimeSpan.Zero ? duration : TimeSpan.Zero;
    }

    private static TimeSpan CalculateUndertime(
        TimeSpan worked,
        TimeSpan late,
        DateTime date,
        DateTime actualTimeIn,
        DateTime? actualTimeOut,
        string? employeeStatus)
    {
        var shortage = RequiredWorkDuration - worked;
        if (shortage <= TimeSpan.Zero)
        {
            return TimeSpan.Zero;
        }

        var undertime = shortage - late;
        if (!IsFixedEightAmEmployee(employeeStatus) && actualTimeOut.HasValue)
        {
            var requiredEndTime = CalculateRequiredEndTime(date, actualTimeIn);
            var endTimeShortage = requiredEndTime - NormalizeAttendanceTime(date, actualTimeOut.Value);
            if (endTimeShortage > undertime)
            {
                undertime = endTimeShortage;
            }
        }

        return undertime > TimeSpan.Zero ? undertime : TimeSpan.Zero;
    }

    private static DateTime CalculateRequiredEndTime(DateTime date, DateTime actualTimeIn)
    {
        var current = GetOfficialTimeIn(date, actualTimeIn);
        var remaining = RequiredWorkDuration;
        var lunchStart = date.AddHours(12);
        var lunchEnd = date.AddHours(13);

        if (current < lunchStart)
        {
            var beforeLunch = lunchStart - current;
            if (beforeLunch >= remaining)
            {
                return current + remaining;
            }

            remaining -= beforeLunch;
            current = lunchEnd;
        }
        else if (current < lunchEnd)
        {
            current = lunchEnd;
        }

        return current + remaining;
    }

    private static bool HasOpenOnsiteInterval(AttendanceLog log)
        => (log.TimeInAm.HasValue && !log.TimeOutAm.HasValue)
            || (log.TimeInPm.HasValue && !log.TimeOutPm.HasValue);

    private static bool IsAfternoonStart(DateTime value)
        => value.TimeOfDay >= TimeSpan.FromHours(12);

    private static bool IsMorningHalfDay(DateTime? timeIn, DateTime? timeOut, DateTime date, bool allowLunchWindowTimeOut)
    {
        if (!timeIn.HasValue || !timeOut.HasValue)
        {
            return false;
        }

        var timeInClock = timeIn.Value.TimeOfDay;
        var timeOutClock = NormalizeHalfDayTimeOutClock(timeInClock, timeOut.Value.TimeOfDay);
        var noon = TimeSpan.FromHours(12);
        var isLunchOut = allowLunchWindowTimeOut
            ? timeOutClock >= noon && timeOutClock <= TimeSpan.FromHours(13)
            : timeOutClock == TimeSpan.FromHours(12);

        return timeInClock < noon
            && isLunchOut
            && timeOutClock > timeInClock;
    }

    private static bool IsOnsiteMorningOnlyHalfDay(DateTime? timeIn, DateTime? timeOut)
    {
        if (!timeIn.HasValue || !timeOut.HasValue)
        {
            return false;
        }

        var timeInClock = timeIn.Value.TimeOfDay;
        var timeOutClock = NormalizeHalfDayTimeOutClock(timeInClock, timeOut.Value.TimeOfDay);

        return timeInClock < TimeSpan.FromHours(12)
            && timeOutClock <= TimeSpan.FromHours(13)
            && timeOutClock > timeInClock;
    }

    private static bool HasCompleteOnsiteMorning(DateTime? timeIn, DateTime? timeOut)
        => timeIn.HasValue && timeOut.HasValue;

    private static bool HasCompleteOnsiteAfternoon(DateTime? timeIn, DateTime? timeOut)
        => timeIn.HasValue && timeOut.HasValue;

    private static bool HasAnyOnsitePunch(AttendanceLog log)
        => log.TimeInAm.HasValue
            || log.TimeOutAm.HasValue
            || log.TimeInPm.HasValue
            || log.TimeOutPm.HasValue;

    private static bool HasIncompleteOnsitePunch(AttendanceLog log, DateTime? creditedTimeInPm)
    {
        var hasIncompleteMorning = log.TimeInAm.HasValue != log.TimeOutAm.HasValue;
        var hasIncompleteAfternoon = creditedTimeInPm.HasValue != log.TimeOutPm.HasValue;
        return hasIncompleteMorning || hasIncompleteAfternoon;
    }

    private static bool IsAfternoonHalfDay(DateTime? timeIn, DateTime? timeOut)
    {
        if (!timeIn.HasValue || !timeOut.HasValue)
        {
            return false;
        }

        return IsAfternoonStart(timeIn.Value)
            && timeOut.Value.TimeOfDay > timeIn.Value.TimeOfDay;
    }

    private static TimeSpan NormalizeHalfDayTimeOutClock(TimeSpan timeInClock, TimeSpan timeOutClock)
    {
        if (timeInClock < TimeSpan.FromHours(12)
            && timeOutClock >= TimeSpan.FromHours(23)
            && timeOutClock < TimeSpan.FromHours(24))
        {
            return timeOutClock - TimeSpan.FromHours(12);
        }

        return timeOutClock;
    }

    private static string FormatLateUndertime(TimeSpan late, TimeSpan undertime)
    {
        var parts = new List<string>();
        if (late > TimeSpan.Zero)
        {
            parts.Add($"{FormatDurationCompact(late)} late");
        }

        if (undertime > TimeSpan.Zero)
        {
            parts.Add($"{FormatDurationCompact(undertime)} undertime");
        }

        return string.Join("; ", parts);
    }

    private static string FormatHalfDayLateUndertime(string halfDayTag, TimeSpan late, TimeSpan undertime)
    {
        var lateUndertime = FormatLateUndertime(late, undertime);
        return string.IsNullOrWhiteSpace(lateUndertime)
            ? halfDayTag
            : $"{halfDayTag}; {lateUndertime}";
    }

    private static string FormatDurationCompact(TimeSpan diff)
    {
        var totalMinutes = (int)Math.Ceiling(diff.TotalSeconds / 60.0);
        if (totalMinutes <= 0)
        {
            totalMinutes = 1;
        }

        if (totalMinutes < 60)
        {
            return $"{totalMinutes}m";
        }

        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;
        return minutes == 0 ? $"{hours}h" : $"{hours}h {minutes}m";
    }

    private async Task LoadDivisionPieAsync(DateTime start, DateTime endExclusive)
    {
        var onsiteDivisions = await Db.AttendanceLogs
            .AsNoTracking()
            .Where(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .Select(l => l.DivisionCenterUnit)
            .ToListAsync();

        var wfhDivisions = await Db.AttendanceLogsWfh
            .AsNoTracking()
            .Where(l => l.AttendanceDate >= start && l.AttendanceDate < endExclusive)
            .Where(l => l.TimeIn.HasValue || l.TimeOut.HasValue)
            .Select(l => l.DivisionCenterUnit)
            .ToListAsync();

        divisionPieOptions = GetDistinctOptions(onsiteDivisions.Concat(wfhDivisions)).ToList();
        if (!string.IsNullOrWhiteSpace(selectedDivisionPie)
            && !divisionPieOptions.Any(option => string.Equals(option, selectedDivisionPie, StringComparison.OrdinalIgnoreCase)))
        {
            selectedDivisionPie = string.Empty;
        }

        ApplyDivisionPieSelection(onsiteDivisions, wfhDivisions);
    }

    private void ApplyDivisionPieSelection()
    {
        _ = RefreshDivisionPieSelectionAsync();
    }

    private async Task RefreshDivisionPieSelectionAsync()
    {
        var (start, endExclusive) = GetSelectedRange();
        await LoadDivisionPieAsync(start, endExclusive);
        dashboardChartsRenderPending = true;
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyDivisionPieSelection(IEnumerable<string?> onsiteDivisions, IEnumerable<string?> wfhDivisions)
    {
        divisionPieOnsiteCount = onsiteDivisions.Count(division => MatchesSelectedValue(division, selectedDivisionPie));
        divisionPieWfhCount = wfhDivisions.Count(division => MatchesSelectedValue(division, selectedDivisionPie));
        divisionPieTotal = divisionPieOnsiteCount + divisionPieWfhCount;
    }

    private static string FormatName(string lastName, string firstName, string middleName)
    {
        var middleInitial = string.IsNullOrWhiteSpace(middleName) ? string.Empty : $" {middleName.Trim()[0]}.";
        return $"{lastName}, {firstName}{middleInitial}";
    }

    private static string FormatEmployeeMeta(string? divisionCenterUnit, string? designation)
    {
        var division = string.IsNullOrWhiteSpace(divisionCenterUnit) ? "-" : divisionCenterUnit.Trim();
        var role = string.IsNullOrWhiteSpace(designation) ? "-" : designation.Trim();
        return $"{division} - {role}";
    }

    private static string FormatTime(DateTime? value) => value?.ToString("MMM dd, yyyy\nhh:mm tt") ?? "-";

    private static string FormatTimeRange(DateTime? start, DateTime? end)
        => $"{(start?.ToString("hh:mm tt") ?? "-")} / {(end?.ToString("hh:mm tt") ?? "-")}";
}
