    private static string BuildCsv(IEnumerable<string> headers, IEnumerable<IEnumerable<string>> rows)
    {
        var builder = new StringBuilder();
        builder.AppendLine(string.Join(",", headers.Select(CsvValue)));

        foreach (var row in rows)
        {
            builder.AppendLine(string.Join(",", row.Select(CsvValue)));
        }

        return builder.ToString();
    }

    private static string CsvValue(object? value)
    {
        var text = value?.ToString() ?? string.Empty;
        return $"\"{text.Replace("\"", "\"\"")}\"";
    }

    private string BuildOnsiteCsv(IEnumerable<AttendanceLog> logs)
        => BuildCsv(
            new[]
            {
                "AttendanceLogId",
                "ID Number",
                "Employee",
                "AM Time In",
                "AM Time Out",
                "PM Time In",
                "PM Time Out",
                "Attendance Date"
            },
            logs.Select(log => new[]
            {
                log.AttendanceLogId.ToString(),
