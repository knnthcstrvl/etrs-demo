    .flip-clock-card {
        --flip-card-height: 3.35rem;
        --flip-card-font-size: 2.65rem;
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.45rem;
        height: var(--flip-card-height);
        border-radius: 8px;
        overflow: hidden;
        background: linear-gradient(180deg, #353535 0%, #2b2b2b 49%, #242424 50%, #303030 100%);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 8px 16px rgba(15, 23, 42, 0.18);
        color: #d7d7d7;
        font-size: var(--flip-card-font-size);
        line-height: 1;
        font-weight: 800;
        letter-spacing: 0;
        text-shadow: 0 2px 3px rgba(0,0,0,0.55);
        perspective: 360px;
        transform-style: preserve-3d;
    }

    .flip-clock-number {
        position: relative;
        z-index: 1;
        display: inline-block;
        backface-visibility: hidden;
    }

    .flip-clock-top-previous {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        z-index: 5;
        display: block;
        height: 50%;
        overflow: hidden;
        border-radius: 8px 8px 0 0;
        background: linear-gradient(180deg, #353535 0%, #2b2b2b 100%);
        animation: flip-clock-top-hold 520ms linear forwards;
    }

    .flip-clock-top-number {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: var(--flip-card-height);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d7d7d7;
        font-size: var(--flip-card-font-size);
        line-height: 1;
        font-weight: 800;
        letter-spacing: 0;
        text-shadow: 0 2px 3px rgba(0,0,0,0.55);
    }

    .flip-clock-bottom-next {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 2;
        display: block;
        height: 50%;
        overflow: hidden;
        border-radius: 0 0 8px 8px;
        background: linear-gradient(180deg, #242424 0%, #303030 100%);
    }

    .flip-clock-bottom-number {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: var(--flip-card-height);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d7d7d7;
        font-size: var(--flip-card-font-size);
        line-height: 1;
        font-weight: 800;
        letter-spacing: 0;
        text-shadow: 0 2px 3px rgba(0,0,0,0.55);
    }

    .flip-clock-lower-flap {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 6;
        display: block;
        height: 50%;
        overflow: visible;
        border-radius: 0 0 8px 8px;
        border: 1px solid transparent;
        background: linear-gradient(180deg, #242424 0%, #303030 100%);
        transform-origin: top center;
        transform-style: preserve-3d;
        backface-visibility: visible;
        animation: flip-clock-lower-turn 520ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .flip-clock-flap-face {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        height: 100%;
        overflow: hidden;
        border-radius: inherit;
        backface-visibility: hidden;
    }

    .flip-clock-flap-front {
        background: linear-gradient(180deg, #242424 0%, #303030 100%);
        transform: rotateX(0deg);
        animation: flip-clock-front-face 520ms linear forwards;
    }

    .flip-clock-flap-back {
        background: linear-gradient(180deg, #353535 0%, #2b2b2b 100%);
        transform: rotateX(180deg) translateZ(1px);
        animation: flip-clock-back-face 520ms linear forwards;
    }

    .flip-clock-flap-number {
        position: absolute;
        left: 0;
        right: 0;
        height: var(--flip-card-height);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d7d7d7;
        font-size: var(--flip-card-font-size);
        line-height: 1;
        font-weight: 800;
        letter-spacing: 0;
        text-shadow: 0 2px 3px rgba(0,0,0,0.55);
    }

    .flip-clock-flap-number-bottom {
        bottom: 0;
        backface-visibility: hidden;
    }

    .flip-clock-flap-number-top {
        top: 0;
        backface-visibility: hidden;
    }

    .flip-clock-back-number-overlay {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 100%;
        overflow: hidden;
        z-index: 2;
        opacity: 0;
        transform: rotateX(180deg) translateZ(3px);
        backface-visibility: hidden;
        animation: flip-clock-back-face 520ms linear forwards;
    }

    .flip-clock-back-number {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: var(--flip-card-height);
        display: flex;
        align-items: center;
        justify-content: center;
