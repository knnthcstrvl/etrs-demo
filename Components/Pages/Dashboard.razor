    private void StartLiveClock()
    {
        liveClockCancellation = new CancellationTokenSource();
        liveClockTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunLiveClockAsync(liveClockCancellation.Token);
    }

    private async Task RunLiveClockAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (liveClockTimer is not null && await liveClockTimer.WaitForNextTickAsync(cancellationToken))
            {
                previousLiveClockNow = liveClockNow;
                liveClockNow = DateTime.Now;
                RestartFlipRenderReset();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void RestartFlipRenderReset()
    {
        flipRenderCancellation?.Cancel();
        flipRenderCancellation?.Dispose();
        flipRenderCancellation = new CancellationTokenSource();
        _ = ResetFlipRenderStateAsync(flipRenderCancellation.Token);
    }

    private async Task ResetFlipRenderStateAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(560, cancellationToken);
            previousLiveClockNow = liveClockNow;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

