    }

    .dashboard-chart-heading {
        align-items: center !important;
    }

    .dashboard-chart-heading h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
    }

    .dashboard-chart-totals {
        display: inline-flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.55rem 0.85rem;
        color: var(--finance-text-muted);
        font-size: 0.82rem;
        white-space: nowrap;
    }

    .dashboard-chart-totals span {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .dashboard-chart-dot {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 999px;
    }

    .dashboard-chart-dot.late {
        background: #111844;
    }

    .dashboard-chart-dot.undertime {
        background: #4B5694;
    }

    .dashboard-chart-dot.onsite {
        background: #111844;
    }

    .dashboard-chart-dot.wfh {
        background: #EAE0CF;
        border: 1px solid #d8ccb8;
    }

    .dashboard-late-chart {
        position: relative;
        flex: 1 1 auto;
        min-height: 360px;
        padding: 0.4rem 0.25rem 0;
        border-radius: 8px;
        background: var(--etrs-gray-50);
        border: 1px solid var(--finance-border-soft);
        overflow: hidden;
    }

    .dashboard-apex-chart {
        min-height: 340px;
    }

    .dashboard-apex-pie-wrap {
        min-width: 0;
    }

    .dashboard-apex-pie {
        min-height: 300px;
    }

    .dashboard-apex-chart .apexcharts-canvas,
    .dashboard-apex-pie .apexcharts-canvas {
