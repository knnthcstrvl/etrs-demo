        gap: 0.8rem;
        min-width: 100%;
        height: 100%;
    }

    .dashboard-chart-column {
        position: relative;
        display: grid;
        grid-template-rows: minmax(0, 1fr) minmax(0, 1fr) 1.2rem;
        min-width: 42px;
        height: 100%;
    }

    .dashboard-chart-positive,
    .dashboard-chart-negative {
        position: relative;
        min-height: 0;
    }

    .dashboard-chart-positive {
        display: flex;
        align-items: flex-end;
    }

    .dashboard-chart-negative {
        display: flex;
        align-items: flex-start;
    }

    .dashboard-chart-bar {
        display: block;
        width: 100%;
        min-height: 3px;
        border-radius: 7px;
        transition: height 180ms ease;
    }

    .dashboard-chart-bar.late {
        background: #111844;
        box-shadow: none;
    }

    .dashboard-chart-bar.undertime {
        background: #4B5694;
        box-shadow: none;
    }

    .dashboard-chart-bar[style*="height: 0"] {
        min-height: 0;
    }

    .dashboard-chart-label {
        align-self: end;
        padding-top: 0.45rem;
        color: var(--finance-text-muted);
        font-size: 0.7rem;
        line-height: 1;
        text-align: center;
        white-space: nowrap;
    }

    .dashboard-chart-zero-line {
        position: absolute;
        left: 2.35rem;
        right: 1.1rem;
        top: calc(50% - 0.6rem);
        z-index: 1;
        height: 1px;
        background: var(--finance-border);
    }

    .dashboard-chart-scale {
        position: absolute;
        left: 0.45rem;
        z-index: 3;
        color: var(--finance-text-muted);
        font-size: 0.7rem;
        line-height: 1;
    }

    .dashboard-chart-scale-top {
        top: 1.1rem;
    }

    .dashboard-chart-scale-zero {
        top: calc(50% - 1rem);
    }

    .dashboard-chart-empty {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        color: var(--finance-text-muted);
        font-size: 0.9rem;
        text-align: center;
    }

    .dashboard-division-dropdown {
        width: min(100%, 14rem);
    }

    .dashboard-division-trigger {
        min-height: 2.25rem;
        height: 2.25rem;
        padding: 0.45rem 0.65rem;
        font-size: 0.82rem;
    }

    .dashboard-division-menu {
        right: 0;
        left: auto;
        width: min(18rem, 84vw);
        max-height: 16rem;
        overflow-y: auto;
    }

    .dashboard-pie-content {
        flex: 1 1 auto;
        display: grid;
        grid-template-columns: minmax(160px, 1fr) minmax(170px, 0.9fr);
        gap: 1.25rem;
        align-items: center;
        min-height: 320px;
    }

    .dashboard-donut-wrap {
        display: flex;
        justify-content: center;
    }

    .dashboard-donut {
        --onsite-slice: 50%;
        position: relative;
        width: min(100%, 210px);
        aspect-ratio: 1;
        border-radius: 50%;
        background:
            radial-gradient(circle at center, #ffffff 0 46%, transparent 47%),
            conic-gradient(#2f6b3d 0 var(--onsite-slice), #d7b252 var(--onsite-slice) 100%);
        box-shadow: inset 0 0 0 1px var(--finance-border-soft);
    }

    .dashboard-donut::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: repeating-conic-gradient(from -8deg, rgba(255,255,255,0.18) 0deg 8deg, transparent 8deg 16deg);
        pointer-events: none;
        mix-blend-mode: soft-light;
    }

    .dashboard-donut.empty {
        background:
            radial-gradient(circle at center, #ffffff 0 46%, transparent 47%),
            conic-gradient(var(--etrs-gray-300) 0 100%);
