                log.TimeInAm?.ToString("yyyy-MM-dd HH:mm:ss") ?? string.Empty,
                log.TimeOutAm?.ToString("yyyy-MM-dd HH:mm:ss") ?? string.Empty,
                log.TimeInPm?.ToString("yyyy-MM-dd HH:mm:ss") ?? string.Empty,
                log.TimeOutPm?.ToString("yyyy-MM-dd HH:mm:ss") ?? string.Empty,
                log.AttendanceDate.ToString("yyyy-MM-dd")
            }));

