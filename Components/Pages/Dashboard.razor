@page "/dashboard"
<PageTitle>ETRS | Dashboard</PageTitle>
@using Financial.Data
@using Financial.Model.Dtr
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using System.IO.Compression
@using System.Globalization
@using System.Text
@inject ProcurementDbContext Db
@inject IJSRuntime JS

@implements IAsyncDisposable


<div class="dashboard-shell" @onclick="CloseDashboardTransientMenus">
    <div class="dashboard-hero">
        <div class="hero-left">
            <div class="hero-label">Dashboard</div>
            <h1>Electronic Time Record System</h1>
        </div>
        <div class="dashboard-live-clock" aria-live="polite">
            <div class="dashboard-live-time" aria-label="@LiveClockTimeLabel">
                @foreach (var part in LiveClockParts)
                {
                    if (part.Value == ":")
                    {
                        <span class="flip-clock-separator">:</span>
                    }
                    else
                    {
                        <span @key="GetClockPartKey(part.Index, part.Value, part.PreviousValue)" class="flip-clock-card @(part.HasChanged ? "changing" : null)">
                            <span class="flip-clock-number">@part.Value</span>
                            @if (part.HasChanged)
                            {
                                <span class="flip-clock-top-previous" aria-hidden="true">
                                    <span class="flip-clock-top-number">@part.PreviousValue</span>
                                </span>
                                <span class="flip-clock-bottom-next" aria-hidden="true">
                                    <span class="flip-clock-bottom-number">@part.Value</span>
                                </span>
                            }
                            <span class="flip-clock-lower-flap" aria-hidden="true">
                                <span class="flip-clock-flap-face flip-clock-flap-front">
                                    <span class="flip-clock-flap-number flip-clock-flap-number-bottom">@part.PreviousValue</span>
                                </span>
                                <span class="flip-clock-flap-face flip-clock-flap-back">
                                    <span class="flip-clock-flap-number flip-clock-flap-number-top">@part.Value</span>
                                </span>
                                <span class="flip-clock-back-number-overlay">
                                    <span class="flip-clock-back-number">@part.Value</span>
                                </span>
                            </span>
                        </span>
                    }
                }
                <span class="flip-clock-meridiem">@liveClockNow.ToString("tt")</span>
            </div>
            <div class="dashboard-live-date">@LiveClockDateLabel</div>
        </div>
        <div class="period-dropdown @(showAddPeriod || isClosingAddPeriod ? "has-period-range" : null)" @ref="periodControlsRef">
            <div class="period-primary-row">
                <div class="attendance-filter-select-wrap period-dropdown">
                    <button type="button" class="attendance-filter-select-trigger period-button @(showPeriodMenu ? "active" : null)" @onclick="TogglePeriodMenu">
                        <span class="period-button-content">
                            <span class="period-label">Period:</span>
                            <span class="period-selected">@SelectedPeriodLabel</span>
                            @if (selectedPeriod?.IsCurrent == true)
                            {
                                <span class="period-current-text">(Current)</span>
                            }
                        </span>
                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                    </button>

                    <div class="attendance-filter-select-menu period-menu @(showPeriodMenu ? "show" : null)">
                        @foreach (var p in periods)
                        {
                            var itemId = selectedPeriod == p ? "period-1-selected-item" : null;
                            <button type="button" class="attendance-filter-select-option period-option @(selectedPeriod == p ? "active" : null)" id="@itemId" @onclick="() => SelectPeriod(p)">
                                <span class="period-option-label">@p.Label</span>
                                @if (p.IsCurrent)
                                {
                                    <span class="period-current-text">(Current)</span>
                                }
                            </button>
                        }
                    </div>
                </div>

                @if (periods.Count > 1 && !showAddPeriod && !isClosingAddPeriod)
                {
                    <button type="button" class="btn btn-outline-secondary period-add-button" @onclick="ToggleAddPeriod">+</button>
                }
            </div>

            @if (showAddPeriod || isClosingAddPeriod)
            {
                <div class="period-range-entry @(isClosingAddPeriod ? "closing" : null)">
                    <div class="period-to-label">TO</div>

                    <div class="attendance-filter-select-wrap period-dropdown">
                        <button type="button" class="period-close-btn" title="Close period range" @onclick="ToggleAddPeriod">×</button>
                        <button type="button" class="attendance-filter-select-trigger period-button @(showPeriod2Menu ? "active" : null)" @onclick="TogglePeriod2Menu">
                            <span class="period-button-content">
                                <span class="period-label">Period:</span>
                                <span class="period-selected">@SelectedPeriod2Label</span>
                                @if (secondSelectedPeriod?.IsCurrent == true)
                                {
                                    <span class="period-current-text">(Current)</span>
                                }
                            </span>
                            <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                        </button>

                        <div class="attendance-filter-select-menu period-menu @(showPeriod2Menu ? "show" : null)">
                            @foreach (var p in periods)
                            {
                                var itemId = secondSelectedPeriod == p ? "period-2-selected-item" : null;
                                <button type="button" class="attendance-filter-select-option period-option @(secondSelectedPeriod == p ? "active" : null)" id="@itemId" @onclick="() => SelectSecondPeriod(p)">
                                    <span class="period-option-label">@p.Label</span>
                                    @if (p.IsCurrent)
                                    {
                                        <span class="period-current-text">(Current)</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="metric-grid dashboard-metrics">
        <div class="metric-card">
            <span class="metric-label">Employees</span>
            <strong>@employeeCount</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Onsite Logs Today</span>
            <strong>@onsiteLogsToday</strong>
            <div class="metric-percent" title="Percentage of employees">@OnsitePercentLabel</div>
        </div>
        <div class="metric-card">
            <span class="metric-label">WFH Logs Today</span>
            <strong>@wfhLogsToday</strong>
            <div class="metric-percent" title="Percentage of employees">@WfhPercentLabel</div>
        </div>
    </div>

    <div class="dashboard-grid dashboard-log-grid" @ref="tableMenuControlsRef">
        <section class="panel-card dashboard-log-card">
            <div class="panel-heading">
                <h2>Recent Onsite Logs</h2>
                <div class="dashboard-table-actions" @onclick:stopPropagation="true">
                    <button type="button" class="dashboard-table-action-trigger @(openTableMenu == DashboardTableMenu.Onsite ? "active" : null)" @onclick="() => ToggleTableMenu(DashboardTableMenu.Onsite)" aria-label="Open recent onsite logs actions" aria-expanded="@(openTableMenu == DashboardTableMenu.Onsite)">
                        <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                    </button>
                    <div class="dashboard-table-action-menu @(openTableMenu == DashboardTableMenu.Onsite ? "show" : null)">
                        <button type="button" @onclick="() => OpenViewMoreLogsAsync(DashboardTableMenu.Onsite)">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            <span>View More</span>
                        </button>
                        <button type="button" @onclick="OpenExportLogsModal">
                            <i class="fa-solid fa-file-export" aria-hidden="true"></i>
                            <span>Export</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle dashboard-log-table">
                    <thead>
                        <tr>
                            <th>ID Number</th>
                            <th>Employee</th>
                            <th>AM</th>
                            <th>PM</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in recentOnsiteLogs)
                        {
                            <tr>
                                <td>@log.IdNumber</td>
                                <td>
                                    <div>@FormatName(log.LastName, log.FirstName, log.MiddleName)</div>
                                    <div class="dashboard-employee-meta">@FormatEmployeeMeta(log.DivisionCenterUnit, log.Designation)</div>
                                </td>
                                <td style="white-space:pre-line;">@FormatTimeRange(log.TimeInAm, log.TimeOutAm)</td>
                                <td style="white-space:pre-line;">@FormatTimeRange(log.TimeInPm, log.TimeOutPm)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel-card dashboard-log-card">
            <div class="panel-heading">
                <h2>Recent WFH Logs</h2>
                <div class="dashboard-table-actions" @onclick:stopPropagation="true">
                    <button type="button" class="dashboard-table-action-trigger @(openTableMenu == DashboardTableMenu.Wfh ? "active" : null)" @onclick="() => ToggleTableMenu(DashboardTableMenu.Wfh)" aria-label="Open recent WFH logs actions" aria-expanded="@(openTableMenu == DashboardTableMenu.Wfh)">
                        <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                    </button>
                    <div class="dashboard-table-action-menu @(openTableMenu == DashboardTableMenu.Wfh ? "show" : null)">
                        <button type="button" @onclick="() => OpenViewMoreLogsAsync(DashboardTableMenu.Wfh)">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            <span>View More</span>
                        </button>
                        <button type="button" @onclick="OpenExportLogsModal">
                            <i class="fa-solid fa-file-export" aria-hidden="true"></i>
                            <span>Export</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle dashboard-log-table dashboard-log-table-wfh">
                    <thead>
                        <tr>
                            <th>ID Number</th>
                            <th>Employee</th>
                            <th>Target</th>
                            <th>Accomplishment</th>
                            <th>MOV</th>
                            <th>Time In</th>
                            <th>Time Out</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in recentWfhLogs)
                        {
                            <tr>
                                <td>@log.IdNumber</td>
                                <td>
                                    <div>@FormatName(log.LastName, log.FirstName, log.MiddleName)</div>
                                    <div class="dashboard-employee-meta">@FormatEmployeeMeta(log.DivisionCenterUnit, log.Designation)</div>
                                </td>
                                <td><span class="dashboard-text-cell" title="@DisplayValue(log.Target)">@DisplayValue(log.Target)</span></td>
                                <td><span class="dashboard-text-cell" title="@DisplayValue(log.Accomplishment)">@DisplayValue(log.Accomplishment)</span></td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(log.Mov))
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        <a class="dashboard-text-cell" href="@log.Mov" target="_blank" title="@log.Mov">View File</a>
                                    }
                                </td>
                                <td style="white-space:pre-line;">@FormatTime(log.TimeIn)</td>
                                <td style="white-space:pre-line;">@FormatTime(log.TimeOut)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="dashboard-chart-row">
        <section class="panel-card dashboard-chart-card">
            <div class="panel-heading dashboard-chart-heading">
                <div>
                    <h2>Late and Undertime Summary</h2>
                </div>
                <div class="dashboard-chart-totals" aria-label="Late and undertime totals">
                    <span><i class="dashboard-chart-dot late" aria-hidden="true"></i>@lateTotal Late</span>
                    <span><i class="dashboard-chart-dot undertime" aria-hidden="true"></i>@undertimeTotal Undertime</span>
                </div>
            </div>

            <div class="dashboard-late-chart" role="img" aria-label="Late and undertime summary chart">
                <div class="dashboard-apex-chart" @ref="lateUndertimeChartRef"></div>
            </div>
        </section>

        <section class="panel-card dashboard-pie-card">
            <div class="panel-heading dashboard-chart-heading">
                <div>
                    <h2>Work Arrangement</h2>
                </div>
                <div class="attendance-filter-select-wrap dashboard-division-dropdown" @onclick:stopPropagation="true">
                    <button type="button" class="attendance-filter-select-trigger dashboard-division-trigger @(showDivisionPieMenu ? "active" : null)" @onclick="ToggleDivisionPieMenu">
                        <span class="attendance-filter-select-value">@SelectedDivisionPieLabel</span>
                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                    </button>
                    <div class="attendance-filter-select-menu dashboard-division-menu @(showDivisionPieMenu ? "show" : null)">
                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(selectedDivisionPie) ? "active" : null)" @onclick='() => SelectDivisionPie(string.Empty)'>All Divisions / Units</button>
                        @foreach (var option in divisionPieOptions)
                        {
                            <button type="button" class="attendance-filter-select-option @(string.Equals(selectedDivisionPie, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SelectDivisionPie(option)'>@option</button>
                        }
                    </div>
                </div>
            </div>

            <div class="dashboard-pie-content">
                <div class="dashboard-apex-pie-wrap">
                    <div class="dashboard-apex-pie" @ref="workArrangementChartRef"></div>
                </div>

                <div class="dashboard-pie-legend">
                    <div class="dashboard-pie-legend-row">
                        <span><i class="dashboard-chart-dot onsite" aria-hidden="true"></i>Onsite</span>
                        <strong>@DivisionPieOnsitePercentLabel</strong>
                    </div>
                    <div class="dashboard-pie-legend-row">
                        <span><i class="dashboard-chart-dot wfh" aria-hidden="true"></i>WFH</span>
                        <strong>@DivisionPieWfhPercentLabel</strong>
                    </div>
                    <div class="dashboard-pie-counts">
                        <span>@divisionPieOnsiteCount onsite logs</span>
                        <span>@divisionPieWfhCount WFH logs</span>
                    </div>
                </div>
            </div>
        </section>
    </div>

    @if (showViewMoreModal)
    {
        <div class="attendance-detail-overlay dashboard-modal-overlay" @onclick="CloseViewMoreModal">
            <div class="attendance-detail-modal dashboard-logs-modal" @onclick="CloseViewMoreTransientMenus" @onclick:stopPropagation="true">
                <div class="attendance-detail-header">
                    <div>
                        <h2 class="attendance-detail-title">@ViewMoreTitle</h2>
                    </div>
                    <button type="button" class="attendance-detail-close" @onclick="CloseViewMoreModal" aria-label="Close dashboard logs">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="attendance-detail-body dashboard-logs-modal-body">
                    <div class="attendance-table-toolbar dashboard-modal-toolbar">
                        <div class="attendance-table-search">
                            <input id="dashboardLogSearch"
                                   class="form-control attendance-table-search-input"
                                   type="search"
                                   placeholder="Search..."
                                   value="@viewMoreSearchText"
                                   @oninput="HandleViewMoreSearchInput" />
                        </div>

                        <div class="attendance-table-actions">
                            <div class="attendance-filter-dropdown" @onclick:stopPropagation="true">
                                <button type="button" class="btn btn-outline-secondary attendance-filter-button" @onclick="ToggleViewMoreFilterMenu">
                                    <i class="fa-solid fa-bars-staggered" aria-hidden="true"></i>
                                    <span>Filter</span>
                                    @if (HasActiveViewMoreFilters)
                                    {
                                        <span class="attendance-filter-button-clear"
                                              title="Clear filters"
                                              role="button"
                                              tabindex="0"
                                              @onclick="ClearViewMoreFiltersFromButton"
                                              @onclick:stopPropagation="true">×</span>
                                    }
                                </button>

                                <div class="attendance-filter-menu @(showViewMoreFilterMenu ? "show" : null)" @onclick:stopPropagation="true">
                                    <div class="attendance-filter-grid">
                                        <div class="attendance-filter-field">
                                            <label class="attendance-table-toolbar-label" for="dashboardFilterId">ID Number</label>
                                            <div class="attendance-filter-select-wrap">
                                                <button type="button" id="dashboardFilterId" class="attendance-filter-select-trigger @(activeViewMoreFilterField == "id" ? "active" : null)" @onclick='() => ToggleViewMoreFilterField("id")'>
                                                    <span class="attendance-filter-select-value">@DisplayValue(viewMoreFilterIdNumber, "All ID Numbers")</span>
                                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                                </button>

                                                <div class="attendance-filter-select-menu @(activeViewMoreFilterField == "id" ? "show" : null)">
                                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(viewMoreFilterIdNumber) ? "active" : null)" @onclick='() => SetViewMoreFilterValue("id", string.Empty)'>All ID Numbers</button>
                                                    @foreach (var option in CurrentViewMoreIdNumberOptions)
                                                    {
                                                        <button type="button" class="attendance-filter-select-option @(string.Equals(viewMoreFilterIdNumber, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetViewMoreFilterValue("id", option)'>@option</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="attendance-filter-field">
                                            <label class="attendance-table-toolbar-label" for="dashboardFilterEmployee">Employee</label>
                                            <div class="attendance-filter-select-wrap">
                                                <button type="button" id="dashboardFilterEmployee" class="attendance-filter-select-trigger @(activeViewMoreFilterField == "employee" ? "active" : null)" @onclick='() => ToggleViewMoreFilterField("employee")'>
                                                    <span class="attendance-filter-select-value">@DisplayValue(viewMoreFilterEmployee, "All Employees")</span>
                                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                                </button>

                                                <div class="attendance-filter-select-menu @(activeViewMoreFilterField == "employee" ? "show" : null)">
                                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(viewMoreFilterEmployee) ? "active" : null)" @onclick='() => SetViewMoreFilterValue("employee", string.Empty)'>All Employees</button>
                                                    @foreach (var option in CurrentViewMoreEmployeeOptions)
                                                    {
                                                        <button type="button" class="attendance-filter-select-option @(string.Equals(viewMoreFilterEmployee, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetViewMoreFilterValue("employee", option)'>@option</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="attendance-filter-field">
                                            <label class="attendance-table-toolbar-label" for="dashboardFilterDivision">Division / Unit</label>
                                            <div class="attendance-filter-select-wrap">
                                                <button type="button" id="dashboardFilterDivision" class="attendance-filter-select-trigger @(activeViewMoreFilterField == "division" ? "active" : null)" @onclick='() => ToggleViewMoreFilterField("division")'>
                                                    <span class="attendance-filter-select-value">@DisplayValue(viewMoreFilterDivision, "All Divisions / Units")</span>
                                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                                </button>

                                                <div class="attendance-filter-select-menu @(activeViewMoreFilterField == "division" ? "show" : null)">
                                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(viewMoreFilterDivision) ? "active" : null)" @onclick='() => SetViewMoreFilterValue("division", string.Empty)'>All Divisions / Units</button>
                                                    @foreach (var option in CurrentViewMoreDivisionOptions)
                                                    {
                                                        <button type="button" class="attendance-filter-select-option @(string.Equals(viewMoreFilterDivision, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetViewMoreFilterValue("division", option)'>@option</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="attendance-filter-field">
                                            <label class="attendance-table-toolbar-label" for="dashboardFilterDesignation">Designation</label>
                                            <div class="attendance-filter-select-wrap">
                                                <button type="button" id="dashboardFilterDesignation" class="attendance-filter-select-trigger @(activeViewMoreFilterField == "designation" ? "active" : null)" @onclick='() => ToggleViewMoreFilterField("designation")'>
                                                    <span class="attendance-filter-select-value">@DisplayValue(viewMoreFilterDesignation, "All Designations")</span>
                                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                                </button>

                                                <div class="attendance-filter-select-menu @(activeViewMoreFilterField == "designation" ? "show" : null)">
                                                    <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(viewMoreFilterDesignation) ? "active" : null)" @onclick='() => SetViewMoreFilterValue("designation", string.Empty)'>All Designations</button>
                                                    @foreach (var option in CurrentViewMoreDesignationOptions)
                                                    {
                                                        <button type="button" class="attendance-filter-select-option @(string.Equals(viewMoreFilterDesignation, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetViewMoreFilterValue("designation", option)'>@option</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="attendance-filter-actions">
                                        <button type="button" class="attendance-filter-clear" @onclick="ClearViewMoreFilters">Clear</button>
                                        <button type="button" class="btn btn-primary attendance-filter-apply" @onclick="CloseViewMoreFilterMenu">Apply</button>
                                    </div>
                                </div>
                            </div>

                            <div class="attendance-filter-dropdown attendance-entries-counter" @onclick:stopPropagation="true">
                                <button type="button" class="btn btn-outline-secondary attendance-filter-button attendance-entries-button" @onclick="ToggleViewMoreEntriesMenu">
                                    <span>@viewMorePageSize</span>
                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                </button>

                                <div class="attendance-entries-menu attendance-filter-menu @(showViewMoreEntriesMenu ? "show" : null)" @onclick:stopPropagation="true">
                                    @foreach (var option in PageSizeOptions)
                                    {
                                        <button type="button"
                                                class="attendance-entries-option @(viewMorePageSize == option ? "active" : null)"
                                                @onclick="() => SelectViewMorePageSize(option)">
                                            @option
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive dashboard-modal-table-wrap">
                        @if (viewMoreTable == DashboardTableMenu.Onsite)
                        {
                            <table class="table table-sm align-middle dashboard-log-table">
                                <thead>
                                    <tr>
                                        <th>ID Number</th>
                                        <th>Employee</th>
                                        <th>AM</th>
                                        <th>PM</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in PagedViewMoreOnsiteLogs)
                                    {
                                        <tr>
                                            <td>@log.IdNumber</td>
                                            <td>
                                                <div>@FormatName(log.LastName, log.FirstName, log.MiddleName)</div>
                                                <div class="dashboard-employee-meta">@FormatEmployeeMeta(log.DivisionCenterUnit, log.Designation)</div>
                                            </td>
                                            <td style="white-space:pre-line;">@FormatTimeRange(log.TimeInAm, log.TimeOutAm)</td>
                                            <td style="white-space:pre-line;">@FormatTimeRange(log.TimeInPm, log.TimeOutPm)</td>
                                        </tr>
                                    }
                                    @if (!PagedViewMoreOnsiteLogs.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="attendance-empty-state">No attendance logs match the current search and filters.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <table class="table table-sm align-middle dashboard-log-table dashboard-log-table-wfh">
                                <thead>
                                    <tr>
                                        <th>ID Number</th>
                                        <th>Employee</th>
                                        <th>Target</th>
                                        <th>Accomplishment</th>
                                        <th>MOV</th>
                                        <th>Time In</th>
                                        <th>Time Out</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in PagedViewMoreWfhLogs)
                                    {
                                        <tr>
                                            <td>@log.IdNumber</td>
                                            <td>
                                                <div>@FormatName(log.LastName, log.FirstName, log.MiddleName)</div>
                                                <div class="dashboard-employee-meta">@FormatEmployeeMeta(log.DivisionCenterUnit, log.Designation)</div>
                                            </td>
                                            <td><span class="dashboard-text-cell" title="@DisplayValue(log.Target)">@DisplayValue(log.Target)</span></td>
                                            <td><span class="dashboard-text-cell" title="@DisplayValue(log.Accomplishment)">@DisplayValue(log.Accomplishment)</span></td>
                                            <td>
                                                @if (string.IsNullOrWhiteSpace(log.Mov))
                                                {
                                                    <span>-</span>
                                                }
                                                else
                                                {
                                                    <a class="dashboard-text-cell" href="@log.Mov" target="_blank" title="@log.Mov">View File</a>
                                                }
                                            </td>
                                            <td style="white-space:pre-line;">@FormatTime(log.TimeIn)</td>
                                            <td style="white-space:pre-line;">@FormatTime(log.TimeOut)</td>
                                        </tr>
                                    }
                                    @if (!PagedViewMoreWfhLogs.Any())
                                    {
                                        <tr>
                                            <td colspan="7" class="attendance-empty-state">No attendance logs match the current search and filters.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    <div class="table-footer dashboard-modal-table-footer">
                        <div class="table-entries">@ViewMoreEntryLabel</div>
                        <div class="table-pagination">
                            <button type="button" class="table-page-btn table-page-arrow" @onclick="PreviousViewMorePage" disabled="@(viewMorePage <= 1)">&#8249;</button>
                            @foreach (var pageItem in BuildPageItems(ViewMoreTotalPages, viewMorePage))
                            {
                                if (pageItem.HasValue)
                                {
                                    <button type="button" class="table-page-btn @(viewMorePage == pageItem.Value ? "active" : null)" @onclick="() => SelectViewMorePage(pageItem.Value)">@pageItem.Value</button>
                                }
                                else
                                {
                                    <span class="table-page-ellipsis">...</span>
                                }
                            }
                            <button type="button" class="table-page-btn table-page-arrow" @onclick="NextViewMorePage" disabled="@(viewMorePage >= ViewMoreTotalPages)">&#8250;</button>
                        </div>
                    </div>
                </div>

                <div class="attendance-detail-footer">
                    <button type="button" class="attendance-detail-text-action" @onclick="CloseViewMoreModal">Close</button>
                </div>
            </div>
        </div>
    }

    @if (showExportLogsModal)
    {
        <div class="attendance-detail-overlay dashboard-modal-overlay" @onclick="CloseExportLogsModal">
            <div class="attendance-detail-modal attendance-export-modal" @onclick="CloseExportPeriodMenus" @onclick:stopPropagation="true">
                <div class="attendance-detail-header">
                    <div>
                        <h2 class="attendance-detail-title">Export Logs</h2>
                    </div>
                    <button type="button" class="attendance-detail-close" @onclick="CloseExportLogsModal" aria-label="Close export attendance logs">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="attendance-detail-body attendance-input-body">
                    <div class="attendance-detail-section attendance-detail-hero">
                        <div>
                            <div class="attendance-detail-eyebrow">CSV Export</div>
                            <div class="attendance-detail-person">Select the period range to include in the export.</div>
                            <div class="attendance-detail-meta">This export downloads a ZIP file with separate onsite and WFH CSV files.</div>
                        </div>
                    </div>

                    <div class="attendance-detail-section attendance-detail-section-primary">
                        <div class="attendance-export-periods" @ref="exportPeriodControlsRef" @onclick:stopPropagation="true">
                            <div class="attendance-export-period-row @(showExportPeriodMenu ? "menu-open" : null)">
                                <span class="attendance-detail-label">From</span>
                                <div class="attendance-filter-select-wrap period-dropdown attendance-export-period-dropdown @(showExportPeriodMenu ? "menu-open" : null)" @onclick:stopPropagation="true">
                                    <button type="button" class="attendance-filter-select-trigger period-button @(showExportPeriodMenu ? "active" : null)" @ref="exportPeriodButtonRef" @onclick="ToggleExportPeriodMenu">
                                        <span class="period-button-content">
                                            <span class="period-label">Period:</span>
                                            <span class="period-selected">@ExportSelectedPeriodLabel</span>
                                            @if (exportSelectedPeriod?.IsCurrent == true)
                                            {
                                                <span class="period-current-text">(Current)</span>
                                            }
                                        </span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="@GetExportPeriodMenuClass(showExportPeriodMenu, openExportPeriodMenuUpward)" @onclick:stopPropagation="true">
                                        @foreach (var p in periods)
                                        {
                                            var itemId = exportSelectedPeriod == p ? "dashboard-export-period-1-selected-item" : null;
                                            <button type="button" class="attendance-filter-select-option period-option @(exportSelectedPeriod == p ? "active" : null)" id="@itemId" @onclick="() => SelectExportPeriod(p)">
                                                <span class="period-option-label">@p.Label</span>
                                                @if (p.IsCurrent)
                                                {
                                                    <span class="period-current-text">(Current)</span>
                                                }
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (periods.Count > 1 && !showExportAddPeriod && !isClosingExportAddPeriod)
                            {
                                <button type="button" class="btn btn-outline-secondary period-add-button attendance-export-period-add" @onclick="ToggleExportAddPeriod">
                                    <span class="attendance-export-period-add-icon" aria-hidden="true">+</span>
                                    <span>Add a period</span>
                                </button>
                            }

                            @if (showExportAddPeriod || isClosingExportAddPeriod)
                            {
                                <div class="period-range-entry attendance-export-range-entry @(isClosingExportAddPeriod ? "closing" : null) @(showExportPeriod2Menu ? "menu-open" : null)">
                                    <div class="period-to-label">TO</div>

                                    <div class="attendance-filter-select-wrap period-dropdown attendance-export-period-dropdown @(showExportPeriod2Menu ? "menu-open" : null)" @onclick:stopPropagation="true">
                                        <button type="button" class="period-close-btn" title="Close export period range" @onclick="ToggleExportAddPeriod">×</button>
                                        <button type="button" class="attendance-filter-select-trigger period-button @(showExportPeriod2Menu ? "active" : null)" @ref="exportPeriod2ButtonRef" @onclick="ToggleExportPeriod2Menu">
                                            <span class="period-button-content">
                                                <span class="period-label">Period:</span>
                                                <span class="period-selected">@ExportSelectedPeriod2Label</span>
                                                @if (exportSecondSelectedPeriod?.IsCurrent == true)
                                                {
                                                    <span class="period-current-text">(Current)</span>
                                                }
                                            </span>
                                            <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                        </button>

                                        <div class="@GetExportPeriodMenuClass(showExportPeriod2Menu, openExportPeriod2MenuUpward)" @onclick:stopPropagation="true">
                                            @foreach (var p in periods)
                                            {
                                                var itemId = exportSecondSelectedPeriod == p ? "dashboard-export-period-2-selected-item" : null;
                                                <button type="button" class="attendance-filter-select-option period-option @(exportSecondSelectedPeriod == p ? "active" : null)" id="@itemId" @onclick="() => SelectExportSecondPeriod(p)">
                                                    <span class="period-option-label">@p.Label</span>
                                                    @if (p.IsCurrent)
                                                    {
                                                        <span class="period-current-text">(Current)</span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="attendance-detail-footer">
                    <button type="button" class="attendance-detail-text-action" @onclick="CloseExportLogsModal" disabled="@isExportingLogs">Cancel</button>
                    <button type="button" class="btn btn-primary attendance-detail-done" @onclick="ExportAttendanceLogsAsync" disabled="@isExportingLogs">@(isExportingLogs ? "Exporting..." : "Export")</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .dashboard-grid .panel-heading {
        align-items: center;
    }

    .dashboard-grid .panel-heading h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
    }

    .dashboard-log-grid {
        grid-template-columns: repeat(2, minmax(320px, 1fr));
        align-items: stretch;
    }

    .dashboard-chart-row {
        display: grid;
        grid-template-columns: minmax(0, 60%) minmax(320px, 40%);
        gap: 1rem;
        align-items: stretch;
    }

    .dashboard-log-card,
    .dashboard-chart-card,
    .dashboard-pie-card {
        min-width: 0;
    }

    .dashboard-log-card {
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .dashboard-log-card .table-responsive {
        flex: 1 1 auto;
    }

    .dashboard-chart-card,
    .dashboard-pie-card {
        display: flex;
        flex-direction: column;
