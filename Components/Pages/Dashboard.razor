    private bool MatchesLogSearch(string? idNumber, string? lastName, string? firstName, string? middleName)
    {
        var query = viewMoreSearchText.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return ContainsText(idNumber, query)
            || ContainsText(firstName, query)
            || ContainsText(middleName, query)
            || ContainsText(lastName, query)
            || ContainsText(FormatName(lastName ?? string.Empty, firstName ?? string.Empty, middleName ?? string.Empty), query);
    }

    private static bool ContainsText(string? source, string query)
        => !string.IsNullOrWhiteSpace(source)
            && source.Contains(query, StringComparison.OrdinalIgnoreCase);

