        padding: 0.55rem 0.75rem;
        border: 1px solid var(--finance-border);
        border-radius: 6px;
        background: #ffffff;
        color: var(--finance-text);
        box-shadow: 0 10px 24px rgba(30, 41, 57, 0.12);
        font-size: 0.8rem;
        font-weight: 500;
    }

