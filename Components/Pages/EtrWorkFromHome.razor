@page "/etr/etr-work-from-home"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Financial.Data
@using Financial.Model.Dtr
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Net.Mail
@using System.Security.Cryptography
@using System.Text.RegularExpressions
@inject ProcurementDbContext Db
@inject IToastService ToastService
@inject IWebHostEnvironment Environment
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IAttendanceEmailService AttendanceEmailService
@inject IJSRuntime JS
@inject NavigationManager NavManager
@layout BlankLayout

@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>ETRS</PageTitle>

<div class="etr-shell">
    <div class="etr-stage">
        <section class="etr-copy-panel" aria-labelledby="etrWfhTitle">
            <div class="etr-logo-row">
                <img class="etr-logo etr-logo-bagong" src="@Assets["images/bagong-pilipinas.png"]" alt="bagong-pilipinas" />
                <img class="etr-logo" src="@Assets["images/bswm-light.png"]" alt="bswm" />
            </div>
            <div class="etr-copy-content">
                <h1 id="etrWfhTitle" class="etr-title">Electronic Time Record<br>Work From Home</h1>
                <div class="etr-sub">
                    <p>Log your WFH attendance using your employee ID number and complete photo verification.</p>
                    <p>Time in records your target, while time out records your accomplishment and optional MOV upload.</p>
                </div>
            </div>
        </section>

        <div class="etr-form-wrap">
            <button type="button"
                    class="etr-attendance-request-button"
                    title="Request attendance logs by email"
                    aria-label="Request attendance logs by email"
                    @onclick="OpenAttendanceRequestAsync">
                <i class="fa-regular fa-address-book" aria-hidden="true"></i>
                <span class="etr-attendance-request-label">Request Logs</span>
            </button>
            <EditForm EditContext="editContext" OnSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <label class="required-star">Attendance</label>
                    <div class="options-row">
                        <button type="button"
                                class="@GetOptionClass("IN")"
                                @onclick='() => SelectLogType("IN")'
                                >
                            <span class="option-indicator" aria-hidden="true"></span>
                            <div class="opt-title">IN</div>
                            <div class="opt-sub">Start of work</div>
                        </button>

                        <button type="button"
                                class="@GetOptionClass("OUT")"
                                @onclick='() => SelectLogType("OUT")'
                                >
                            <span class="option-indicator" aria-hidden="true"></span>
                            <div class="opt-title">OUT</div>
                            <div class="opt-sub">End of work</div>
                        </button>
                    </div>
                </div>

                <div class="form-row">
                    <label class="required-star">ID Number</label>
                    <div class="employee-search-wrap" @ref="employeeSearchWrapRef">
                        <div class="employee-search-input-wrap">
                            <input
                                value="@employeeSearchText"
                                @oninput="HandleIdInputChanged"
                                @onfocus="HandleIdInputFocus"
                                class="etr-input employee-search-input field-control"
                                disabled="@isSubmitting"
                                autocomplete="off" />
                            <span class="employee-search-icon" aria-hidden="true">Search</span>
                        </div>

                        <div class="@GetEmployeeOverlayClass()">
                            @if (showEmployeeResults)
                            {
                                @if (employeeSearchResults.Count == 0)
                                {
                                    <div class="employee-empty-state">No Employee Found</div>
                                }
                                else
                                {
                                    <div class="employee-results-grid">
                                        @foreach (var employee in employeeSearchResults)
                                        {
                                            <button type="button" class="@GetEmployeeResultClass(employee)" @onclick="() => SelectEmployee(employee)">
                                                <span class="employee-result-id">@employee.IdNumber</span>
                                                <span class="employee-result-name">@FormatEmployeeName(employee)</span>
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <label class="required-star">Verification</label>
                    <button type="button"
                            class="@GetVerificationButtonClass()"
                            @onclick="OpenVerificationAsync"
                            disabled="@isSubmitting">
                        <span>@VerificationButtonText</span>
                        <span class="verification-button-status" aria-label="@VerificationStatusLabel">
                            @if (HasCompletedVerification)
                            {
                                <i class="fa-solid fa-check" aria-hidden="true"></i>
                            }
                        </span>
                    </button>
                </div>

                <div class="@GetSectionClass("IN")" aria-hidden="@(entryModel.LogType != "IN")">
                    <div class="form-row">
                        <label class="required-star">Target</label>
                        <textarea value="@entryModel.Target"
                                  @oninput="HandleTargetInputChanged"
                                  class="etr-textarea field-control"
                                  disabled="@isSubmitting"></textarea>
                    </div>

                    <div class="section-spacer" aria-hidden="true"></div>
                </div>

                <div class="@GetSectionClass("OUT")" aria-hidden="@(entryModel.LogType != "OUT")">
                    <div class="form-row">
                        <label class="required-star">Accomplishment</label>
                        <textarea value="@entryModel.Accomplishment"
                                  @oninput="HandleAccomplishmentInputChanged"
                                  class="etr-textarea field-control"
                                  disabled="@isSubmitting"></textarea>
                    </div>

                    <div class="form-row">
                        <label>Means of Verification</label>
                        <div class="file-upload-wrap">
                            <label for="movUpload" class="etr-file-button">Choose Files</label>
                            <InputFile id="movUpload"
                                       class="etr-file-input"
                                       OnChange="HandleMovSelected"
                                       accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.ppt,.pptx,.jpg,.jpeg,.png,.txt"
                                       multiple
                                       disabled="@isSubmitting" />
                            <span class="upload-note upload-file-name">@GetMovUploadLabel()</span>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="etr-submit" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner" aria-hidden="true"></span><span>Submitting&#8230;</span>
                        }
                        else
                        {
                            <span>Submit</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    @if (showAttendanceRequestModal)
    {
        <div class="attendance-detail-overlay" @onclick="CloseAttendanceRequestModal">
            <div class="attendance-detail-modal etr-attendance-request-modal" @onclick="CloseAttendanceRequestPeriodMenus" @onclick:stopPropagation="true">
                <div class="attendance-detail-header">
                    <div>
                        <h2 class="attendance-detail-title">Request Logs</h2>
                    </div>
                    <button type="button" class="attendance-detail-close" @onclick="CloseAttendanceRequestModal" aria-label="Close request" disabled="@isSubmittingAttendanceRequest">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="attendance-detail-body etr-request-body">
                    <p class="etr-request-intro">Enter your employee details and email address. Use an email address named after you so the Request Approver can verify your identity before ETRS sends your records.</p>

                    <div class="etr-request-field">
                        <label for="attendanceRequestEmployee">ID Number</label>
                        <div class="employee-search-wrap" @ref="attendanceRequestSearchWrapRef">
                            <div class="employee-search-input-wrap">
                                <input id="attendanceRequestEmployee"
                                       class="etr-input employee-search-input field-control"
                                       value="@attendanceRequestSearchText"
                                       @oninput="HandleAttendanceRequestSearchChanged"
                                       @onfocus="HandleAttendanceRequestInputFocus"
                                       autocomplete="off"
                                       disabled="@isSubmittingAttendanceRequest" />
                                <span class="employee-search-icon" aria-hidden="true">Search</span>
                            </div>
                            @if (showAttendanceRequestResults)
                            {
                                <div class="employee-results-overlay active etr-request-results">
                                    @if (attendanceRequestSearchResults.Count == 0)
                                    {
                                        <div class="employee-empty-state">No Employee Found</div>
                                    }
                                    else
                                    {
                                        <div class="employee-results-grid">
                                            @foreach (var employee in attendanceRequestSearchResults)
                                            {
                                                <button type="button" class="@GetAttendanceRequestEmployeeResultClass(employee)" @onclick="() => SelectAttendanceRequestEmployeeAsync(employee)">
                                                    <span class="employee-result-id">@employee.IdNumber</span>
                                                    <span class="employee-result-name">@FormatEmployeeName(employee)</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="etr-request-period-grid">
                        <div class="etr-request-field">
                            <label>From</label>
                            <div class="etr-request-period-dropdown" @onclick:stopPropagation="true">
                                <button type="button"
                                        class="etr-request-period-trigger @(showAttendanceRequestFromMenu ? "active" : null)"
                                        @onclick="ToggleAttendanceRequestFromMenu"
                                        disabled="@(isSubmittingAttendanceRequest || attendanceRequestPeriods.Count == 0)">
                                    <span class="etr-request-period-content">
                                        <span class="etr-request-period-selected">@AttendanceRequestFromLabel</span>
                                        @if (AttendanceRequestFromPeriod?.IsCurrent == true)
                                        {
                                            <span class="etr-request-period-current">(Current)</span>
                                        }
                                    </span>
                                    <i class="fa-solid fa-chevron-down etr-request-period-caret" aria-hidden="true"></i>
                                </button>
                                <div class="etr-request-period-menu @(showAttendanceRequestFromMenu ? "show" : null)">
                                    @foreach (var period in attendanceRequestPeriods)
                                    {
                                        <button type="button" class="etr-request-period-option @(attendanceRequestFromKey == period.Key ? "active" : null)" @onclick="() => SelectAttendanceRequestFromPeriod(period)">
                                            <span>@period.Label</span>
                                            @if (period.IsCurrent)
                                            {
                                                <span class="etr-request-period-current">(Current)</span>
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="etr-request-field">
                            <label>To</label>
                            <div class="etr-request-period-dropdown" @onclick:stopPropagation="true">
                                <button type="button"
                                        class="etr-request-period-trigger @(showAttendanceRequestToMenu ? "active" : null)"
                                        @onclick="ToggleAttendanceRequestToMenu"
                                        disabled="@(isSubmittingAttendanceRequest || attendanceRequestPeriods.Count == 0)">
                                    <span class="etr-request-period-content">
                                        <span class="etr-request-period-selected">@AttendanceRequestToLabel</span>
                                        @if (AttendanceRequestToPeriod?.IsCurrent == true)
                                        {
                                            <span class="etr-request-period-current">(Current)</span>
                                        }
                                    </span>
                                    <i class="fa-solid fa-chevron-down etr-request-period-caret" aria-hidden="true"></i>
                                </button>
                                <div class="etr-request-period-menu @(showAttendanceRequestToMenu ? "show" : null)">
                                    @foreach (var period in attendanceRequestPeriods)
                                    {
                                        <button type="button" class="etr-request-period-option @(attendanceRequestToKey == period.Key ? "active" : null)" @onclick="() => SelectAttendanceRequestToPeriod(period)">
                                            <span>@period.Label</span>
                                            @if (period.IsCurrent)
                                            {
                                                <span class="etr-request-period-current">(Current)</span>
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="etr-request-field">
                        <label for="attendanceRequestEmail">Email address</label>
                        <input id="attendanceRequestEmail"
                               type="email"
                               class="etr-input field-control"
                               @bind="attendanceRequestEmail"
                               autocomplete="email"
                               disabled="@isSubmittingAttendanceRequest" />
                    </div>
                </div>

                <div class="attendance-detail-footer">
                    <button type="button" class="attendance-detail-text-action" @onclick="CloseAttendanceRequestModal" disabled="@isSubmittingAttendanceRequest">Cancel</button>
                    <button type="button" class="btn attendance-detail-done etr-request-submit" @onclick="SubmitAttendanceRequestAsync" disabled="@isSubmittingAttendanceRequest">
                        @if (isSubmittingAttendanceRequest)
                        {
                            <span class="spinner" aria-hidden="true"></span><span>Submitting...</span>
                        }
                        else
                        {
                            <span>Submit request</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    @if (showSubmitConfirmation && selectedEmployee is not null)
    {
        <div class="attendance-detail-overlay" @onclick="CloseSubmitConfirmation">
            <div class="attendance-detail-modal etr-confirmation-modal" @onclick:stopPropagation="true">
                <div class="attendance-detail-header">
                    <div>
                        <h2 class="attendance-detail-title">Confirm WFH @entryModel.LogType</h2>
                    </div>
                    <button type="button" class="attendance-detail-close" @onclick="CloseSubmitConfirmation" aria-label="Close confirmation" disabled="@isSubmitting">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="attendance-detail-body">
                    <div class="attendance-detail-section attendance-detail-hero">
                        <div>
                            <div class="attendance-detail-eyebrow">Employee Verification</div>
                            <div class="attendance-detail-person">@FormatEmployeeName(selectedEmployee)</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(photoVerificationImage))
                        {
                            <img class="confirmation-photo-thumb" src="@photoVerificationImage" alt="Photo verification" />
                        }
                        else if (!string.IsNullOrWhiteSpace(emailVerificationVerifiedEmail))
                        {
                            <div class="confirmation-photo-thumb confirmation-photo-placeholder">
                                <i class="fa-solid fa-envelope-circle-check" aria-hidden="true"></i>
                                <span>Email Verified</span>
                            </div>
                        }
                        else
                        {
                            <div class="confirmation-photo-thumb confirmation-photo-placeholder">No Verification</div>
                        }
                    </div>

                    <div class="attendance-detail-section attendance-detail-section-primary">
                        <div class="attendance-detail-grid">
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">ID Number</span>
                                <strong>@DisplayValue(selectedEmployee.IdNumber)</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Attendance Date</span>
                                <strong>@DateTime.Today.ToString("MMMM d, yyyy")</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Division/Center/Admin Unit</span>
                                <strong>@DisplayValue(selectedEmployee.DivisionCenterUnit)</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Designation</span>
                                <strong>@DisplayValue(selectedEmployee.Designation)</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Time In</span>
                                <strong>@FormatClockTime(confirmationTimeIn)</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Time Out</span>
                                <strong>@FormatClockTime(confirmationTimeOut)</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="attendance-detail-footer">
                    <button type="button" class="attendance-detail-text-action" @onclick="CloseSubmitConfirmation" disabled="@isSubmitting">Cancel</button>
                    <button type="button" class="btn btn-primary attendance-detail-done" @onclick="ConfirmSubmitAsync" disabled="@isSubmitting">
                        @(isSubmitting ? "Submitting..." : $"Confirm {entryModel.LogType}")
                    </button>
                </div>
            </div>
        </div>
    }

    @* Email verification UI removed — only photo verification is available *@

    @if (showPhotoVerificationModal)
    {
        <div class="attendance-detail-overlay" @onclick="ClosePhotoVerificationModalAsync">
            <div class="@GetPhotoModalClass()" @onclick:stopPropagation="true">
                @if (isPhotoCaptureClosing)
                {
                    <div class="etr-photo-spotlight" aria-hidden="true"></div>
                }
                <div class="attendance-detail-header">
                    <div>
                        <h2 class="attendance-detail-title">Photo Verification</h2>
                    </div>
                    <button type="button" class="attendance-detail-close" @onclick="ClosePhotoVerificationModalAsync" aria-label="Close photo verification">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="attendance-detail-body">
                    <div class="attendance-detail-section attendance-detail-hero">
                        <div>
                            <div class="attendance-detail-eyebrow">Camera Check</div>
                            <div class="attendance-detail-person">@PhotoVerificationStatusText</div>
                            <div class="attendance-detail-meta">Take a clear photo before submitting the WFH log.</div>
                        </div>
                        <div class="attendance-detail-status">WFH @entryModel.LogType</div>
                    </div>

                    <div class="@GetPhotoCameraSectionClass()">
                        <div class="@GetPhotoCameraFrameClass()">
                            @if (!string.IsNullOrWhiteSpace(photoVerificationImage))
                            {
                                <img src="@photoVerificationImage" alt="Captured verification" />
                            }
                            else
                            {
                                <video @ref="photoVideoRef" autoplay playsinline muted></video>
                                <div class="etr-camera-guide" aria-hidden="true">
                                    <span class="etr-face-oval"></span>
                                    <span class="etr-face-center"></span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(photoCameraMessage))
                                {
                                    <div class="etr-camera-message">@photoCameraMessage</div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="attendance-detail-footer etr-photo-footer">
                    <button type="button" class="attendance-detail-text-action" @onclick="ClosePhotoVerificationModalAsync">Close</button>
                    <div class="etr-photo-actions">
                        @if (!string.IsNullOrWhiteSpace(photoVerificationImage))
                        {
                            <button type="button" class="btn btn-outline-secondary attendance-detail-done etr-photo-action-button etr-photo-secondary" @onclick="RetakePhotoAsync" disabled="@isPhotoCaptureClosing">Retake</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary attendance-detail-done etr-photo-action-button" @onclick="CapturePhotoAsync" disabled="@(isPhotoCaptureClosing || isPhotoValidating)">
                                @(isPhotoValidating ? "Capturing..." : "Capture")
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .etr-shell {
        --etrs-black: #1e2939;
        --etrs-gray-950: #1e2939;
        --etrs-gray-900: #334155;
        --etrs-gray-800: #475569;
        --etrs-gray-700: #64748b;
        --etrs-gray-600: #94a3b8;
        --etrs-gray-500: #cbd5e1;
        --etrs-gray-400: #dbe2ea;
        --etrs-gray-300: #e2e8f0;
        --etrs-gray-200: #edf2f7;
        --etrs-gray-100: #f5f7fa;
        --etrs-gray-50: #f8fafc;
        --etrs-surface: #ffffff;
        --etrs-surface-soft: #f5f7fa;
        --etrs-border: #e2e8f0;
        --etrs-border-soft: #edf2f7;
        --etrs-text: #1e2939;
        --etrs-text-muted: #64748b;
        --etrs-brand: #2f6b3d;
        --etrs-brand-strong: #204d2b;
        --etrs-gold: #d7b252;
        --finance-surface: #ffffff;
        --finance-surface-soft: #f5f7fa;
        --finance-border: #e2e8f0;
        --finance-border-soft: #edf2f7;
        --finance-text: #1e2939;
        --finance-text-muted: #64748b;
        --finance-brand: #1e2939;
        --finance-brand-strong: #1e2939;
        position: relative;
        box-sizing: border-box;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-image: linear-gradient(rgba(0,0,0,0.44), rgba(0,0,0,0.44)), url('@(NavManager.BaseUri)images/etr-bg.jpg');
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        overflow-x: hidden;
        padding: clamp(1.25rem, 4vw, 4.5rem);
    }

    body.etrs-dark-theme .etr-shell {
        color-scheme: light;
        color: #1e2939 !important;
        background-image: linear-gradient(rgba(0,0,0,0.44), rgba(0,0,0,0.44)), url('@(NavManager.BaseUri)images/etr-bg.jpg') !important;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-item {
        background: #ffffff !important;
        border-top-color: transparent !important;
        border-right-color: transparent !important;
        border-bottom-color: transparent !important;
        color: #1e2939 !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06) !important;
        color-scheme: light;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-title {
        color: #1e2939 !important;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-message {
        color: #64748b !important;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-close {
        color: #64748b !important;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-info {
        border-left-color: #cfe9ff !important;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-info .toast-left {
        background: #e6f3ff !important;
        color: #1762a6 !important;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-success {
        border-left-color: #cfead6 !important;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-success .toast-left {
        background: #e8fbec !important;
        color: #2e8b4a !important;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-warning {
        border-left-color: #ffefc6 !important;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-warning .toast-left {
        background: #fff7e6 !important;
        color: #b97a00 !important;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-error {
        border-left-color: #ffd6d6 !important;
    }

    body.etrs-dark-theme:has(.etr-shell) .toast-error .toast-left {
        background: #fdecec !important;
        color: #b32a2a !important;
    }

    body.etrs-dark-theme .etr-shell .etr-copy-panel,
    body.etrs-dark-theme .etr-shell .etr-title,
    body.etrs-dark-theme .etr-shell .etr-sub,
    body.etrs-dark-theme .etr-shell .form-row label,
    body.etrs-dark-theme .etr-shell .required-star,
    body.etrs-dark-theme .etr-shell .upload-note {
        color: #ffffff !important;
    }

    body.etrs-dark-theme .etr-shell .etr-input,
    body.etrs-dark-theme .etr-shell .etr-textarea,
    body.etrs-dark-theme .etr-shell input,
    body.etrs-dark-theme .etr-shell textarea {
        background: #ffffff !important;
        border-color: transparent !important;
        color: #1f2937 !important;
    }

    body.etrs-dark-theme .etr-shell .file-upload-wrap .etr-file-button {
        background: #ffffff !important;
        border-color: #e5e7eb !important;
        color: #111827 !important;
        opacity: 1 !important;
    }

    body.etrs-dark-theme .etr-shell .file-upload-wrap .etr-file-button:hover {
        background: #f8fafc !important;
        border-color: #d1d5db !important;
        color: #111827 !important;
    }

    body.etrs-dark-theme .etr-shell .etr-file-input::file-selector-button,
    body.etrs-dark-theme .etr-shell .etr-file-input::-webkit-file-upload-button {
        background: #ffffff !important;
        border-color: #e5e7eb !important;
        color: #111827 !important;
    }

    body.etrs-dark-theme .etr-shell .employee-search-icon,
    body.etrs-dark-theme .etr-shell .etr-input::placeholder,
    body.etrs-dark-theme .etr-shell .etr-textarea::placeholder {
        color: #4b5563 !important;
    }

    body.etrs-dark-theme .etr-shell .verification-button {
        background: #ffffff !important;
