    private async Task SubmitAttendanceRequestAsync()
    {
        var employee = attendanceRequestEmployee;
        var fromPeriod = attendanceRequestPeriods.FirstOrDefault(period => period.Key == attendanceRequestFromKey);
        var toPeriod = attendanceRequestPeriods.FirstOrDefault(period => period.Key == attendanceRequestToKey);
        if (employee is null)
        {
            ShowAttendanceRequestToast(ToastType.Warning, "Select employee", "Choose an employee from the search results.");
            return;
        }
        if (fromPeriod is null || toPeriod is null)
        {
            ShowAttendanceRequestToast(ToastType.Warning, "Select period", "Choose the attendance period to send.");
            return;
        }
        if (!IsValidEmailAddress(attendanceRequestEmail))
        {
            ShowAttendanceRequestToast(ToastType.Warning, "Invalid email", "Enter a valid recipient email address.");
            return;
        }

        var start = fromPeriod.Start <= toPeriod.Start ? fromPeriod.Start : toPeriod.Start;
        var end = fromPeriod.End >= toPeriod.End ? fromPeriod.End : toPeriod.End;
        var recipient = attendanceRequestEmail.Trim();
        isSubmittingAttendanceRequest = true;
        try
        {
            var duplicate = await Db.AttendanceEmailRequests.AsNoTracking().AnyAsync(request =>
                request.EmployeeId == employee.EmployeeId
                && request.RecipientEmail == recipient
                && request.PeriodStart == start
                && request.PeriodEnd == end
                && request.Status == "Pending");
            if (duplicate)
            {
                ShowAttendanceRequestToast(ToastType.Information, "Request already pending", "The same attendance request is already waiting for approval.");
                return;
            }

            Db.AttendanceEmailRequests.Add(new AttendanceEmailRequest
            {
                EmployeeId = employee.EmployeeId,
                IdNumber = employee.IdNumber,
                EmployeeName = FormatEmployeeName(employee),
                RecipientEmail = recipient,
                PeriodStart = start,
                PeriodEnd = end,
                Status = "Pending",
                RequestedAt = DateTime.UtcNow
            });
            await Db.SaveChangesAsync();
            showAttendanceRequestResults = false;
            await UnregisterAttendanceRequestOutsideClickAsync();
            showAttendanceRequestModal = false;
            ShowAttendanceRequestToast(ToastType.Success, "Request submitted", "Your attendance request is waiting for approval.");
        }
        catch (Exception)
        {
            ShowAttendanceRequestToast(ToastType.Error, "Request failed", "The attendance request could not be submitted. Please try again.");
        }
        finally
        {
            isSubmittingAttendanceRequest = false;
        }
    }

