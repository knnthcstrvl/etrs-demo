            .Select(log => log.AttendanceDate)
            .Distinct()
            .ToListAsync();
        var wfhDates = await Db.AttendanceLogsWfh.AsNoTracking()
            .Where(log => log.EmployeeId == employeeId)
            .Select(log => log.AttendanceDate)
            .Distinct()
            .ToListAsync();

        attendanceRequestPeriods = onsiteDates.Concat(wfhDates).Append(DateTime.Today)
            .Select(BuildAttendanceRequestPeriod)
            .GroupBy(period => period.Start)
            .Select(group => group.First())
            .OrderByDescending(period => period.Start)
            .ToList();

        var current = attendanceRequestPeriods.First();
        attendanceRequestFromKey = current.Key;
        attendanceRequestToKey = current.Key;
    }

    private static AttendanceRequestPeriod BuildAttendanceRequestPeriod(DateTime date)
    {
        var start = date.Day <= 15
            ? new DateTime(date.Year, date.Month, 1)
            : new DateTime(date.Year, date.Month, 16);
        var end = date.Day <= 15
            ? new DateTime(date.Year, date.Month, 15)
            : new DateTime(date.Year, date.Month, DateTime.DaysInMonth(date.Year, date.Month));
        return new AttendanceRequestPeriod(start, end, $"{start:MMM dd} - {end:dd}, {end:yyyy}");
    }

