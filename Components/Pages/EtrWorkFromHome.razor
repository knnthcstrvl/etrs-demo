    private async Task CapturePhotoAsync()
    {
        if (!showPhotoVerificationModal || isPhotoValidating || !string.IsNullOrWhiteSpace(photoVerificationImage))
        {
            return;
        }

        isPhotoValidating = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await JS.InvokeAsync<PhotoCaptureValidationResult>("etrWorkFromHome.capturePhoto", photoVideoRef);
            if (!result.IsValid || string.IsNullOrWhiteSpace(result.DataUrl))
            {
                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = string.IsNullOrWhiteSpace(result.Title) ? "Photo capture failed" : result.Title,
                    Message = string.IsNullOrWhiteSpace(result.Message) ? "Wait for the camera preview and try again." : result.Message,
                    Duration = 5000
                });
                return;
            }

            photoVerificationImage = result.DataUrl;
            ResetEmailVerification(keepModalState: false);
            photoCameraMessage = string.Empty;
            await StopPhotoCameraAsync();
            isPhotoCaptureClosing = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(2000);

            if (isPhotoCaptureClosing)
            {
                await ClosePhotoVerificationModalAsync();
            }
        }
        catch
        {
            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Error,
                Title = "Photo capture unavailable",
                Message = "The photo could not be captured. Wait for the camera preview and try again.",
                Duration = 5000
            });
        }
        finally
        {
            isPhotoValidating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RetakePhotoAsync()
    {
        photoVerificationImage = string.Empty;
        photoCameraMessage = string.Empty;
        isPhotoCaptureClosing = false;
        isPhotoValidating = false;
        pendingStartPhotoCamera = true;
