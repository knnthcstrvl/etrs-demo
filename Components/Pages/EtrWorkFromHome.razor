@page "/etr-work-from-home"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Financial.Data
@using Financial.Model.Dtr
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@inject ProcurementDbContext Db
@inject IToastService ToastService
@inject IWebHostEnvironment Environment
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IJSRuntime JS
@layout BlankLayout

@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>ETRS</PageTitle>

<div class="etr-shell">
    <div class="etr-stage">
        <section class="etr-copy-panel" aria-labelledby="etrWfhTitle">
            <div class="etr-logo-row">
                <img class="etr-logo etr-logo-bagong" src="/images/bagong-pilipinas.png" alt="bagong-pilipinas" />
                <img class="etr-logo" src="/images/bswm-light.png" alt="bswm" />
            </div>
            <div class="etr-copy-content">
                <h1 id="etrWfhTitle" class="etr-title">Electronic Time Record<br>Work From Home</h1>
                <div class="etr-sub">
                    <p>Log your WFH attendance using your employee ID number.</p>
                    <p>Time in records target, while time out records accomplishment and optional MOV upload.</p>
                </div>
            </div>
        </section>

        <div class="etr-form-wrap">
            <EditForm EditContext="editContext" OnSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <label class="required-star">Attendance</label>
                    <div class="options-row">
                        <button type="button"
                                class="@GetOptionClass("IN")"
                                @onclick='() => SelectLogType("IN")'
                                >
                            <span class="option-indicator" aria-hidden="true"></span>
                            <div class="opt-title">IN</div>
                            <div class="opt-sub">Start of work</div>
                        </button>

                        <button type="button"
                                class="@GetOptionClass("OUT")"
                                @onclick='() => SelectLogType("OUT")'
                                >
                            <span class="option-indicator" aria-hidden="true"></span>
                            <div class="opt-title">OUT</div>
                            <div class="opt-sub">End of work</div>
                        </button>
                    </div>
                </div>

                <div class="form-row">
                    <label class="required-star">ID Number</label>
                    <div class="employee-search-wrap" @ref="employeeSearchWrapRef">
                        <div class="employee-search-input-wrap">
                            <input
                                value="@employeeSearchText"
                                @oninput="HandleIdInputChanged"
                                @onfocus="HandleIdInputFocus"
                                class="etr-input employee-search-input field-control"
                                disabled="@isSubmitting"
                                autocomplete="off" />
                            <span class="employee-search-icon" aria-hidden="true">Search</span>
                        </div>

                        <div class="@GetEmployeeOverlayClass()">
                            @if (showEmployeeResults)
                            {
                                @if (employeeSearchResults.Count == 0)
                                {
                                    <div class="employee-empty-state">No Employee Found</div>
                                }
                                else
                                {
                                    <div class="employee-results-grid">
                                        @foreach (var employee in employeeSearchResults)
                                        {
                                            <button type="button" class="@GetEmployeeResultClass(employee)" @onclick="() => SelectEmployee(employee)">
                                                <span class="employee-result-id">@employee.IdNumber</span>
                                                <span class="employee-result-name">@FormatEmployeeName(employee)</span>
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>

                </div>

                <div class="@GetSectionClass("IN")" aria-hidden="@(entryModel.LogType != "IN")">
                    <div class="form-row">
                        <label class="required-star">Target</label>
                        <textarea value="@entryModel.Target"
                                  @oninput="HandleTargetInputChanged"
                                  class="etr-textarea field-control"
                                  disabled="@isSubmitting"></textarea>
                    </div>

                    <div class="section-spacer" aria-hidden="true"></div>
                </div>

                <div class="@GetSectionClass("OUT")" aria-hidden="@(entryModel.LogType != "OUT")">
                    <div class="form-row">
                        <label class="required-star">Accomplishment</label>
                        <textarea value="@entryModel.Accomplishment"
                                  @oninput="HandleAccomplishmentInputChanged"
                                  class="etr-textarea field-control"
                                  disabled="@isSubmitting"></textarea>
                    </div>

                    <div class="form-row">
                        <label>Means of Verification</label>
                        <div class="file-upload-wrap">
                            <label for="movUpload" class="etr-file-button">Choose File</label>
                            <InputFile id="movUpload"
                                       class="etr-file-input"
                                       OnChange="HandleMovSelected"
                                       disabled="@isSubmitting" />
                            <span class="upload-note upload-file-name">@(string.IsNullOrWhiteSpace(entryModel.MovFileName) ? "No file chosen." : entryModel.MovFileName)</span>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="etr-submit" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner" aria-hidden="true"></span><span>Submitting&#8230;</span>
                        }
                        else
                        {
                            <span>Submit</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    @if (showSubmitConfirmation && selectedEmployee is not null)
    {
        <div class="attendance-detail-overlay" @onclick="CloseSubmitConfirmation">
            <div class="attendance-detail-modal etr-confirmation-modal" @onclick:stopPropagation="true">
                <div class="attendance-detail-header">
                    <div>
                        <h2 class="attendance-detail-title">Confirm WFH @entryModel.LogType</h2>
                    </div>
                    <button type="button" class="attendance-detail-close" @onclick="CloseSubmitConfirmation" aria-label="Close confirmation" disabled="@isSubmitting">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="attendance-detail-body">
                    <div class="attendance-detail-section attendance-detail-hero">
                        <div>
                            <div class="attendance-detail-eyebrow">Employee Verification</div>
                            <div class="attendance-detail-person">@FormatEmployeeName(selectedEmployee)</div>
                            <div class="attendance-detail-meta">Confirm this is the correct employee before recording time @entryModel.LogType.</div>
                        </div>
                        <div class="attendance-detail-status">WFH @entryModel.LogType</div>
                    </div>

                    <div class="attendance-detail-section attendance-detail-section-primary">
                        <div class="attendance-detail-grid">
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">ID Number</span>
                                <strong>@DisplayValue(selectedEmployee.IdNumber)</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Attendance Date</span>
                                <strong>@DateTime.Today.ToString("MMMM d, yyyy")</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Division / Unit</span>
                                <strong>@DisplayValue(selectedEmployee.DivisionCenterUnit)</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Designation</span>
                                <strong>@DisplayValue(selectedEmployee.Designation)</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Time In</span>
                                <strong>@FormatClockTime(confirmationTimeIn)</strong>
                            </div>
                            <div class="attendance-detail-field">
                                <span class="attendance-detail-label">Time Out</span>
                                <strong>@FormatClockTime(confirmationTimeOut)</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="attendance-detail-footer">
                    <button type="button" class="attendance-detail-text-action" @onclick="CloseSubmitConfirmation" disabled="@isSubmitting">Cancel</button>
                    <button type="button" class="btn btn-primary attendance-detail-done" @onclick="ConfirmSubmitAsync" disabled="@isSubmitting">
                        @(isSubmitting ? "Submitting..." : $"Confirm {entryModel.LogType}")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .etr-shell {
        --etrs-black: #1e2939;
        --etrs-gray-950: #1e2939;
        --etrs-gray-900: #334155;
        --etrs-gray-800: #475569;
        --etrs-gray-700: #64748b;
        --etrs-gray-600: #94a3b8;
        --etrs-gray-500: #cbd5e1;
        --etrs-gray-400: #dbe2ea;
        --etrs-gray-300: #e2e8f0;
        --etrs-gray-200: #edf2f7;
        --etrs-gray-100: #f5f7fa;
        --etrs-gray-50: #f8fafc;
        --etrs-surface: #ffffff;
        --etrs-surface-soft: #f5f7fa;
        --etrs-border: #e2e8f0;
        --etrs-border-soft: #edf2f7;
        --etrs-text: #1e2939;
        --etrs-text-muted: #64748b;
        --etrs-brand: #2f6b3d;
        --etrs-brand-strong: #204d2b;
        --etrs-gold: #d7b252;
        --finance-surface: #ffffff;
        --finance-surface-soft: #f5f7fa;
        --finance-border: #e2e8f0;
        --finance-border-soft: #edf2f7;
        --finance-text: #1e2939;
        --finance-text-muted: #64748b;
        --finance-brand: #1e2939;
        --finance-brand-strong: #1e2939;
        position: relative;
        box-sizing: border-box;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-image: linear-gradient(rgba(0,0,0,0.44), rgba(0,0,0,0.44)), url('/images/etr-bg.jpg');
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        overflow-x: hidden;
        padding: clamp(1.25rem, 4vw, 4.5rem);
    }

    body.etrs-dark-theme .etr-shell {
        color-scheme: light;
        color: #1e2939 !important;
        background-image: linear-gradient(rgba(0,0,0,0.44), rgba(0,0,0,0.44)), url('/images/etr-bg.jpg') !important;
    }

    body.etrs-dark-theme .etr-shell .etr-copy-panel,
    body.etrs-dark-theme .etr-shell .etr-title,
    body.etrs-dark-theme .etr-shell .etr-sub,
    body.etrs-dark-theme .etr-shell .form-row label,
    body.etrs-dark-theme .etr-shell .required-star,
    body.etrs-dark-theme .etr-shell .upload-note {
        color: #ffffff !important;
    }

    body.etrs-dark-theme .etr-shell .etr-input,
    body.etrs-dark-theme .etr-shell .etr-textarea,
    body.etrs-dark-theme .etr-shell input,
    body.etrs-dark-theme .etr-shell textarea {
        background: #ffffff !important;
        border-color: transparent !important;
        color: #1f2937 !important;
    }

    body.etrs-dark-theme .etr-shell .file-upload-wrap .etr-file-button {
        background: #ffffff !important;
        border-color: #e5e7eb !important;
        color: #111827 !important;
        opacity: 1 !important;
    }

    body.etrs-dark-theme .etr-shell .file-upload-wrap .etr-file-button:hover {
        background: #f8fafc !important;
        border-color: #d1d5db !important;
        color: #111827 !important;
    }

    body.etrs-dark-theme .etr-shell .etr-file-input::file-selector-button,
    body.etrs-dark-theme .etr-shell .etr-file-input::-webkit-file-upload-button {
        background: #ffffff !important;
        border-color: #e5e7eb !important;
        color: #111827 !important;
    }

    body.etrs-dark-theme .etr-shell .employee-search-icon,
    body.etrs-dark-theme .etr-shell .etr-input::placeholder,
    body.etrs-dark-theme .etr-shell .etr-textarea::placeholder {
        color: #4b5563 !important;
    }

    body.etrs-dark-theme .etr-shell .option-card {
        background: #ffffff !important;
        border-color: #ffffff !important;
        color: #111827 !important;
    }

    body.etrs-dark-theme .etr-shell .option-card.selected {
        border-color: #10b981 !important;
        box-shadow: 0 0 0 3px rgba(16,185,129,0.18) !important;
    }

    body.etrs-dark-theme .etr-shell .employee-results-overlay {
        background: rgba(255,255,255,0.96) !important;
        border-color: rgba(209,213,219,0.9) !important;
        color: #111827 !important;
    }

    body.etrs-dark-theme .etr-shell .employee-result-card {
        background: #ffffff !important;
        border-color: #d1d5db !important;
        color: #111827 !important;
    }

    body.etrs-dark-theme .etr-shell .employee-result-name,
    body.etrs-dark-theme .etr-shell .employee-empty-state {
        color: #6b7280 !important;
    }

    body.etrs-dark-theme .etr-shell .etr-submit,
    body.etrs-dark-theme .etr-shell .btn-primary {
        background: #ebca4a !important;
        border-color: #ebca4a !important;
        color: #111827 !important;
    }

    body.etrs-dark-theme .etr-shell .attendance-detail-modal,
    body.etrs-dark-theme .etr-shell .attendance-detail-header,
    body.etrs-dark-theme .etr-shell .attendance-detail-footer,
    body.etrs-dark-theme .etr-shell .attendance-detail-section,
    body.etrs-dark-theme .etr-shell .attendance-detail-field {
        background: #ffffff !important;
        border-color: #e2e8f0 !important;
        color: #1e2939 !important;
    }

    body.etrs-dark-theme .etr-shell .attendance-detail-label,
    body.etrs-dark-theme .etr-shell .attendance-detail-meta,
    body.etrs-dark-theme .etr-shell .attendance-detail-eyebrow,
    body.etrs-dark-theme .etr-shell .attendance-detail-text-action {
        color: #64748b !important;
    }

    .etr-stage {
        width: min(100%, 1320px);
        display: grid;
        grid-template-columns: minmax(520px, 560px) minmax(440px, 520px);
        align-items: center;
        gap: clamp(6rem, 12vw, 12rem);
    }

    .etr-copy-panel {
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        color: #ffffff;
    }

    .etr-logo-row {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        margin-bottom: clamp(1rem, 3vh, 1.75rem);
    }

    .etr-logo {
        width: clamp(72px, 8vw, 112px);
        height: auto;
        object-fit: contain;
        filter: drop-shadow(0 8px 16px rgba(0,0,0,0.35));
    }

    .etr-logo-bagong {
        width: clamp(58px, 6.6vw, 94px);
    }

    .etr-copy-content {
        width: 100%;
        text-align: left;
        margin-inline: auto;
    }

    .etr-title {
        margin: 0 0 1.25rem;
        font-size: clamp(1.8rem, 3.45vw, 2.75rem);
        line-height: 1.08;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: 0;
        white-space: nowrap;
        text-shadow: 0 4px 18px rgba(0,0,0,0.42);
    }

    .etr-sub {
        margin: 0;
        max-width: none;
        color: rgba(255,255,255,0.95);
        font-size: clamp(0.8rem, 1.05vw, 0.9rem);
        line-height: 1.5;
        text-shadow: 0 3px 14px rgba(0,0,0,0.38);
    }

    .etr-sub p {
        margin: 0;
    }

    .etr-sub p + p {
        margin-top: 0.45rem;
    }

    .etr-form-wrap {
        width: 100%;
        padding: 1.15rem;
        border-radius: 24px;
        background: linear-gradient(180deg, rgba(255,255,255,0.18), rgba(255,255,255,0.08));
        border: 1px solid rgba(255,255,255,0.2);
        box-shadow: 0 18px 40px rgba(0,0,0,0.24);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }

    @@media (max-width: 1024px) {
        .etr-stage {
            grid-template-columns: 1fr;
            gap: 1.5rem;
            max-width: 620px;
        }

        .etr-copy-panel {
            min-height: 0;
        }

        .etr-logo-row {
            margin-bottom: 1rem;
        }

        .etr-title {
            font-size: clamp(1.7rem, 5.4vw, 2.2rem);
        }
    }

    @@media (max-width: 640px) {
        .etr-shell {
            align-items: flex-start;
            padding: 1rem;
        }

        .etr-stage {
            gap: 1rem;
        }

        .etr-logo {
            width: 68px;
        }

        .etr-logo-bagong {
            width: 58px;
        }

        .etr-copy-content {
            max-width: 360px;
            text-align: center;
        }

        .etr-sub {
            margin-inline: auto;
        }

        .etr-title {
            font-size: 1.55rem;
            white-space: normal;
        }

        .etr-sub {
            font-size: 0.78rem;
        }
    }

    .form-row {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-bottom: 0.75rem;
        position: relative;
    }

    .form-row label,
    .required-star,
    .upload-note {
        color: #ffffff;
    }

    .etr-input,
    .etr-textarea {
        width: 100%;
        border: 1px solid transparent;
        border-radius: 10px;
        padding: 0.6rem 0.75rem;
        box-sizing: border-box;
        min-width: 0;
        display: block;
        background: #ffffff;
        color: #1f2937;
        font-size: 0.9rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .etr-textarea {
        min-height: 110px;
        line-height: 1.5;
        resize: vertical;
    }

    .field-control:focus,
    .option-card:focus {
        outline: none;
    }

    .etr-form-wrap .field-control:focus {
        border-color: #ebca4a !important;
        box-shadow: none;
    }

    .employee-search-wrap {
        position: relative;
    }

    .employee-search-input-wrap {
        position: relative;
    }

    .employee-search-input {
        padding-right: 5.5rem;
    }

    .employee-search-icon {
        position: absolute;
        top: 50%;
        right: 0.9rem;
        transform: translateY(-50%);
        color: #4b5563;
        font-size: 0.82rem;
        font-weight: 600;
        pointer-events: none;
    }

    .employee-results-overlay {
        position: absolute;
        top: calc(100% + 0.45rem);
        left: 0;
        right: 0;
        z-index: 20;
        padding: 0.8rem;
        border-radius: 10px;
        background: rgba(255,255,255,0.96);
        border: 1px solid rgba(209,213,219,0.9);
        box-shadow: 0 16px 34px rgba(15,23,42,0.2);
        max-height: 280px;
        overflow-y: auto;
        opacity: 0;
        transform: translateY(-6px);
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .employee-results-overlay.active {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    .employee-results-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.7rem;
    }

    .employee-result-card {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        width: 100%;
        padding: 0.8rem 0.85rem;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        background: #ffffff;
        text-align: left;
        color: #111827;
        opacity: 0;
        transform: translateY(8px);
        animation: employee-card-in 0.22s ease forwards;
    }

    .employee-result-card.selected {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16,185,129,0.14);
    }

    .employee-result-id {
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .employee-result-name {
        font-size: 0.78rem;
        color: #6b7280;
        line-height: 1.35;
    }

    .employee-empty-state {
        padding: 0.5rem 0.15rem;
        color: #6b7280;
        font-size: 0.9rem;
    }

    .transition-panel {
        overflow: hidden;
        max-height: 0;
        opacity: 0;
        transform: translateY(10px);
        pointer-events: none;
        transition: max-height 0.3s ease, opacity 0.25s ease, transform 0.25s ease, margin-bottom 0.3s ease;
        margin-bottom: 0;
    }

    .transition-panel.active {
        max-height: 320px;
        opacity: 1;
        overflow: visible;
        transform: translateY(0);
        pointer-events: auto;
        margin-bottom: 0.75rem;
    }

    .section-spacer {
        height: 0;
    }

    .options-row { display:flex; gap:0.6rem; width:100%; }
    .option-card {
        border: 1px solid #e6e6e6;
        padding: 0.5rem 2.75rem 0.5rem 0.75rem;
        border-radius: 8px;
        flex: 1 1 50%;
        min-width: 0;
        cursor: pointer;
        background: #fff;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        position: relative;
        appearance: none;
        text-align: left;
    }

    .option-card .opt-title { font-weight: 700; color: #111827; }
    .option-card .opt-sub { font-size: 0.82rem; color: #9ca3af; }
    .option-card.selected { border-color: #10b981; box-shadow: none; }
    .option-indicator {
        position: absolute;
        top: 50%;
        right: 0.75rem;
        width: 18px;
        height: 18px;
        border: 2px solid #d1d5db;
        border-radius: 999px;
        background: #ffffff;
        transform: translateY(-50%);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .option-indicator::after {
        content: "";
        position: absolute;
        inset: 3px;
        border-radius: 999px;
        background: transparent;
        transition: background-color 0.15s ease;
    }

    .option-card.selected .option-indicator {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16,185,129,0.18);
    }

    .option-card.selected .option-indicator::after {
        background: #10b981;
    }

    .file-upload-wrap {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .etr-file-input {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .etr-file-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.6rem 0.9rem;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
        color: #111827 !important;
        cursor: pointer;
        font-size: 0.9rem;
        min-width: 116px;
    }

    .upload-file-name {
        color: #ffffff;
    }

    .form-actions { margin-top: 0.9rem; }

    .etr-submit {
        width: 100%;
        border: 0;
        border-radius: 12px;
        padding: 0.65rem 0.9rem;
        background: #ebca4a;
        color: #111827;
        font-size: 0.92rem;
        font-weight: 500;
    }

    .attendance-detail-overlay {
        position: fixed;
        inset: 0;
        z-index: 1200;
