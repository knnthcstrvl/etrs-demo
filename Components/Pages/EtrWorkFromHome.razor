    private async Task HandleValidSubmit(DateTime? submissionTime = null)
    {
        isSubmitting = true;

        try
        {
            var trimmedId = entryModel.IdNumber.Trim();
            var employee = selectedEmployee;

            if (employee is null || !string.Equals(employee.IdNumber, trimmedId, StringComparison.OrdinalIgnoreCase))
            {
                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "Select employee",
                    Message = "Choose an employee from the search results before submitting.",
                    Duration = 4000
                });
                return;
            }

            if (!IsActiveEmployeeStatus(employee.Status))
            {
                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "Inactive employee",
                    Message = $"{FormatEmployeeName(employee)} is inactive and cannot submit a WFH log.",
                    Duration = 5000
                });
                return;
            }

            var today = DateTime.Today;
            var log = await Db.AttendanceLogsWfh
                .Include(l => l.ExceptionCondition)
                .FirstOrDefaultAsync(l => l.EmployeeId == employee.EmployeeId && l.AttendanceDate == today);

            if (!CanSubmitWfhLog(log, employee))
            {
                return;
            }

            var scheduledLog = log!;

            await RefreshTimeOutVerificationRequirementAsync();

            if (!HasCompletedVerification)
            {
                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "Verification required",
                    Message = "Complete photo or email verification before submitting your WFH log.",
                    Duration = 4000
                });
                return;
            }

            var now = submissionTime ?? DateTime.Now;

            var verificationValue = string.Empty;
            if (!string.IsNullOrWhiteSpace(photoVerificationImage))
            {
                var photoPath = await SavePhotoVerificationAsync(photoVerificationImage, employee, entryModel.LogType);
                if (string.IsNullOrWhiteSpace(photoPath))
                {
                    return;
                }

                verificationValue = BuildPhotoVerificationValue(scheduledLog.Verification, photoPath, entryModel.LogType);
            }
            else
            {
                verificationValue = emailVerificationVerifiedEmail.Trim();
            }

            if (entryModel.LogType == "OUT" && !scheduledLog.TimeIn.HasValue)
            {
                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "Time IN required",
                    Message = "Record your WFH time IN first before submitting time OUT.",
                    Duration = 4000
                });
                return;
            }

            if (entryModel.LogType == "IN")
            {
                // Prevent multiple time-in records for the same day
                if (scheduledLog.TimeIn.HasValue)
                {
                    ToastService.Show(new ToastMessage
                    {
                        Type = ToastType.Warning,
                        Title = "Already clocked in",
                        Message = "You have already recorded time IN for today.",
                        Duration = 4000
                    });
                    return;
                }

                scheduledLog.TimeIn = now;
                scheduledLog.Target = entryModel.Target.Trim();
            }
            else
            {
                // Prevent multiple time-out records for the same day
                if (scheduledLog.TimeOut.HasValue)
                {
                    ToastService.Show(new ToastMessage
                    {
                        Type = ToastType.Warning,
                        Title = "Already clocked out",
                        Message = "You have already recorded time OUT for today.",
                        Duration = 4000
                    });
                    return;
                }

                scheduledLog.TimeOut = now;
                scheduledLog.Accomplishment = entryModel.Accomplishment.Trim();
                scheduledLog.Mov = await SaveMovFilesAsync(entryModel.MovFiles, employee) ?? scheduledLog.Mov;
            }

            scheduledLog.Tardiness = CalculateWfhTardiness(scheduledLog.TimeIn);
            scheduledLog.Verification = string.IsNullOrWhiteSpace(verificationValue)
                ? scheduledLog.Verification
                : verificationValue;

            await Db.SaveChangesAsync();

            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Success,
                Title = "Saved",
                Message = $"WFH time {entryModel.LogType} recorded for {FormatEmployeeName(employee)}.",
                Duration = 3500
            });

            entryModel = new EtrEntryModel();
            InitializeEditContext();
            selectedEmployee = null;
            employeeSearchResults.Clear();
            employeeSearchText = string.Empty;
            showEmployeeResults = false;
            ResetVerification();
            pendingSubmissionTime = null;
            confirmationTimeIn = null;
            confirmationTimeOut = null;
        }
        finally
        {
            isSubmitting = false;
        }
    }

