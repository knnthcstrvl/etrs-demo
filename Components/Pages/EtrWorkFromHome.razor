    private Task HandleMovSelected(InputFileChangeEventArgs e)
    {
        var selectedFiles = e.GetMultipleFiles();
        var validFiles = new List<IBrowserFile>();

        foreach (var file in selectedFiles)
        {
            if (!IsAllowedMovFile(file))
            {
                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "Unsupported file",
                    Message = $"File '{file.Name}' is not supported. Accepted formats: PDF, Word, Excel, CSV, PowerPoint, JPG, PNG, and TXT.",
                    Duration = 5000
                });
                continue;
            }

            if (file.Size > 5 * 1024 * 1024)
            {
                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "File too large",
                    Message = $"File '{file.Name}' exceeds the 5 MB limit.",
                    Duration = 5000
                });
                continue;
            }

            validFiles.Add(file);
        }

        entryModel.MovFiles = validFiles;
        entryModel.MovFileName = validFiles.Count == 0
            ? string.Empty
            : string.Join(", ", validFiles.Select(file => file.Name));

        return Task.CompletedTask;
    }

