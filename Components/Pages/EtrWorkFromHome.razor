    private static string FormatEmployeeName(Employee employee)
    {
        var last = employee.LastName?.Trim() ?? string.Empty;
        var first = employee.FirstName?.Trim() ?? string.Empty;
        var middleInitial = string.IsNullOrWhiteSpace(employee.MiddleName) ? string.Empty : $" {employee.MiddleName.Trim()[0]}.";
        return $"{last}, {first}{middleInitial}".Trim(' ', ',').ToUpperInvariant();
    }

    private static string DisplayValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private static string FormatClockTime(DateTime? value)
        => value.HasValue ? value.Value.ToString("h:mm tt") : "-";

    private static bool IsMeaningfulEntry(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var normalized = Regex.Replace(value.Trim(), "\\s+", " ");
        if (normalized.Length < 20)
        {
            return false;
        }

        var alphaNumericCount = normalized.Count(char.IsLetterOrDigit);
        var hasLetter = normalized.Any(char.IsLetter);

        return hasLetter && alphaNumericCount >= 10;
    }

    private string GetMovUploadLabel()
        => entryModel.MovFiles.Count == 0
            ? "No file chosen."
            : string.Join(", ", entryModel.MovFiles.Select(file => file.Name));

    private static bool IsAllowedMovFile(IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name);
        if (string.IsNullOrWhiteSpace(extension))
        {
            return false;
        }

        var normalizedExtension = extension.Trim().ToLowerInvariant();
        return normalizedExtension is ".pdf" or ".doc" or ".docx" or ".xls" or ".xlsx" or ".csv"
            or ".ppt" or ".pptx" or ".jpg" or ".jpeg" or ".png" or ".txt";
    }

    private async Task<string?> SaveMovFilesAsync(IReadOnlyList<IBrowserFile>? files, Employee employee)
    {
        if (files is null || files.Count == 0)
        {
            return null;
        }

        var configuredPath = Configuration["Uploads:WfhMovPath"];
        var savedPaths = new List<string>();
        const long maxFileSizeBytes = 5 * 1024 * 1024;

        async Task<string?> WriteToPathAsync(IBrowserFile file, string root, bool returnWebRelative, bool showFailureToast)
        {
            try
            {
                var uploadsRootResolved = Path.IsPathRooted(root) ? root : Path.Combine(Environment.ContentRootPath, root);
                var directory = GetEmployeeUploadDirectory(uploadsRootResolved, employee, "FILES");
                Directory.CreateDirectory(directory);

                var safeName = $"{DateTime.UtcNow:yyyyMMddHHmmssfff}_{Path.GetFileName(file.Name)}";
                var fullPath = Path.Combine(directory, safeName);

                await using var stream = file.OpenReadStream(maxFileSizeBytes);
                await using var fileStream = File.Create(fullPath);
                await stream.CopyToAsync(fileStream);

                if (returnWebRelative)
                {
                    var wwwroot = Environment.WebRootPath ?? string.Empty;
                    var relative = Path.GetRelativePath(wwwroot, fullPath).Replace('\\', '/');
                    return "/" + relative;
                }

                return fullPath;
            }
            catch (Exception ex)
            {
                if (showFailureToast)
                {
                    ToastService.Show(new ToastMessage
                    {
                        Type = ToastType.Error,
                        Title = "File upload failed",
                        Message = $"Could not save MOV '{file.Name}': {ex.Message}",
                        Duration = 6000
                    });
                }

                return null;
            }
        }

        foreach (var file in files)
        {
            if (!IsAllowedMovFile(file))
            {
                continue;
            }

            if (file.Size > maxFileSizeBytes)
            {
                continue;
            }

            if (!string.IsNullOrWhiteSpace(configuredPath))
            {
                var result = await WriteToPathAsync(file, configuredPath, false, false);
                if (!string.IsNullOrWhiteSpace(result))
                {
                    savedPaths.Add(result);
                    continue;
                }

                var fallback = Path.Combine(Environment.WebRootPath ?? string.Empty, "uploads", "wfh-mov");
                var fallbackResult = await WriteToPathAsync(file, fallback, true, true);
                if (!string.IsNullOrWhiteSpace(fallbackResult))
                {
                    savedPaths.Add(fallbackResult);
                }
            }
            else
            {
                var defaultRoot = Path.Combine(Environment.WebRootPath ?? string.Empty, "uploads", "wfh-mov");
                var result = await WriteToPathAsync(file, defaultRoot, true, true);
                if (!string.IsNullOrWhiteSpace(result))
                {
                    savedPaths.Add(result);
                }
            }
        }

        return savedPaths.Count == 0 ? null : string.Join(";", savedPaths);
    }

    private async Task<string?> SavePhotoVerificationAsync(string? dataUrl, Employee employee, string logType)
    {
        if (string.IsNullOrWhiteSpace(dataUrl))
        {
            return null;
        }

        const string dataUrlPrefix = "data:image/jpeg;base64,";
        var base64 = dataUrl.StartsWith(dataUrlPrefix, StringComparison.OrdinalIgnoreCase)
            ? dataUrl[dataUrlPrefix.Length..]
            : dataUrl;

        byte[] photoBytes;
        try
        {
            photoBytes = Convert.FromBase64String(base64);
        }
        catch (FormatException)
        {
            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Error,
                Title = "Photo save failed",
                Message = "The captured photo could not be read. Please retake the photo.",
                Duration = 5000
            });
            return null;
        }

        var configuredPath = Configuration["Uploads:WfhPhotoVerificationPath"];
        var safeId = Regex.Replace(employee.IdNumber, "[^A-Za-z0-9_-]", "");
        if (string.IsNullOrWhiteSpace(safeId))
        {
            safeId = employee.EmployeeId.ToString();
        }

        var safeType = logType.Equals("OUT", StringComparison.OrdinalIgnoreCase) ? "time-out" : "time-in";
        var safeName = $"{DateTime.UtcNow:yyyyMMddHHmmssfff}_{safeId}_photo-verification-{safeType}.jpg";

        async Task<string?> WriteToPathAsync(string root, bool returnWebRelative, bool showFailureToast)
        {
            try
            {
                var uploadsRootResolved = Path.IsPathRooted(root) ? root : Path.Combine(Environment.ContentRootPath, root);
                var directory = GetEmployeeUploadDirectory(uploadsRootResolved, employee, "PHOTO-VERIFICATION");
                Directory.CreateDirectory(directory);

                var fullPath = Path.Combine(directory, safeName);
                await File.WriteAllBytesAsync(fullPath, photoBytes);

                if (returnWebRelative)
                {
                    var wwwroot = Environment.WebRootPath ?? string.Empty;
                    var relative = Path.GetRelativePath(wwwroot, fullPath).Replace('\\', '/');
                    return "/" + relative;
                }

                return fullPath;
            }
            catch (Exception ex)
            {
                if (showFailureToast)
                {
                    ToastService.Show(new ToastMessage
                    {
                        Type = ToastType.Error,
                        Title = "Photo save failed",
                        Message = $"Could not save photo verification: {ex.Message}",
                        Duration = 6000
                    });
                }

                return null;
            }
        }

        if (!string.IsNullOrWhiteSpace(configuredPath))
        {
            var result = await WriteToPathAsync(configuredPath, false, false);
            if (!string.IsNullOrWhiteSpace(result))
            {
                return result;
            }

            var fallback = Path.Combine(Environment.WebRootPath ?? string.Empty, "uploads", "wfh-photo-verification");
            return await WriteToPathAsync(fallback, true, true);
        }

        var defaultRoot = Path.Combine(Environment.WebRootPath ?? string.Empty, "uploads", "wfh-photo-verification");
        return await WriteToPathAsync(defaultRoot, true, true);
    }

    private static string GetEmployeeUploadDirectory(string root, Employee employee, string leafFolderName)
    {
        var pathSegments = new List<string> { root };
        var divisionSegments = (employee.DivisionCenterUnit ?? string.Empty)
            .Split(new[] { '/', '\\' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(SanitizePathSegment)
            .Where(s => !string.IsNullOrWhiteSpace(s));

        pathSegments.AddRange(divisionSegments);
        var employeeFolder = $"{SanitizePathSegment(employee.IdNumber)}-{SanitizePathSegment(FormatEmployeeName(employee))}";
        pathSegments.Add(employeeFolder);
        pathSegments.Add(leafFolderName);

        return Path.Combine(pathSegments.ToArray());
    }

    private static string SanitizePathSegment(string? segment)
    {
        if (string.IsNullOrWhiteSpace(segment))
        {
            return string.Empty;
        }

        var normalized = segment.Trim();
        normalized = Regex.Replace(normalized, "[<>:\"/\\|?*,]", string.Empty);
        normalized = Regex.Replace(normalized, "\\s+", " ").Trim();
        return normalized.Trim(' ', ',');
    }

    private static string BuildPhotoVerificationValue(string existingVerification, string newPhotoUrl, string logType)
    {
        var values = SplitPhotoVerificationValue(existingVerification);
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var value in values)
        {
            var trimmed = value.Trim();
            if (trimmed.StartsWith("time-in:", StringComparison.OrdinalIgnoreCase))
            {
                result["time-in"] = trimmed["time-in:".Length..].Trim();
            }
            else if (trimmed.StartsWith("time-out:", StringComparison.OrdinalIgnoreCase))
            {
                result["time-out"] = trimmed["time-out:".Length..].Trim();
            }
            else if (!result.ContainsKey("time-in"))
            {
                result["time-in"] = trimmed;
            }
            else if (!result.ContainsKey("time-out"))
            {
                result["time-out"] = trimmed;
            }
        }

        var key = logType.Equals("OUT", StringComparison.OrdinalIgnoreCase) ? "time-out" : "time-in";
        result[key] = newPhotoUrl;

        return string.Join("||", result
            .Where(kvp => !string.IsNullOrWhiteSpace(kvp.Value))
            .Select(kvp => $"{kvp.Key}:{kvp.Value}"));
    }

    private static List<string> SplitPhotoVerificationValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return new();
        }

        var trimmed = value.Trim();
        var separators = new[] { "||", "|", ";", "\n" };
        foreach (var separator in separators)
        {
            if (trimmed.Contains(separator, StringComparison.Ordinal))
            {
                return trimmed
                    .Split(separator, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(item => !string.IsNullOrWhiteSpace(item))
                    .ToList();
            }
        }

        return new List<string> { trimmed };
    }

    private static string CalculateWfhTardiness(DateTime? timeIn)
    {
        if (timeIn is null)
        {
            return string.Empty;
        }

        var workDate = timeIn.Value.Date;
        var shiftStart = workDate.AddHours(8);
        if (timeIn <= shiftStart)
        {
            return "On time";
        }

        var lunchStart = workDate.AddHours(12);
        var lunchEnd = workDate.AddHours(13);
        var lateMinutes = (int)Math.Round((timeIn.Value - shiftStart).TotalMinutes);

        if (timeIn > lunchStart)
        {
            var deductedLunchMinutes = (int)Math.Round((Min(timeIn.Value, lunchEnd) - lunchStart).TotalMinutes);
            lateMinutes -= Math.Max(deductedLunchMinutes, 0);
        }

        lateMinutes = Math.Max(lateMinutes, 0);
        if (lateMinutes == 0)
        {
            return "On time";
        }

        return $"{lateMinutes} minute(s) late";
    }

    private static DateTime Min(DateTime left, DateTime right) => left <= right ? left : right;

    private void InitializeEditContext()
    {
        editContext = new EditContext(entryModel);
        validationMessageStore = new ValidationMessageStore(editContext);
    }

    private void ValidateSelectedEmployee()
    {
        var fieldIdentifier = new FieldIdentifier(entryModel, nameof(EtrEntryModel.IdNumber));
        validationMessageStore.Clear(fieldIdentifier);

        if (!string.IsNullOrWhiteSpace(entryModel.IdNumber) && !HasValidSelectedEmployee())
        {
            validationMessageStore.Add(fieldIdentifier, "Choose an employee from the search results before submitting.");
        }

        editContext.NotifyValidationStateChanged();
    }

    private bool HasValidSelectedEmployee()
        => selectedEmployee is not null
            && !string.IsNullOrWhiteSpace(entryModel.IdNumber)
            && string.Equals(selectedEmployee.IdNumber, entryModel.IdNumber.Trim(), StringComparison.OrdinalIgnoreCase)
            && IsActiveEmployeeStatus(selectedEmployee.Status);

    private static bool IsActiveEmployeeStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return false;
        }

        var activity = GetFirstStatusToken(status);
        return string.Equals(activity, "Active", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetFirstStatusToken(string status)
    {
        var normalizedStatus = status.Trim();
        var separatorIndex = normalizedStatus.IndexOf(',');
        if (separatorIndex < 0)
        {
            separatorIndex = normalizedStatus.IndexOf(' ');
        }

        return separatorIndex < 0
            ? normalizedStatus
            : normalizedStatus[..separatorIndex].Trim();
    }

    private void ClearFieldValidation(string fieldName)
    {
        var fieldIdentifier = new FieldIdentifier(entryModel, fieldName);
        validationMessageStore.Clear(fieldIdentifier);
        editContext.NotifyValidationStateChanged();
    }

    private void ApplyTimeOutVerificationRequirement(AttendanceLogWfh? todayLog)
    {
        timeOutRequiresEmailVerification = todayLog is not null
            && IsEmailVerificationValue(todayLog.Verification)
            && todayLog.TimeIn.HasValue;
    }

    private async Task RefreshTimeOutVerificationRequirementAsync()
    {
        if (selectedEmployee is null)
        {
            timeOutRequiresEmailVerification = false;
            return;
        }

        var todayLog = await Db.AttendanceLogsWfh
            .AsNoTracking()
            .FirstOrDefaultAsync(l => l.EmployeeId == selectedEmployee.EmployeeId && l.AttendanceDate == DateTime.Today);

        ApplyTimeOutVerificationRequirement(todayLog);
        await InvokeAsync(StateHasChanged);
    }

    private static bool IsEmailVerificationValue(string? value)
        => !string.IsNullOrWhiteSpace(value)
            && value.Contains('@', StringComparison.Ordinal)
            && !value.Contains('/', StringComparison.Ordinal)
            && !value.Contains('\\', StringComparison.Ordinal);
}

