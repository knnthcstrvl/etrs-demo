@page "/etr-work-from-home"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Financial.Data
@using Financial.Model.Dtr
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@inject ProcurementDbContext Db
@inject IToastService ToastService
@inject IWebHostEnvironment Environment
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IJSRuntime JS
@layout BlankLayout

@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>ETRS</PageTitle>

<div class="etr-shell">
    <img class="corner-logo logo-left" src="/images/bswm-light.png" alt="bswm" />
    <img class="corner-logo logo-right" src="/images/bagong-pilipinas.png" alt="bagong-pilipinas" />
    <div class="etr-card">
        <h1 class="etr-title">Electronic Time Record<br>Work From Home</h1>

        <div class="etr-form-wrap">
            <p class="etr-sub">Log your WFH attendance using your employee ID number. Time in records target, while time out records accomplishment and optional MOV upload.</p>
            <EditForm EditContext="editContext" OnSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <label class="required-star">Attendance</label>
                    <div class="options-row">
                        <button type="button"
                                class="@GetOptionClass("IN")"
                                @onclick='() => SelectLogType("IN")'
                                >
                            <span class="option-indicator" aria-hidden="true"></span>
                            <div class="opt-title">IN</div>
                            <div class="opt-sub">Start of work</div>
                        </button>

                        <button type="button"
                                class="@GetOptionClass("OUT")"
                                @onclick='() => SelectLogType("OUT")'
                                >
                            <span class="option-indicator" aria-hidden="true"></span>
                            <div class="opt-title">OUT</div>
                            <div class="opt-sub">End of work</div>
                        </button>
                    </div>
                </div>

                <div class="form-row">
                    <label class="required-star">ID Number</label>
                    <div class="employee-search-wrap" @ref="employeeSearchWrapRef">
                        <div class="employee-search-input-wrap">
                            <input
                                value="@employeeSearchText"
                                @oninput="HandleIdInputChanged"
                                @onfocus="HandleIdInputFocus"
                                class="etr-input employee-search-input field-control"
                                disabled="@isSubmitting"
                                autocomplete="off" />
                            <span class="employee-search-icon" aria-hidden="true">Search</span>
                        </div>

                        <div class="@GetEmployeeOverlayClass()">
                            @if (showEmployeeResults)
                            {
                                @if (employeeSearchResults.Count == 0)
                                {
                                    <div class="employee-empty-state">No Employee Found</div>
                                }
                                else
                                {
                                    <div class="employee-results-grid">
                                        @foreach (var employee in employeeSearchResults)
                                        {
                                            <button type="button" class="@GetEmployeeResultClass(employee)" @onclick="() => SelectEmployee(employee)">
                                                <span class="employee-result-id">@employee.IdNumber</span>
                                                <span class="employee-result-name">@FormatEmployeeName(employee)</span>
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>

                </div>

                <div class="@GetSectionClass("IN")" aria-hidden="@(entryModel.LogType != "IN")">
                <div class="form-row">
                        <label class="required-star">Target</label>
                        <textarea value="@entryModel.Target"
                                  @oninput="HandleTargetInputChanged"
                                  class="etr-textarea field-control"
                                  disabled="@isSubmitting"></textarea>
                    </div>

                    <div class="section-spacer" aria-hidden="true"></div>
                </div>

                <div class="@GetSectionClass("OUT")" aria-hidden="@(entryModel.LogType != "OUT")">
                    <div class="form-row">
                        <label class="required-star">Accomplishment</label>
                        <textarea value="@entryModel.Accomplishment"
                                  @oninput="HandleAccomplishmentInputChanged"
                                  class="etr-textarea field-control"
                                  disabled="@isSubmitting"></textarea>
                    </div>

                    <div class="form-row">
                        <label>Means of Verification</label>
                        <div class="file-upload-wrap">
                            <label for="movUpload" class="etr-file-button">Choose File</label>
                            <InputFile id="movUpload"
                                       class="etr-file-input"
                                       OnChange="HandleMovSelected"
                                       disabled="@isSubmitting" />
                            <span class="upload-note upload-file-name">@(string.IsNullOrWhiteSpace(entryModel.MovFileName) ? "No file chosen." : entryModel.MovFileName)</span>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="etr-submit" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner" aria-hidden="true"></span><span>Submitting&#8230;</span>
                        }
                        else
                        {
                            <span>Submit</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .etr-shell {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url('/images/etr-bg.jpg');
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        padding: 2rem;
    }

    .corner-logo {
        position: absolute;
        top: 1.25rem;
        /* increased default width to make images bigger */
        width: 220px;
        /* allow a larger relative size on small viewports */
        max-width: 36%;
        height: auto;
        object-fit: contain;
        z-index: 30;
    }

    .logo-left { left: 1.25rem; }
    .logo-right { right: 1.25rem; }

    @@media (max-width: 1024px) {
        /* reduce image size for tablet view */
        .corner-logo { width: 160px; top: 1rem; max-width: 30%; }
        .logo-left { left: 1rem; }
        .logo-right { right: 1rem; }
    }

    @@media (max-width: 640px) {
        /* make images smaller on mobile while keeping them responsive */
        .corner-logo { width: 120px; top: 0.6rem; }
        .logo-left { left: 0.5rem; }
        .logo-right { right: 0.5rem; }
    }

    .etr-card {
        width: min(100%, 560px);
        background: transparent;
        padding: 0.8rem 0.9rem;
        border: 0;
        border-radius: 0;
        box-shadow: none;
    }

    .etr-title {
        margin: 0 0 1rem;
        text-align: center;
        font-size: clamp(1.75rem, 3.6vw, 2.4rem);
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.02em;
    }

    .etr-sub {
        margin: 0 0 0.9rem;
        color: rgba(255,255,255,0.95);
        font-size: 0.9rem;
        text-align: center;
    }

    .etr-form-wrap {
        padding: 1.15rem;
        border-radius: 24px;
        background: linear-gradient(180deg, rgba(255,255,255,0.18), rgba(255,255,255,0.08));
        border: 1px solid rgba(255,255,255,0.2);
        box-shadow: 0 18px 40px rgba(0,0,0,0.24);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }

    .form-row {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-bottom: 0.75rem;
        position: relative;
    }

    .form-row label,
    .required-star,
    .upload-note {
        color: #ffffff;
    }

    .etr-input,
    .etr-textarea {
        width: 100%;
        border: 1px solid transparent;
        border-radius: 10px;
        padding: 0.6rem 0.75rem;
        box-sizing: border-box;
        min-width: 0;
        display: block;
        background: #ffffff;
        color: #1f2937;
        font-size: 0.9rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .etr-textarea {
        min-height: 110px;
        line-height: 1.5;
        resize: vertical;
    }

    .field-control:focus,
    .option-card:focus {
        outline: none;
    }

    .etr-form-wrap .field-control:focus {
        border-color: #ebca4a !important;
        box-shadow: none;
    }

    .employee-search-wrap {
        position: relative;
    }

    .employee-search-input-wrap {
        position: relative;
    }

    .employee-search-input {
        padding-right: 5.5rem;
    }

    .employee-search-icon {
        position: absolute;
        top: 50%;
        right: 0.9rem;
        transform: translateY(-50%);
        color: #4b5563;
        font-size: 0.82rem;
        font-weight: 600;
        pointer-events: none;
    }

    .employee-results-overlay {
        position: absolute;
        top: calc(100% + 0.45rem);
        left: 0;
        right: 0;
        z-index: 20;
        padding: 0.8rem;
        border-radius: 10px;
        background: rgba(255,255,255,0.96);
        border: 1px solid rgba(209,213,219,0.9);
        box-shadow: 0 16px 34px rgba(15,23,42,0.2);
        max-height: 280px;
        overflow-y: auto;
        opacity: 0;
        transform: translateY(-6px);
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .employee-results-overlay.active {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    .employee-results-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.7rem;
    }

    .employee-result-card {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        width: 100%;
        padding: 0.8rem 0.85rem;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        background: #ffffff;
        text-align: left;
        color: #111827;
        opacity: 0;
        transform: translateY(8px);
        animation: employee-card-in 0.22s ease forwards;
    }

    .employee-result-card.selected {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16,185,129,0.14);
    }

    .employee-result-id {
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .employee-result-name {
        font-size: 0.78rem;
        color: #6b7280;
        line-height: 1.35;
    }

    .employee-empty-state {
        padding: 0.5rem 0.15rem;
        color: #6b7280;
        font-size: 0.9rem;
    }

    .transition-panel {
    overflow: visible;
    max-height: 0;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: max-height 0.3s ease, opacity 0.25s ease, transform 0.25s ease, margin-bottom 0.3s ease;
    margin-bottom: 0;
}

    .transition-panel.active {
        max-height: 320px;
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
        margin-bottom: 0.75rem;
    }

    .section-spacer {
        height: 0;
    }

    .options-row { display:flex; gap:0.6rem; width:100%; }
    .option-card {
        border: 1px solid #e6e6e6;
        padding: 0.5rem 2.75rem 0.5rem 0.75rem;
        border-radius: 8px;
        flex: 1 1 50%;
        min-width: 0;
        cursor: pointer;
        background: #fff;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        position: relative;
        appearance: none;
        text-align: left;
    }

    .option-card .opt-title { font-weight: 700; color: #111827; }
    .option-card .opt-sub { font-size: 0.82rem; color: #9ca3af; }
    .option-card.selected { border-color: #10b981; box-shadow: none; }
    .option-indicator {
        position: absolute;
        top: 50%;
        right: 0.75rem;
        width: 18px;
        height: 18px;
        border: 2px solid #d1d5db;
        border-radius: 999px;
        background: #ffffff;
        transform: translateY(-50%);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .option-indicator::after {
        content: "";
        position: absolute;
        inset: 3px;
        border-radius: 999px;
        background: transparent;
        transition: background-color 0.15s ease;
    }

    .option-card.selected .option-indicator {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16,185,129,0.18);
    }

    .option-card.selected .option-indicator::after {
        background: #10b981;
    }

    .file-upload-wrap {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .etr-file-input {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .etr-file-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.6rem 0.9rem;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
        color: #111827 !important;
        cursor: pointer;
        font-size: 0.9rem;
        min-width: 116px;
    }

    .upload-file-name {
        color: #ffffff;
    }

    .form-actions { margin-top: 0.9rem; }

    .etr-submit {
        width: 100%;
        border: 0;
        border-radius: 12px;
        padding: 0.65rem 0.9rem;
        background: #ebca4a;
        color: #111827;
        font-size: 0.92rem;
        font-weight: 500;
    }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(0,0,0,0.12);
        border-top-color: #111827;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
        vertical-align: middle;
        animation: spin 0.9s linear infinite;
    }

    @@keyframes employee-card-in {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private bool isSubmitting;
    private EtrEntryModel entryModel = new();
    private EditContext editContext = default!;
    private ValidationMessageStore validationMessageStore = default!;
    private List<Employee> employeeSearchResults = new();
    private Employee? selectedEmployee;
    private bool showEmployeeResults;
    private string employeeSearchText = string.Empty;
    private ElementReference employeeSearchWrapRef;
    private DotNetObjectReference<EtrWorkFromHome>? dotNetRef;
    private bool pendingRegisterOutsideClick;

    private class EtrEntryModel
        : IValidatableObject
    {
        [Required]
        public string IdNumber { get; set; } = string.Empty;

        public string LogType { get; set; } = "IN";

        public string Target { get; set; } = string.Empty;

        public string Accomplishment { get; set; } = string.Empty;

        public string MovFileName { get; set; } = string.Empty;
        public IBrowserFile? MovFile { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (LogType == "IN" && !IsMeaningfulEntry(Target))
            {
                yield return new ValidationResult(
                    "Target must be at least 20 characters and contain meaningful text.",
                    new[] { nameof(Target) });
            }

            if (LogType == "OUT" && !IsMeaningfulEntry(Accomplishment))
            {
                yield return new ValidationResult(
                    "Accomplishment must be at least 20 characters and contain meaningful text.",
                    new[] { nameof(Accomplishment) });
            }
        }
    }

    protected override void OnInitialized()
    {
        InitializeEditContext();
    }

    private bool IsSubmitDisabled => isSubmitting;

    private async Task HandleSubmit(EditContext editContext)
    {
        ValidateSelectedEmployee();

        // Run data annotation / IValidatableObject validation
        var valid = editContext?.Validate() ?? true;

        if (!valid)
        {
            ShowValidationMessages(editContext);
            return;
        }

        // Proceed with actual submit logic
        await HandleValidSubmit();
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;

        try
        {
            var trimmedId = entryModel.IdNumber.Trim();
            var employee = selectedEmployee;

            if (employee is null || !string.Equals(employee.IdNumber, trimmedId, StringComparison.OrdinalIgnoreCase))
            {
                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "Select employee",
                    Message = "Choose an employee from the search results before submitting.",
                    Duration = 4000
                });
                return;
            }

            if (!IsActiveEmployeeStatus(employee.Status))
            {
                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "Inactive employee",
                    Message = $"{employee.FirstName} {employee.LastName} is inactive and cannot submit a WFH log.",
                    Duration = 5000
                });
                return;
            }

            var today = DateTime.Today;
            var now = DateTime.Now;
            var log = await Db.AttendanceLogsWfh
                .Include(l => l.ExceptionCondition)
                .FirstOrDefaultAsync(l => l.EmployeeId == employee.EmployeeId && l.AttendanceDate == today);

            if (log is null)
            {
                log = new AttendanceLogWfh
                {
                    EmployeeId = employee.EmployeeId,
                    AttendanceDate = today,
                    IdNumber = employee.IdNumber,
                    LastName = employee.LastName,
                    FirstName = employee.FirstName,
                    MiddleName = employee.MiddleName,
                    DivisionCenterUnit = employee.DivisionCenterUnit,
                    Designation = employee.Designation,
                    WorkArrangement = "WFH",
                    TagUpdatedAt = now
                };
                Db.AttendanceLogsWfh.Add(log);
            }

            if (!string.Equals(log.WorkArrangement, "WFH", StringComparison.OrdinalIgnoreCase))
            {
                var arrangementLabel = string.IsNullOrWhiteSpace(log.ExceptionCondition?.ConditionName)
                    ? log.WorkArrangement
                    : log.ExceptionCondition.ConditionName;

                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "WFH blocked",
                    Message = $"{employee.FirstName} {employee.LastName} is tagged as {arrangementLabel} for today and cannot submit a WFH log.",
                    Duration = 5000
                });
                return;
            }

            if (entryModel.LogType == "IN")
            {
                // Prevent multiple time-in records for the same day
                if (log.TimeIn.HasValue)
                {
                    ToastService.Show(new ToastMessage
                    {
                        Type = ToastType.Warning,
                        Title = "Already clocked in",
                        Message = "You have already recorded time IN for today.",
                        Duration = 4000
                    });
                    return;
                }

                log.TimeIn = now;
                log.Target = entryModel.Target.Trim();
            }
            else
            {
                // Prevent multiple time-out records for the same day
                if (log.TimeOut.HasValue)
                {
                    ToastService.Show(new ToastMessage
                    {
                        Type = ToastType.Warning,
                        Title = "Already clocked out",
                        Message = "You have already recorded time OUT for today.",
                        Duration = 4000
                    });
                    return;
                }

                log.TimeOut = now;
                log.Accomplishment = entryModel.Accomplishment.Trim();
                log.Mov = await SaveMovFileAsync(entryModel.MovFile) ?? log.Mov;
            }

            log.Tardiness = CalculateWfhTardiness(log.TimeIn);

            await Db.SaveChangesAsync();

            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Success,
                Title = "Saved",
                Message = $"WFH time {entryModel.LogType} recorded for {employee.FirstName} {employee.LastName}.",
                Duration = 3500
            });

            entryModel = new EtrEntryModel();
            InitializeEditContext();
            selectedEmployee = null;
            employeeSearchResults.Clear();
            employeeSearchText = string.Empty;
            showEmployeeResults = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleIdInputChanged(ChangeEventArgs e)
    {
        employeeSearchText = e.Value?.ToString() ?? string.Empty;

        if (!string.Equals(selectedEmployee?.IdNumber, employeeSearchText.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            selectedEmployee = null;
            entryModel.IdNumber = employeeSearchText;
        }

        ClearFieldValidation(nameof(EtrEntryModel.IdNumber));
        editContext.NotifyFieldChanged(new FieldIdentifier(entryModel, nameof(EtrEntryModel.IdNumber)));
        await SearchEmployeesAsync(employeeSearchText);
    }

    private void HandleTargetInputChanged(ChangeEventArgs e)
    {
        entryModel.Target = e.Value?.ToString() ?? string.Empty;
        ClearFieldValidation(nameof(EtrEntryModel.Target));
        editContext.NotifyFieldChanged(new FieldIdentifier(entryModel, nameof(EtrEntryModel.Target)));
    }

    private void HandleAccomplishmentInputChanged(ChangeEventArgs e)
    {
        entryModel.Accomplishment = e.Value?.ToString() ?? string.Empty;
        ClearFieldValidation(nameof(EtrEntryModel.Accomplishment));
        editContext.NotifyFieldChanged(new FieldIdentifier(entryModel, nameof(EtrEntryModel.Accomplishment)));
    }

    // Show validation and other messages in toast when appropriate
    private void ShowValidationMessages(EditContext? ctx)
    {
        if (ctx is null) return;
        var messages = ctx.GetValidationMessages().ToList();
        foreach (var m in messages)
        {
            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Warning,
                Title = "Validation",
                Message = m,
                Duration = 5000
            });
        }
    }

    private async Task HandleIdInputFocus(FocusEventArgs _)
    {
        await SearchEmployeesAsync(selectedEmployee is null ? employeeSearchText : entryModel.IdNumber);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await UnregisterOutsideClickAsync();
        }
        catch { }
        dotNetRef?.Dispose();
    }

    private async Task HandleMovSelected(InputFileChangeEventArgs e)
    {
        entryModel.MovFile = e.File;
        entryModel.MovFileName = e.File?.Name ?? string.Empty;
    }

    private string GetOptionClass(string type)
    {
        var classes = new List<string> { "option-card" };
        var isSelected = entryModel.LogType == type;

        if (isSelected)
        {
            classes.Add("selected");
        }

        return string.Join(" ", classes.Where(c => !string.IsNullOrWhiteSpace(c)));
    }

    private string GetEmployeeResultClass(Employee employee)
        => selectedEmployee?.EmployeeId == employee.EmployeeId ? "employee-result-card selected" : "employee-result-card";

    private string GetEmployeeOverlayClass()
        => showEmployeeResults ? "employee-results-overlay active" : "employee-results-overlay";

    private string GetSectionClass(string type) => entryModel.LogType == type ? "transition-panel active" : "transition-panel";

    private void SelectLogType(string type)
    {
        entryModel.LogType = type;
        editContext.NotifyFieldChanged(new FieldIdentifier(entryModel, nameof(EtrEntryModel.LogType)));
    }

    private async Task SearchEmployeesAsync(string? searchText)
    {
        var query = (searchText ?? string.Empty).Trim();
        var shouldShow = query.Length >= 1;
        showEmployeeResults = shouldShow;

        if (!showEmployeeResults)
        {
            employeeSearchResults.Clear();
            return;
        }

        // Defer registering the outside click handler until after render
        pendingRegisterOutsideClick = shouldShow;

        employeeSearchResults = await Db.Employees
            .AsNoTracking()
            .Where(e => e.IdNumber.Contains(query))
            .Where(e => e.Status.StartsWith("Active"))
            .OrderBy(e => e.LastName)
            .ThenBy(e => e.FirstName)
            .Take(12)
            .ToListAsync();
    }
    private async Task SelectEmployee(Employee employee)
    {
        selectedEmployee = employee;
        entryModel.IdNumber = employee.IdNumber;
        employeeSearchText = $"{employee.IdNumber} - {FormatEmployeeName(employee)}";
        showEmployeeResults = false;
        ClearFieldValidation(nameof(EtrEntryModel.IdNumber));
        editContext.NotifyFieldChanged(new FieldIdentifier(entryModel, nameof(EtrEntryModel.IdNumber)));
        await UnregisterOutsideClickAsync();
    }

    [JSInvokable]
    public Task HideEmployeeResults()
    {
        if (!showEmployeeResults) return Task.CompletedTask;
        showEmployeeResults = false;
        StateHasChanged();
        return UnregisterOutsideClickAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingRegisterOutsideClick && showEmployeeResults)
        {
            pendingRegisterOutsideClick = false;
            await RegisterOutsideClickAsync();
        }
    }

    private async Task RegisterOutsideClickAsync()
    {
        try
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("etrWorkFromHome.registerOutsideClick", employeeSearchWrapRef, dotNetRef);
        }
        catch { }
    }

    private async Task UnregisterOutsideClickAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("etrWorkFromHome.unregisterOutsideClick", employeeSearchWrapRef);
        }
        catch { }
    }

    private static string FormatEmployeeName(Employee employee)
    {
        var middleInitial = string.IsNullOrWhiteSpace(employee.MiddleName) ? string.Empty : $" {employee.MiddleName.Trim()[0]}.";
        return $"{employee.FirstName} {employee.LastName}{middleInitial}";
    }

    private static bool IsMeaningfulEntry(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var normalized = Regex.Replace(value.Trim(), "\\s+", " ");
        if (normalized.Length < 20)
        {
            return false;
        }

        var alphaNumericCount = normalized.Count(char.IsLetterOrDigit);
        var hasLetter = normalized.Any(char.IsLetter);

        return hasLetter && alphaNumericCount >= 10;
    }

    private async Task<string?> SaveMovFileAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return null;
        }
        // Read configured upload path from appsettings (e.g. a NAS UNC path)
        var configuredPath = Configuration["Uploads:WfhMovPath"];

        var safeName = $"{DateTime.UtcNow:yyyyMMddHHmmssfff}_{Path.GetFileName(file.Name)}";

        async Task<string?> WriteToPathAsync(string root, bool returnWebRelative)
        {
            try
            {
                var uploadsRootResolved = Path.IsPathRooted(root) ? root : Path.Combine(Environment.ContentRootPath, root);
                Directory.CreateDirectory(uploadsRootResolved);

                var fullPath = Path.Combine(uploadsRootResolved, safeName);

                await using var stream = file.OpenReadStream(10 * 1024 * 1024);
                await using var fileStream = File.Create(fullPath);
                await stream.CopyToAsync(fileStream);

                if (returnWebRelative)
                {
                    var wwwroot = Environment.WebRootPath ?? string.Empty;
                    var relative = Path.GetRelativePath(wwwroot, fullPath).Replace('\\', '/');
                    return "/" + relative;
                }

                return fullPath;
            }
            catch (Exception ex)
            {
                // Let caller decide fallback; log toast to inform user
                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Error,
                    Title = "File upload failed",
                    Message = $"Could not save MOV to '{root}': {ex.Message}",
                    Duration = 6000
                });

                return null;
            }
        }

        // Try configured path first
        if (!string.IsNullOrWhiteSpace(configuredPath))
        {
            var result = await WriteToPathAsync(configuredPath, false);
            if (!string.IsNullOrWhiteSpace(result))
            {
                return result;
            }

            // fallback to wwwroot/uploads/wfh-mov if configured path failed
            var fallback = Path.Combine(Environment.WebRootPath ?? string.Empty, "uploads", "wfh-mov");
            var fallbackResult = await WriteToPathAsync(fallback, true);
            return fallbackResult;
        }

        // No configured path: write under wwwroot/uploads/wfh-mov and return web relative path
        var defaultRoot = Path.Combine(Environment.WebRootPath ?? string.Empty, "uploads", "wfh-mov");
        return await WriteToPathAsync(defaultRoot, true);
    }

    private static string CalculateWfhTardiness(DateTime? timeIn)
    {
        if (timeIn is null)
        {
            return string.Empty;
        }

        var workDate = timeIn.Value.Date;
        var shiftStart = workDate.AddHours(8);
        if (timeIn <= shiftStart)
        {
            return "On time";
        }

        var lunchStart = workDate.AddHours(12);
        var lunchEnd = workDate.AddHours(13);
        var lateMinutes = (int)Math.Round((timeIn.Value - shiftStart).TotalMinutes);

        if (timeIn > lunchStart)
        {
            var deductedLunchMinutes = (int)Math.Round((Min(timeIn.Value, lunchEnd) - lunchStart).TotalMinutes);
            lateMinutes -= Math.Max(deductedLunchMinutes, 0);
        }

        lateMinutes = Math.Max(lateMinutes, 0);
        if (lateMinutes == 0)
        {
            return "On time";
        }

        return $"{lateMinutes} minute(s) late";
    }

    private static DateTime Min(DateTime left, DateTime right) => left <= right ? left : right;

    private void InitializeEditContext()
    {
        editContext = new EditContext(entryModel);
        validationMessageStore = new ValidationMessageStore(editContext);
    }

    private void ValidateSelectedEmployee()
    {
        var fieldIdentifier = new FieldIdentifier(entryModel, nameof(EtrEntryModel.IdNumber));
        validationMessageStore.Clear(fieldIdentifier);

        if (!string.IsNullOrWhiteSpace(entryModel.IdNumber) && !HasValidSelectedEmployee())
        {
            validationMessageStore.Add(fieldIdentifier, "Choose an employee from the search results before submitting.");
        }

        editContext.NotifyValidationStateChanged();
    }

    private bool HasValidSelectedEmployee()
        => selectedEmployee is not null
            && !string.IsNullOrWhiteSpace(entryModel.IdNumber)
            && string.Equals(selectedEmployee.IdNumber, entryModel.IdNumber.Trim(), StringComparison.OrdinalIgnoreCase)
            && IsActiveEmployeeStatus(selectedEmployee.Status);

    private static bool IsActiveEmployeeStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return false;
        }

        var activity = GetFirstStatusToken(status);
        return string.Equals(activity, "Active", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetFirstStatusToken(string status)
    {
        var normalizedStatus = status.Trim();
        var separatorIndex = normalizedStatus.IndexOf(',');
        if (separatorIndex < 0)
        {
            separatorIndex = normalizedStatus.IndexOf(' ');
        }

        return separatorIndex < 0
            ? normalizedStatus
            : normalizedStatus[..separatorIndex].Trim();
    }

    private void ClearFieldValidation(string fieldName)
    {
        var fieldIdentifier = new FieldIdentifier(entryModel, fieldName);
        validationMessageStore.Clear(fieldIdentifier);
        editContext.NotifyValidationStateChanged();
    }
}
