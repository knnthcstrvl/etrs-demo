        color: #ffffff;
        letter-spacing: 0;
        white-space: nowrap;
        text-shadow: 0 4px 18px rgba(0,0,0,0.42);
    }

    .etr-sub {
        margin: 0;
        max-width: none;
        color: rgba(255,255,255,0.95);
