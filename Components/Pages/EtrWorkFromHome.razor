    private async Task SendEmailVerificationCodeAsync()
    {
        if (isSendingEmailCode)
        {
            return;
        }

        var recipient = emailVerificationAddress.Trim();
        if (!IsValidEmailAddress(recipient))
        {
            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Warning,
                Title = "Invalid email",
                Message = "Enter a valid email address to receive the code.",
                Duration = 4000
            });
            return;
        }

        isSendingEmailCode = true;
        try
        {
            var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString("D6");
            await SendVerificationEmailAsync(recipient, code);

            emailVerificationPendingCode = code;
            emailVerificationPendingEmail = recipient;
            emailVerificationVerifiedEmail = string.Empty;
            emailVerificationCodeInput = string.Empty;
            emailVerificationCodeExpiresAt = DateTime.Now.AddMinutes(5);
            emailVerificationAttempts = 0;

            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Success,
                Title = "Code sent",
                Message = $"A verification code was sent to {recipient}.",
                Duration = 4000
            });
        }
        catch (Exception ex)
        {
            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Error,
                Title = "Email failed",
                Message = GetEmailVerificationFailureMessage(ex),
                Duration = 8000
            });
        }
        finally
        {
            isSendingEmailCode = false;
        }
    }

    private async Task SendVerificationEmailAsync(string recipient, string code)
    {
        await AttendanceEmailService.SendVerificationCodeAsync(recipient, code);
    }

    private static string GetEmailVerificationFailureMessage(Exception ex)
    {
        var message = ex.Message;
        if (message.Contains("Authentication Required", StringComparison.OrdinalIgnoreCase)
            || message.Contains("not authenticated", StringComparison.OrdinalIgnoreCase)
            || message.Contains("5.7.0", StringComparison.OrdinalIgnoreCase))
        {
            return "Gmail refused the sender login. Ask an administrator to verify the configured ETRS mailer app passwords.";
        }

        return $"Could not send the verification code: {message}";
    }

    private void VerifyEmailCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(emailVerificationPendingCode)
            || string.IsNullOrWhiteSpace(emailVerificationPendingEmail)
            || emailVerificationCodeExpiresAt is null)
        {
            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Warning,
                Title = "Code required",
                Message = "Send a verification code before verifying.",
                Duration = 4000
            });
            return;
        }

        if (DateTime.Now > emailVerificationCodeExpiresAt.Value)
        {
            ClearPendingEmailCode();
            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Warning,
                Title = "Code expired",
                Message = "Send a new verification code and try again.",
                Duration = 4000
            });
            return;
        }

        if (!string.Equals(emailVerificationAddress.Trim(), emailVerificationPendingEmail, StringComparison.OrdinalIgnoreCase))
        {
            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Warning,
                Title = "Email changed",
                Message = "Send a new code for the current email address.",
                Duration = 4000
            });
            return;
        }

        emailVerificationAttempts++;
        if (!string.Equals(emailVerificationCodeInput.Trim(), emailVerificationPendingCode, StringComparison.Ordinal))
        {
            if (emailVerificationAttempts >= 5)
            {
                ClearPendingEmailCode();
                ToastService.Show(new ToastMessage
                {
                    Type = ToastType.Warning,
                    Title = "Too many attempts",
                    Message = "Send a new verification code and try again.",
                    Duration = 4000
                });
                return;
            }

            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Warning,
                Title = "Invalid code",
                Message = $"The code is incorrect. {5 - emailVerificationAttempts} attempt(s) left.",
                Duration = 4000
            });
            return;
        }

        emailVerificationVerifiedEmail = emailVerificationPendingEmail;
        ClearPendingEmailCode();
        showEmailVerificationModal = false;

        ToastService.Show(new ToastMessage
        {
            Type = ToastType.Success,
            Title = "Email verified",
            Message = "Email verification is complete.",
            Duration = 3500
        });
    }

    private static bool IsValidEmailAddress(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        try
        {
            var address = new MailAddress(value.Trim());
            return string.Equals(address.Address, value.Trim(), StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

