    private Employee? attendanceRequestEmployee;
    private List<Employee> attendanceRequestSearchResults = new();
    private List<AttendanceRequestPeriod> attendanceRequestPeriods = new();

    private sealed record AttendanceRequestPeriod(DateTime Start, DateTime End, string Label)
    {
        public string Key => Start.ToString("yyyy-MM-dd");
        public bool IsCurrent => DateTime.Today >= Start.Date && DateTime.Today <= End.Date;
    }

    private AttendanceRequestPeriod? AttendanceRequestFromPeriod
        => attendanceRequestPeriods.FirstOrDefault(period => period.Key == attendanceRequestFromKey);
    private AttendanceRequestPeriod? AttendanceRequestToPeriod
        => attendanceRequestPeriods.FirstOrDefault(period => period.Key == attendanceRequestToKey);
    private string AttendanceRequestFromLabel => AttendanceRequestFromPeriod?.Label ?? "No periods available";
    private string AttendanceRequestToLabel => AttendanceRequestToPeriod?.Label ?? "No periods available";

    private sealed class PhotoCaptureValidationResult
    {
        public bool IsValid { get; set; }
        public string DataUrl { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }

    private class EtrEntryModel
        : IValidatableObject
    {
        [Required]
        public string IdNumber { get; set; } = string.Empty;

        public string LogType { get; set; } = "IN";

        public string Target { get; set; } = string.Empty;

        public string Accomplishment { get; set; } = string.Empty;

        public string MovFileName { get; set; } = string.Empty;
        public List<IBrowserFile> MovFiles { get; set; } = new();

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (LogType == "IN" && !IsMeaningfulEntry(Target))
            {
                yield return new ValidationResult(
                    "Target must be at least 20 characters and contain meaningful text.",
                    new[] { nameof(Target) });
            }

            if (LogType == "OUT" && !IsMeaningfulEntry(Accomplishment))
            {
                yield return new ValidationResult(
                    "Accomplishment must be at least 20 characters and contain meaningful text.",
                    new[] { nameof(Accomplishment) });
            }
        }
    }

    protected override void OnInitialized()
    {
        InitializeEditContext();
    }

    private Task OpenAttendanceRequestAsync()
    {
        showAttendanceRequestModal = true;
        isSubmittingAttendanceRequest = false;
        showAttendanceRequestResults = false;
        attendanceRequestSearchText = string.Empty;
        attendanceRequestEmail = string.Empty;
        attendanceRequestEmployee = null;
        attendanceRequestSearchResults.Clear();
        attendanceRequestPeriods.Clear();
        attendanceRequestFromKey = string.Empty;
        attendanceRequestToKey = string.Empty;
        showAttendanceRequestFromMenu = false;
        showAttendanceRequestToMenu = false;
        return Task.CompletedTask;
    }

    private async Task CloseAttendanceRequestModal()
    {
        if (!isSubmittingAttendanceRequest)
        {
            showAttendanceRequestResults = false;
            CloseAttendanceRequestPeriodMenus();
            await UnregisterAttendanceRequestOutsideClickAsync();
            showAttendanceRequestModal = false;
        }
    }

    private async Task HandleAttendanceRequestSearchChanged(ChangeEventArgs e)
    {
        attendanceRequestSearchText = e.Value?.ToString() ?? string.Empty;
        if (attendanceRequestEmployee is not null
            && !string.Equals(attendanceRequestEmployee.IdNumber, attendanceRequestSearchText.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            attendanceRequestEmployee = null;
            attendanceRequestPeriods.Clear();
            attendanceRequestFromKey = string.Empty;
            attendanceRequestToKey = string.Empty;
        }

        var search = attendanceRequestSearchText.Trim();
        if (search.Length < 1)
        {
            attendanceRequestSearchResults.Clear();
            showAttendanceRequestResults = false;
            await UnregisterAttendanceRequestOutsideClickAsync();
            return;
        }

        attendanceRequestSearchResults = await Db.Employees.AsNoTracking()
            .Where(employee => employee.IdNumber.Contains(search))
            .Where(employee => employee.Status.StartsWith("Active"))
            .OrderBy(employee => employee.LastName)
            .ThenBy(employee => employee.FirstName)
            .Take(12)
            .ToListAsync();
        showAttendanceRequestResults = true;
        pendingRegisterAttendanceRequestOutsideClick = true;
    }

    private async Task HandleAttendanceRequestInputFocus(FocusEventArgs _)
    {
        var searchText = attendanceRequestEmployee is null
            ? attendanceRequestSearchText
            : attendanceRequestEmployee.IdNumber;
        await SearchAttendanceRequestEmployeesAsync(searchText);
    }

    private async Task SearchAttendanceRequestEmployeesAsync(string? searchText)
    {
        var search = (searchText ?? string.Empty).Trim();
        if (search.Length < 1)
        {
            attendanceRequestSearchResults.Clear();
            showAttendanceRequestResults = false;
            await UnregisterAttendanceRequestOutsideClickAsync();
            return;
        }

        attendanceRequestSearchResults = await Db.Employees.AsNoTracking()
            .Where(employee => employee.IdNumber.Contains(search))
            .Where(employee => employee.Status.StartsWith("Active"))
            .OrderBy(employee => employee.LastName)
            .ThenBy(employee => employee.FirstName)
            .Take(12)
            .ToListAsync();
        showAttendanceRequestResults = true;
        pendingRegisterAttendanceRequestOutsideClick = true;
    }

    private async Task SelectAttendanceRequestEmployeeAsync(Employee employee)
    {
        attendanceRequestEmployee = employee;
        attendanceRequestSearchText = $"{employee.IdNumber} - {FormatEmployeeName(employee)}";
        showAttendanceRequestResults = false;
        await UnregisterAttendanceRequestOutsideClickAsync();
        await LoadAttendanceRequestPeriodsAsync(employee.EmployeeId);
    }

    private string GetAttendanceRequestEmployeeResultClass(Employee employee)
        => attendanceRequestEmployee?.EmployeeId == employee.EmployeeId
            ? "employee-result-card selected"
            : "employee-result-card";

    [JSInvokable]
    public async Task HideAttendanceRequestResults()
    {
        if (!showAttendanceRequestResults)
        {
            return;
        }

        showAttendanceRequestResults = false;
        await UnregisterAttendanceRequestOutsideClickAsync();
        StateHasChanged();
    }

    private async Task LoadAttendanceRequestPeriodsAsync(int employeeId)
    {
        var onsiteDates = await Db.AttendanceLogs.AsNoTracking()
