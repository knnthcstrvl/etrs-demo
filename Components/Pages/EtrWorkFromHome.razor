        background: #ebca4a;
        color: #111827;
        box-shadow: none;
        outline: none;
    }

    .etr-attendance-request-label {
        font-size: 0.78rem;
        font-weight: 700;
    }

    @@media (max-width: 1024px) {
        .etr-stage {
            grid-template-columns: 1fr;
            gap: 1.5rem;
