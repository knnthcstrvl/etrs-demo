            gap: 1rem;
        }

        .etr-logo {
            width: 68px;
        }

        .etr-logo-bagong {
            width: 58px;
        }

        .etr-copy-content {
            max-width: 360px;
            text-align: center;
        }

        .etr-sub {
            margin-inline: auto;
