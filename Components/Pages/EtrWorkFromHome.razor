    private async Task<bool> PrepareSubmitConfirmationAsync()
    {
        var employee = selectedEmployee;
        if (employee is null)
        {
            return false;
        }

        if (!IsActiveEmployeeStatus(employee.Status))
        {
            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Warning,
                Title = "Inactive employee",
                Message = $"{FormatEmployeeName(employee)} is inactive and cannot submit a WFH log.",
                Duration = 5000
            });
            return false;
        }

        var todayLog = await Db.AttendanceLogsWfh
            .AsNoTracking()
            .Include(l => l.ExceptionCondition)
            .FirstOrDefaultAsync(l => l.EmployeeId == employee.EmployeeId && l.AttendanceDate == DateTime.Today);

        if (!CanSubmitWfhLog(todayLog, employee))
        {
            return false;
        }

        ApplyTimeOutVerificationRequirement(todayLog);

        pendingSubmissionTime = DateTime.Now;

        if (entryModel.LogType == "IN")
        {
            confirmationTimeIn = pendingSubmissionTime;
            confirmationTimeOut = todayLog?.TimeOut;
            return true;
        }

        if (todayLog is null || !todayLog.TimeIn.HasValue)
        {
            ToastService.Show(new ToastMessage
            {
                Type = ToastType.Warning,
                Title = "Time IN required",
                Message = "Record your WFH time IN first before submitting time OUT.",
                Duration = 4000
            });
            return false;
        }

        confirmationTimeIn = todayLog.TimeIn;
        confirmationTimeOut = pendingSubmissionTime;
        return true;
    }

    private void CloseSubmitConfirmation()
    {
        if (isSubmitting)
        {
            return;
        }

        showSubmitConfirmation = false;
        pendingSubmissionTime = null;
        confirmationTimeIn = null;
        confirmationTimeOut = null;
    }

