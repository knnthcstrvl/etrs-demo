        justify-content: center;
        gap: 0.5rem;
        width: 8.25rem;
        height: 2.35rem;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: #ebca4a;
        color: #111827;
        font-size: 1rem;
        box-shadow: none;
        white-space: nowrap;
        transition: none;
