@page "/Property"
@using Financial.Data
@using Financial.Model.Dtr
@using Microsoft.EntityFrameworkCore
@inject ProcurementDbContext Db

<PageTitle>Exceptions</PageTitle>

<section class="panel-card">
    <div class="panel-heading">
        <div>
            <h1>Attendance Exceptions</h1>
            <p class="mb-0 text-muted">Seeded exception cases for late punches, pending sync items, and overtime validation.</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Date</th>
                    <th>Issue</th>
                    <th>Severity</th>
                    <th>Status</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var issue in issues)
                {
                    <tr>
                        <td>@issue.Employee.FirstName @issue.Employee.LastName</td>
                        <td>@issue.AttendanceDate.ToString("MMM dd, yyyy")</td>
                        <td>@issue.IssueType</td>
                        <td>@issue.Severity</td>
                        <td><span class="status-badge status-warning">@issue.Status</span></td>
                        <td>@issue.Remarks</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private List<AttendanceIssue> issues = new();

    protected override async Task OnInitializedAsync()
    {
        issues = await Db.AttendanceIssues
            .AsNoTracking()
            .Include(i => i.Employee)
            .OrderByDescending(i => i.AttendanceDate)
            .ThenBy(i => i.Severity)
            .ToListAsync();
    }
}
