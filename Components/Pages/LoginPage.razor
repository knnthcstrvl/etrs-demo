@using Financial.DTO.Auth
@using Syncfusion.Blazor.DataForm
@using Syncfusion.Blazor.Notifications


@rendermode InteractiveServer

<div class="col-lg-12 control-section">
    <div class="control-wrapper">
        <h4 class="control-header">Login Form</h4>
        @if (isError == true)
        {
            <SfMessage Severity="MessageSeverity.Error">A problem occurred while submitting your data</SfMessage>
        }
        <SfDataForm @ref="_loginForm" ID="MyForm"
                    Model="@_loginDto" OnValidSubmit="LoginSubmit">
            <FormValidator>
                <DataAnnotationsValidator></DataAnnotationsValidator>
            </FormValidator>
            <FormItems>
                <FormAutoGenerateItems></FormAutoGenerateItems>
            </FormItems>
        </SfDataForm>
    </div>
</div>
<style>
    .mobile .control-wrapper {
        max-width: 100%;
    }

    .control-wrapper {
        max-width: 400px;
        margin: 0 auto;
        padding: 0px 0px 0px;
    }

    .control-header {
        text-align: center;
    }
</style>
@code {
    public bool isError = false;
    private SfDataForm _loginForm = new SfDataForm();
    private LoginDto _loginDto = new LoginDto();


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity.IsAuthenticated)
        {
            // Console.WriteLine("Login Check: " + JsonConvert.SerializeObject(user));
            _constants.JWTToken = user.Claims.FirstOrDefault(_ => _.Type == "Jwt").Value;
            NavManager.NavigateTo(NavManager.Uri, false);
        }

        isError = false;

    }

    public async Task LoginSubmit()
    {
        // Console.WriteLine("Login Button");
        // Console.WriteLine(JsonConvert.SerializeObject(_loginDto));

        LoginResponse response = await accountService.LoginAsync(_loginDto);

        if (!response.Flag)
        {
            _loginForm.Refresh();
            isError = true;
            return;
        }

        var customAuthStateProvider = (CustomAuthenticationStateProvider)AuthStateProvider;
        customAuthStateProvider.UpdateAuthenticationState(response.JWTToken);
        _constants.JWTToken = response.JWTToken;
        StateHasChanged();

        NavManager.NavigateTo("/", forceLoad: true);

    }
}