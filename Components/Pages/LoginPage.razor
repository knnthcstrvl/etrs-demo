@page "/etr/login"
@layout BlankLayout
@using Financial.DTO.Auth
@inject Financial.Services.IToastService ToastService
@inject Financial.Services.CurrentUserService CurrentUser
@inject IJSRuntime JS
@inject IConfiguration Configuration


<PageTitle>ETRS</PageTitle>

<div class="login-page">
    @if (showDeletedAccountModal)
    {
        <div class="deleted-account-overlay" @onclick="CloseDeletedAccountModal">
            <div class="deleted-account-modal" role="dialog" aria-modal="true" aria-labelledby="deletedAccountTitle" @onclick:stopPropagation="true">
                <div class="deleted-account-header">
                    <h2 id="deletedAccountTitle">Account Deleted</h2>
                    <button type="button" class="deleted-account-close" @onclick="CloseDeletedAccountModal" aria-label="Close account deleted notice">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="deleted-account-body">
                    <div class="deleted-account-callout">
                        <div class="deleted-account-icon" aria-hidden="true">
                            <i class="fa-solid fa-user-slash"></i>
                        </div>
                        <div>
                            <div class="deleted-account-eyebrow">Account Access</div>
                            <div class="deleted-account-message-title">Your account has been deleted.</div>
                            <p>Coordinate with the system admin for account details.</p>
                        </div>
                    </div>
                </div>
                <div class="deleted-account-actions">
                    <button type="button" class="btn btn-primary attendance-detail-done deleted-account-button" @onclick="CloseDeletedAccountModal">OK</button>
                </div>
            </div>
        </div>
    }

    <button type="button"
            class="login-theme-toggle"
            title="Dark mode"
            aria-label="Toggle dark mode"
            @onclick="ToggleThemeAsync">
        <i class="fa-solid fa-moon" aria-hidden="true"></i>
    </button>

    <div class="login-card">
        <h1 class="login-title">Welcome Back</h1>

        @* Errors and notifications are shown as global toasts *@

        <EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />

            <div class="login-field">
                <label for="username" class="required-star">Username</label>
                <InputText id="username" @bind-Value="_loginDto.Username" class="login-input focus-yellow" placeholder="Enter your username" />
            </div>

            <div class="login-field">
                <label for="password" class="required-star">Password</label>
                <InputText id="password" @bind-Value="_loginDto.Password" class="login-input focus-yellow" type="password" placeholder="Enter your Password" />
            </div>

            <label class="remember-row" for="rememberMe">
                <InputCheckbox id="rememberMe" @bind-Value="_loginDto.RememberMe" class="remember-checkbox" />
                <span>Remember me</span>
            </label>

            <button type="submit" class="login-button">Login</button>
        </EditForm>

        @if (Configuration.GetValue<bool>("DemoLogin:Enabled"))
        {
            <div class="demo-login-divider"><span>Portfolio preview</span></div>
            <button type="button" class="demo-login-button" @onclick="LoginAsDemoAsync" disabled="@_isLoggingIn">
                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                Try the demo
            </button>
        }
    </div>
</div>

<style>
    .login-page {
        position: relative;
        background: #ffffff;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .login-theme-toggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 10;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--finance-text);
        font-size: 1.35rem;
        line-height: 1;
        padding: 0;
        transition: color 0.16s ease, transform 0.16s ease;
    }

    .login-theme-toggle:hover {
        color: var(--finance-brand-strong);
        transform: translateY(-1px);
    }

    .login-card {
        width: min(100%, 360px);
        padding: 1rem 1.2rem;
        background: transparent;
        border: 0;
        border-radius: 0;
        box-shadow: none;
    }

    .login-title {
        margin: 0 0 1.35rem;
        text-align: center;
        font-size: clamp(1.7rem, 3.5vw, 2.4rem);
        font-weight: 800;
        color: #111827;
        letter-spacing: -0.04em;
    }

    .login-message {
        margin-bottom: 1rem;
    }

    .login-field {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-bottom: 1rem;
    }

    .login-field label {
        font-size: 0.9rem;
        font-weight: 500;
        color: #111827;
    }

    .login-input {
        width: 100%;
        border: 1px solid transparent;
        border-radius: 12px;
        padding: 0.8rem 0.95rem;
        background: #f3f3f3;
        color: #1f2937;
        font-size: 0.95rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .login-input::placeholder {
        color: #9a9a9a;
    }

    .login-card .login-input:focus,
    .login-card .login-input:focus-visible {
        outline: 0;
        border-color: #ebca4a !important;
        box-shadow: none !important;
    }

    .login-input:not(:focus):not(:focus-visible) {
        border-color: transparent !important;
        box-shadow: none !important;
    }

    .login-input.valid,
    .login-input.valid.modified,
    .login-input.invalid,
    .login-input.invalid.modified {
        outline: none !important;
        border-color: transparent !important;
        box-shadow: none !important;
    }

    .remember-row {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        margin: 0.1rem 0 1.15rem;
        font-size: 0.92rem;
        color: #111827;
        cursor: pointer;
    }

    .remember-checkbox {
        width: 1rem;
        height: 1rem;
        margin: 0;
    }

    .login-button {
        width: 100%;
        border: 0;
        border-radius: 12px;
        padding: 0.8rem 1rem;
        background: #ebca4a;
        color: #111827;
        font-size: 0.95rem;
        font-weight: 500;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .login-button:hover {
        background: #dfbe42;
    }

    .login-button:active {
        transform: translateY(1px);
    }

    .demo-login-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1.2rem 0 0.9rem;
        color: #7b8492;
        font-size: 0.78rem;
    }

    .demo-login-divider::before,
    .demo-login-divider::after {
        content: "";
        height: 1px;
        flex: 1;
        background: #e5e7eb;
    }

    .demo-login-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        width: 100%;
        padding: 0.72rem 1rem;
        border: 1px solid #d9dee7;
        border-radius: 12px;
        background: #fff;
        color: #25324b;
        font-size: 0.92rem;
        font-weight: 600;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .demo-login-button:hover:not(:disabled) {
        background: #f8fafc;
        border-color: #b9c2d0;
    }

    .demo-login-button:disabled {
        cursor: wait;
        opacity: 0.7;
    }

    body.etrs-dark-theme .demo-login-divider {
        color: #9fb3d0;
    }

    body.etrs-dark-theme .demo-login-divider::before,
    body.etrs-dark-theme .demo-login-divider::after {
        background: #2f4058;
    }

    body.etrs-dark-theme .demo-login-button {
        border-color: #2f4058;
        background: #111c2d;
        color: #f8fafc;
    }

    body.etrs-dark-theme .demo-login-button:hover:not(:disabled) {
        background: #1b2a3d;
        border-color: #3a506f;
    }

    .deleted-account-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        background: rgba(30, 41, 57, 0.28);
        backdrop-filter: blur(10px);
    }

    .deleted-account-modal {
        width: min(100%, 600px);
        overflow: visible;
        position: relative;
        border: 0;
        border-radius: 10px;
        background: transparent;
        color: #111827;
        box-shadow: none;
    }

    .deleted-account-modal::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        border: 1px solid color-mix(in srgb, var(--etrs-gray-300, #d9dee7) 88%, white);
        border-radius: 10px;
        background: linear-gradient(180deg, #ffffff 0%, var(--etrs-gray-50, #f8fafc) 100%);
        box-shadow: 0 26px 60px rgba(30, 41, 57, 0.18);
        pointer-events: none;
    }

    .deleted-account-modal > * {
        position: relative;
        z-index: 1;
    }

    .deleted-account-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.15rem 1.5rem 1rem;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        border-bottom: 1px solid var(--etrs-gray-200, #e8edf5);
        background: linear-gradient(180deg, #ffffff 0%, var(--etrs-gray-50, #f8fafc) 100%);
    }

    .deleted-account-header h2 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 700;
        letter-spacing: 0;
    }

    .deleted-account-close {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #66758a;
        font-size: 1rem;
        line-height: 1;
    }

    .deleted-account-close:hover,
    .deleted-account-close:focus-visible {
        color: #ffffff;
        outline: 0;
    }

    .deleted-account-body {
        padding: 2rem 1.5rem;
        padding-bottom: 0.5rem;
    }

    .deleted-account-callout {
        display: flex;
        gap: 1rem;
        padding: 1rem 1.05rem;
        border: 1px solid color-mix(in srgb, var(--etrs-gray-300, #d9dee7) 88%, white);
        border-radius: 8px;
        background: #ffffff;
    }

    .deleted-account-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 999px;
        background: #eef4ff;
        color: #4f6df5;
        font-size: 1.05rem;
    }

    .deleted-account-eyebrow {
        color: #66758a;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .deleted-account-message-title {
        margin-top: 0.35rem;
        color: #111827;
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1.35;
    }

    .deleted-account-callout p {
        margin: 0;
        margin-top: 0.35rem;
        color: #5f6b7c;
        font-size: 1rem;
        line-height: 1.45;
    }

    .deleted-account-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 1rem 1.5rem 1.25rem;
        border-top: 1px solid var(--etrs-gray-200, #e8edf5);
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
        background: linear-gradient(180deg, rgba(250, 250, 250, 0.92) 0%, var(--etrs-gray-50, #f8fafc) 100%);
    }

    .deleted-account-button {
        min-width: 7rem;
        border: 1px solid var(--finance-border, #d9dee7) !important;
        border-radius: 12px;
        padding-inline: 1.25rem;
        background: var(--etrs-gray-100, #f3f4f6) !important;
        color: var(--finance-text, #25324b) !important;
        box-shadow: none !important;
        font-weight: 500;
    }

    .deleted-account-button:hover,
    .deleted-account-button:focus-visible {
        background: var(--etrs-gray-200, #e5e7eb) !important;
        border-color: var(--etrs-gray-300, #d1d5db) !important;
        color: var(--finance-text, #25324b) !important;
        box-shadow: none !important;
        outline: 0;
    }

    body.etrs-dark-theme .deleted-account-modal {
        background: transparent;
        border: 0;
        color: #f8fafc;
        box-shadow: none;
    }

    body.etrs-dark-theme .deleted-account-modal::before {
        background: #111c2d;
        border-color: #2f4058;
        box-shadow: 0 28px 70px rgba(0, 0, 0, 0.48);
    }

    body.etrs-dark-theme .deleted-account-header {
        background: #111c2d;
        border-color: #2f4058;
    }

    body.etrs-dark-theme .deleted-account-header h2 {
        color: #f8fafc;
    }

    body.etrs-dark-theme .deleted-account-close {
        color: #9fb3d0;
    }

    body.etrs-dark-theme .deleted-account-callout {
        background: #0f1828;
        border-color: #2f4058;
    }

    body.etrs-dark-theme .deleted-account-icon {
        background: #1b2a3d;
        color: #8ea2ff;
    }

    body.etrs-dark-theme .deleted-account-eyebrow {
        color: #9fb3d0;
    }

    body.etrs-dark-theme .deleted-account-message-title {
        color: #f8fafc;
    }

    body.etrs-dark-theme .deleted-account-callout p {
        color: #9fb3d0;
    }

    body.etrs-dark-theme .deleted-account-actions {
        background: #111c2d;
        border-color: #2f4058;
    }

    body.etrs-dark-theme .deleted-account-button {
        background: #1b2a3d !important;
        border-color: #2f4058 !important;
        color: #f8fafc !important;
    }

    body.etrs-dark-theme .deleted-account-button:hover,
    body.etrs-dark-theme .deleted-account-button:focus-visible {
        background: #243852 !important;
        border-color: #3a506f !important;
    }

    @@media (max-width: 640px) {
        .login-card {
            width: min(100%, 320px);
            padding: 0.85rem 1rem;
        }
    }
</style>

@code {
    public bool isError = false;
    public string errorMessage = "A problem occurred while submitting your data";
    private readonly LoginDto _loginDto = new();
    private EditContext _editContext = default!;
    private bool showDeletedAccountModal;
    private bool _isLoggingIn;

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_loginDto);
        showDeletedAccountModal = NavManager.ToAbsoluteUri(NavManager.Uri).Query.Contains("accountDeleted=1", StringComparison.OrdinalIgnoreCase);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // already authenticated - redirect to dashboard (client-side)
            _constants.JWTToken = user.Claims.FirstOrDefault(_ => _.Type == "Jwt")?.Value!;
            NavManager.NavigateTo("/etr/dashboard");
            return;
        }

        isError = false;
    }

    public async Task LoginSubmit()
    {
        isError = false;
        errorMessage = "A problem occurred while submitting your data";

        try
        {
            LoginResponse response = await accountService.LoginAsync(_loginDto);

            if (!response.Flag)
            {
                var msg = string.IsNullOrWhiteSpace(response.Message)
                    ? "A problem occurred while submitting your data"
                    : response.Message;
                ToastService.Show(new Models.ToastMessage { Type = Models.ToastType.Warning, Title = "Warning", Message = msg, Duration = 6000 });
                return;
            }

            await AuthStateProvider.UpdateAuthenticationState(response.JWTToken, _loginDto.RememberMe);
            _constants.JWTToken = response.JWTToken;
            // ensure CurrentUserService refreshes immediately so UI (sidebar/menu) updates
            try { await CurrentUser.InitializeAsync(); } catch { }
            StateHasChanged();

            ToastService.Show(new Models.ToastMessage { Type = Models.ToastType.Success, Title = "Success", Message = "You are logged in.", Duration = 3000 });
            NavManager.NavigateTo(GetPostLoginDestination());
        }
        catch (Exception ex)
        {
            ToastService.Show(new Models.ToastMessage { Type = Models.ToastType.Error, Title = "Error", Message = ex.Message, Duration = 0 });
        }
    }

    private async Task HandleValidSubmit()
    {
        await LoginSubmit();
    }

    private async Task LoginAsDemoAsync()
    {
        if (_isLoggingIn) return;

        _isLoggingIn = true;
        _loginDto.Username = "demo.user001";
        _loginDto.Password = "Demo@123";
        _loginDto.RememberMe = false;
        try
        {
            await LoginSubmit();
        }
        finally
        {
            _isLoggingIn = false;
        }
    }

    private void HandleInvalidSubmit(EditContext editContext)
        => ShowValidationMessages(editContext);

    private void ShowValidationMessages(EditContext? ctx)
    {
        if (ctx is null) return;

        foreach (var message in ctx.GetValidationMessages().Distinct())
        {
            ToastService.Show(new Models.ToastMessage
            {
                Type = Models.ToastType.Warning,
                Title = "Validation",
                Message = message,
                Duration = 5000
            });
        }
    }

    private async Task ToggleThemeAsync()
    {
        await JS.InvokeVoidAsync("etrsLayoutSync.toggleTheme");
    }

    private void CloseDeletedAccountModal()
    {
        showDeletedAccountModal = false;
        NavManager.NavigateTo("/etr/login", replace: true);
    }

    private string GetPostLoginDestination()
    {
        var relativePath = NavManager.ToBaseRelativePath(NavManager.Uri);
        var pathAndQuery = string.IsNullOrWhiteSpace(relativePath)
            ? "/"
            : "/" + relativePath;

        var pathOnly = pathAndQuery.Split('?', '#')[0].TrimEnd('/');
        if (string.IsNullOrWhiteSpace(pathOnly) || pathOnly == "/" || string.Equals(pathOnly, "/etr/login", StringComparison.OrdinalIgnoreCase))
        {
            return "/etr/dashboard";
        }

        return pathAndQuery;
    }
}
