@page "/accounting"
@using Financial.Data
@using Financial.Model.Dtr
@using Microsoft.EntityFrameworkCore
@inject ProcurementDbContext Db

<PageTitle>Accounting</PageTitle>

<section class="panel-card">
    <div class="panel-heading">
        <div>
            <h1>Attendance Export View</h1>
            <p class="mb-0 text-muted">Combined onsite logs for accounting or payroll review.</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>ID Number</th>
                    <th>Employee</th>
                    <th>Date</th>
                    <th>AM</th>
                    <th>PM</th>
                    <th>Tardiness</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in logs)
                {
                    <tr>
                        <td>@log.IdNumber</td>
                        <td>@FormatName(log.LastName, log.FirstName, log.MiddleName)</td>
                        <td>@log.AttendanceDate.ToString("MMM dd, yyyy")</td>
                        <td>@FormatTimeRange(log.TimeInAm, log.TimeOutAm)</td>
                        <td>@FormatTimeRange(log.TimeInPm, log.TimeOutPm)</td>
                        <td>@(string.IsNullOrWhiteSpace(log.Tardiness) ? "-" : log.Tardiness)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private List<AttendanceLog> logs = new();

    protected override async Task OnInitializedAsync()
    {
        logs = await Db.AttendanceLogs
            .AsNoTracking()
            .OrderByDescending(l => l.AttendanceDate)
            .ThenBy(l => l.LastName)
            .ToListAsync();
    }

    private static string FormatName(string lastName, string firstName, string middleName)
    {
        var middleInitial = string.IsNullOrWhiteSpace(middleName) ? string.Empty : $" {middleName.Trim()[0]}.";
        return $"{lastName}, {firstName}{middleInitial}";
    }

    private static string FormatTimeRange(DateTime? start, DateTime? end)
        => $"{(start?.ToString("hh:mm tt") ?? "-")} / {(end?.ToString("hh:mm tt") ?? "-")}";
}
