    private static string FormatName(string? lastName, string? firstName, string? middleName)
    {
        var middleInitial = string.IsNullOrWhiteSpace(middleName) ? string.Empty : $" {middleName.Trim()[0]}.";
        var formatted = $"{lastName}, {firstName}{middleInitial}".Trim(' ', ',');
        return string.IsNullOrWhiteSpace(formatted) ? "-" : formatted;
    }

    private static string FormatDate(DateTime value) => value.ToString("MMM dd, yyyy");

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string DisplayValue(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string GetStatusText(UserAccount user) => user.IsActive ? "Active" : "Inactive";

    private static string DisplayAccess(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? "-"
            : string.Join(", ", value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));

    private sealed class RowMenuPosition
    {
        public double Left { get; set; }
        public double Top { get; set; }
    }
