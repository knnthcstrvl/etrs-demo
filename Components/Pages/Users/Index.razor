    private bool IsAccessSelected(AccessMenuOption option)
        => option.Children.Length == 0
            ? selectedAccess.Contains(option.Name)
            : option.Children.Where(child => !IsAccessDisabled(child)).All(child => selectedAccess.Contains(child));

    private bool IsAccessDisabled(AccessMenuOption option)
        => IsAccessDisabled(option.Name);

    private static bool IsAccessDisabled(string access)
        => false;

    private void SyncParentSelections()
    {
        foreach (var option in specificAccessOptions.Concat(generalAccessOptions))
        {
            if (option.Children.Length == 0)
            {
                continue;
            }

            var selectableChildren = option.Children.Where(child => !IsAccessDisabled(child)).ToArray();
            if (selectableChildren.Length > 0 && selectableChildren.All(child => selectedAccess.Contains(child)))
            {
                selectedAccess.Add(option.Name);
            }
            else
            {
                selectedAccess.Remove(option.Name);
            }
        }
    }

    private IEnumerable<string> GetCurrentTabSelectableAccess()
    {
        foreach (var option in CurrentAccessOptions)
        {
            if (!IsAccessDisabled(option.Name))
            {
                yield return option.Name;
            }

            foreach (var child in option.Children)
            {
                if (!IsAccessDisabled(child))
                {
                    yield return child;
                }
            }
        }
    }

