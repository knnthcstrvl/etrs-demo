    private async Task SaveUserAsync()
    {
        if (!isEditingUser && !PasswordsMatch(userForm.Password, addUserPasswordConfirm, "user"))
        {
            return;
        }

        SyncParentSelections();

        userForm.AccessLevel = string.Join(",", selectedAccess.OrderBy(value => value));
        var wasEditingUser = isEditingUser;
        var savedUserName = FormatName(userForm.LastName, userForm.FirstName, userForm.MiddleName);

        try
        {
            if (isEditingUser)
            {
                var existing = await Db.UserAccounts.FindAsync(userForm.UserAccountId);
                if (existing is null)
                {
                    ShowToast(ToastType.Warning, "User not found", "The user account no longer exists.");
                    return;
                }

                existing.LastName = userForm.LastName;
                existing.FirstName = userForm.FirstName;
                existing.MiddleName = userForm.MiddleName;
                existing.Username = userForm.Username;
                existing.Email = userForm.Email;
                existing.Role = userForm.Role;
                existing.DivisionCenterUnit = userForm.DivisionCenterUnit;
                existing.Designation = userForm.Designation;
                existing.IsActive = userForm.IsActive;
                existing.AccessLevel = userForm.AccessLevel;
                existing.DateUpdated = DateTime.UtcNow;
                await Db.SaveChangesAsync();
            }
            else
            {
                userForm.Password = BCrypt.Net.BCrypt.HashPassword(userForm.Password);
                userForm.MustChangePassword = true;
                userForm.DateCreated = DateTime.UtcNow;
                await Db.UserAccounts.AddAsync(userForm);
                await Db.SaveChangesAsync();
            }

            await LoadUsersAsync();
            showUserModal = false;
            showRoleDropdown = false;
            showAccessDropdown = false;
            showStatusDropdown = false;
            openRoleDropdownUpward = false;
            openAccessDropdownUpward = false;
            openStatusDropdownUpward = false;
            activeAccessParent = null;
            activeAccessChildOpenLeft = false;
            activeAccessChildOpenUpward = false;
            userModalStep = UserModalStep.PersonalInfo;
            userModalStepMovingForward = true;
            addUserPasswordConfirm = string.Empty;
            ResetUserModalMenuPlacement();

            ShowToast(
                ToastType.Success,
                wasEditingUser ? "User updated" : "User added",
                $"{savedUserName} was {(wasEditingUser ? "updated" : "added")}.");
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, wasEditingUser ? "Update failed" : "Add failed", ex.Message);
        }
    }

