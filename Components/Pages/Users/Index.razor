    }

    private void CloseUserDetail()
    {
        selectedUser = null;
    }

    private void OpenHoveredUserDetail()
    {
        if (hoveredUserRowMenuUser is not { } user)
        {
            return;
        }

        OpenUserDetail(user);
    }

    private void OpenHoveredUserEdit()
    {
        if (hoveredUserRowMenuUser is not { } user)
