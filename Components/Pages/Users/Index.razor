@code {
    private const int DefaultPageSize = 10;
    private const int MaxPageSize = 50;
    private static readonly int[] PageSizeOptions = { 10, 25, 50 };
    private static readonly string[] StatusOptions = { "Active", "Inactive" };

    private List<UserAccount> users = new();
    private List<UserAccount> filteredUsers = new();
    private int activeUsers;
    private int inactiveUsers;
    private int adminUsers;
    private int userPage = 1;
    private int pageSize = DefaultPageSize;
    private string tableSearchText = string.Empty;
    private string filterName = string.Empty;
    private string filterUsername = string.Empty;
    private string filterRole = string.Empty;
    private string filterDivision = string.Empty;
    private string filterDesignation = string.Empty;
    private string filterStatus = string.Empty;
    private string? activeFilterField;
    private string? sortColumn;
    private bool sortDescending = true;
    private bool showFilterMenu;
    private bool showEntriesMenu;
    private UserAccount? selectedUser;
    private UserAccount? hoveredUserRowMenuUser;
    private double rowActionMenuLeft;
    private double rowActionMenuTop;
    private bool showRowActionMenu;
    private bool rowActionMenuHovered;
    private int rowActionMenuShowVersion;
    private int rowActionMenuHideVersion;

    private bool showUserModal;
    private bool isEditingUser;
    private UserAccount userForm = new();
    private readonly List<string> accessOptions = new() { "Add", "Edit", "Delete", "Import", "Export", "View" };
    private HashSet<string> selectedAccess = new(StringComparer.OrdinalIgnoreCase);
    private bool showAccessDropdown;

    private bool HasHoveredRowMenu => showRowActionMenu && hoveredUserRowMenuUser is not null;
    private string RowActionMenuStyle => $"left:{rowActionMenuLeft:0}px;top:{rowActionMenuTop:0}px;";

    private IEnumerable<UserAccount> PagedUsers => filteredUsers
        .Skip((userPage - 1) * pageSize)
        .Take(pageSize);

    private int UserTotalPages => Math.Max(1, (int)Math.Ceiling(filteredUsers.Count / (double)pageSize));

    private bool HasActiveTableFilters
        => !string.IsNullOrWhiteSpace(filterName)
            || !string.IsNullOrWhiteSpace(filterUsername)
            || !string.IsNullOrWhiteSpace(filterRole)
            || !string.IsNullOrWhiteSpace(filterDivision)
            || !string.IsNullOrWhiteSpace(filterDesignation)
            || !string.IsNullOrWhiteSpace(filterStatus);

    private IEnumerable<string> CurrentNameOptions => GetDistinctOptions(users.Select(user => FormatName(user.LastName, user.FirstName, user.MiddleName)));
    private IEnumerable<string> CurrentUsernameOptions => GetDistinctOptions(users.Select(user => user.Username));
    private IEnumerable<string> CurrentRoleOptions => GetDistinctOptions(users.Select(user => user.Role));
    private IEnumerable<string> CurrentDivisionOptions => GetDistinctOptions(users.Select(user => user.DivisionCenterUnit));
    private IEnumerable<string> CurrentDesignationOptions => GetDistinctOptions(users.Select(user => user.Designation));

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitializeAsync();
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = await Db.UserAccounts
            .AsNoTracking()
            .OrderBy(u => u.LastName)
            .ThenBy(u => u.FirstName)
            .ToListAsync();

        activeUsers = users.Count(u => u.IsActive);
        inactiveUsers = users.Count - activeUsers;
        adminUsers = users.Count(u => string.Equals(u.Role, "Admin", StringComparison.OrdinalIgnoreCase));

        RefreshFilteredUsers();
    }

    private void RefreshFilteredUsers(bool resetPaging = false)
    {
        filteredUsers = ApplyUserSort(users.Where(MatchesUserFilters)).ToList();

        if (resetPaging)
        {
            userPage = 1;
            return;
        }

        userPage = Math.Clamp(userPage, 1, UserTotalPages);
    }

    private bool MatchesUserFilters(UserAccount user)
    {
        if (!MatchesSharedSearch(user))
        {
            return false;
        }

        if (!MatchesSelectedValue(FormatName(user.LastName, user.FirstName, user.MiddleName), filterName))
        {
            return false;
        }

        if (!MatchesSelectedValue(user.Username, filterUsername))
        {
            return false;
        }

        if (!MatchesSelectedValue(user.Role, filterRole))
        {
            return false;
        }

        if (!MatchesSelectedValue(user.DivisionCenterUnit, filterDivision))
        {
            return false;
        }

        if (!MatchesSelectedValue(user.Designation, filterDesignation))
        {
            return false;
        }

        return MatchesSelectedValue(GetStatusText(user), filterStatus);
    }

    private bool MatchesSharedSearch(UserAccount user)
    {
        var query = tableSearchText.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return MatchesUserName(user.LastName, user.FirstName, user.MiddleName, query)
            || ContainsText(user.Username, query)
            || ContainsText(user.Email, query)
            || ContainsText(user.Role, query)
            || ContainsText(user.DivisionCenterUnit, query)
            || ContainsText(user.Designation, query)
            || ContainsText(GetStatusText(user), query)
            || ContainsText(FormatDate(user.DateCreated), query);
    }

    private static bool ContainsText(string? source, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        return !string.IsNullOrWhiteSpace(source)
            && source.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static bool MatchesSelectedValue(string? source, string? selectedValue)
    {
        if (string.IsNullOrWhiteSpace(selectedValue))
        {
            return true;
        }

        return string.Equals(source?.Trim(), selectedValue.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static bool MatchesUserName(string? lastName, string? firstName, string? middleName, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return true;
        }

        var trimmedQuery = query.Trim();
        var fullName = string.Join(" ", new[] { firstName, middleName, lastName }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var reversedName = string.Join(" ", new[] { lastName, firstName, middleName }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var formattedName = FormatName(lastName ?? string.Empty, firstName ?? string.Empty, middleName ?? string.Empty);

        return ContainsText(firstName, trimmedQuery)
            || ContainsText(middleName, trimmedQuery)
            || ContainsText(lastName, trimmedQuery)
            || ContainsText(fullName, trimmedQuery)
            || ContainsText(reversedName, trimmedQuery)
            || ContainsText(formattedName, trimmedQuery);
    }

    private static IEnumerable<string> GetDistinctOptions(IEnumerable<string?> values)
        => values
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value, StringComparer.OrdinalIgnoreCase);

