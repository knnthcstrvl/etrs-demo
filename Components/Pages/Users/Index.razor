        => $"{(activeAccessChildOpenLeft ? "open-left" : string.Empty)} {(activeAccessChildOpenUpward ? "open-upward" : string.Empty)}";

    private static string GetAccessChildMenuKey(AccessMenuOption option)
        => $"access-child-{option.Name}";

    private static double GetAccessChildMenuEstimatedHeight(AccessMenuOption option)
        => Math.Max(56, option.Children.Length * 36 + 14);

    private double GetAccessMenuEstimatedHeight()
        => Math.Max(220, CurrentAccessOptions.Count() * 40 + 76);

    private void ResetUserModalMenuPlacement()
    {
        userRoleMenuMaxHeight = 120;
        userAccessMenuMaxHeight = 320;
        userStatusMenuMaxHeight = 120;
    }

    private static string FormatName(string? lastName, string? firstName, string? middleName)
    {
        var middleInitial = string.IsNullOrWhiteSpace(middleName) ? string.Empty : $" {middleName.Trim()[0]}.";
        var formatted = $"{lastName}, {firstName}{middleInitial}".Trim(' ', ',');
        return string.IsNullOrWhiteSpace(formatted) ? "-" : formatted;
    }

    private static string FormatDate(DateTime value) => value.ToString("MMM dd, yyyy");

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string DisplayValue(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string GetStatusText(UserAccount user) => user.IsActive ? "Active" : "Inactive";

    private static string DisplayAccess(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? "-"
            : string.Join(", ", value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));

    private static IEnumerable<string> GetAccessPills(UserAccount user)
    {
        if (string.Equals(user.Role, "Admin", StringComparison.OrdinalIgnoreCase))
        {
            yield return "All Access Levels";
            yield break;
        }

        var access = user.AccessLevel?
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToArray() ?? Array.Empty<string>();

        if (access.Length == 0)
        {
            yield return "None";
            yield break;
        }

        foreach (var item in access)
        {
            yield return item;
        }
    }

    private static IEnumerable<string> NormalizeAccessTokens(IEnumerable<string> tokens)
    {
        var normalized = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var token in tokens)
        {
            switch (token)
            {
                case "View":
                    normalized.Add(AccessPolicy.ViewLogs);
                    break;
                case "Import":
                    normalized.Add(AccessPolicy.ImportEmployees);
                    break;
                default:
                    normalized.Add(token);
                    break;
            }
        }

        if (normalized.Contains("Add"))
        {
            normalized.Add(AccessPolicy.InputLogs);
            normalized.Add(AccessPolicy.AddEmployee);
            normalized.Add(AccessPolicy.AddUser);
        }

        if (normalized.Contains("Edit"))
        {
            normalized.Add(AccessPolicy.EditLogs);
            normalized.Add(AccessPolicy.EditEmployee);
            normalized.Add(AccessPolicy.EditUser);
        }

        if (normalized.Contains("Delete"))
        {
            normalized.Add(AccessPolicy.DeleteUser);
        }

        if (normalized.Contains("Export"))
        {
            normalized.Add(AccessPolicy.ExportLogs);
            normalized.Add(AccessPolicy.ExportEmployees);
        }

        normalized.Remove("View");
        normalized.Remove("Import");
        return normalized;
    }

