    private void ToggleAccess(AccessMenuOption option)
    {
        if (IsAccessDisabled(option))
        {
            return;
        }

        if (option.Children.Length == 0)
        {
            ToggleChildAccess(option.Name);
            return;
        }

        var selectableChildren = option.Children.Where(child => !IsAccessDisabled(child)).ToArray();
        var allChildrenSelected = selectableChildren.All(child => selectedAccess.Contains(child));
        if (allChildrenSelected)
        {
            foreach (var child in selectableChildren)
            {
                selectedAccess.Remove(child);
            }

            selectedAccess.Remove(option.Name);
            return;
        }

        selectedAccess.Add(option.Name);
        foreach (var child in selectableChildren)
        {
            selectedAccess.Add(child);
        }
    }

    private void ToggleAllAccess()
    {
        if (AllAccessSelected)
        {
            selectedAccess.Clear();
            return;
        }

        selectedAccess = new HashSet<string>(AccessPolicy.AdminAssignableAccess, StringComparer.OrdinalIgnoreCase);
    }

    private void ToggleCurrentTabAccess()
    {
        var tabAccess = GetCurrentTabSelectableAccess().ToArray();
        if (tabAccess.Length == 0)
        {
            return;
        }

        if (tabAccess.All(access => selectedAccess.Contains(access)))
        {
            foreach (var access in tabAccess)
            {
                selectedAccess.Remove(access);
            }

            SyncParentSelections();
            return;
        }

        foreach (var access in tabAccess)
        {
            selectedAccess.Add(access);
        }

        SyncParentSelections();
    }

