@page "/etr/users"
@using Financial.Data
@using Financial.Model
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Security.Cryptography
@implements IAsyncDisposable
@inject ProcurementDbContext Db
@inject Financial.Services.CurrentUserService CurrentUser
@inject IJSRuntime JS

<PageTitle>ETRS | Users</PageTitle>

<RequireAccess RequiredAccess='@(new string[] { AccessPolicy.ManageUsers })'>
<div class="dashboard-shell">
    <div class="panel-heading attendance-logs-heading">
        <div>
            <h1 class="attendance-logs-title">User</h1>
        </div>
        <div class="attendance-logs-header-actions">
            <button type="button" class="btn btn-outline-secondary attendance-logs-export-btn" @onclick="OpenAddUserModal" disabled="@(!CurrentUser.HasAccess(AccessPolicy.AddUser))">Add User</button>
        </div>
    </div>

    <div class="metric-grid dashboard-metrics attendance-logs-metrics">
        <div class="metric-card">
            <span class="metric-label">Users</span>
            <strong>@users.Count</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Active</span>
            <strong>@activeUsers</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Inactive</span>
            <strong>@inactiveUsers</strong>
        </div>
        <div class="metric-card">
            <span class="metric-label">Admins</span>
            <strong>@adminUsers</strong>
        </div>
    </div>

    <div style="margin-top:1rem;">
        <div class="attendance-table-toolbar">
            <div class="attendance-table-search">
                <input id="userSearch"
                       class="form-control attendance-table-search-input"
                       type="search"
                       placeholder="Search..."
                       value="@tableSearchText"
                       @oninput="HandleTableSearchInput" />
            </div>

            <div class="attendance-table-actions" @ref="tableMenuControlsRef">
                <div class="attendance-filter-dropdown">
                    <button type="button" class="btn btn-outline-secondary attendance-filter-button" @onclick="ToggleFilterMenu">
                        <i class="fa-solid fa-bars-staggered" aria-hidden="true"></i>
                        <span>Filter</span>
                        @if (HasActiveTableFilters)
                        {
                            <span class="attendance-filter-button-clear"
                                  title="Clear filters"
                                  role="button"
                                  tabindex="0"
                                  @onclick="ClearFiltersFromButton"
                                  @onclick:stopPropagation="true">&times;</span>
                        }
                    </button>

                    <div class="attendance-filter-menu @(showFilterMenu ? "show" : null)" @onclick:stopPropagation="true">
                        <div class="attendance-filter-grid">
                            <div class="attendance-filter-field">
                                <label class="attendance-table-toolbar-label" for="userFilterName">Name</label>
                                <div class="attendance-filter-select-wrap">
                                    <button type="button"
                                            id="userFilterName"
                                            class="attendance-filter-select-trigger @(activeFilterField == "name" ? "active" : null)"
                                            @onclick='() => ToggleFilterField("name")'>
                                        <span class="attendance-filter-select-value">@DisplayValue(filterName, "All Names")</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(activeFilterField == "name" ? "show" : null)">
                                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterName) ? "active" : null)" @onclick='() => SetFilterValue("name", string.Empty)'>All Names</button>
                                        @foreach (var option in CurrentNameOptions)
                                        {
                                            <button type="button" class="attendance-filter-select-option @(string.Equals(filterName, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("name", option)'>@option</button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="attendance-filter-field">
                                <label class="attendance-table-toolbar-label" for="userFilterUsername">Username</label>
                                <div class="attendance-filter-select-wrap">
                                    <button type="button"
                                            id="userFilterUsername"
                                            class="attendance-filter-select-trigger @(activeFilterField == "username" ? "active" : null)"
                                            @onclick='() => ToggleFilterField("username")'>
                                        <span class="attendance-filter-select-value">@DisplayValue(filterUsername, "All Usernames")</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(activeFilterField == "username" ? "show" : null)">
                                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterUsername) ? "active" : null)" @onclick='() => SetFilterValue("username", string.Empty)'>All Usernames</button>
                                        @foreach (var option in CurrentUsernameOptions)
                                        {
                                            <button type="button" class="attendance-filter-select-option @(string.Equals(filterUsername, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("username", option)'>@option</button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="attendance-filter-field">
                                <label class="attendance-table-toolbar-label" for="userFilterRole">Role</label>
                                <div class="attendance-filter-select-wrap">
                                    <button type="button"
                                            id="userFilterRole"
                                            class="attendance-filter-select-trigger @(activeFilterField == "role" ? "active" : null)"
                                            @onclick='() => ToggleFilterField("role")'>
                                        <span class="attendance-filter-select-value">@DisplayValue(filterRole, "All Roles")</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(activeFilterField == "role" ? "show" : null)">
                                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterRole) ? "active" : null)" @onclick='() => SetFilterValue("role", string.Empty)'>All Roles</button>
                                        @foreach (var option in CurrentRoleOptions)
                                        {
                                            <button type="button" class="attendance-filter-select-option @(string.Equals(filterRole, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("role", option)'>@option</button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="attendance-filter-field">
                                <label class="attendance-table-toolbar-label" for="userFilterDivision">Division / Unit</label>
                                <div class="attendance-filter-select-wrap">
                                    <button type="button"
                                            id="userFilterDivision"
                                            class="attendance-filter-select-trigger @(activeFilterField == "division" ? "active" : null)"
                                            @onclick='() => ToggleFilterField("division")'>
                                        <span class="attendance-filter-select-value">@DisplayValue(filterDivision, "All Divisions / Units")</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(activeFilterField == "division" ? "show" : null)">
                                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterDivision) ? "active" : null)" @onclick='() => SetFilterValue("division", string.Empty)'>All Divisions / Units</button>
                                        @foreach (var option in CurrentDivisionOptions)
                                        {
                                            <button type="button" class="attendance-filter-select-option @(string.Equals(filterDivision, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("division", option)'>@option</button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="attendance-filter-field">
                                <label class="attendance-table-toolbar-label" for="userFilterDesignation">Designation</label>
                                <div class="attendance-filter-select-wrap">
                                    <button type="button"
                                            id="userFilterDesignation"
                                            class="attendance-filter-select-trigger @(activeFilterField == "designation" ? "active" : null)"
                                            @onclick='() => ToggleFilterField("designation")'>
                                        <span class="attendance-filter-select-value">@DisplayValue(filterDesignation, "All Designations")</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(activeFilterField == "designation" ? "show" : null)">
                                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterDesignation) ? "active" : null)" @onclick='() => SetFilterValue("designation", string.Empty)'>All Designations</button>
                                        @foreach (var option in CurrentDesignationOptions)
                                        {
                                            <button type="button" class="attendance-filter-select-option @(string.Equals(filterDesignation, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("designation", option)'>@option</button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="attendance-filter-field">
                                <label class="attendance-table-toolbar-label" for="userFilterStatus">Status</label>
                                <div class="attendance-filter-select-wrap">
                                    <button type="button"
                                            id="userFilterStatus"
                                            class="attendance-filter-select-trigger @(activeFilterField == "status" ? "active" : null)"
                                            @onclick='() => ToggleFilterField("status")'>
                                        <span class="attendance-filter-select-value">@DisplayValue(filterStatus, "All Statuses")</span>
                                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="attendance-filter-select-menu @(activeFilterField == "status" ? "show" : null)">
                                        <button type="button" class="attendance-filter-select-option @(string.IsNullOrWhiteSpace(filterStatus) ? "active" : null)" @onclick='() => SetFilterValue("status", string.Empty)'>All Statuses</button>
                                        @foreach (var option in StatusOptions)
                                        {
                                            <button type="button" class="attendance-filter-select-option @(string.Equals(filterStatus, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick='() => SetFilterValue("status", option)'>@option</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="attendance-filter-actions">
                            <button type="button" class="attendance-filter-clear" @onclick="ClearFilters">Clear</button>
                            <button type="button" class="btn btn-primary attendance-filter-apply" @onclick="CloseFilterMenu">Apply</button>
                        </div>
                    </div>
                </div>

                <div class="attendance-filter-dropdown attendance-entries-counter">
                    <button type="button" class="btn btn-outline-secondary attendance-filter-button attendance-entries-button" @onclick="ToggleEntriesMenu">
                        <span>@pageSize</span>
                        <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                    </button>

                    <div class="attendance-entries-menu attendance-filter-menu @(showEntriesMenu ? "show" : null)" @onclick:stopPropagation="true">
                        @foreach (var option in PageSizeOptions)
                        {
                            <button type="button"
                                    class="attendance-entries-option @(pageSize == option ? "active" : null)"
                                    @onclick="() => SelectPageSize(option)">
                                @option
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-card attendance-table-card"
             @onmouseenter="KeepRowMenuOpen"
             @onmouseleave="HideRowMenuAsync">
            @if (selectedUser is not null)
            {
                <div class="attendance-detail-overlay" @onclick="CloseUserDetail">
                    <div class="attendance-detail-modal user-detail-modal" @onclick:stopPropagation="true">
                        <div class="attendance-detail-header">
                            <div>
                                <h2 class="attendance-detail-title">User Details</h2>
                            </div>
                            <div class="attendance-detail-header-actions">
                                <button type="button"
                                        class="attendance-detail-header-button"
                                        @onclick="() => OpenEditUserModal(selectedUser)"
                                        disabled="@(!CurrentUser.HasAccess(AccessPolicy.EditUser))">
                                    Edit User
                                </button>
                                <button type="button" class="attendance-detail-close" @onclick="CloseUserDetail" aria-label="Close user details">
                                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>

                        <div class="attendance-detail-body user-detail-body">
                            <div class="attendance-detail-section attendance-detail-hero">
                                <div>
                                    <div class="attendance-detail-eyebrow">User</div>
                                    <div class="attendance-detail-person">@FormatName(selectedUser.LastName, selectedUser.FirstName, selectedUser.MiddleName)</div>
                                    <div class="attendance-detail-meta">@DisplayValue(selectedUser.Username)</div>
                                </div>
                                <span class="status-badge @(selectedUser.IsActive ? "status-ok" : "status-danger")">@(selectedUser.IsActive ? "Active" : "Inactive")</span>
                            </div>

                            <div class="attendance-detail-section attendance-detail-section-primary">
                                <div class="attendance-detail-grid">
                                    <div class="attendance-detail-field">
                                        <span class="attendance-detail-label">Email</span>
                                        <strong>@DisplayValue(selectedUser.Email)</strong>
                                    </div>
                                    <div class="attendance-detail-field">
                                        <span class="attendance-detail-label">Created</span>
                                        <strong>@FormatDate(selectedUser.DateCreated)</strong>
                                    </div>
                                    <div class="attendance-detail-field">
                                        <span class="attendance-detail-label">Division / Unit</span>
                                        <strong>@DisplayValue(selectedUser.DivisionCenterUnit)</strong>
                                    </div>
                                    <div class="attendance-detail-field">
                                        <span class="attendance-detail-label">Designation</span>
                                        <strong>@DisplayValue(selectedUser.Designation)</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="attendance-detail-section attendance-detail-section-primary">
                                <div class="attendance-detail-grid user-detail-access-grid">
                                    <div class="attendance-detail-field">
                                        <span class="attendance-detail-label">Role</span>
                                        <strong>@DisplayValue(selectedUser.Role)</strong>
                                    </div>
                                    <div class="attendance-detail-field">
                                        <span class="attendance-detail-label">Access Level</span>
                                        <div class="user-access-pill-list user-detail-access-pill-list" title="@DisplayAccess(selectedUser.AccessLevel)">
                                            @foreach (var access in GetAccessPills(selectedUser))
                                            {
                                                <span class="access-level-badge">@access</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="attendance-detail-footer">
                            <button type="button" class="attendance-detail-text-action" @onclick="CloseUserDetail">Close</button>
                        </div>
                    </div>
                </div>
            }

            @if (showUserModal)
            {
                <div class="attendance-detail-overlay" @onclick="CloseUserModal">
                    <div class="attendance-detail-modal attendance-input-modal user-input-modal @(ShouldScrollUserModalBody ? "user-input-modal-scrollable" : null)" @onclick="CloseUserDropdowns" @onclick:stopPropagation="true">
                        <div class="attendance-detail-header">
                            <div>
                                <h2 class="attendance-detail-title">@(isEditingUser ? "Edit User" : "Add User")</h2>
                            </div>
                            <button type="button" class="attendance-detail-close" @onclick="CloseUserModal" aria-label="Close user form">
                                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                            </button>
                        </div>

                        <div class="attendance-detail-body attendance-input-body">
                            <div class="attendance-detail-section attendance-detail-hero user-modal-hero">
                                <div>
                                    <div class="attendance-detail-eyebrow">User Account</div>
                                    <div class="attendance-detail-person">@GetUserModalStepTitle()</div>
                                    <div class="attendance-detail-meta">@GetUserModalStepMeta()</div>
                                </div>
                                <div class="attendance-input-pill">Step @((int)userModalStep) of @UserModalStepCount</div>
                            </div>

                            <div class="user-modal-step-panel @(userModalStepMovingForward ? "step-forward" : "step-backward")" @key="userModalStep">
                                @if (userModalStep == UserModalStep.PersonalInfo)
                                {
                                    <div class="attendance-detail-section user-modal-section user-modal-identity">
                                        <div class="attendance-input-grid">
                                            <div class="attendance-input-field">
                                                <label class="attendance-table-toolbar-label" for="userLastName">Last Name</label>
                                                <input id="userLastName" class="form-control attendance-input-control" @bind="userForm.LastName" />
                                            </div>
                                            <div class="attendance-input-field">
                                                <label class="attendance-table-toolbar-label" for="userFirstName">First Name</label>
                                                <input id="userFirstName" class="form-control attendance-input-control" @bind="userForm.FirstName" />
                                            </div>
                                            <div class="attendance-input-field">
                                                <label class="attendance-table-toolbar-label" for="userMiddleName">Middle Name</label>
                                                <input id="userMiddleName" class="form-control attendance-input-control" @bind="userForm.MiddleName" />
                                            </div>
                                            <div class="attendance-input-field">
                                                <label class="attendance-table-toolbar-label" for="userUsername">Username</label>
                                                <input id="userUsername" class="form-control attendance-input-control" @bind="userForm.Username" />
                                            </div>
                                            <div class="attendance-input-field">
                                                <label class="attendance-table-toolbar-label" for="userEmail">Email</label>
                                                <input id="userEmail" class="form-control attendance-input-control" @bind="userForm.Email" />
                                            </div>
                                            <div class="attendance-input-field">
                                                <label class="attendance-table-toolbar-label" for="userDivision">Division / Unit</label>
                                                <input id="userDivision" class="form-control attendance-input-control" @bind="userForm.DivisionCenterUnit" />
                                            </div>
                                            <div class="attendance-input-field">
                                                <label class="attendance-table-toolbar-label" for="userDesignation">Designation</label>
                                                <input id="userDesignation" class="form-control attendance-input-control" @bind="userForm.Designation" />
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (userModalStep == UserModalStep.AccountAccess)
                                {
                                    <div class="attendance-detail-section user-modal-section">
                                        <div class="attendance-input-grid user-access-grid">
                                        <div class="attendance-input-field @(showRoleDropdown ? "user-modal-field-open" : null)">
                                        <label class="attendance-table-toolbar-label" for="userRole">Role</label>
                                        <div class="attendance-filter-select-wrap user-modal-dropdown" @onclick:stopPropagation="true">
                                            <button type="button"
                                                    id="userRole"
                                                    @ref="userRoleButtonRef"
                                                    class="attendance-filter-select-trigger attendance-input-control @(showRoleDropdown ? "active" : null)"
                                                    @onclick="ToggleRoleDropdown">
                                                <span class="attendance-filter-select-value">@DisplayValue(userForm.Role, "Select role")</span>
                                                <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                            </button>

                                            <div class="@GetUserModalDropdownMenuClass(showRoleDropdown, openRoleDropdownUpward)" style="@GetUserModalDropdownMenuStyle(userRoleMenuMaxHeight)">
                                                @foreach (var option in roleOptions)
                                                {
                                                    <button type="button"
                                                            class="attendance-filter-select-option @(string.Equals(userForm.Role, option, StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                                            @onclick="() => SelectRole(option)">
                                                        @option
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="attendance-input-field @(showAccessDropdown ? "user-modal-field-open" : null)">
                                        <label class="attendance-table-toolbar-label" for="userAccess">Access Level</label>
                                        <div class="attendance-filter-select-wrap user-modal-dropdown access-select" @onclick:stopPropagation="true">
                                            <button type="button"
                                                    id="userAccess"
                                                    @ref="userAccessButtonRef"
                                                    class="attendance-filter-select-trigger attendance-input-control access-pills @(showAccessDropdown ? "active" : null)"
                                                    @onclick="ToggleAccessDropdown">
                                                <span class="access-placeholder">Select access</span>
                                                @if (selectedAccess.Count > 0)
                                                {
                                                    <span class="access-count-pill">
                                                        <span>@selectedAccess.Count</span>
                                                        <span class="access-count-clear" role="button" tabindex="0" title="Clear access levels" @onclick="ClearAccess" @onclick:stopPropagation="true">
                                                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                                        </span>
                                                    </span>
                                                }
                                                <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                            </button>

                                            <div class="access-dropdown @GetUserModalDropdownMenuClass(showAccessDropdown, openAccessDropdownUpward)" style="@GetUserModalDropdownMenuStyle(userAccessMenuMaxHeight)">
                                                <div class="access-tabs" role="tablist" aria-label="Access level groups">
                                                    <button type="button"
                                                            role="tab"
                                                            class="access-tab @(activeAccessTab == AccessTab.Specific ? "active" : null)"
                                                            @onclick="() => SetAccessTab(AccessTab.Specific)">
                                                        Specific
                                                    </button>
                                                    <button type="button"
                                                            role="tab"
                                                            class="access-tab @(activeAccessTab == AccessTab.General ? "active" : null)"
                                                            @onclick="() => SetAccessTab(AccessTab.General)">
                                                        General
                                                    </button>
                                                </div>
                                                <button type="button"
                                                        class="attendance-filter-select-option access-option access-option-select-all @(CurrentTabAllAccessSelected ? "active" : null)"
                                                        @onclick="ToggleCurrentTabAccess">
                                                    <span class="access-option-check">
                                                        @if (CurrentTabAllAccessSelected)
                                                        {
                                                            <i class="fa-solid fa-minus" aria-hidden="true"></i>
                                                        }
                                                    </span>
                                                    <span>Select all</span>
                                                </button>
                                                @foreach (var option in CurrentAccessOptions)
                                                {
                                                    var selectedChildCount = GetSelectedChildCount(option);
                                                    <div class="access-option-wrap @(activeAccessParent == option.Name ? "active-parent" : null)"
                                                         data-access-child-key="@GetAccessChildMenuKey(option)"
                                                         @onmouseenter="() => ShowAccessChildrenAsync(option)"
                                                         @onmouseleave="HideAccessChildren">
                                                        <button type="button"
                                                                class="attendance-filter-select-option access-option @(IsAccessSelected(option) ? "active" : null) @(IsAccessDisabled(option) ? "disabled" : null)"
                                                                disabled="@IsAccessDisabled(option)"
                                                                @onclick="(() => ToggleAccess(option))">
                                                            <span class="access-option-check">
                                                                @if (IsAccessSelected(option))
                                                                {
                                                                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                                                                }
                                                            </span>
                                                            <span>@option.Name</span>
                                                            @if (option.Children.Length > 0)
                                                            {
                                                                <span class="access-child-count">@selectedChildCount/@option.Children.Length</span>
                                                                <i class="fa-solid fa-chevron-right access-parent-arrow" aria-hidden="true"></i>
                                                            }
                                                        </button>
                                                        @if (option.Children.Length > 0 && activeAccessParent == option.Name)
                                                        {
                                                            <div class="access-child-menu @GetAccessChildMenuClass()">
                                                                <div class="access-child-menu-title">@option.Name</div>
                                                                @foreach (var child in option.Children)
                                                                {
                                                                    <button type="button"
                                                                            class="attendance-filter-select-option access-option access-child-option @(selectedAccess.Contains(child) ? "active" : null) @(IsAccessDisabled(child) ? "disabled" : null)"
                                                                            disabled="@IsAccessDisabled(child)"
                                                                            @onclick="(() => ToggleChildAccess(child))">
                                                                        <span class="access-option-check">
                                                                            @if (selectedAccess.Contains(child))
                                                                            {
                                                                                <i class="fa-solid fa-check" aria-hidden="true"></i>
                                                                            }
                                                                        </span>
                                                                        <span>@child</span>
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    @if (isEditingUser)
                                    {
                                        <div class="attendance-input-field user-status-field @(showStatusDropdown ? "user-modal-field-open" : null)">
                                            <label class="attendance-table-toolbar-label" for="userStatus">Status</label>
                                            <div class="attendance-filter-select-wrap user-modal-dropdown" @onclick:stopPropagation="true">
                                                <button type="button"
                                                        id="userStatus"
                                                        @ref="userStatusButtonRef"
                                                        class="attendance-filter-select-trigger attendance-input-control @(showStatusDropdown ? "active" : null)"
                                                        @onclick="ToggleStatusDropdown">
                                                    <span class="attendance-filter-select-value">@(userForm.IsActive ? "Active" : "Inactive")</span>
                                                    <i class="fa-solid fa-chevron-down attendance-dropdown-caret" aria-hidden="true"></i>
                                                </button>

                                                <div class="@GetUserModalDropdownMenuClass(showStatusDropdown, openStatusDropdownUpward)" style="@GetUserModalDropdownMenuStyle(userStatusMenuMaxHeight)">
                                                    @foreach (var option in StatusOptions)
                                                    {
                                                        var isActiveOption = string.Equals(option, "Active", StringComparison.OrdinalIgnoreCase);
                                                        <button type="button"
                                                                class="attendance-filter-select-option @(userForm.IsActive == isActiveOption ? "active" : null)"
                                                                @onclick="() => SelectStatus(option)">
                                                            @option
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    </div>
                                </div>
                                }
                                else
                                {
                                    <div class="attendance-detail-section user-modal-section user-modal-password-section">
                                        <div class="attendance-input-grid">
                                            <div class="attendance-input-field">
                                                <label class="attendance-table-toolbar-label" for="userPassword">Password</label>
                                                <div class="user-password-input-row">
                                                    <input id="userPassword"
                                                           class="form-control attendance-input-control"
                                                           type="text"
                                                           autocomplete="new-password"
                                                           @bind="userForm.Password" />
                                                    <button type="button"
                                                            class="attendance-action-button user-password-random-button"
                                                            title="Generate password"
                                                            aria-label="Generate random password"
                                                            @onclick="GenerateAddUserPassword">
                                                        <i class="fa-solid fa-shuffle" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="attendance-input-field">
                                                <label class="attendance-table-toolbar-label" for="userPasswordConfirm">Confirm Password</label>
                                                <input id="userPasswordConfirm"
                                                       class="form-control attendance-input-control"
                                                       type="text"
                                                       autocomplete="new-password"
                                                       @bind="addUserPasswordConfirm" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>

                        <div class="attendance-detail-footer">
                            <button type="button" class="attendance-detail-text-action" @onclick="CloseUserModal">Cancel</button>
                            <div class="user-modal-footer-actions">
                                @if (userModalStep == UserModalStep.PersonalInfo)
                                {
                                    <button type="button" class="btn btn-primary attendance-detail-done" @onclick="GoToAccountAccessStep">Next</button>
                                }
                                else if (userModalStep == UserModalStep.AccountAccess)
                                {
                                    <button type="button" class="btn btn-outline-secondary attendance-detail-done" @onclick="GoToPersonalInfoStep">Back</button>
                                    @if (isEditingUser)
                                    {
                                        <button type="button" class="btn btn-primary attendance-detail-done" @onclick="SaveUserAsync">Save</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-primary attendance-detail-done" @onclick="GoToPasswordSetupStep">Next</button>
                                    }
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary attendance-detail-done" @onclick="GoToAccountAccessStepBack">Back</button>
                                    <button type="button" class="btn btn-primary attendance-detail-done" @onclick="SaveUserAsync">Save</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (showPasswordResetModal && userPendingPasswordReset is not null)
            {
                <div class="attendance-detail-overlay" @onclick="ClosePasswordResetModal">
                    <div class="attendance-detail-modal user-delete-modal" @onclick:stopPropagation="true">
                        <div class="attendance-detail-header">
                            <div>
                                <h2 class="attendance-detail-title">Password Reset</h2>
                            </div>
                            <button type="button"
                                    class="attendance-detail-close"
                                    @onclick="ClosePasswordResetModal"
                                    aria-label="Close password reset"
                                    disabled="@isResettingPassword">
                                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                            </button>
                        </div>

                        <div class="attendance-detail-body attendance-input-body">
                            <div class="attendance-detail-section attendance-detail-hero user-modal-hero">
                                <div>
                                    <div class="attendance-detail-eyebrow">Reset Password</div>
                                    <div class="attendance-detail-person">@FormatName(userPendingPasswordReset.LastName, userPendingPasswordReset.FirstName, userPendingPasswordReset.MiddleName)</div>
                                    <div class="attendance-detail-meta">@DisplayValue(userPendingPasswordReset.Username)</div>
                                </div>
                            </div>

                            <div class="attendance-detail-section user-modal-section user-modal-password-section">
                                <div class="attendance-input-grid">
                                    <div class="attendance-input-field">
                                        <label class="attendance-table-toolbar-label" for="resetPassword">New Password</label>
                                        <div class="user-password-input-row">
                                            <input id="resetPassword"
                                                   class="form-control attendance-input-control"
                                                   type="text"
                                                   autocomplete="new-password"
                                                   @bind="passwordResetValue" />
                                            <button type="button"
                                                    class="attendance-action-button user-password-random-button"
                                                    title="Generate password"
                                                    aria-label="Generate random password"
                                                    @onclick="GeneratePasswordResetValue"
                                                    disabled="@isResettingPassword">
                                                <i class="fa-solid fa-shuffle" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="attendance-input-field">
                                        <label class="attendance-table-toolbar-label" for="resetPasswordConfirm">Confirm Password</label>
                                        <input id="resetPasswordConfirm"
                                               class="form-control attendance-input-control"
                                               type="text"
                                               autocomplete="new-password"
                                               @bind="passwordResetConfirm"
                                               disabled="@isResettingPassword" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="attendance-detail-footer">
                            <button type="button"
                                    class="attendance-detail-text-action"
                                    @onclick="ClosePasswordResetModal"
                                    disabled="@isResettingPassword">
                                Cancel
                            </button>
                            <button type="button"
                                    class="btn btn-primary attendance-detail-done"
                                    @onclick="ResetPasswordAsync"
                                    disabled="@isResettingPassword">
                                @(isResettingPassword ? "Saving..." : "Save")
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (showDeleteUserModal && userPendingDelete is not null)
            {
                <div class="attendance-detail-overlay" @onclick="CloseDeleteUserModal">
                    <div class="attendance-detail-modal user-delete-modal" @onclick:stopPropagation="true">
                        <div class="attendance-detail-header">
                            <div>
                                <h2 class="attendance-detail-title">Delete User</h2>
                            </div>
                            <button type="button"
                                    class="attendance-detail-close"
                                    @onclick="CloseDeleteUserModal"
                                    aria-label="Close delete confirmation"
                                    disabled="@isDeletingUser">
                                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                            </button>
                        </div>

                        <div class="attendance-detail-body">
                            <div class="attendance-detail-section attendance-delete-warning">
                                <div class="attendance-delete-icon" aria-hidden="true">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                </div>
                                <div>
                                    <div class="attendance-detail-eyebrow">Confirm Delete</div>
                                    <div class="attendance-detail-person">@FormatName(userPendingDelete.LastName, userPendingDelete.FirstName, userPendingDelete.MiddleName)</div>
                                    <div class="attendance-detail-meta">
                                        This will permanently delete the user account and its access settings.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="attendance-detail-footer">
                            <button type="button"
                                    class="attendance-detail-text-action"
                                    @onclick="CloseDeleteUserModal"
                                    disabled="@isDeletingUser">
                                Cancel
                            </button>
                            <button type="button"
                                    class="btn btn-danger attendance-detail-done"
                                    @onclick="DeleteUserAsync"
                                    disabled="@isDeletingUser">
                                @(isDeletingUser ? "Deleting..." : "Delete")
                            </button>
                        </div>
                    </div>
                </div>
            }

            <table class="table attendance-table">
                <thead>
                    <tr>
                        <th class="attendance-actions-column">Actions</th>
                        <th>@SortHeader("Name", "name")</th>
                        <th>@SortHeader("Username", "username")</th>
                        <th>Email</th>
                        <th>@SortHeader("Role", "role")</th>
                        <th>Access Level</th>
                        <th>@SortHeader("Division / Unit", "division")</th>
                        <th>@SortHeader("Designation", "designation")</th>
                        <th>@SortHeader("Status", "status")</th>
                        <th>@SortHeader("Created", "created")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in PagedUsers)
                    {
                        <tr class="attendance-log-row"
                            data-row-menu-key="@GetUserRowMenuKey(user)"
                            @ondblclick="() => OpenUserDetail(user)"
                            @onmouseenter="e => ShowUserRowMenuAsync(user, e)">
                            <td class="attendance-actions-cell">
                                <button type="button"
                                        class="attendance-action-button"
                                        title="View"
                                        aria-label="View user details"
                                        @onclick="() => OpenUserDetail(user)"
                                        @onclick:stopPropagation="true">
                                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                </button>
                                <button type="button"
                                        class="attendance-action-button"
                                        title="Edit"
                                        aria-label="Edit user"
                                        @onclick="() => OpenEditUserModal(user)"
                                        @onclick:stopPropagation="true"
                                        disabled="@(!CurrentUser.HasAccess(AccessPolicy.EditUser))">
                                    <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                                </button>
                                <button type="button"
                                        class="attendance-action-button"
                                        title="Password Reset"
                                        aria-label="Reset user password"
                                        @onclick="() => OpenPasswordResetModal(user)"
                                        @onclick:stopPropagation="true"
                                        disabled="@(!CurrentUser.HasAccess(AccessPolicy.EditUser))">
                                    <i class="fa-solid fa-key" aria-hidden="true"></i>
                                </button>
                                <button type="button"
                                        class="attendance-action-button"
                                        title="Delete"
                                        aria-label="Delete user"
                                        @onclick="() => OpenDeleteUserModal(user)"
                                        @onclick:stopPropagation="true"
                                        disabled="@(!CanDeleteUser(user))">
                                    <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                                </button>
                            </td>
                            <td><span class="cell-ellipsis" title="@FormatName(user.LastName, user.FirstName, user.MiddleName)">@FormatName(user.LastName, user.FirstName, user.MiddleName)</span></td>
                            <td><span class="cell-ellipsis" title="@DisplayValue(user.Username)">@DisplayValue(user.Username)</span></td>
                            <td><span class="cell-ellipsis" title="@DisplayValue(user.Email)">@DisplayValue(user.Email)</span></td>
                            <td><span class="cell-ellipsis" title="@DisplayValue(user.Role)">@DisplayValue(user.Role)</span></td>
                            <td>
                                <div class="user-access-pill-list" title="@DisplayAccess(user.AccessLevel)">
                                    @foreach (var access in GetAccessPills(user))
                                    {
                                        <span class="access-level-badge">@access</span>
                                    }
                                </div>
                            </td>
                            <td><span class="cell-ellipsis" title="@DisplayValue(user.DivisionCenterUnit)">@DisplayValue(user.DivisionCenterUnit)</span></td>
                            <td><span class="cell-ellipsis" title="@DisplayValue(user.Designation)">@DisplayValue(user.Designation)</span></td>
                            <td><span class="status-badge @(user.IsActive ? "status-ok" : "status-danger")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                            <td><span class="cell-ellipsis" title="@FormatDate(user.DateCreated)">@FormatDate(user.DateCreated)</span></td>
                        </tr>
                    }
                    @if (!PagedUsers.Any())
                    {
                        <tr>
                            <td colspan="10" class="attendance-empty-state">No users match the current search and filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="attendance-hover-row-menu @(HasHoveredRowMenu ? "show" : null)"
             style="@RowActionMenuStyle"
             @onmouseenter="KeepRowMenuOpen"
             @onmouseleave="HideRowMenuAsync"
             @onclick:stopPropagation="true">
            @if (hoveredUserRowMenuUser is not null)
            {
                <div class="attendance-hover-row-menu-title" title="@FormatName(hoveredUserRowMenuUser.LastName, hoveredUserRowMenuUser.FirstName, hoveredUserRowMenuUser.MiddleName)">
                    @FormatName(hoveredUserRowMenuUser.LastName, hoveredUserRowMenuUser.FirstName, hoveredUserRowMenuUser.MiddleName)
                </div>
                <button type="button" @onclick="OpenHoveredUserDetail">
                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                    <span>View</span>
                </button>
            <button type="button" @onclick="OpenHoveredUserEdit" disabled="@(!CurrentUser.HasAccess(AccessPolicy.EditUser))">
                    <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                    <span>Edit</span>
                </button>
                <button type="button" @onclick="OpenHoveredPasswordReset" disabled="@(!CurrentUser.HasAccess(AccessPolicy.EditUser))">
                    <i class="fa-solid fa-key" aria-hidden="true"></i>
                    <span>Password Reset</span>
                </button>
                <button type="button" class="attendance-hover-row-menu-danger" @onclick="OpenHoveredUserDelete" disabled="@(!CanDeleteUser(hoveredUserRowMenuUser))">
                    <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                    <span>Delete</span>
                </button>
            }
        </div>

        <div class="table-footer">
            <div class="table-entries">@GetEntriesText(filteredUsers.Count, userPage, pageSize)</div>
            <div class="table-pagination">
                <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangeUserPage(userPage - 1)" disabled="@(userPage <= 1)">&#8249;</button>
                @foreach (var pageItem in BuildPageItems(UserTotalPages, userPage))
                {
                    if (pageItem.HasValue)
                    {
                        <button type="button" class="table-page-btn @(pageItem.Value == userPage ? "active" : null)" @onclick="() => ChangeUserPage(pageItem.Value)">@pageItem.Value</button>
                    }
                    else
                    {
                        <span class="table-page-ellipsis">...</span>
                    }
                }
                <button type="button" class="table-page-btn table-page-arrow" @onclick="() => ChangeUserPage(userPage + 1)" disabled="@(userPage >= UserTotalPages)">&#8250;</button>
            </div>
        </div>
    </div>
</div>
</RequireAccess>

<style>
    .attendance-logs-export-btn {
        align-self: center;
        white-space: nowrap;
    }

    .attendance-table-toolbar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .attendance-table-search {
        flex: 1 1 420px;
        max-width: 520px;
    }

    .attendance-table-search-input,
    .attendance-input-control {
        min-height: 2.85rem;
    }

    .attendance-table-search-input::-webkit-search-cancel-button {
        cursor: pointer;
        filter: grayscale(1) brightness(0);
        opacity: 1;
    }

    .attendance-table-actions {
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .attendance-table-toolbar-label {
        display: inline-block;
        margin-bottom: 0.25rem;
        color: var(--finance-text-muted);
        font-size: 0.74rem;
        font-weight: 600;
    }

    .attendance-filter-dropdown,
    .attendance-filter-field,
    .access-select {
        position: relative;
    }

    .attendance-filter-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 2.85rem;
    }

    .attendance-filter-button-clear,
    .attendance-sort-clear {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 0.92rem;
        height: 0.92rem;
        border: 1px solid #d4d8e1;
        border-radius: 999px;
        background: #fff;
        color: var(--finance-text-muted);
        font-size: 0.62rem;
        line-height: 1;
        cursor: pointer;
    }

    .attendance-filter-button-clear:hover,
    .attendance-sort-clear:hover {
        border-color: #bcc4d2;
        color: var(--finance-primary, var(--finance-text));
    }

    .attendance-filter-menu {
        position: absolute;
        top: calc(100% + 0.55rem);
        right: 0;
        width: min(92vw, 560px);
        padding: 0.55rem;
        border: 1px solid var(--finance-border);
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
        opacity: 0;
        transform: translateY(-8px);
        pointer-events: none;
        transition: opacity 0.18s ease, transform 0.18s ease;
        z-index: 20;
    }

    .attendance-filter-menu.show {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    .attendance-filter-grid,
    .attendance-input-grid.two-columns {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem;
    }

    .attendance-input-grid.user-access-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.5rem;
        align-items: end;
    }

    .user-office-grid {
        gap: 0.5rem;
    }

    .attendance-input-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.65rem;
    }

    .user-modal-identity .attendance-input-grid {
        grid-template-columns: 1fr;
    }

    .user-modal-identity .attendance-input-field {
        grid-column: auto;
    }

    .user-modal-identity .user-identity-account-field {
        grid-column: auto;
    }

    .user-status-toggle {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 2.05rem;
        width: 10.5rem;
        padding: 0.12rem;
        border: 1px solid #d8dee8;
        border-radius: 999px;
        background: #eceef2;
        box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.08);
        gap: 0;
    }

    .user-status-toggle-option {
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: #64748b;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0;
    }

    .user-status-toggle-option.active {
        background: #ffffff;
        color: #166534;
        box-shadow: 0 1px 5px rgba(15, 23, 42, 0.18);
    }

    .user-status-toggle-option.inactive {
        background: #ffffff;
        color: #991b1b;
        box-shadow: 0 1px 5px rgba(15, 23, 42, 0.18);
    }

    .attendance-filter-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 0.55rem;
        font-size: 0.82rem;
    }

    .attendance-filter-clear {
        border: 0;
        padding: 0.3rem 0.45rem;
        background: transparent;
        color: var(--finance-text-muted);
        font-size: 0.82rem;
        cursor: pointer;
    }

    .attendance-filter-apply {
        min-width: 64px;
        min-height: 2rem;
        padding: 0.32rem 0.72rem;
        font-size: 0.82rem;
    }

    .attendance-filter-select-wrap {
        position: relative;
    }

    .attendance-filter-select-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.65rem;
        width: 100%;
        min-height: 2.35rem;
        padding: 0.5rem 0.65rem;
        border: 1px solid var(--finance-border);
        border-radius: 8px;
        background: #fff;
        color: var(--finance-text);
        font-size: 0.9rem;
        text-align: left;
    }

    .attendance-filter-select-trigger.active {
        border-color: var(--finance-primary, #2563eb);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .attendance-filter-select-value {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .attendance-filter-select-menu {
        position: absolute;
        top: calc(100% + 0.35rem);
        left: 0;
        right: 0;
        max-height: 16rem;
        overflow: auto;
        padding: 0.35rem;
        border: 1px solid var(--finance-border);
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 16px 34px rgba(15, 23, 42, 0.12);
        opacity: 0;
        transform: translateY(-4px);
        pointer-events: none;
        visibility: hidden;
        z-index: 30;
    }

    .attendance-filter-select-menu.show {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
        visibility: visible;
    }

    .attendance-filter-select-option,
    .attendance-entries-option {
        display: block;
        width: 100%;
        padding: 0.5rem 0.65rem;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: var(--finance-text);
        text-align: left;
        font-size: 0.9rem;
    }

    .attendance-filter-select-option:hover,
    .attendance-filter-select-option.active,
    .attendance-entries-option:hover,
    .attendance-entries-option.active {
        background: var(--finance-surface-soft);
    }

    .attendance-entries-counter,
    .attendance-entries-menu {
        min-width: 92px;
    }

    .attendance-entries-button {
        justify-content: space-between;
        min-width: 92px;
        width: 100%;
        gap: 0.75rem;
    }

    .attendance-entries-menu {
        width: 100%;
        padding: 0.35rem;
    }

    .attendance-empty-state {
        padding: 2rem 1rem;
        text-align: center;
        color: var(--finance-text-muted);
    }

    .attendance-sort-header,
    .attendance-sort-trigger {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .attendance-sort-trigger {
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
    }

    .attendance-sort-trigger.active {
        color: var(--finance-text, #25324b);
    }

    .attendance-sort-label {
        white-space: nowrap;
    }

    .attendance-sort-icon {
        color: var(--finance-text-muted);
        line-height: 1;
    }

    .attendance-sort-icon.active {
        color: var(--finance-primary, #1f3a8a);
    }

    .attendance-sort-clear {
        padding: 0;
        font-weight: 500;
    }

    .attendance-table tbody .attendance-log-row {
        cursor: pointer;
        transition: background-color 0.18s ease;
    }

    .attendance-table tbody .attendance-log-row:hover {
        background: #fbfcff;
    }

    .attendance-actions-column,
    .attendance-actions-cell {
