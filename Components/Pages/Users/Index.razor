    private async Task ResetPasswordAsync()
    {
        if (userPendingPasswordReset is null || isResettingPassword)
        {
            return;
        }

        if (!CurrentUser.HasAccess(AccessPolicy.EditUser))
        {
            ShowToast(ToastType.Warning, "Password reset unavailable", "You do not have access to edit users.");
            return;
        }

        if (!PasswordsMatch(passwordResetValue, passwordResetConfirm, "reset"))
        {
            return;
        }

        isResettingPassword = true;

        try
        {
            var existing = await Db.UserAccounts.FindAsync(userPendingPasswordReset.UserAccountId);
            if (existing is null)
            {
                ShowToast(ToastType.Warning, "User not found", "The user account no longer exists.");
            }
            else
            {
                existing.Password = BCrypt.Net.BCrypt.HashPassword(passwordResetValue);
                existing.MustChangePassword = true;
                existing.DateUpdated = DateTime.UtcNow;
                await Db.SaveChangesAsync();
                showPasswordResetModal = false;
                userPendingPasswordReset = null;
                passwordResetValue = string.Empty;
                passwordResetConfirm = string.Empty;
                await LoadUsersAsync();
                ShowToast(ToastType.Success, "Password reset", "The user's password was updated.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Password reset failed", ex.Message);
        }
        finally
        {
            isResettingPassword = false;
        }
    }

    private async Task DeleteUserAsync()
    {
        if (userPendingDelete is null || isDeletingUser)
        {
            return;
        }

        if (!CanDeleteUsers)
        {
            ShowToast(ToastType.Warning, "Delete unavailable", "You do not have access to delete users.");
            return;
        }

        if (IsCurrentUser(userPendingDelete))
        {
            ShowToast(ToastType.Warning, "Delete unavailable", "You cannot delete your own user account.");
            return;
        }

        isDeletingUser = true;

        try
        {
            var userId = userPendingDelete.UserAccountId;
            var userName = FormatName(userPendingDelete.LastName, userPendingDelete.FirstName, userPendingDelete.MiddleName);
            var existing = await Db.UserAccounts.FindAsync(userId);

            if (existing is null)
            {
                ShowToast(ToastType.Warning, "User not found", "The user account no longer exists.");
            }
            else
            {
                Db.UserAccounts.Remove(existing);
                await Db.SaveChangesAsync();

                if (selectedUser?.UserAccountId == userId)
                {
                    selectedUser = null;
                }

                showDeleteUserModal = false;
                userPendingDelete = null;
                await LoadUsersAsync();
                ShowToast(ToastType.Success, "User deleted", $"{userName} was deleted.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(ToastType.Error, "Delete failed", ex.Message);
        }
        finally
        {
            isDeletingUser = false;
        }
    }

