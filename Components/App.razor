<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap-grid.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap-reboot.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap-utilities.min.css"]" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    @* <link href="@Assets["_content/Syncfusion.Blazor.Themes/bootstrap5.css"]" rel="stylesheet" /> *@
    <link href="@Assets["lib/syncfusion/blazor-themes/compiled-themes/bootstrap5.3.css"]" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/admin.css"]" />
    <script>
        (() => {
            try {
                const theme = localStorage.getItem('etrs.theme');
                const isDark = theme === 'dark';
                document.documentElement.dataset.bsTheme = isDark ? 'dark' : 'light';
                document.documentElement.classList.toggle('etrs-dark-theme', isDark);
                document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
            } catch {
                document.documentElement.dataset.bsTheme = 'light';
            }
        })();
    </script>
    @* <link rel="stylesheet" href="@Assets["Financial.styles.css"]" /> *@

    <ImportMap />
    <link rel="icon" type="image/png" href="@Assets["images/bswm-light.png"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* <Routes @rendermode="InteractiveServer" /> *@
    @* Global toast container (interactive) - declared without overriding render mode *@
    <ToastContainer />
    <Routes />
    <ReconnectModal />
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.min.js"]"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.Core/scripts/syncfusion-blazor.min.js"]" type="text/javascript"></script>
    <script src="@Assets["js/sidebar-overlay.js"]"></script>
    <script src="@Assets["js/layout-sync.js"]"></script>
    <script src="@Assets["js/attendance-logs.js"]"></script>
    <script src="@Assets["js/dashboard-apex-charts.js"]"></script>
</body>

</html>
