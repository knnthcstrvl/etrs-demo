<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
		<UseAppHost>false</UseAppHost>
       <AssemblyName>Financial</AssemblyName>
		<RootNamespace>Financial</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
	  <Content Remove="wwwroot\images\banner.jpg" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="wwwroot\images\banner.jpg" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="bin\**\*.cs" />
		<Compile Remove="obj\**\*.cs" />
		<Compile Remove="artifacts\**\*.cs" />
		<Compile Remove="build-temp\**\*.cs" />
		<Compile Remove="build-verify\**\*.cs" />
		<EmbeddedResource Remove="bin\**" />
		<EmbeddedResource Remove="obj\**" />
		<EmbeddedResource Remove="artifacts\**" />
		<EmbeddedResource Remove="build-temp\**" />
		<EmbeddedResource Remove="build-verify\**" />
		<Content Remove="bin\**" />
		<Content Remove="obj\**" />
		<Content Remove="artifacts\**" />
		<Content Remove="build-temp\**" />
		<Content Remove="build-verify\**" />
		<None Remove="bin\**" />
		<None Remove="obj\**" />
		<None Remove="artifacts\**" />
		<None Remove="build-temp\**" />
		<None Remove="build-verify\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="Mapster" Version="7.4.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.1.0" />
		<PackageReference Include="Syncfusion.Blazor.Buttons" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Charts" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Core" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Data" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.DataForm" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.DropDowns" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Grid" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Inputs" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Layouts" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Lists" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Navigations" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Notifications" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Popups" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.ProgressBar" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.SfPdfViewer" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Spinner" Version="32.1.20" />
		<PackageReference Include="Syncfusion.Blazor.Themes" Version="32.1.20" />
        <PackageReference Include="QuestPDF" Version="2024.3.0" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Components\Pages\Accounting\" />
	  <Folder Include="DTO\Library\" />
	  <Folder Include="Hubs\" />
	  <Folder Include="Migrations\" />
	  <Folder Include="Model\Modules\" />
	  <Folder Include="Model\Trace\" />
	</ItemGroup>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>
</Project>
